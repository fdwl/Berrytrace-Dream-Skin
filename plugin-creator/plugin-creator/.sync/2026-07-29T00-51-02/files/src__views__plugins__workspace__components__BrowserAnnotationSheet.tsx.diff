diff --git a/src/views/plugins/workspace/components/BrowserAnnotationSheet.tsx b/src/views/plugins/workspace/components/BrowserAnnotationSheet.tsx
new file mode 100644
index 0000000..43f8b11
--- /dev/null
+++ b/src/views/plugins/workspace/components/BrowserAnnotationSheet.tsx
@@ -0,0 +1,133 @@
+import React, { useState } from 'react';
+import { X, AlertCircle, Plus } from 'lucide-react';
+
+export interface BrowserAnnotationSheetProps {
+  payload: any;
+  annotationIndex: number;
+  existingComment?: string;
+  existingIntent?: string;
+  onSaveAnnotation: (comment: string, intent: string) => void;
+  onCancel: () => void;
+}
+
+export function BrowserAnnotationSheet({
+  payload,
+  annotationIndex,
+  existingComment = '',
+  existingIntent = 'fix',
+  onSaveAnnotation,
+  onCancel,
+}: BrowserAnnotationSheetProps) {
+  const [comment, setComment] = useState(existingComment);
+  const [intent, setIntent] = useState<'fix' | 'change' | 'question' | 'approve'>(existingIntent as any);
+
+  const handleSubmit = (e: React.FormEvent) => {
+    e.preventDefault();
+    if (!comment.trim()) return;
+    onSaveAnnotation(comment.trim(), intent);
+  };
+
+  return (
+    <div className="absolute inset-0 z-40 bg-black/40 dark:bg-black/60 backdrop-blur-sm flex items-center justify-center p-4 select-none animate-in fade-in duration-150">
+      <div className="w-full max-w-lg bg-card text-foreground border border-border rounded-2xl shadow-2xl overflow-hidden flex flex-col">
+        {/* Header */}
+        <div className="flex items-center justify-between px-5 py-3.5 border-b border-border bg-muted/30">
+          <div className="flex items-center gap-2">
+            <span className="w-5 h-5 rounded-full bg-emerald-600 text-white font-bold flex items-center justify-center text-[11px] shadow-sm">
+              {annotationIndex}
+            </span>
+            <h3 className="text-sm font-semibold text-foreground">添加/修改元素注释标注</h3>
+          </div>
+          <button
+            type="button"
+            onClick={onCancel}
+            className="p-1 rounded-lg text-muted-foreground hover:text-foreground hover:bg-muted transition-colors cursor-pointer"
+            title="关闭"
+          >
+            <X className="w-4 h-4" />
+          </button>
+        </div>
+
+        {/* Form Body */}
+        <form onSubmit={handleSubmit} className="p-5 space-y-4 text-xs">
+          {/* Target Element Info */}
+          <div className="p-3 rounded-xl bg-muted/40 border border-border/60 space-y-1">
+            <div className="flex items-center gap-2">
+              <span className="font-mono text-emerald-600 dark:text-emerald-400 font-semibold">{`<${payload.target.tagName}>`}</span>
+              <span className="text-muted-foreground font-mono truncate">{payload.target.selector}</span>
+            </div>
+            {payload.target.textSnippet && (
+              <p className="text-muted-foreground truncate italic">"{payload.target.textSnippet}"</p>
+            )}
+          </div>
+
+          {/* Intent Selector */}
+          <div className="space-y-1.5">
+            <label className="text-foreground font-medium">标注类型</label>
+            <div className="grid grid-cols-4 gap-2">
+              {[
+                { id: 'fix', label: 'BUG 修复' },
+                { id: 'change', label: '样式修改' },
+                { id: 'question', label: '疑问咨询' },
+                { id: 'approve', label: '验收确认' },
+              ].map((item) => (
+                <button
+                  key={item.id}
+                  type="button"
+                  onClick={() => setIntent(item.id as any)}
+                  className={`py-1.5 px-2 rounded-lg border text-center transition-all cursor-pointer ${
+                    intent === item.id
+                      ? 'border-emerald-500 bg-emerald-500/15 text-emerald-600 dark:text-emerald-400 font-medium shadow-sm'
+                      : 'border-border bg-muted/30 text-muted-foreground hover:bg-muted'
+                  }`}
+                  title={item.label}
+                >
+                  {item.label}
+                </button>
+              ))}
+            </div>
+          </div>
+
+          {/* Comment Area */}
+          <div className="space-y-1.5">
+            <label className="text-foreground font-medium">标注需求与修改建议</label>
+            <textarea
+              autoFocus
+              rows={4}
+              value={comment}
+              onChange={(e) => setComment(e.target.value)}
+              placeholder="请输入对此元素的修改要求。保存后可继续点击其他元素添加更多注释，最后可一键批量发送给 Agent..."
+              className="w-full p-3 rounded-xl bg-background border border-input focus:border-emerald-500 text-foreground placeholder-muted-foreground outline-none resize-none shadow-inner"
+            />
+          </div>
+
+          <div className="flex items-center gap-2 text-[11px] text-muted-foreground">
+            <AlertCircle className="w-3.5 h-3.5 shrink-0 text-emerald-500" />
+            <span>保存后可在网页上保留 [Pin 标记]，点击 Pin 可随时重新编辑</span>
+          </div>
+
+          {/* Footer Actions */}
+          <div className="flex items-center justify-end gap-2 pt-2 border-t border-border">
+            <button
+              type="button"
+              onClick={onCancel}
+              className="px-4 py-2 rounded-xl border border-border text-muted-foreground hover:bg-muted transition-colors cursor-pointer"
+              title="取消"
+            >
+              取消
+            </button>
+            <button
+              type="submit"
+              disabled={!comment.trim()}
+              className="flex items-center gap-1.5 px-4 py-2 rounded-xl bg-emerald-600 disabled:opacity-40 hover:bg-emerald-500 text-white font-medium shadow-md transition-colors cursor-pointer"
+              title="保存注释"
+            >
+              <Plus className="w-4 h-4" />
+              保存标注 #{annotationIndex}
+            </button>
+          </div>
+        </form>
+      </div>
+    </div>
+  );
+}