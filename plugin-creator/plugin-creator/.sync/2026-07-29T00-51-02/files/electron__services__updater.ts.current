import type { BrowserWindow } from 'electron';
import { app, ipcMain } from 'electron';

// 独立注册基础 IPC handlers (版本获取与基础 IPC)
export function registerUpdaterIpc(): void {
  ipcMain.handle('updater:get-version', () => {
    return app.getVersion();
  });
}

export async function setupAutoUpdater(mainWindow: BrowserWindow): Promise<void> {
  const pkg = await import('electron-updater')
  const autoUpdater = pkg.autoUpdater || (pkg.default && (pkg.default as unknown as typeof pkg).autoUpdater)
  if (!autoUpdater) {
    console.error('[Updater] Failed to get autoUpdater instance from electron-updater')
    return
  }

  autoUpdater.logger = console
  autoUpdater.autoDownload = true

  // 注册手动检查更新 IPC
  ipcMain.handle('updater:check', async () => {
    console.log('[Updater] 手动触发检查更新...')
    if (app.isPackaged) {
      try {
        const result = await autoUpdater.checkForUpdates();
        return { success: true, result };
      } catch (err: any) {
        console.error('[Updater] 手动检查更新失败:', err);
        return { success: false, error: err.message };
      }
    } else {
      console.log('[Updater] 开发环境模拟触发检查更新...')
      // 模拟触发检查流程
      setTimeout(() => {
        if (mainWindow && !mainWindow.isDestroyed()) {
          mainWindow.webContents.send('updater:checking');
        }
      }, 500);
      setTimeout(() => {
        if (mainWindow && !mainWindow.isDestroyed()) {
          mainWindow.webContents.send('updater:available', { version: '2.0.0' });
        }
      }, 1500);
      setTimeout(() => {
        if (mainWindow && !mainWindow.isDestroyed()) {
          mainWindow.webContents.send('updater:download-progress', { percent: 50.0 });
        }
      }, 2500);
      setTimeout(() => {
        if (mainWindow && !mainWindow.isDestroyed()) {
          mainWindow.webContents.send('updater:downloaded', { version: '2.0.0' });
        }
      }, 4000);
      return { success: true, mock: true };
    }
  });


  if (app.isPackaged) {
    setTimeout(() => {
      autoUpdater.checkForUpdates().catch((err) => {
        console.error('[Updater] 检查更新失败:', err)
      })
    }, 60 * 1000)
  } else {
    ipcMain.on('updater:mock-downloaded', () => {
      console.log('[Updater] 开发环境模拟发送：更新下载完成')
      mainWindow.webContents.send('updater:downloaded', { version: '2.0.0' })
    })
  }

  autoUpdater.on('checking-for-update', () => {
    console.log('[Updater] 正在检查更新...')
    if (mainWindow && !mainWindow.isDestroyed()) {
      mainWindow.webContents.send('updater:checking');
    }
  })

  autoUpdater.on('update-available', (info) => {
    console.log('[Updater] 发现新版本:', info.version)
    if (mainWindow && !mainWindow.isDestroyed()) {
      mainWindow.webContents.send('updater:available', info);
    }
  })

  autoUpdater.on('update-not-available', (info) => {
    console.log('[Updater] 当前已是最新版本:', info.version)
    if (mainWindow && !mainWindow.isDestroyed()) {
      mainWindow.webContents.send('updater:not-available', info);
    }
  })

  autoUpdater.on('download-progress', (progressObj) => {
    console.log(`[Updater] 下载进度: ${progressObj.percent.toFixed(2)}%`)
    if (mainWindow && !mainWindow.isDestroyed()) {
      mainWindow.webContents.send('updater:download-progress', progressObj);
    }
  })

  autoUpdater.on('update-downloaded', (info) => {
    console.log('[Updater] 新版本已在后台下载完成:', info.version)
    if (mainWindow && !mainWindow.isDestroyed()) {
      mainWindow.webContents.send('updater:downloaded', info)
    }
  })

  autoUpdater.on('error', (err) => {
    console.error('[Updater] 自动更新发生错误:', err)
    if (mainWindow && !mainWindow.isDestroyed()) {
      mainWindow.webContents.send('updater:error', err?.message || String(err));
    }
  })

  ipcMain.on('updater:quit-and-install', () => {
    console.log('[Updater] 收到重启并安装指令，正在退出并安装更新...')
    autoUpdater.quitAndInstall()
  })
}
