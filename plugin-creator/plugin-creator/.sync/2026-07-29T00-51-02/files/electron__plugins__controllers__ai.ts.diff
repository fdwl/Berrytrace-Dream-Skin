+  /**
+   * 预热 Agent 内核会话进程。
+   */
+  async ai_prewarmAgentSession(options: { agentId: string; model?: string; sessionId?: string }): Promise<null> {
+    if (!options || !options.agentId) return null;
+
+    const pm = PluginManager.getInstance();
+    const kernelPluginId = pm.getAgentKernelPluginId();
+    if (!kernelPluginId) return null;
+
+    pm.emitToBackgroundPlugin(kernelPluginId, 'agent:prewarm_session', options);
+    console.log(`[AiController] Forwarded agent:prewarm_session to kernel plugin: ${kernelPluginId}`);
+    return null;
+  }
+
+  /**
+   * 离开 Agent 内核会话。
+   */
+  async ai_leaveAgentSession(options: { sessionId: string } | string): Promise<null> {
+    const sessionId = typeof options === 'string' ? options : options?.sessionId;
+    if (!sessionId) return null;
+
+    const pm = PluginManager.getInstance();
+    const kernelPluginId = pm.getAgentKernelPluginId();
+    if (!kernelPluginId) return null;
+
+    pm.emitToBackgroundPlugin(kernelPluginId, 'agent:session_leave', { sessionId });
+    console.log(`[AiController] Forwarded agent:session_leave to kernel plugin: ${kernelPluginId}`);
+    return null;
+  }
