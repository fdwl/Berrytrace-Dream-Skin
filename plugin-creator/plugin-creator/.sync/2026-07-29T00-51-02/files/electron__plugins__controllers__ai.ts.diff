+  /**
+   * 获取所有已注册的 AI 服务商及其模型列表。
+   */
+  async ai_getAiServers(): Promise<unknown> {
+    const mainWindow = ElectronMainWindow.getInstance().getWindow();
+    if (mainWindow && !mainWindow.isDestroyed()) {
+      try {
+        const serversJson = await mainWindow.webContents.executeJavaScript(`localStorage.getItem('agent-ai-servers')`);
+        if (serversJson) {
+          return JSON.parse(serversJson);
+        }
+      } catch (err) {
+        console.warn('[AiController] Failed to retrieve AI servers from main window:', err);
+      }
+    }
+    return [];
+  }
+
+  /**
+   * 获取按能力分配的服务商与模型映射（供 cline-agent 等插件读取当前 capability→{serverId, model} 配置）
+   */
+  async ai_getCapabilityModels(): Promise<unknown> {
+    const mainWindow = ElectronMainWindow.getInstance().getWindow();
+    if (mainWindow && !mainWindow.isDestroyed()) {
+      try {
+        // capability 映射存储在 agentStore 的 capabilityModels 字段，通过 localStorage 的 agent-store 读取
+        const storeJson = await mainWindow.webContents.executeJavaScript(`localStorage.getItem('agent-store')`);
+        if (storeJson) {
+          const state = JSON.parse(storeJson);
+          return state?.state?.capabilityModels || {};
+        }
+      } catch (err) {
+        console.warn('[AiController] Failed to retrieve capability models:', err);
+      }
+    }
+    return {};
+  }
+
+  async ai_getServerLlmConfig(options: string | { serverId: string }): Promise<unknown> {
+    const serverId = typeof options === 'string' ? options : options?.serverId;
+    if (!serverId) throw new Error('serverId parameter is required');
+
+    const mainWindow = ElectronMainWindow.getInstance().getWindow();
+    if (mainWindow && !mainWindow.isDestroyed()) {
+      try {
+        const serversJson = await mainWindow.webContents.executeJavaScript(`localStorage.getItem('agent-ai-servers')`);
+        if (serversJson) {
+          const aiServers = JSON.parse(serversJson);
+          const server = Array.isArray(aiServers) ? aiServers.find((s: any) => s.id === serverId || s.provider === serverId) : null;
+          if (server) {
+            const { ElectronAuthManager } = await import('../../services/auth-manager');
+            const userToken = ElectronAuthManager.getInstance().getToken() || undefined;
+            return {
+              provider: server.provider,
+              model: server.model,
+              apiKey: server.provider === 'berrytrace' ? userToken : (server.apiKey || undefined),
+              baseUrl: server.baseUrl || (server.provider === 'berrytrace' ? 'https://ai.getdear.cn/v1' : undefined),
+            };
+          }
+        }
+      } catch (err) {
+        console.warn('[AiController] Failed to retrieve server config from main window:', err);
+      }
+    }
+    // Fallback to active default config
+    return this.retrieveLlmConfig();
+  }
+
