import { BaseApiController } from './api-context';
import { MacOSComputerUse } from '../../native/computer-use/computer-use-macos';
import { WindowsComputerUse } from '../../native/computer-use/computer-use-windows';
import type {
  ComputerClickArgs,
  ComputerTypeArgs,
  ComputerHotkeyArgs,
  ComputerScreenshotArgs,
} from '../../native/computer-use/computer-use-types';

export class ComputerUseController extends BaseApiController {
  readonly namespace = 'computerUse';

  private macEngine = new MacOSComputerUse();
  private winEngine = new WindowsComputerUse();

  private get isWindows(): boolean {
    return process.platform === 'win32';
  }

  async getAccessibilityTree(windowTitle?: string) {
    if (this.isWindows) {
      return this.winEngine.getAccessibilityTree(windowTitle);
    }
    return this.macEngine.getAccessibilityTree(windowTitle);
  }

  async clickElement(args: ComputerClickArgs) {
    if (this.isWindows) {
      return this.winEngine.click(args);
    }
    return this.macEngine.click(args);
  }

  async typeText(args: ComputerTypeArgs) {
    if (this.isWindows) {
      return this.winEngine.type(args);
    }
    return this.macEngine.type(args);
  }

  async pressHotkey(args: ComputerHotkeyArgs) {
    if (this.isWindows) {
      return this.winEngine.pressHotkey(args);
    }
    return this.macEngine.pressHotkey(args);
  }

  async captureScreen(args?: ComputerScreenshotArgs) {
    if (this.isWindows) {
      return this.winEngine.captureScreen(args);
    }
    return this.macEngine.captureScreen(args);
  }

  getHandlers(): Record<string, (...args: never[]) => Promise<unknown>> {
    return {
      getAccessibilityTree: this.getAccessibilityTree.bind(this) as (...args: never[]) => Promise<unknown>,
      clickElement: this.clickElement.bind(this) as (...args: never[]) => Promise<unknown>,
      typeText: this.typeText.bind(this) as (...args: never[]) => Promise<unknown>,
      pressHotkey: this.pressHotkey.bind(this) as (...args: never[]) => Promise<unknown>,
      captureScreen: this.captureScreen.bind(this) as (...args: never[]) => Promise<unknown>,
    };
  }
}
