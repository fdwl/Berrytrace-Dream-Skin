+  /**
+   * 检测系统已安装的本地浏览器
+   */
+  async browser_detectBrowsers(): Promise<any> {
+    const { detectInstalledBrowsers } = await import('../../services/browser-cookie-import');
+    return detectInstalledBrowsers();
+  }
+
+  /**
+   * 将网页抓取/注释/截图临时保存为文件，用于 ChatInput 附件块
+   */
+  async browser_saveTempAttachment(params: { filename: string; content: string; isBase64?: boolean }): Promise<{ ok: boolean; filePath: string; relativePath: string }> {
+    const fs = await import('node:fs/promises');
+    const path = await import('node:path');
+    const os = await import('node:os');
+    const { app } = await import('electron');
+
+    try {
+      const tmpDir = path.join(app.getPath('userData'), 'tmp_attachments');
+      await fs.mkdir(tmpDir, { recursive: true });
+      const filePath = path.join(tmpDir, params.filename);
+
+      if (params.isBase64) {
+        const base64Data = params.content.replace(/^data:image\/\w+;base64,/, '');
+        const buffer = Buffer.from(base64Data, 'base64');
+        await fs.writeFile(filePath, buffer);
+      } else {
+        await fs.writeFile(filePath, params.content, 'utf-8');
+      }
+
+      return { ok: true, filePath, relativePath: filePath };
+    } catch (err: any) {
+      console.error('[BrowserController] saveTempAttachment error:', err);
+      throw err;
+    }
+  }
+
