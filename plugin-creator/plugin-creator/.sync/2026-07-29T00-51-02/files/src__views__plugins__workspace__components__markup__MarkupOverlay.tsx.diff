+import React, { useRef, useState, useEffect, useCallback } from 'react';
+import { Check, X } from 'lucide-react';
+import { MarkupToolbar, type MarkupTool } from './MarkupToolbar';
+
+export interface MarkupOverlayProps {
+  baseDataUrl: string;
+  onComplete: (dataUrl: string) => void;
+  onCancel: () => void;
+}
+
+interface Shape {
+  id: string;
+  tool: MarkupTool;
+  color: string;
+  width: number;
+  points: { x: number; y: number }[];
+  text?: string;
+}
+
+export function MarkupOverlay({ baseDataUrl, onComplete, onCancel }: MarkupOverlayProps) {
+  const containerRef = useRef<HTMLDivElement | null>(null);
+  const canvasRef = useRef<HTMLCanvasElement | null>(null);
+  const imgRef = useRef<HTMLImageElement | null>(null);
+  const textInputRef = useRef<HTMLInputElement | null>(null);
+  const [imgLoaded, setImgLoaded] = useState(false);
+
+  const [tool, setTool] = useState<MarkupTool>('rect');
+  const [color, setColor] = useState('#ef4444');
+  const [width, setWidth] = useState(4);
+
+  const [shapes, setShapes] = useState<Shape[]>([]);
+  const [redoStack, setRedoStack] = useState<Shape[]>([]);
+
+  const [isDrawing, setIsDrawing] = useState(false);
+  const [currentShape, setCurrentShape] = useState<Shape | null>(null);
+
+  const [textInput, setTextInput] = useState<{ x: number; y: number; text: string } | null>(null);
+
+  useEffect(() => {
+    if (textInput) {
+      console.log('[MarkupOverlay] Text tool activated at:', textInput.x, textInput.y);
+      setTimeout(() => textInputRef.current?.focus(), 50);
+    }
+  }, [textInput]);
+
+  // 1. High-DPI Resolution & Coordinate Transform
+  const redraw = useCallback(() => {
+    const container = containerRef.current;
+    const canvas = canvasRef.current;
+    const img = imgRef.current;
+    if (!container || !canvas || !img || !imgLoaded) return;
+
+    const ctx = canvas.getContext('2d');
+    if (!ctx) return;
+
+    const dpr = window.devicePixelRatio || 1;
+    const cssWidth = container.clientWidth;
+    const cssHeight = container.clientHeight;
+
+    if (canvas.width !== Math.round(cssWidth * dpr) || canvas.height !== Math.round(cssHeight * dpr)) {
+      canvas.width = Math.round(cssWidth * dpr);
+      canvas.height = Math.round(cssHeight * dpr);
+      canvas.style.width = `${cssWidth}px`;
+      canvas.style.height = `${cssHeight}px`;
+    }
+
+    ctx.setTransform(1, 0, 0, 1, 0, 0);
+    ctx.clearRect(0, 0, canvas.width, canvas.height);
+    ctx.drawImage(img, 0, 0, canvas.width, canvas.height);
+
+    ctx.setTransform(dpr, 0, 0, dpr, 0, 0);
+
+    const allShapes = currentShape ? [...shapes, currentShape] : shapes;
+
+    allShapes.forEach((s) => {
+      ctx.strokeStyle = s.color;
+      ctx.fillStyle = s.color;
+      ctx.lineWidth = s.width;
+      ctx.lineCap = 'round';
+      ctx.lineJoin = 'round';
+
+      if (s.tool === 'rect' && s.points.length >= 2) {
+        const p1 = s.points[0];
+        const p2 = s.points[s.points.length - 1];
+        ctx.beginPath();
+        ctx.rect(p1.x, p1.y, p2.x - p1.x, p2.y - p1.y);
+        ctx.stroke();
+      } else if (s.tool === 'arrow' && s.points.length >= 2) {
+        const p1 = s.points[0];
+        const p2 = s.points[s.points.length - 1];
+        const headLength = 14 + s.width * 2;
+        const dx = p2.x - p1.x;
+        const dy = p2.y - p1.y;
+        const angle = Math.atan2(dy, dx);
+
+        ctx.beginPath();
+        ctx.moveTo(p1.x, p1.y);
+        ctx.lineTo(p2.x, p2.y);
+        ctx.stroke();
+
+        ctx.beginPath();
+        ctx.moveTo(p2.x, p2.y);
+        ctx.lineTo(
+          p2.x - headLength * Math.cos(angle - Math.PI / 6),
+          p2.y - headLength * Math.sin(angle - Math.PI / 6)
+        );
+        ctx.lineTo(
+          p2.x - headLength * Math.cos(angle + Math.PI / 6),
+          p2.y - headLength * Math.sin(angle + Math.PI / 6)
+        );
+        ctx.closePath();
+        ctx.fill();
+      } else if (s.tool === 'pen' && s.points.length > 0) {
+        ctx.beginPath();
+        ctx.moveTo(s.points[0].x, s.points[0].y);
+        for (let i = 1; i < s.points.length; i++) {
+          ctx.lineTo(s.points[i].x, s.points[i].y);
+        }
+        ctx.stroke();
+      } else if (s.tool === 'text' && s.points.length > 0 && s.text) {
+        const p = s.points[0];
+        ctx.font = `bold ${16 + s.width * 2}px sans-serif`;
+        ctx.shadowColor = s.color === '#ffffff' || s.color === '#000000' ? 'rgba(0,0,0,0.8)' : 'rgba(255,255,255,0.9)';
+        ctx.shadowBlur = 4;
+        ctx.fillText(s.text, p.x, p.y + 16);
+        ctx.shadowBlur = 0;
+      }
+    });
+  }, [currentShape, imgLoaded, shapes]);
+
+  useEffect(() => {
+    redraw();
+  }, [redraw]);
+
+  useEffect(() => {
+    const handleResize = () => redraw();
+    window.addEventListener('resize', handleResize);
+    return () => window.removeEventListener('resize', handleResize);
+  }, [redraw]);
+
+  const handlePointerDown = (e: React.PointerEvent<HTMLCanvasElement>) => {
+    if (textInput) {
+      commitText();
+      return;
+    }
+    const rect = canvasRef.current?.getBoundingClientRect();
+    if (!rect) return;
+    const x = e.clientX - rect.left;
+    const y = e.clientY - rect.top;
+
+    if (tool === 'text') {
+      console.log('[MarkupOverlay] Creating text input at x/y:', x, y);
+      setTextInput({ x, y, text: '' });
+      return;
+    }
+
+    setIsDrawing(true);
+    setCurrentShape({
+      id: Math.random().toString(36).substring(2),
+      tool,
+      color,
+      width,
+      points: [{ x, y }],
+    });
+  };
+
+  const handlePointerMove = (e: React.PointerEvent<HTMLCanvasElement>) => {
+    if (!isDrawing || !currentShape) return;
+    const rect = canvasRef.current?.getBoundingClientRect();
+    if (!rect) return;
+    const x = e.clientX - rect.left;
+    const y = e.clientY - rect.top;
+
+    if (tool === 'pen') {
+      setCurrentShape({ ...currentShape, points: [...currentShape.points, { x, y }] });
+    } else {
+      setCurrentShape({ ...currentShape, points: [currentShape.points[0], { x, y }] });
+    }
+  };
+
+  const handlePointerUp = () => {
+    if (!isDrawing || !currentShape) return;
+    setIsDrawing(false);
+    setShapes([...shapes, currentShape]);
+    setCurrentShape(null);
+    setRedoStack([]);
+  };
+
+  const commitText = () => {
+    if (!textInput || !textInput.text.trim()) {
+      setTextInput(null);
+      return;
+    }
+    console.log('[MarkupOverlay] Committing text shape:', textInput.text);
+    setShapes([
+      ...shapes,
+      {
+        id: Math.random().toString(36).substring(2),
+        tool: 'text',
+        color,
+        width,
+        points: [{ x: textInput.x, y: textInput.y }],
+        text: textInput.text.trim(),
+      },
+    ]);
+    setTextInput(null);
+    setRedoStack([]);
+  };
+
+  const handleUndo = () => {
+    if (shapes.length === 0) return;
+    const last = shapes[shapes.length - 1];
+    setShapes(shapes.slice(0, -1));
+    setRedoStack([...redoStack, last]);
+  };
+
+  const handleRedo = () => {
+    if (redoStack.length === 0) return;
+    const last = redoStack[redoStack.length - 1];
+    setRedoStack(redoStack.slice(0, -1));
+    setShapes([...shapes, last]);
+  };
+
+  const handleClear = () => {
+    setShapes([]);
+    setRedoStack([]);
+  };
+
+  const handleFinish = () => {
+    const canvas = canvasRef.current;
+    if (!canvas) return;
+    const resultUrl = canvas.toDataURL('image/png');
+    onComplete(resultUrl);
+  };
+
+  return (
+    <div ref={containerRef} className="absolute inset-0 z-50 overflow-hidden bg-black/80 flex flex-col select-none">
+      {/* Base Image */}
+      <img
+        ref={imgRef}
+        src={baseDataUrl}
+        alt="Base Screenshot"
+        className="hidden"
+        onLoad={() => {
+          setImgLoaded(true);
+          redraw();
+        }}
+      />
+
+      {/* High-DPI Canvas */}
+      <canvas
+        ref={canvasRef}
+        onPointerDown={handlePointerDown}
+        onPointerMove={handlePointerMove}
+        onPointerUp={handlePointerUp}
+        className="absolute inset-0 w-full h-full cursor-crosshair z-10"
+      />
+
+      {/* Active Text Input Editor Overlay */}
+      {textInput && (
+        <div
+          className="absolute z-[99999] pointer-events-auto"
+          style={{
+            left: `${textInput.x}px`,
+            top: `${textInput.y}px`,
+          }}
+        >
+          <input
+            ref={textInputRef}
+            type="text"
+            value={textInput.text}
+            onChange={(e) => setTextInput({ ...textInput, text: e.target.value })}
+            onKeyDown={(e) => {
+              if (e.key === 'Enter') commitText();
+              else if (e.key === 'Escape') setTextInput(null);
+            }}
+            onBlur={commitText}
+            placeholder="输入标注文字 (Enter保存)..."
+            className="bg-slate-900/95 border-2 border-blue-500 text-white font-bold px-3 py-1.5 outline-none rounded-lg shadow-2xl min-w-[200px] text-sm"
+            style={{
+              color,
+            }}
+          />
+        </div>
+      )}
+
+      {/* Toolbar & Action Bar */}
+      <div className="absolute bottom-4 inset-x-0 z-50 flex flex-col items-center gap-3 pointer-events-none">
+        <div className="pointer-events-auto">
+          <MarkupToolbar
+            tool={tool}
+            onToolChange={setTool}
+            color={color}
+            onColorChange={setColor}
+            width={width}
+            onWidthChange={setWidth}
+            canUndo={shapes.length > 0}
+            canRedo={redoStack.length > 0}
+            onUndo={handleUndo}
+            onRedo={handleRedo}
+            onClear={handleClear}
+          />
+        </div>
+
+        <div className="pointer-events-auto flex items-center gap-3 px-4 py-2 rounded-xl bg-card border border-border text-foreground shadow-2xl text-xs backdrop-blur">
+          <span>完成标注后点击导出，图片将自动添加至 Agent ChatInput 顶部卡片</span>
+          <button
+            type="button"
+            onClick={onCancel}
+            className="flex items-center gap-1 px-3 py-1.5 rounded-lg border border-border hover:bg-muted text-muted-foreground hover:text-foreground cursor-pointer"
+            title="取消"
+          >
+            <X className="w-3.5 h-3.5" />
+            取消
+          </button>
+          <button
+            type="button"
+            onClick={handleFinish}
+            className="flex items-center gap-1 px-3.5 py-1.5 rounded-lg bg-blue-600 hover:bg-blue-500 text-white font-medium shadow cursor-pointer"
+            title="完成导出"
+          >
+            <Check className="w-3.5 h-3.5" />
+            完成导出
+          </button>
+        </div>
+      </div>
+    </div>
+  );
+}