import { useEffect, useState } from 'react';
import { useDashboardStore } from '../../../stores/dashboard';
import { useWorkspaceStore } from '../../../stores/workspace';
import { useAppStore } from '../../../stores/app';
import { isMac } from '../../../utils/platform';

export interface RecentDocItem {
  path: string;
  title: string;
  lastOpened: number;
}

interface WorkspaceHomeProps {
  onOpenRecent?: (item: RecentDocItem) => void;
  onCreateNew?: () => void;
  onClose?: () => void;
}

interface QuickAction {
  id: string;
  label: string;
  icon: React.ReactNode;
  color: string;
  onClick: () => void;
}

export default function WorkspaceHome({ _onOpenRecent, onCreateNew, _onClose }: WorkspaceHomeProps) {
  const [workspaceName, setWorkspaceName] = useState<string>('');
  const _hideWorkspace = useDashboardStore((s) => s.hideWorkspace);
  const sidebarCollapsed = useAppStore((s) => s.sidebarCollapsed);
  const zenMode = useAppStore((s) => s.zenMode);
  const workspaceMaximized = useDashboardStore((s) => s.workspaceMaximized);

  // 仅在 macOS 且 左侧边栏(sidebar) 与 中间内容区(content area) 均被隐藏/折叠（即只有 Workspace 独占屏幕）时，标题才需要右移避开交通灯
  const isWorkspaceOnly = sidebarCollapsed && (workspaceMaximized || zenMode);
  const needMacOffset = isMac && isWorkspaceOnly;

  useEffect(() => {
    const fetchInfo = async () => {
      try {
        const meta = await window.electronAPI?.workspace?.getMetadata();
        if (meta) setWorkspaceName(meta.name || '');
      } catch {
        // ignore
      }
    };
    fetchInfo();
  }, []);

  const _handleClose = () => {
    _hideWorkspace();
    _onClose?.();
  };

  const actions: QuickAction[] = [
    {
      id: 'files',
      label: '文件',
      color: 'var(--color-brand)',
      icon: (
        <svg width="28" height="28" viewBox="0 0 24 24" fill="none" stroke="currentColor" strokeWidth="1.5" strokeLinecap="round" strokeLinejoin="round">
          <path d="M22 19a2 2 0 0 1-2 2H4a2 2 0 0 1-2-2V5a2 2 0 0 1 2-2h5l2 3h9a2 2 0 0 1 2 2z" />
        </svg>
      ),
      onClick: () => onCreateNew?.(),
    },
    {
      id: 'terminal',
      label: '终端',
      color: '#10b981',
      icon: (
        <svg width="28" height="28" viewBox="0 0 24 24" fill="none" stroke="currentColor" strokeWidth="1.5" strokeLinecap="round" strokeLinejoin="round">
          <polyline points="4 17 10 11 4 5" />
          <line x1="12" y1="19" x2="20" y2="19" />
        </svg>
      ),
      onClick: () => {
        const sessionId = `terminal_${Date.now()}`;
        useWorkspaceStore.getState().openWorkspaceTab(
          undefined,
          'system.terminal',
          undefined,
          undefined,
          sessionId,
          false,
          '终端'
        );
      },
    },
    {
      id: 'browser',
      label: '浏览器',
      color: '#f59e0b',
      icon: (
        <svg width="28" height="28" viewBox="0 0 24 24" fill="none" stroke="currentColor" strokeWidth="1.5" strokeLinecap="round" strokeLinejoin="round">
          <circle cx="12" cy="12" r="10" />
          <line x1="2" y1="12" x2="22" y2="12" />
          <path d="M12 2a15.3 15.3 0 0 1 4 10 15.3 15.3 0 0 1-4 10 15.3 15.3 0 0 1-4-10 15.3 15.3 0 0 1 4-10z" />
        </svg>
      ),
      onClick: () => {
        const sessionId = `browser_${Date.now()}`;
        useWorkspaceStore.getState().openWorkspaceTab(
          undefined,
          'system.browser',
          undefined,
          undefined,
          sessionId,
          false,
          '浏览器'
        );
      },
    },
    {
      id: 'plugins',
      label: '插件',
      color: '#8b5cf6',
      icon: (
        <svg width="28" height="28" viewBox="0 0 24 24" fill="none" stroke="currentColor" strokeWidth="1.5" strokeLinecap="round" strokeLinejoin="round">
          <rect x="3" y="3" width="7" height="7" />
          <rect x="14" y="3" width="7" height="7" />
          <rect x="3" y="14" width="7" height="7" />
          <rect x="14" y="14" width="7" height="7" />
        </svg>
      ),
      onClick: () => {},
    },
  ];

  return (
    <div className="flex-1 flex flex-col w-full h-full overflow-hidden" style={{ background: 'var(--bg-page)', color: 'var(--text-primary)' }}>
      {/* Header */}
      <div className={`flex items-center justify-between py-3 shrink-0 transition-all ${
        needMacOffset ? 'pl-[74px] pr-4' : 'px-4'
      }`}>
        <span className="text-[11px] font-semibold text-[var(--text-tertiary)] uppercase tracking-wider">
          {workspaceName || 'Workspace'}
        </span>
        {/* <button
          onClick={handleClose}
          className="p-1 rounded-md text-[var(--text-tertiary)] hover:text-[var(--text-primary)] hover:bg-[var(--bg-hover)] transition-colors cursor-pointer border-none bg-transparent"
          title="隐藏 Workspace"
        >
          <svg width="14" height="14" viewBox="0 0 24 24" fill="none" stroke="currentColor" strokeWidth="2" strokeLinecap="round" strokeLinejoin="round">
            <line x1="18" y1="6" x2="6" y2="18" />
            <line x1="6" y1="6" x2="18" y2="18" />
          </svg>
        </button> */}
      </div>

      {/* Quick Actions Grid */}
      <div className="flex-1 flex items-center justify-center px-8">
        <div className="grid grid-cols-2 gap-4 w-full max-w-[320px]">
          {actions.map((action) => (
            <button
              key={action.id}
              onClick={action.onClick}
              className="flex flex-col items-center justify-center gap-3 p-6 rounded-2xl transition-all duration-200 cursor-pointer border border-[var(--border-light)] bg-[var(--bg-card)] hover:bg-[var(--bg-hover)] hover:border-[var(--color-brand)] hover:shadow-lg group outline-none"
            >
              <div
                className="transition-transform duration-200 group-hover:scale-110"
                style={{ color: action.color }}
              >
                {action.icon}
              </div>
              <span className="text-sm font-medium text-[var(--text-primary)]">{action.label}</span>
            </button>
          ))}
        </div>
      </div>
    </div>
  );
}
