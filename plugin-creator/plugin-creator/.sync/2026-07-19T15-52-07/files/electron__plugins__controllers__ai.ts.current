import { BrowserWindow } from 'electron';
import { ApiContext, BaseApiController } from './api-context';
import { ElectronMainWindow } from '../../windows/main-window';
import { McpHost } from '../mcp-host';
import { PluginManager } from '../plugin-manager';
import { PluginLauncher } from '../plugin-launcher';

// Active AI Call registries to route answers back to the sandbox process
export const activeAiCalls = new Map<number, {
  resolve: (data: unknown) => void;
  reject: (err: Error) => void;
  onChunk?: (chunk: string) => void;
}>();

export function handleProxyAiResponse(payload: { token: number; type: 'response' | 'chunk' | 'error'; data?: unknown; error?: string }) {
  const active = activeAiCalls.get(payload.token);
  if (!active) return;

  if (payload.type === 'response') {
    active.resolve(payload.data);
    activeAiCalls.delete(payload.token);
  } else if (payload.type === 'chunk') {
    const chunkData = payload.data && typeof payload.data === 'object' ? payload.data as Record<string, unknown> : null;
    const text = chunkData && 'text' in chunkData ? String(chunkData.text) : '';
    if (active.onChunk && text) {
      active.onChunk(text);
    }
    if (chunkData && chunkData.is_end) {
      const finalText = chunkData.text ? String(chunkData.text) : '';
      active.resolve({ content: finalText });
      activeAiCalls.delete(payload.token);
    }
  } else if (payload.type === 'error') {
    active.reject(new Error(payload.error || 'AI generation failed'));
    activeAiCalls.delete(payload.token);
  }
}

export class AiController extends BaseApiController {
  private async retrieveLlmConfig(): Promise<{ provider: string; model: string; apiKey?: string; baseUrl?: string }> {
    const mainWindow = ElectronMainWindow.getInstance().getWindow();
    let llmConfig: any = null;
    if (mainWindow && !mainWindow.isDestroyed()) {
      try {
        const configJson = await mainWindow.webContents.executeJavaScript(`
          (function() {
            try {
              return JSON.stringify({
                provider: localStorage.getItem('agent-llm-provider'),
                model: localStorage.getItem('agent-llm-model'),
                apiKey: localStorage.getItem('agent-llm-apikey'),
                baseUrl: localStorage.getItem('agent-llm-baseurl'),
              });
            } catch(e) {
              return null;
            }
          })()
        `);

        if (configJson) {
          const parsed = JSON.parse(configJson);
          const { ElectronAuthManager } = await import('../../services/auth-manager');
          const userToken = ElectronAuthManager.getInstance().getToken() || undefined;

          if (parsed.provider) {
            llmConfig = {
              provider: parsed.provider,
              model: parsed.model || '',
              apiKey: parsed.provider === 'berrytrace' ? userToken : (parsed.apiKey || undefined),
              baseUrl: parsed.baseUrl || undefined,
            };
          }
        }
      } catch (err) {
        console.warn('[AiController] Failed to retrieve LLM settings from main window:', err);
      }
    }

    if (!llmConfig) {
      llmConfig = { provider: 'berrytrace', model: (import.meta as any).env.VITE_BERRYTRACE_MODEL };
    }

    if (llmConfig.provider === 'berrytrace') {
      try {
        const { ElectronAuthManager } = await import('../../services/auth-manager');
        const token = ElectronAuthManager.getInstance().getToken();
        if (token) {
          llmConfig.apiKey = token;
        }
      } catch (err) {
        console.warn('[AiController] Failed to retrieve user token for berrytrace provider:', err);
      }
    }

    return llmConfig;
  }

  private async retrieveAllLlmConfigs(): Promise<Array<{ provider: string; model: string; apiKey?: string; baseUrl?: string }>> {
    const mainWindow = ElectronMainWindow.getInstance().getWindow();
    const configs: Array<{ provider: string; model: string; apiKey?: string; baseUrl?: string }> = [];

    // Add default config first
    try {
      const defaultLlmConfig = await this.retrieveLlmConfig();
      configs.push(defaultLlmConfig);
    } catch (e) {
      console.warn('[AiController] Failed to retrieve default LLM config:', e);
    }

    if (mainWindow && !mainWindow.isDestroyed()) {
      try {
        const aiServersJson = await mainWindow.webContents.executeJavaScript(`
          (function() {
            try {
              return localStorage.getItem('agent-ai-servers');
            } catch(e) {
              return null;
            }
          })()
        `);

        if (aiServersJson) {
          const aiServers = JSON.parse(aiServersJson);
          if (Array.isArray(aiServers)) {
            const { ElectronAuthManager } = await import('../../services/auth-manager');
            const userToken = ElectronAuthManager.getInstance().getToken() || undefined;

            for (const s of aiServers) {
              if (s.provider) {
                configs.push({
                  provider: s.provider,
                  model: s.model || '',
                  apiKey: s.provider === 'berrytrace' ? userToken : (s.apiKey || undefined),
                  baseUrl: s.baseUrl || undefined,
                });
              }
            }
          }
        }
      } catch (err) {
        console.warn('[AiController] Failed to retrieve all LLM settings from main window:', err);
      }
    }

    return configs;
  }

  // ── ai namespace ──

  /**
   * 启动 AI Agent 任务。自动获取 LLM 配置，找到可用的 Agent 内核插件，发送任务到后台进程异步执行。
   * @param options sessionId — 会话 ID（可选），task — 任务描述，history — 历史对话，workDir — 工作目录，activeDocument — 当前文档信息，llmConfig — LLM 配置（可选），maxSteps — 最大步数，systemPrompt — 系统提示词，skipDefaultSystemPrompt — 跳过默认提示词
   * @returns { sessionId, kernelPluginId, accepted: true }
   * @example
   * await callApi("ai", "runAgentTask", [{ task: "找出项目中所有未使用的 import", workDir: "/path/to/project", maxSteps: 20 }]);
   */
  async ai_runAgentTask(options: {
    sessionId?: string;
    task: string;
    history?: Array<{ role: 'user' | 'assistant'; content: string }>;
    workDir?: string;
    activeDocument?: {
      tabId: string;
      title: string;
      path?: string;
      extension?: string;
      pluginId?: string;
      isUntitled?: boolean;
    };
    llmConfig?: {
      provider: 'aliyun' | 'ollama' | 'berrytrace' | 'custom';
      model: string;
      apiKey?: string;
      baseUrl?: string;
    };
    maxSteps?: number;
    systemPrompt?: string;
    skipDefaultSystemPrompt?: boolean;
  }, context: ApiContext): Promise<unknown> {
    if (!options.task || !String(options.task).trim()) {
      throw new Error('ai.runAgentTask requires a non-empty task');
    }

    const pm = PluginManager.getInstance();
    const kernelPluginId = await pm.ensureAgentKernelRunning();
    if (!kernelPluginId) {
      throw new Error('未检测到可用 AI Agent 插件，请先安装并启用 AI Agent 内核插件。');
    }

    let llmConfig = options.llmConfig;
    let availableConfigs = (options as any).availableConfigs;

    if (llmConfig) {
      const masked = {
        ...llmConfig,
        apiKey: llmConfig.apiKey ? (llmConfig.apiKey.length > 8 ? `${llmConfig.apiKey.slice(0, 4)}...${llmConfig.apiKey.slice(-4)}` : '***') : undefined
      };
      console.log('[AiController] Received — llmConfig:', JSON.stringify(masked));
    } else {
      console.log('[AiController] Received — llmConfig: (none, resolving default)');
    }

    if (!llmConfig) {
      const mainWindow = ElectronMainWindow.getInstance().getWindow();
      if (mainWindow && !mainWindow.isDestroyed()) {
        try {
          const configJson = await mainWindow.webContents.executeJavaScript(`
            (function() {
              try {
                return JSON.stringify({
                  provider: localStorage.getItem('agent-llm-provider'),
                  model: localStorage.getItem('agent-llm-model'),
                  apiKey: localStorage.getItem('agent-llm-apikey'),
                  baseUrl: localStorage.getItem('agent-llm-baseurl'),
                  aiServers: localStorage.getItem('agent-ai-servers'),
                });
              } catch(e) {
                return null;
              }
            })()
          `);

          if (configJson) {
            const parsed = JSON.parse(configJson);
            const { ElectronAuthManager } = await import('../../services/auth-manager');
            const userToken = ElectronAuthManager.getInstance().getToken() || undefined;

            if (parsed.provider) {
              llmConfig = {
                provider: parsed.provider,
                model: parsed.model || '',
                apiKey: parsed.provider === 'berrytrace' ? userToken : (parsed.apiKey || undefined),
                baseUrl: parsed.baseUrl || undefined,
              };
            }

            if (!availableConfigs && parsed.aiServers) {
              try {
                const aiServers = JSON.parse(parsed.aiServers);
                if (Array.isArray(aiServers)) {
                  availableConfigs = aiServers.map((s: any) => ({
                    provider: s.provider,
                    model: s.model,
                    apiKey: s.provider === 'berrytrace' ? userToken : (s.apiKey || undefined),
                    baseUrl: s.baseUrl || undefined,
                  }));
                }
              } catch (e) {
                console.warn('[AiController] Failed to parse aiServers from localStorage:', e);
              }
            }
          }
        } catch (err) {
          console.warn('[AiController] Failed to retrieve LLM settings from main window localStorage:', err);
        }
      }
    }

    if (!llmConfig) {
      llmConfig = { provider: 'berrytrace', model: (import.meta as any).env.VITE_BERRYTRACE_MODEL };
    }

    if (llmConfig.provider === 'berrytrace' && !llmConfig.apiKey) {
      try {
        const { ElectronAuthManager } = await import('../../services/auth-manager');
        const token = ElectronAuthManager.getInstance().getToken();
        if (token) {
          llmConfig.apiKey = token;
        }
      } catch (err) {
        console.warn('[AiController] Failed to retrieve user token for berrytrace provider:', err);
      }
    }

    const sessionId = options.sessionId || `plugin_agent_${Date.now()}_${Math.random().toString(36).slice(2, 8)}`;
    const payload = {
      sessionId,
      task: options.task,
      history: Array.isArray(options.history) ? options.history : [],
      workDir: options.workDir,
      activeDocument: options.activeDocument,
      llmConfig,
      availableConfigs,
      maxSteps: typeof options.maxSteps === 'number' ? options.maxSteps : 50,
      systemPrompt: options.systemPrompt,
      skipDefaultSystemPrompt: options.skipDefaultSystemPrompt,
    };

    pm.emitToBackgroundPlugin(kernelPluginId, 'agent:execute_task', payload);
    return { sessionId, kernelPluginId, accepted: true };
  }

  /**
   * 取消指定会话的 Agent 任务。
   * @param sessionId runAgentTask 返回的 sessionId
   */
  async ai_cancelAgentTask(sessionId: string): Promise<null> {
    if (!sessionId) return null;

    const pm = PluginManager.getInstance();
    const kernelPluginId = pm.getAgentKernelPluginId();
    if (!kernelPluginId) return null;

    pm.emitToBackgroundPlugin(kernelPluginId, 'agent:cancel_session', { sessionId });
    return null;
  }

  /**
   * 查询 Agent 内核状态。
   * @returns { isRunning, pluginId, activeSessions }
   */
  async ai_getAgentKernelStatus(): Promise<unknown> {
    const pm = PluginManager.getInstance();
    const targetPluginId = pm.getAgentKernelPluginId();
    const launcher = PluginLauncher.getInstance();
    return {
      isRunning: targetPluginId ? pm.isBackgroundPluginRunning(targetPluginId) : false,
      pluginId: targetPluginId,
      activeSessions: Array.from(launcher.getActiveAgentSessions()),
    };
  }

  /**
   * 调用 AI 聊天（非流式）。自动路由到 Agent 内核插件。
   * @param options messages — 消息数组，sessionId — 会话 ID（可选）
   * @example
   * await callApi("ai", "chat", [{ messages: [{ role: "user", content: "你好" }] }]);
   */
  async ai_chat(options: { messages?: { role: 'system' | 'user' | 'assistant'; content: string }[]; sessionId?: string; [key: string]: unknown }, context: ApiContext): Promise<unknown> {
    return this.chatInternal('chat', options, context);
  }

  /**
   * 调用 AI 聊天（流式）。通过 onChunk 回调接收增量文本。
   * @param options messages — 消息数组，sessionId — 会话 ID（可选）
   * @example
   * await callApi("ai", "chatStream", [{ messages: [{ role: "user", content: "写一首诗" }] }]);
   */
  async ai_chatStream(options: { messages?: { role: 'system' | 'user' | 'assistant'; content: string }[]; sessionId?: string; [key: string]: unknown }, context: ApiContext): Promise<unknown> {
    return this.chatInternal('chatStream', options, context);
  }

  private async chatInternal(methodName: 'chat' | 'chatStream', options: { messages?: { role: 'system' | 'user' | 'assistant'; content: string }[]; sessionId?: string; [key: string]: unknown }, context: ApiContext): Promise<unknown> {
    const { callbacks } = context;
    const messages = options.messages || [];
    const sessionId = options.sessionId;
    const isStream = methodName === 'chatStream';

    const token = Math.floor(Math.random() * 1000000);

    const pm = PluginManager.getInstance();
    const kernelPluginId = await pm.ensureAgentKernelRunning();
    if (!kernelPluginId) {
      throw new Error('未检测到可用 AI Agent 插件，请先安装并启用 AI Agent 内核插件。');
    }

    let llmConfig = options.llmConfig as any;
    if (!llmConfig) {
      const defaultLlmConfig = await this.retrieveLlmConfig();
      llmConfig = { ...defaultLlmConfig };

      if (options.model && typeof options.model === 'string') {
        let requestedModel = options.model;
        if (requestedModel.startsWith('berrytrace:')) {
          requestedModel = requestedModel.substring(11);
        }
        if (requestedModel.toLowerCase() === 'default') {
          // 如果请求的是 'default' 模型，保持使用配置的默认模型名称 (即 defaultLlmConfig.model)
        } else {
          const allConfigs = await this.retrieveAllLlmConfigs();
          const matched = allConfigs.find(c => c.model.toLowerCase() === requestedModel.toLowerCase());
          if (matched) {
            llmConfig = { ...matched };
          } else {
            llmConfig.model = requestedModel;
          }
        }
      }
    }

    console.log(`[AiController:chat] Routing chat request (token: ${token}, isStream: ${isStream}) for sessionId: ${sessionId}`);

    return new Promise<unknown>((resolve, reject) => {
      // 注册到 activeAiCalls 注册表，由 plugin-launcher 通过 handleProxyAiResponse 路由回来
      // 不再裸用 proc.on('message')，避免绕过所有抽象层
      activeAiCalls.set(token, {
        resolve,
        reject,
        onChunk: isStream && callbacks?.onChunk ? callbacks.onChunk as (chunk: string) => void : undefined,
      });

      // 设置超时，防止 background 进程崩溃导致 Promise 永久挂起
      const timeoutId = setTimeout(() => {
        if (activeAiCalls.has(token)) {
          activeAiCalls.delete(token);
          reject(new Error(`[AiController:chat] Request timeout (token: ${token})`));
        }
      }, 120_000);

      // 发送聊天请求到 Agent 内核（走标准命令通道，不裸访问 proc）
      pm.emitToBackgroundPlugin(kernelPluginId, 'agent:chat_request', {
        token,
        messages,
        llmConfig,
        isStream,
        sessionId,
      });

      // 清理超时定时器（在 resolve/reject 时）
      const originalResolve = resolve;
      const originalReject = reject;
      resolve = (value) => { clearTimeout(timeoutId); originalResolve(value); };
      reject = (err) => { clearTimeout(timeoutId); originalReject(err); };
    });
  }

  /**
   * 获取当前活跃的 LLM 配置。
   */
  async getActiveLlmConfig(): Promise<unknown> {
    return this.retrieveLlmConfig();
  }

  // ── mcp namespace ──

  async ["mcp_tool-response"](options: { token: number; success: boolean; result: unknown; error?: string }): Promise<null> {
    const { token, success, result, error } = options;
    McpHost.getInstance().handleSandboxResponse(token, success, result, error);
    return null;
  }

  /**
   * 动态注册 MCP 工具（运行时注册，非 plugin.json 声明）。
   * @param callerPluginId 调用插件 ID
   * @param toolSpec { name, description, inputSchema }
   */
  async mcp_registerDynamicTool(callerPluginId: string, toolSpec: { name: string; description: string; inputSchema: Record<string, unknown> }, context: ApiContext): Promise<null> {
    McpHost.getInstance().registerDynamicRendererTool(callerPluginId || context.pluginId, toolSpec);
    return null;
  }

  /**
   * 注销动态 MCP 工具。
   * @param callerPluginId 调用插件 ID
   * @param toolName 工具名
   */
  async mcp_unregisterDynamicTool(callerPluginId: string, toolName: string, context: ApiContext): Promise<null> {
    McpHost.getInstance().unregisterDynamicRendererTool(callerPluginId || context.pluginId, toolName);
    return null;
  }

  /**
   * 列出所有已注册的 MCP 工具。
   */
  async mcp_listTools(): Promise<unknown> {
    return McpHost.getInstance().listTools();
  }

  /**
   * 注册系统提示词（注入到 AI Agent 的 system prompt 中）。
   * @param callerPluginId 调用插件 ID
   * @param options { promptId, promptText }
   */
  async mcp_registerSystemPrompt(callerPluginId: string, options: { promptId: string; promptText: string }, context: ApiContext): Promise<null> {
    McpHost.getInstance().registerSystemPrompt(callerPluginId || context.pluginId, options.promptId, options.promptText);
    return null;
  }

  /**
   * 注销系统提示词。
   * @param callerPluginId 调用插件 ID
   * @param promptId 提示词 ID
   */
  async mcp_unregisterSystemPrompt(callerPluginId: string, promptId: string, context: ApiContext): Promise<null> {
    McpHost.getInstance().unregisterSystemPrompt(callerPluginId || context.pluginId, promptId);
    return null;
  }

  /**
   * 列出所有已注册的系统提示词。
   */
  async mcp_listSystemPrompts(): Promise<unknown> {
    return McpHost.getInstance().listSystemPrompts();
  }

  /**
   * 调用指定的 MCP 工具。
   * @param toolName 工具名
   * @param toolArgs 工具参数
   * @returns { content: [{ type, text }] }，失败时返回 { isError: true, content: [...] }
   * @example
   * await callApi("mcp", "callTool", [{ toolName: "search_tool", toolArgs: { query: "ffmpeg" } }]);
   */
  async mcp_callTool(toolName: string, toolArgs: Record<string, unknown>): Promise<unknown> {
    try {
      const rawResult = await McpHost.getInstance().callTool(toolName, toolArgs ?? {});
      if (rawResult && typeof rawResult === 'object' && 'content' in rawResult) {
        return rawResult;
      }
      return { content: [{ type: 'text', text: JSON.stringify(rawResult) }] };
    } catch (toolErr) {
      const errMsg = toolErr instanceof Error ? toolErr.message : String(toolErr);
      console.warn(`[AiController] callTool("${toolName}") threw exception (wrapped as isError result):`, toolErr);
      return { isError: true, content: [{ type: 'text', text: errMsg }] };
    }
  }
}
