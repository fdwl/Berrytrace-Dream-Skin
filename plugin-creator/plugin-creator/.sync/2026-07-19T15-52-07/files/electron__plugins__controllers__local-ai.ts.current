import { ApiContext, BaseApiController } from './api-context';
import { LocalAIService } from '../../services/local-ai-service';

/**
 * 解析 workspace 路径。
 * 当调用来自 ForkUtilityProcess（后台插件）时 sender 为 undefined，
 * 此时遍历所有已打开窗口查找 workspace，最后 fallback 到历史记录中的初始 workspace。
 */
async function resolveWorkspacePath(sender?: Electron.WebContents): Promise<string | null> {
  const { WorkspaceManager } = await import('../../services/workspace-manager.js');
  if (sender) {
    return WorkspaceManager.getInstance().getPathForWebContents(sender);
  }
  // sender 为空（ForkUtilityProcess / 后台插件调用）：遍历所有窗口查找
  const wsMgr = WorkspaceManager.getInstance();
  const { BrowserWindow } = await import('electron');
  for (const win of BrowserWindow.getAllWindows()) {
    if (!win.isDestroyed()) {
      const path = wsMgr.getPathForWindow(win);
      if (path) return path;
    }
  }
  // 最终兜底：历史记录中的初始 workspace
  return wsMgr.getInitialWorkspacePath();
}

export class LocalAiController extends BaseApiController {
  /**
   * 获取文本嵌入向量。
   * @param text 文本
   */
  async getEmbedding(text: string): Promise<unknown> {
    return this.embedding(text);
  }

  /**
   * 获取文本嵌入向量（与 getEmbedding 相同）。
   * @param text 文本
   */
  async embedding(text: string): Promise<unknown> {
    return LocalAIService.getInstance().getEmbedding(text);
  }

  /**
   * 对图片执行 OCR 文字识别。
   * @param imagePath 图片路径
   */
  async runOCR(imagePath: string): Promise<unknown> {
    return this.ocr(imagePath);
  }

  /**
   * 对图片执行 OCR 文字识别（与 runOCR 相同）。
   * @param imagePath 图片路径
   */
  async ocr(imagePath: string): Promise<unknown> {
    const { parseImageOcr } = await import('../../services/ocr-image-parser.js');
    return parseImageOcr(imagePath);
  }

  /**
   * 查询本地 AI 服务状态。
   * @returns { modelId, embeddingDimension }
   */
  async status(): Promise<unknown> {
    const { modelId, dimension } = LocalAIService.getInstance().getActiveEmbeddingModel();
    return {
      modelId,
      embeddingDimension: dimension
    };
  }

  /**
   * 索引工具库到全文搜索引擎。
   * 注意：此方法立即返回 true，实际的索引工作（含向量 embedding 生成）在后台异步执行，
   * 避免阻塞渲染进程的插件 onload 流程（embedding 生成可能需要数十秒）。
   * @param tools 工具数组
   */
  async indexToolsLibrary(tools: any[], context: ApiContext): Promise<boolean> {
    const { FullTextIndexManager } = await import('../../services/fulltext-index-manager.js');
    const workspacePath = await resolveWorkspacePath(context.sender);
    // 不 await：FTS 全文索引（insert 到 SQLite）很快，向量 embedding 生成（调用本地 AI 模型）
    // 可能耗时数十秒，改为后台执行，立即返回让插件 onload 不阻塞。
    FullTextIndexManager.getInstance().indexToolsLibrary(tools, workspacePath).catch(err => {
      console.warn('[LocalAI] indexToolsLibrary background task failed:', err);
    });
    return true;
  }

  /**
   * 搜索 Agent 能力（混合检索：FTS5 全文 + 向量 RRF 融合）。
   * @param query 搜索查询
   */
  async searchAgentCapabilities(query: string, context: ApiContext): Promise<unknown> {
    const { FtsHybridSearcher } = await import('../../services/fts-hybrid-searcher.js');
    const workspacePath = await resolveWorkspacePath(context.sender);
    return FtsHybridSearcher.searchAgentCapabilities(query, workspacePath);
  }

  /**
   * 对所有 Skill 建立 FTS5 全文索引。
   */
  async indexAllSkills(context: ApiContext): Promise<boolean> {
    const { FullTextIndexManager } = await import('../../services/fulltext-index-manager.js');
    const workspacePath = await resolveWorkspacePath(context.sender);
    // fire-and-forget：避免阻塞调用方
    FullTextIndexManager.getInstance().indexAllSkills(workspacePath).catch(err => {
      console.error('[LocalAI] indexAllSkills background task failed:', err);
    });
    return true;
  }

  /**
   * 全量重建所有索引（Tools + Skills + Files 的 FTS5 全文索引 + 向量索引）。
   * 此操作可能耗时较长，在后台异步执行。调用方不需要等待结果。
   */
  async rebuildAllIndices(_context: ApiContext): Promise<boolean> {
    const { FullTextIndexManager } = await import('../../services/fulltext-index-manager.js');
    FullTextIndexManager.getInstance().rebuildAllIndices().catch(err => {
      console.error('[LocalAI] rebuildAllIndices failed:', err);
    });
    return true;
  }

  // ── 本地 LLM (Qwen2.5-1.5B) ──────────────────────────────────────────────

  /**
   * 返回宿主 app 目录（用于插件定位 node_modules/@huggingface/transformers）。
   * 插件通过此路径使用 file:// URL 动态 import transformers，
   * 绕过 Electron 主进程的原生模块限制（在独立系统 Node.js 进程中加载）。
   */
  async getAppPath(): Promise<string> {
    const { app } = await import('electron');
    return app.getAppPath();
  }

  /**
   * 返回宿主模型存储目录，提供给插件获取下载/扫描本地模型的根路径。
   */
  async getModelDir(): Promise<string> {
    return LocalAIService.getInstance().getModelDir();
  }

  /**
   * @deprecated 已废弃：LLM 推理已移至插件自身 spawn 的 llm-server.mjs 子进程。
   * 保留仅为兼容旧版插件。
   */
  async llmLoad(opts: { modelDir: string }): Promise<{ ok: boolean; error?: string }> {
    return LocalAIService.getInstance().llmLoad(opts.modelDir);
  }

  /**
   * @deprecated 已废弃：LLM 推理已移至插件自身 spawn 的 llm-server.mjs 子进程。
   * 保留仅为兼容旧版插件。
   */
  async llmGenerate(opts: {
    prompt: string;
    modelDir?: string;
    maxNewTokens?: number;
    temperature?: number;
  }): Promise<{ text: string }> {
    return LocalAIService.getInstance().llmGenerate(opts);
  }

}
