import { useEffect, useRef, useState } from 'react';
import { Terminal, type ITheme } from 'xterm';
import { FitAddon } from 'xterm-addon-fit';
import { SerializeAddon } from '@xterm/addon-serialize';
import { useWorkspaceStore } from '../../../stores/workspace';
import { useAppStore } from '../../../stores/app';
import 'xterm/css/xterm.css';

interface TerminalTabPanelProps {
  tabId: string;
  visible: boolean;
  customParams?: Record<string, any>;
}

const DARK_TERMINAL_THEME: ITheme = {
  background: '#18181c',
  foreground: '#e4e4e7',
  cursor: '#5b7fff',
  cursorAccent: '#18181c',
  selectionBackground: '#3f445b',
  selectionForeground: '#ffffff',
  black: '#18181c',
  red: '#f87171',
  green: '#34d399',
  yellow: '#fbbf24',
  blue: '#60a5fa',
  magenta: '#c084fc',
  cyan: '#2dd4bf',
  white: '#e4e4e7',
  brightBlack: '#4b5563',
  brightRed: '#ef4444',
  brightGreen: '#10b981',
  brightYellow: '#f59e0b',
  brightBlue: '#3b82f6',
  brightMagenta: '#8b5cf6',
  brightCyan: '#06b6d4',
  brightWhite: '#f3f4f6',
};

const LIGHT_TERMINAL_THEME: ITheme = {
  background: '#ffffff',
  foreground: '#18181b',
  cursor: '#2563eb',
  cursorAccent: '#ffffff',
  selectionBackground: '#bfdbfe',
  selectionForeground: '#18181b',
  black: '#2e3436',
  red: '#dc2626',
  green: '#16a34a',
  yellow: '#d97706',
  blue: '#2563eb',
  magenta: '#9333ea',
  cyan: '#0891b2',
  white: '#6a6a6a',
  brightBlack: '#555753',
  brightRed: '#ef2929',
  brightGreen: '#1b7a1b',
  brightYellow: '#6d5a00',
  brightBlue: '#1d4ed8',
  brightMagenta: '#ad7fa8',
  brightCyan: '#034b50',
  brightWhite: '#3d3d3d',
};

export default function TerminalTabPanel({ tabId, visible, customParams }: TerminalTabPanelProps) {
  const containerRef = useRef<HTMLDivElement>(null);
  const terminalRef = useRef<Terminal | null>(null);
  const fitAddonRef = useRef<FitAddon | null>(null);
  const serializeAddonRef = useRef<SerializeAddon | null>(null);

  const customParamsRef = useRef(customParams);
  useEffect(() => {
    customParamsRef.current = customParams;
  }, [customParams]);

  // Tracks how many times the main useEffect has mounted. Used to distinguish
  // React StrictMode double-mount (generationRef increments on 2nd mount)
  // from a real unmount (no increment). Prevents orphan-close from killing
  // the PTY session that the next StrictMode mount is warm-reattaching to.
  const generationRef = useRef(0);
  const sessionIdRef = useRef<string | null>(null);
  const [error, setError] = useState<string | null>(null);
  const [isEditingTitle, setIsEditingTitle] = useState(false);
  const [titleInput, setTitleInput] = useState('');
  const [isBusy, setIsBusy] = useState(false);
  const [isTuiMode, setIsTuiMode] = useState(false);

  const themeMode = useAppStore((state) => state.theme);
  const isLight = themeMode === 'light';

  const saveScrollback = () => {
    const term = terminalRef.current;
    const serializeAddon = serializeAddonRef.current;
    if (!term || !serializeAddon) return;
    try {
      const raw = serializeAddon.serialize({ scrollback: 1000 });
      if (raw && raw.length > 0) {
        const currentScrollback = customParamsRef.current?.scrollbackBuffer;
        if (raw !== currentScrollback) {
          useWorkspaceStore.getState().updateTabConfig(tabId, {
            customParams: {
              ...customParamsRef.current,
              scrollbackBuffer: raw
            }
          });
        }
      }
    } catch (e) {
      console.warn('[TerminalTabPanel] Failed to save scrollback buffer:', e);
    }
  };

  useEffect(() => {
    const handleBeforeUnload = () => {
      saveScrollback();
    };
    window.addEventListener('beforeunload', handleBeforeUnload);
    return () => {
      window.removeEventListener('beforeunload', handleBeforeUnload);
    };
  }, []);

  // ─── Main terminal lifecycle ────────────────────────────────────────────────
  // Why the delayed dispose:
  //   xterm's Viewport constructor fires: setTimeout(0) → requestAnimationFrame → _innerRefresh.
  //   If dispose() is called synchronously (as React 18 StrictMode does on double-mount cleanup),
  //   _renderService is nulled out before _innerRefresh fires → crash:
  //   "Cannot read properties of undefined (reading 'dimensions')".
  //   Delaying dispose by 100ms (>> the ~20ms the chain needs) lets those callbacks complete on
  //   the still-alive instance. isDestroyed=true stops all our own code immediately.
  //   This mirrors orca's pattern: manager.destroy() clears innerHTML + disposes, both together.
  useEffect(() => {
    const el = containerRef.current;
    if (!el) return;

    // Clear any leftover xterm DOM from a previous instance whose dispose is still pending.
    // This is the orca pattern: on destroy(), clear innerHTML alongside dispose().
    el.innerHTML = '';

    const myGeneration = ++generationRef.current;
    let isDestroyed = false;
    let activeSessionId: string | null = null;
    let sessionCleanupFn: (() => void) | null = null;

    const term = new Terminal({
      cursorBlink: true,
      theme: isLight ? LIGHT_TERMINAL_THEME : DARK_TERMINAL_THEME,
      fontSize: 13,
      fontFamily: 'Menlo, Monaco, "Courier New", monospace',
      logLevel: 'off',
    });
    const fitAddon = new FitAddon();
    const serializeAddon = new SerializeAddon();
    term.loadAddon(fitAddon);
    term.loadAddon(serializeAddon);

    terminalRef.current = term;
    fitAddonRef.current = fitAddon;
    serializeAddonRef.current = serializeAddon;

    // Open synchronously — the delayed dispose below prevents the Viewport crash.
    term.open(el);

    // Fit immediately if container has dimensions so term.cols/rows match DOM before writing initialBuffer or spawning PTY
    try {
      if (el.clientWidth > 0 && el.clientHeight > 0) {
        fitAddon.fit();
      }
    } catch { /* ignore */ }

    // Restore scrollback buffer if exists
    const initialBuffer = customParamsRef.current?.scrollbackBuffer as string | undefined;
    if (initialBuffer) {
      try {
        term.write(initialBuffer);
        // Write new line and reset styles/modes (including exiting alternate screen buffer)
        const POST_REPLAY_MODE_RESET = '\x1b[?1049l\x1b[?47l\x1b[0m\x1b[0 q\x1b[<99u\x1b[=0u\x1b[?25h\x1b[?9l\x1b[?1000l\x1b[?1002l\x1b[?1003l\x1b[?1006l\x1b[?1016l\x1b[?1004l\x1b[?2004l';
        term.write('\r\n' + POST_REPLAY_MODE_RESET + '\r\n');
      } catch (err) {
        console.warn('[TerminalTabPanel] Failed to write restored scrollback:', err);
      }
    }

    // Fit after the browser has painted so xterm can re-measure cell sizes if needed.
    requestAnimationFrame(() => {
      if (!isDestroyed && fitAddonRef.current) {
        try { fitAddon.fit(); } catch { /* ignore */ }
      }
    });

    // Create PTY session and wire up I/O.
    const initTerminal = async () => {
      try {
        const cols = term.cols || 80;
        const rows = term.rows || 24;
        const initialCwd = customParamsRef.current?.initialCwd || customParams?.initialCwd;

        const sid = await window.electronAPI.callApi(
          'terminal', 'create', [cols, rows, initialCwd, tabId]
        ) as string;

        console.log(`[TerminalTabPanel:${tabId}] terminal:create sid=${sid}, isDestroyed=${isDestroyed}`);

        if (isDestroyed) {
          if (generationRef.current > myGeneration) {
            // React StrictMode double-mount: a newer effect run has already started and the
            // backend will warm-reattach to the SAME session (same tabId).
            console.log(`[TerminalTabPanel:${tabId}] StrictMode first-mount orphan — leaving sid=${sid} for next mount (gen ${myGeneration} < ${generationRef.current})`);
          } else {
            // Real unmount (tab closed) before session was fully set up. Close the zombie PTY.
            console.log(`[TerminalTabPanel:${tabId}] Closing orphaned sid=${sid} (no successor mount)`);
            window.electronAPI.callApi('terminal', 'close', [sid]);
          }
          return;
        }

        activeSessionId = sid;
        sessionIdRef.current = sid;

        // PTY → xterm: stream output bytes.
        const removeDataListener = window.electronAPI.ipc.on(`terminal:data:${sid}`, (chunk: unknown) => {
          if (typeof chunk === 'string' && !isDestroyed) {
            try { term.write(chunk); } catch { /* disposed */ }
          }
        });

        // PTY status changes (busy/idle, TUI mode).
        const removeStatusListener = window.electronAPI.ipc.on(`terminal:status:${sid}`, (status: any) => {
          if (!isDestroyed && status) {
            if (typeof status.isBusy === 'boolean') setIsBusy(status.isBusy);
            if (typeof status.isTuiMode === 'boolean') setIsTuiMode(status.isTuiMode);
          }
        });

        // PTY process exit.
        const removeExitListener = window.electronAPI.ipc.on(`terminal:exit:${sid}`, (code: unknown) => {
          console.log(`[TerminalTabPanel:${tabId}] terminal:exit sid=${sid}, code=${code}`);
          if (!isDestroyed) {
            setIsBusy(false);
            if (code !== 0 && code !== undefined && code !== null) {
              try { term.write(`\r\n\x1b[33m[Process exited with code ${code}]\x1b[0m\r\n`); } catch { /* disposed */ }
            }
          }
        });

        // OSC title changes → workspace tab title.
        const titleDisposable = term.onTitleChange((newTitle) => {
          if (newTitle?.trim()) {
            useWorkspaceStore.getState().updateTabTitle(tabId, newTitle.trim());
          }
        });

        // xterm → PTY: forward keystrokes.
        const dataDisposable = term.onData((data) => {
          if (!isDestroyed && activeSessionId) {
            window.electronAPI.callApi('terminal', 'write', [sid, data]);
          }
        });

        // 预填充命令（但不自动敲回车）
        if (customParams?.initialCommand && !customParams?.autoCommand) {
          setTimeout(() => {
            if (!isDestroyed && activeSessionId) {
              window.electronAPI.callApi('terminal', 'write', [sid, customParams.initialCommand]);
            }
          }, 300);
        }

        // Auto-run a command if provided (e.g. from open_workspace_tab).
        if (customParams?.autoCommand) {
          setTimeout(() => {
            if (!isDestroyed && activeSessionId) {
              window.electronAPI.callApi('terminal', 'write', [sid, customParams.autoCommand + '\r']);
            }
          }, 300);
        }

        // Replay any buffered output (shell prompt, etc.) captured during create.
        if (!isDestroyed) {
          await window.electronAPI.callApi('terminal', 'attach', [sid]);
        }

        // Sync PTY to the fitted terminal size. The PTY was created with pre-fit dims
        // (likely 80×24 before the rAF fitAddon.fit ran); by the time attach resolves,
        // the rAF fit has fired and term.cols/rows reflect the actual container size.
        if (!isDestroyed && term.cols >= 10 && term.rows >= 2) {
          window.electronAPI.callApi('terminal', 'resize', [sid, term.cols, term.rows]);
        }

        sessionCleanupFn = () => {
          removeDataListener();
          removeStatusListener();
          removeExitListener();
          dataDisposable.dispose();
          titleDisposable.dispose();
        };
      } catch (err) {
        console.error('[TerminalTabPanel] Failed to initialize terminal:', err);
        setError(err instanceof Error ? err.message : String(err));
      }
    };

    initTerminal();

    // Resize observer — fit terminal when container dimensions change.
    let resizeDebounceTimer: ReturnType<typeof setTimeout> | null = null;

    const doFitAndResize = () => {
      if (isDestroyed || !containerRef.current || !terminalRef.current) return;
      const { clientWidth: w, clientHeight: h } = containerRef.current;
      if (w < 100 || h < 50) return;
      try {
        fitAddon.fit();
        if (activeSessionId && term.cols >= 10 && term.rows >= 2) {
          window.electronAPI.callApi('terminal', 'resize', [activeSessionId, term.cols, term.rows]);
        }
      } catch (err) {
        console.warn('[TerminalTabPanel] Resize error:', err);
      }
    };

    // ResizeObserver: fit xterm immediately (visual), debounce PTY resize to avoid
    // SIGWINCH storm during splitter drag (60 events/sec → 1 PTY resize per 100ms).
    const resizeObserver = new ResizeObserver(() => {
      if (isDestroyed || !containerRef.current || !terminalRef.current) return;
      const { clientWidth: w, clientHeight: h } = containerRef.current;
      if (w < 100 || h < 50) return;
      try {
        fitAddon.fit(); // visual update immediately
      } catch { /* ignore */ }
      if (resizeDebounceTimer) clearTimeout(resizeDebounceTimer);
      resizeDebounceTimer = setTimeout(() => {
        resizeDebounceTimer = null;
        if (!isDestroyed && activeSessionId && term.cols >= 10 && term.rows >= 2) {
          window.electronAPI.callApi('terminal', 'resize', [activeSessionId, term.cols, term.rows]);
        }
      }, 100);
    });
    resizeObserver.observe(el);

    // Electron window resize (fullscreen, window drag)
    const handleWindowResize = () => {
      requestAnimationFrame(doFitAndResize);
    };
    window.addEventListener('resize', handleWindowResize);

    // FlexLayout splitter drag → berrytrace:layout-resize dispatched by FlexWorkspace.onModelChange
    const handleLayoutResize = () => doFitAndResize();
    window.addEventListener('berrytrace:layout-resize', handleLayoutResize as EventListener);

    return () => {
      isDestroyed = true;
      if (resizeDebounceTimer) { clearTimeout(resizeDebounceTimer); resizeDebounceTimer = null; }
      window.removeEventListener('resize', handleWindowResize);
      window.removeEventListener('berrytrace:layout-resize', handleLayoutResize as EventListener);

      // Save final scrollback before disposal
      saveScrollback();

      terminalRef.current = null;
      fitAddonRef.current = null;
      serializeAddonRef.current = null;
      sessionIdRef.current = null;
      resizeObserver.disconnect();
      sessionCleanupFn?.();

      // *** KEY: delay dispose so xterm's Viewport setTimeout(0)→rAF chain (~20ms) completes first.
      // Disposing synchronously nulls _renderService before _innerRefresh fires → crash.
      // The el.innerHTML='' at the top of the next effect run clears stale DOM before new open().
      const termToDispose = term;
      const serializeAddonToDispose = serializeAddon;
      setTimeout(() => {
        try { serializeAddonToDispose.dispose(); } catch {}
        try { termToDispose.dispose(); } catch {}
      }, 100);
    };
  }, []); // eslint-disable-line react-hooks/exhaustive-deps

  // ─── Sync xterm theme when app theme changes ────────────────────────────────
  useEffect(() => {
    if (terminalRef.current) {
      terminalRef.current.options.theme = isLight ? LIGHT_TERMINAL_THEME : DARK_TERMINAL_THEME;
    }
  }, [isLight]);

  // ─── Re-fit when tab becomes visible ───────────────────────────────────────
  useEffect(() => {
    if (!visible) return;
    let cancelled = false;
    const doFit = () => {
      if (cancelled || !containerRef.current || !fitAddonRef.current || !terminalRef.current) return;
      const { clientWidth: w, clientHeight: h } = containerRef.current;
      if (w < 100 || h < 50) return;
      try {
        fitAddonRef.current.fit();
        if (sessionIdRef.current && terminalRef.current.cols >= 10 && terminalRef.current.rows >= 2) {
          window.electronAPI.callApi('terminal', 'resize', [
            sessionIdRef.current,
            terminalRef.current.cols,
            terminalRef.current.rows,
          ]);
        }
      } catch { /* ignore */ }
    };
    // Three retries: layout may not be settled at first tick after display:none→flex.
    const t1 = setTimeout(doFit, 50);
    const t2 = setTimeout(doFit, 250);
    const t3 = setTimeout(doFit, 600);
    return () => {
      cancelled = true;
      clearTimeout(t1);
      clearTimeout(t2);
      clearTimeout(t3);
    };
  }, [visible]);

  // ─── Periodically save terminal CWD and scrollback buffer ──────────────────
  useEffect(() => {
    if (!visible) return;
    const timer = setInterval(async () => {
      const sid = sessionIdRef.current;
      if (!sid) return;
      try {
        const cwd = await window.electronAPI.callApi('terminal', 'getCwd', [sid]) as string | null;
        const currentCwd = customParamsRef.current?.initialCwd;
        if (cwd && cwd !== currentCwd) {
          useWorkspaceStore.getState().updateTabConfig(tabId, {
            customParams: {
              ...customParamsRef.current,
              initialCwd: cwd
            }
          });
        }
        saveScrollback();
      } catch { /* ignore */ }
    }, 10000);
    return () => clearInterval(timer);
  }, [visible, tabId]);

  const handleSaveTitle = () => {
    if (titleInput.trim()) {
      useWorkspaceStore.getState().updateTabTitle(tabId, titleInput.trim());
    }
    setIsEditingTitle(false);
  };

  return (
    <div
      className={`w-full h-full flex flex-col relative transition-colors duration-200 ${
        isLight ? 'bg-white text-zinc-800' : 'bg-[#18181c] text-zinc-200'
      }`}
      style={{ display: visible ? 'flex' : 'none' }}
    >
      {/* Top Header Bar */}
      <div
        className={`h-7 shrink-0 px-3 flex items-center justify-between text-[11px] select-none transition-colors duration-200 ${
          isLight
            ? 'bg-zinc-100 border-b border-zinc-200 text-zinc-600'
            : 'bg-[#1e1e24] border-b border-white/10 text-[#a1a1aa]'
        }`}
      >
        <div className="flex items-center gap-2 min-w-0">
          {isBusy ? (
            <span className="flex items-center gap-1.5 text-amber-500 font-mono text-[10px]">
              <span className="w-2 h-2 rounded-full bg-amber-500 animate-ping shrink-0" />
              <span>{isTuiMode ? '[TUI 响应中...]' : '[执行中...]'}</span>
            </span>
          ) : (
            <span className="flex items-center gap-1.5 text-emerald-500 font-mono text-[10px]">
              <span className="w-2 h-2 rounded-full bg-emerald-500 shrink-0" />
              <span>{isTuiMode ? '[TUI 就绪]' : '[就绪]'}</span>
            </span>
          )}
          {isTuiMode && (
            <span
              className={`px-1.5 py-0.5 rounded font-mono text-[9px] border ${
                isLight
                  ? 'bg-purple-100 text-purple-700 border-purple-200'
                  : 'bg-purple-500/20 text-purple-300 border-purple-500/30'
              }`}
            >
              TUI 模式
            </span>
          )}
          {isEditingTitle ? (
            <input
              type="text"
              value={titleInput}
              onChange={(e) => setTitleInput(e.target.value)}
              onBlur={handleSaveTitle}
              onKeyDown={(e) => {
                if (e.key === 'Enter') handleSaveTitle();
                if (e.key === 'Escape') setIsEditingTitle(false);
              }}
              autoFocus
              className={`px-1.5 py-0.5 rounded outline-none border text-[11px] ${
                isLight
                  ? 'bg-white text-zinc-900 border-blue-500'
                  : 'bg-[#2a2a32] text-white border-blue-500'
              }`}
            />
          ) : (
            <div
              className={`flex items-center gap-1 cursor-pointer transition-colors truncate ${
                isLight ? 'hover:text-zinc-900' : 'hover:text-white'
              }`}
              title="点击重命名终端 Tab"
              onClick={() => {
                setIsEditingTitle(true);
                setTitleInput('');
              }}
            >
              <span className={`font-mono ${isLight ? 'text-zinc-700' : 'text-zinc-300'}`}>Terminal</span>
              <svg
                className={`w-3 h-3 ${isLight ? 'text-zinc-400 hover:text-zinc-600' : 'text-zinc-500 hover:text-zinc-300'}`}
                fill="none"
                stroke="currentColor"
                viewBox="0 0 24 24"
              >
                <path strokeLinecap="round" strokeLinejoin="round" strokeWidth="2" d="M15.232 5.232l3.536 3.536m-2.036-5.036a2.5 2.5 0 113.536 3.536L6.5 21.036H3v-3.572L16.732 3.732z" />
              </svg>
            </div>
          )}
        </div>

        {sessionIdRef.current && (
          <div className={`flex items-center gap-2 font-mono text-[10px] shrink-0 ${isLight ? 'text-zinc-400' : 'text-zinc-500'}`}>
            <span>sid: {sessionIdRef.current}</span>
          </div>
        )}
      </div>

      {error ? (
        <div className="flex-1 flex flex-col items-center justify-center p-4 text-red-500">
          <svg className="w-8 h-8 mb-2" fill="none" stroke="currentColor" viewBox="0 0 24 24">
            <path strokeLinecap="round" strokeLinejoin="round" strokeWidth="2" d="M12 9v2m0 4h.01m-6.938 4h13.856c1.54 0 2.502-1.667 1.732-3L13.732 4c-.77-1.333-2.694-1.333-3.464 0L3.34 16c-.77 1.333.192 3 1.732 3z" />
          </svg>
          <span className="text-sm font-semibold">终端初始化失败</span>
          <span className="text-xs opacity-80 mt-1">{error}</span>
        </div>
      ) : (
        <div ref={containerRef} className="flex-1 w-full h-full overflow-hidden p-2" />
      )}
    </div>
  );
}
