-  } else {
-    win.webContents.once('did-finish-load', sendWarning)
-  }
-
-  if (warningTimer) clearTimeout(warningTimer)
-  warningTimer = setTimeout(() => {
-    if (!isRecording && fnVoiceWindowExists()) {
-      panelWin.hidePanel()
-    }
-  }, 3000)
-}
