-export async function handleFnKeyEvent(event: string) {
-  // If onboarding intercept mode is active, do not run the real global voice input
-  const onboardingIntercept = (cache.get('_onboardingInterceptMode') as boolean) ?? false
-  if (onboardingIntercept) {
-    return
-  }
-
-  const fnVoiceEnabled = (cache.get(CacheAttribute.prefFnVoiceEnabled) as boolean) ?? true
-  if (!fnVoiceEnabled) {
-    console.log('[FnVoiceInput] Fn Voice Input feature is disabled by settings.')
-    return
-  }
-
-  // Intercept Fn key press to copy and close in copy-fallback mode
-  if (currentPanelMode === 'copy-fallback' && (event === 'short_press' || event === 'long_press_start')) {
-    console.log('[FnVoiceInput] Fn pressed during copy-fallback. Triggering copy-and-close in renderer.')
-    const panelWin = ElectronFnVoicePanelWindow.getInstance()
-    const win = panelWin.getWindow()
-    if (win && !win.isDestroyed()) {
-      win.webContents.send('fn-voice-panel:action-copy-close')
-    }
-    return
-  }
-
-  // Check if our own Electron window is focused
-  let isInput = false
-  const focusedWin = BrowserWindow.getFocusedWindow()
-  if (focusedWin) {
-    const winTitle = focusedWin.getTitle()
-    const winUrl = focusedWin.webContents.getURL()
-    console.log(`[FnVoiceInput:focus-debug] Focused Electron window - title="${winTitle}", url="${winUrl}"`)
-    try {
-      const jsResult = await focusedWin.webContents.executeJavaScript(`
-        (() => {
-          let el = document.activeElement;
-          let shadowPath = false;
-          while (el && el.shadowRoot && el.shadowRoot.activeElement) {
-            el = el.shadowRoot.activeElement;
-            shadowPath = true;
-          }
-          if (!el) return JSON.stringify({ isInput: false, activeElement: null });
-          const tagName = el.tagName.toLowerCase();
-          const contentEditable = el.contentEditable || 'false';
-          const role = el.getAttribute('role') || '';
-          const elementId = el.id || '';
-          const className = (el.className && typeof el.className === 'string') ? el.className.substring(0, 80) : '';
-          let isInput = false;
-          if (tagName === 'input' || tagName === 'textarea') isInput = true;
-          else if (contentEditable === 'true' || contentEditable === 'plaintext-only') isInput = true;
-          else if (role === 'textbox' || role === 'searchbox' || role === 'combobox') isInput = true;
-          let parent = el;
-          while (parent && parent !== document.body) {
-            if (parent.contentEditable === 'true' || parent.contentEditable === 'plaintext-only') {
-              isInput = true;
-              break;
-            }
-            parent = parent.parentElement;
-          }
-          return JSON.stringify({ isInput, activeElement: { tagName, contentEditable, role, id: elementId, className, shadowPath } });
-        })()
-      `)
-      const parsed = JSON.parse(jsResult)
-      isInput = parsed.isInput
-      console.log('[FnVoiceInput:focus-debug] JS input detection result:', JSON.stringify({ isInput, activeElement: parsed.activeElement }))
-    } catch (err) {
-      console.error('[FnVoiceInput:focus-debug] Failed to execute JS focus check:', err)
-    }
-  } else {
-    // Fallback to native AX hook check for external windows
-    const hook = getMouseHook()
-    const focusInfo = hook && hook.isFocusedInInputArea
-      ? hook.isFocusedInInputArea()
-      : { isInput: false, isEditable: false, role: '' }
-    isInput = focusInfo.isInput
-    console.log('[FnVoiceInput:focus-debug] Focused outside Electron, native AX hook check:', JSON.stringify({
-      isInput: focusInfo.isInput,
-      isEditable: focusInfo.isEditable,
-      role: focusInfo.role,
-      frontmostApp: hook?.getFrontmostAppId?.() || 'N/A',
-    }))
-  }
-
-  const panelWin = ElectronFnVoicePanelWindow.getInstance()
-  const win = panelWin.ensureWindow()
-
-  console.log(`[FnVoiceInput] handleFnKeyEvent: event=${event}, isInput=${isInput}, isRecording=${isRecording}`)
-
-  if (event === 'short_press') {
-    if (isRecording) {
-      // Toggle off: stop recording and start AI polish
-      isRecording = false
-      win.webContents.send('fn-voice-panel:set-state', { mode: 'process' })
-    } else {
-      if (isInput) {
-        // Toggle on: start recording
-        isRecording = true
-        stashActiveAppPid()
-        panelWin.showPanel()
