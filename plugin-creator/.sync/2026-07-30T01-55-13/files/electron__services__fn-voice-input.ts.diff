-  } else if (event === 'long_press_start') {
-    if (!isRecording) {
-      if (isInput) {
-        isRecording = true
-        stashActiveAppPid()
-        panelWin.showPanel()
-        const sendStart = () => {
-          win.webContents.send('fn-voice-panel:set-state', { mode: 'recording' })
-        }
-        if (!win.webContents.isLoading()) {
-          sendStart()
-        } else {
-          win.webContents.once('did-finish-load', sendStart)
-        }
-
-        // Lazy load voice-assistant in background asynchronously and prewarm servers
-        loadAndWarmVoiceAssistant()
-      } else {
