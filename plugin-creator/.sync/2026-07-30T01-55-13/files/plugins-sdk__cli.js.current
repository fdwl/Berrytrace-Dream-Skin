#!/usr/bin/env node

import fs from 'fs';
import path from 'path';
import crypto from 'crypto';
import os from 'os';
import http from 'http';
import { exec } from 'child_process';
import { fileURLToPath } from 'url';
import AdmZip from 'adm-zip';
import { createPlugin } from './create.js';

const __filename = fileURLToPath(import.meta.url);
const __dirname = path.dirname(__filename);

let cliVersion = 'unknown';
try {
  // If run via built bin in dist/berrytrace-cli.js, package.json is one level up
  const pkgPath = path.join(__dirname, '../package.json');
  const pkg = JSON.parse(fs.readFileSync(pkgPath, 'utf8'));
  if (pkg.name === 'berrytrace-plugin-sdk') {
    cliVersion = pkg.version;
  } else {
    throw new Error('Not the right package');
  }
} catch (e) {
  try {
    // If run directly via node cli.js, package.json is in the same directory
    const pkgPath = path.join(__dirname, './package.json');
    const pkg = JSON.parse(fs.readFileSync(pkgPath, 'utf8'));
    if (pkg.name === 'berrytrace-plugin-sdk') {
      cliVersion = pkg.version;
    }
  } catch (e2) {
    // fallback
  }
}

// 辅助函数: 语义化版本号对比 (v1 > v2 ?)
function semverGt(v1, v2) {
  const a = v1.split(/[.-]/).map(x => isNaN(x) ? x : Number(x));
  const b = v2.split(/[.-]/).map(x => isNaN(x) ? x : Number(x));
  for (let i = 0; i < Math.max(a.length, b.length); i++) {
    const va = a[i] === undefined ? 0 : a[i];
    const vb = b[i] === undefined ? 0 : b[i];
    if (typeof va === 'number' && typeof vb === 'number') {
      if (va > vb) return true;
      if (va < vb) return false;
    } else {
      if (va.toString() > vb.toString()) return true;
      if (va.toString() < vb.toString()) return false;
    }
  }
  return false;
}

// 获取最后一次更新检查的配置路径
function getUpdateConfigPath() {
  return path.join(os.homedir(), '.berrytrace', 'update.json');
}

// 获取最新版本号
function getLatestVersion() {
  return new Promise((resolve) => {
    // 优先使用 npm view，能完美支持国内镜像源/自定义源
    exec('npm view berrytrace-plugin-sdk version', (err, stdout) => {
      if (!err && stdout) {
        const ver = stdout.trim();
        if (ver) {
          resolve(ver);
          return;
        }
      }
      // 备用方案：直接请求 npm 官方 registry
      const options = {
        hostname: 'registry.npmjs.org',
        path: '/berrytrace-plugin-sdk/latest',
        method: 'GET',
        headers: { 'User-Agent': 'berrytrace-cli' },
        timeout: 3000
      };
      const req = http.request(options, (res) => {
        let data = '';
        res.on('data', chunk => data += chunk);
        res.on('end', () => {
          try {
            const pkg = JSON.parse(data);
            resolve(pkg.version || null);
          } catch (e) {
            resolve(null);
          }
        });
      });
      req.on('error', () => resolve(null));
      req.on('timeout', () => {
        req.destroy();
        resolve(null);
      });
      req.end();
    });
  });
}

// 升级命令
function runUpgrade() {
  return new Promise((resolve, reject) => {
    console.log('🔄 正在升级 berrytrace-plugin-sdk...');
    exec('npm install -g berrytrace-plugin-sdk', (err, stdout, stderr) => {
      if (err) {
        reject(err);
      } else {
        resolve();
      }
    });
  });
}

// 检查并升级
async function checkAndUpgrade(force = false) {
  // 如果是本地开发环境，不进行自动升级检查
  if (__dirname.includes('/work/work/') || __dirname.includes('berrytrace_app')) {
    return;
  }

  const configPath = getUpdateConfigPath();
  let config = { lastCheck: 0, latestVersion: '' };

  if (fs.existsSync(configPath)) {
    try {
      config = JSON.parse(fs.readFileSync(configPath, 'utf8'));
    } catch (e) {}
  }

  const now = Date.now();
  const ONE_DAY = 24 * 60 * 60 * 1000;

  if (force || (now - config.lastCheck > ONE_DAY)) {
    const latest = await getLatestVersion();
    if (latest) {
      config.lastCheck = now;
      config.latestVersion = latest;
      try {
        fs.mkdirSync(path.dirname(configPath), { recursive: true });
        fs.writeFileSync(configPath, JSON.stringify(config, null, 2), 'utf8');
      } catch (e) {}

      if (semverGt(latest, cliVersion)) {
        console.log(`✨ 发现新版本 v${latest} (当前版本 v${cliVersion})`);
        try {
          await runUpgrade();
          console.log(`✓ 自动升级成功！当前版本已更新为 v${latest}。`);
          cliVersion = latest;
        } catch (err) {
          console.warn(`⚠️ 自动升级失败: ${err.message}`);
          console.warn('建议运行以下命令进行手动升级：');
          console.warn('  npm install -g berrytrace-plugin-sdk');
        }
      } else if (force) {
        console.log(`✓ 当前已是最新版本 v${cliVersion}。`);
      }
    } else if (force) {
      console.error('❌ 检查更新失败，无法连接到 npm 注册表。');
    }
  }
}



// 辅助函数: 跨平台在浏览器中打开 URL
function openBrowser(url) {
  const start = process.platform === 'darwin' ? 'open' : process.platform === 'win32' ? 'start ""' : 'xdg-open';
  exec(`${start} "${url}"`);
}

// 辅助函数: 用于签名包的规范 JSON 字符串生成
function getCanonicalPackageString(pluginId, version, files) {
  const sortedFiles = {};
  for (const key of Object.keys(files).sort()) {
    sortedFiles[key] = files[key];
  }
  const canonicalObj = {
    pluginId,
    version,
    files: sortedFiles
  };
  return JSON.stringify(canonicalObj);
}

// 生成 P-256 ECDSA 密钥对
function generateKeys(targetDir = process.cwd()) {
  console.log('正在生成 ECDSA P-256 密钥对...');
  const { publicKey, privateKey } = crypto.generateKeyPairSync('ec', {
    namedCurve: 'prime256v1',
    publicKeyEncoding: { type: 'spki', format: 'pem' },
    privateKeyEncoding: { type: 'pkcs8', format: 'pem' }
  });

  const pubPath = path.join(targetDir, 'public_key.pem');
  const privPath = path.join(targetDir, 'private_key.pem');

  fs.writeFileSync(pubPath, publicKey);
  fs.writeFileSync(privPath, privateKey);

  console.log(`✓ 公钥已保存至: ${pubPath}`);
  console.log(`✓ 私钥已保存至: ${privPath}`);

  // 如果 .gitignore 存在，尝试将 private_key.pem 添加进去
  const gitignorePath = path.join(targetDir, '.gitignore');
  if (fs.existsSync(gitignorePath)) {
    const gitignoreContent = fs.readFileSync(gitignorePath, 'utf8');
    if (!gitignoreContent.includes('private_key.pem')) {
      fs.appendFileSync(gitignorePath, '\n# 莓莓印记开发者私钥\nprivate_key.pem\n');
      console.log('✓ 已将 private_key.pem 添加至 .gitignore');
    }
  }

  console.log('\n==================================================');
  console.log('⚠️  重要安全警告：');
  console.log('1. 请妥善保管您的私钥 "private_key.pem"，切勿泄露。');
  console.log('   请勿将其提交到 Git 或上传到任何公开网络平台。');
  console.log('2. 此私钥是您后续更新发布该插件的唯一凭证。');
  console.log('   一旦丢失，您将无法为同一个插件 ID 发布任何新版本。');
  console.log('==================================================\n');

  return { publicKey, privateKey };
}

// SDK 统一构建逻辑：零配置编译 background (Node.js) 与 view (Browser) 脚本
async function performSdkBuild(pluginPath) {
  try {
    const pluginJsonPath = path.join(pluginPath, 'plugin.json');
    if (!fs.existsSync(pluginJsonPath)) {
      console.error('❌ 未找到 plugin.json 文件');
      return false;
    }

    const pluginJson = JSON.parse(fs.readFileSync(pluginJsonPath, 'utf8'));
    const { id, main, view } = pluginJson;

    console.log(`🔨 正在使用 BerryTrace SDK 构建插件 "${id}"...`);

    const { build } = await import('esbuild');

    // 别名解析插件，将以 @/ 开头的路径重定向到宿主 src/ 目录，方便内置插件开发引用
    const aliasPlugin = {
      name: 'berrytrace-alias-plugin',
      setup(buildContext) {
        const getProjectRoot = () => {
          let curr = __dirname;
          for (let i = 0; i < 8; i++) {
            if (fs.existsSync(path.resolve(curr, 'src')) && fs.existsSync(path.resolve(curr, 'electron'))) {
              return curr;
            }
            const parent = path.dirname(curr);
            if (parent === curr) break;
            curr = parent;
          }
          if (fs.existsSync(path.resolve(__dirname, '../src'))) return path.resolve(__dirname, '..');
          if (fs.existsSync(path.resolve(__dirname, '../../src'))) return path.resolve(__dirname, '../..');
          return path.resolve(__dirname, '..');
        };
        const ROOT = getProjectRoot();
        buildContext.onResolve({ filter: /^@\// }, args => {
          const targetPath = path.resolve(ROOT, 'src', args.path.slice(2));
          const exts = ['', '.ts', '.tsx', '.js', '.jsx', '/index.ts', '/index.tsx', '/index.js', '/index.jsx'];
          for (const ext of exts) {
            const fullPath = targetPath + ext;
            if (fs.existsSync(fullPath) && fs.statSync(fullPath).isFile()) {
              return { path: fullPath };
            }
          }
          return { path: targetPath };
        });
      }
    };

    // 默认内置的 esbuild 插件，用于对原生二进制文件（.node）和特殊动态包进行打桩，以避免编译失败
    const defaultStubPlugin = {
      name: 'berrytrace-stub-plugin',
      setup(buildContext) {
        // 拦截原生 .node 二进制模块
        buildContext.onResolve({ filter: /\.node$/ }, (args) => ({
          path: args.path,
          namespace: 'node-stub'
        }));
        buildContext.onLoad({ filter: /.*/, namespace: 'node-stub' }, () => ({
          contents: `module.exports = {}; export default null;`
        }));

        // 模拟 registry-js 以防止 Windows 环境下 require 崩溃
        buildContext.onResolve({ filter: /^registry-js$/ }, () => ({
          path: 'registry-js-stub',
          namespace: 'stub-ns'
        }));
        buildContext.onLoad({ filter: /^registry-js-stub$/, namespace: 'stub-ns' }, () => ({
          contents: `
            export const HKEY = {
              HKEY_LOCAL_MACHINE: 'HKLM',
              HKEY_CURRENT_USER: 'HKCU',
              HKEY_CLASSES_ROOT: 'HKCR',
              HKEY_CURRENT_CONFIG: 'HKCC',
              HKEY_USERS: 'HKU'
            };
            export function enumerateValuesSafe() { return []; }
            export default { HKEY, enumerateValuesSafe };
          `
        }));

        // 模拟 fsevents 避免 macOS 原生二进制加载报错
        buildContext.onResolve({ filter: /^fsevents$/ }, () => ({
          path: 'fsevents-stub',
          namespace: 'stub-ns'
        }));
        buildContext.onLoad({ filter: /^fsevents-stub$/, namespace: 'stub-ns' }, () => ({
          contents: `export default null;`
        }));

        // 模拟 Playwright / Puppeteer 的动态依赖 chromium-bidi
        buildContext.onResolve({ filter: /^chromium-bidi/ }, (args) => ({
          path: args.path + '-stub',
          namespace: 'stub-ns'
        }));
        buildContext.onLoad({ filter: /-stub$/, namespace: 'stub-ns' }, () => ({
          contents: `module.exports = {}; export default {};`
        }));
      }
    };

    // UMD 模块构建修复插件：解开 UMD 模块中被参数遮蔽的 require 引用，使其能被 esbuild 静态解析并打包
    const umdFixPlugin = {
      name: 'berrytrace-umd-fix-plugin',
      setup(buildContext) {
        buildContext.onLoad({ filter: /node_modules\/.*\.js$/ }, async (args) => {
          const contents = await fs.promises.readFile(args.path, 'utf8');
          if (/function\s*\(require,\s*exports\)/.test(contents)) {
            const modified = contents.replace(/function\s*\(require,\s*exports\)/g, 'function (__umd_require, exports)');
            return {
              contents: modified,
              loader: 'js'
            };
          }
          return null; // 默认使用 esbuild 原始加载器
        });
      }
    };

    // 1. 构建 background script (main)
    if (main) {
      const srcMain = main.replace(/^dist\//, 'src/').replace(/\.js$/, '.ts');
      const srcMainJs = main.replace(/^dist\//, 'src/');
      let entryPoint = path.join(pluginPath, srcMain);
      if (!fs.existsSync(entryPoint)) {
        entryPoint = path.join(pluginPath, srcMainJs);
      }
      if (!fs.existsSync(entryPoint)) {
        console.error(`❌ 未找到 background 入口文件: ${entryPoint}`);
        return false;
      }

      console.log(`📦 正在编译 background 入口: ${entryPoint} -> ${main}`);

      // 读取 package.json 依赖以设置为外部模块，防止它们被打包进单一的 JS 文件中
      const pkgJsonPath = path.join(pluginPath, 'package.json');
      let dependencies = [];
      if (fs.existsSync(pkgJsonPath)) {
        try {
          const pkg = JSON.parse(fs.readFileSync(pkgJsonPath, 'utf8'));
          dependencies = pkg.dependencies ? Object.keys(pkg.dependencies) : [];
        } catch (err) {
          console.warn('[Packager] Failed to parse package.json dependencies for build:', err);
        }
      }

      await build({
        entryPoints: [entryPoint],
        outfile: path.join(pluginPath, main),
        bundle: true,
        platform: 'node',
        target: ['node20'],
        format: 'esm',
        minify: false,
        allowOverwrite: true,
        mainFields: ['module', 'main'],
        plugins: [defaultStubPlugin, umdFixPlugin],
        tsconfigRaw: {
          compilerOptions: {
            experimentalDecorators: true
          }
        },
        banner: {
          js: "import { createRequire as __createRequire } from 'module'; import { fileURLToPath as __fileURLToPath } from 'url'; import { dirname as __dirnamePolyfill } from 'path'; const require = __createRequire(import.meta.url); const __filename = __fileURLToPath(import.meta.url); const __dirname = __dirnamePolyfill(__filename);",
        },
        logLevel: 'info',
        external: [
          'berrytrace-plugin-sdk',
          'sherpa-onnx-node',
          'electron',
          ...dependencies,
          ...dependencies.map(d => `${d}/*`)
        ],
      });
    }

    // 2. 构建 view script (view)
    if (view) {
      const srcViewTsx = view.replace(/^dist\//, 'src/').replace(/\.js$/, '.tsx');
      const srcViewTs = view.replace(/^dist\//, 'src/').replace(/\.js$/, '.ts');
      const srcViewJsx = view.replace(/^dist\//, 'src/').replace(/\.js$/, '.jsx');
      const srcViewVanilla = view.replace(/^dist\//, 'src/');
      let entryPoint = path.join(pluginPath, srcViewTsx);
      if (!fs.existsSync(entryPoint)) {
        entryPoint = path.join(pluginPath, srcViewTs);
      }
      if (!fs.existsSync(entryPoint)) {
        entryPoint = path.join(pluginPath, srcViewJsx);
      }
      if (!fs.existsSync(entryPoint)) {
        entryPoint = path.join(pluginPath, srcViewVanilla);
      }
      if (!fs.existsSync(entryPoint)) {
        console.error(`❌ 未找到 view 入口文件: ${entryPoint}`);
        return false;
      }

      console.log(`📦 正在编译 view 入口: ${entryPoint} -> ${view}`);

      const cssPlugin = {
        name: 'berrytrace-css-plugin',
        setup(buildContext) {
          buildContext.onResolve({ filter: /\.css$/ }, args => {
            let resolvedPath = '';
            if (args.path.startsWith('.') || args.path.startsWith('/') || path.isAbsolute(args.path)) {
              resolvedPath = path.resolve(args.resolveDir, args.path);
            } else {
              const getProjectRoot = () => {
                let curr = __dirname;
                for (let i = 0; i < 8; i++) {
                  if (fs.existsSync(path.resolve(curr, 'src')) && fs.existsSync(path.resolve(curr, 'electron'))) {
                    return curr;
                  }
                  const parent = path.dirname(curr);
                  if (parent === curr) break;
                  curr = parent;
                }
                if (fs.existsSync(path.resolve(__dirname, '../src'))) return path.resolve(__dirname, '..');
                if (fs.existsSync(path.resolve(__dirname, '../../src'))) return path.resolve(__dirname, '../..');
                return path.resolve(__dirname, '..');
              };
              const ROOT = getProjectRoot();
              const candidates = [
                path.resolve(args.resolveDir, args.path),
                path.resolve(pluginPath, 'node_modules', args.path),
                path.resolve(ROOT, 'node_modules', args.path),
              ];
              try {
                resolvedPath = require.resolve(args.path, { paths: [args.resolveDir, pluginPath, ROOT] });
              } catch (e) {
                resolvedPath = candidates.find(c => fs.existsSync(c)) || candidates[0];
              }
              if (!fs.existsSync(resolvedPath)) {
                resolvedPath = candidates.find(c => fs.existsSync(c)) || resolvedPath;
              }
            }
            return {
              path: resolvedPath, namespace: 'css-ns',
            };
          });
          buildContext.onLoad({ filter: /.*/, namespace: 'css-ns' }, args => {
            const css = fs.readFileSync(args.path, 'utf-8').replace(/\s+/g, ' ');
            return {
              contents: `const el = document.createElement('style'); el.textContent = ${JSON.stringify(css)}; document.head.appendChild(el); export default null;`,
              loader: 'js',
            };
          });
        },
      };

      // ─────────────────────────────────────────────────────────────────────────
      // 全局 shim 插件组（Global Shim Plugins）
      //
      // 作用：将浏览器沙箱（view 层）无法通过 node_modules 解析的 bare specifier，
      //       替换为从宿主已挂载的 window 全局变量读取，避免 ESM 解析失败。
      //
      // ⚠️  【维护协议 - SKILL.md 版本扫描热点】
      //
      // 宿主全局变量定义在：src/main.tsx
      // 当 src/main.tsx 新增 window.Xxx 挂载时，必须同步更新以下两处：
      //
      //   1. 本文件（cli.js）globalReactPlugin / globalSdkPlugin 的 shim 内容
      //      → 新增对应的 onResolve + onLoad 处理分支
      //
      //   2. npx-tools/skills/plugin-creator/references/08-build.md
      //      → 更新"SDK 内置构建已自动处理的 shim"表格
      //
      // 当前已 shim 的全局变量一览（与 src/main.tsx 保持同步）：
      //
      //   window.React        ← react, react/jsx-runtime, react/jsx-dev-runtime
      //   window.ReactDOM     ← react-dom, react-dom/client
      //   window.Zustand      ← zustand
      //   window.__lucide     ← lucide-react
      //   window.berrytrace   ← berrytrace-plugin-sdk（SDK 实例）
      //   window.useUserStore ← @/stores/user（通过 globalHostImportsPlugin 处理）
      //   window.useAppStore  ← @/stores/app
      //   window.httpService  ← @/services/http
      //   window.event_bus    ← @/services/event_bus
      //   window.publish_bridge ← @/services/publish_bridge
      //   window.PluginRegistry ← @/plugins/PluginRegistry
      //
      // ⚠️  lucide-react 图标列表是静态枚举，不能自动枚举 window.__lucide 的 key。
      //     原因：esbuild tree-shaking 依赖静态 named export 分析，动态 key 会
      //     导致所有图标被强制打包（或全部 tree-shake 掉）。
      //     解决方案：当 lucide-react 发布新图标且插件需要使用时，在下方
      //     lucide-react shim 的 contents 中手动补充对应的 export 语句。
      //     图标名参考：https://lucide.dev/icons/
      //
      // ─────────────────────────────────────────────────────────────────────────

      const globalSdkPlugin = {
        name: 'berrytrace-global-sdk-plugin',
        setup(buildContext) {
          buildContext.onResolve({ filter: /^berrytrace-plugin-sdk$/ }, args => ({
            path: args.path, namespace: 'global-sdk-ns'
          }));
          buildContext.onLoad({ filter: /.*/, namespace: 'global-sdk-ns' }, () => {
            return {
              contents: `
                const sdk = (typeof window !== 'undefined' ? window : globalThis).berrytrace;
                export default sdk;
                export const createPluginSDK = sdk ? sdk.createPluginSDK : undefined;
                export const Plugin = sdk ? sdk.Plugin : undefined;
                export const View = sdk ? sdk.View : undefined;
              `,
              loader: 'js'
            };
          });
        }
      };

      const globalReactPlugin = {
        name: 'berrytrace-global-react-plugin',
        setup(buildContext) {
          buildContext.onResolve({ filter: /.*/ }, args => {
            const matches = ['react', 'react-dom', 'react-dom/client', 'zustand', 'lucide-react', 'xterm', 'xterm-addon-fit', 'react-tooltip', 'framer-motion', 'motion'];
            if (matches.includes(args.path) || args.path.startsWith('react/') || args.path.startsWith('react-dom/')) {
              return { path: args.path, namespace: 'global-react-ns' };
            }
            return null;
          });
          buildContext.onLoad({ filter: /.*/, namespace: 'global-react-ns' }, args => {
            if (args.path === 'react') {
              return {
                contents: `
                  const React = (typeof window !== 'undefined' ? window : globalThis).React;
                  export default React;
                  export const useState = React.useState;
                  export const useEffect = React.useEffect;
                  export const useContext = React.useContext;
                  export const useRef = React.useRef;
                  export const useCallback = React.useCallback;
                  export const useMemo = React.useMemo;
                  export const useReducer = React.useReducer;
                  export const useId = React.useId;
                  export const useTransition = React.useTransition;
                  export const useDeferredValue = React.useDeferredValue;
                  export const useSyncExternalStore = React.useSyncExternalStore;
                  export const createContext = React.createContext;
                  export const startTransition = React.startTransition;
                  export const memo = React.memo;
                  export const lazy = React.lazy;
                  export const Fragment = React.Fragment;
                  export const StrictMode = React.StrictMode;
                  export const Suspense = React.Suspense;
                  export const createElement = React.createElement;
                  export const useLayoutEffect = React.useLayoutEffect;
                  export const useInsertionEffect = React.useInsertionEffect;
                  export const Children = React.Children;
                  export const isValidElement = React.isValidElement;
                  export const forwardRef = React.forwardRef;
                  export const Component = React.Component;
                  export const PureComponent = React.PureComponent;
                  export const cloneElement = React.cloneElement;
                  export const createRef = React.createRef;
                  export const useImperativeHandle = React.useImperativeHandle;
                  export const useDebugValue = React.useDebugValue;
                  export const Profiler = React.Profiler;
                `,
                loader: 'js'
              };
            }
            if (args.path === 'react/jsx-runtime' || args.path === 'react/jsx-dev-runtime') {
              return {
                contents: `
                  const React = (typeof window !== 'undefined' ? window : globalThis).React;
                  export const jsx = React.createElement;
                  export const jsxs = React.createElement;
                  export const Fragment = React.Fragment;
                `,
                loader: 'js'
              };
            }
            if (args.path.startsWith('react/')) {
              return {
                contents: `
                  const React = (typeof window !== 'undefined' ? window : globalThis).React;
                  export default React;
                `,
                loader: 'js'
              };
            }
            if (args.path === 'react-dom' || args.path === 'react-dom/client' || args.path.startsWith('react-dom/')) {
              return {
                contents: `
                  const ReactDOM = (typeof window !== 'undefined' ? window : globalThis).ReactDOM;
                  export default ReactDOM;
                  export const createRoot = ReactDOM.createRoot;
                  export const hydrateRoot = ReactDOM.hydrateRoot;
                  export const flushSync = ReactDOM.flushSync;
                  export const createPortal = ReactDOM.createPortal;
                `,
                loader: 'js'
              };
            }
            if (args.path === 'zustand') {
              return {
                contents: `
                  const Zustand = (typeof window !== 'undefined' ? window : globalThis).Zustand;
                  export default Zustand;
                  export const create = Zustand.create;
                  export const useStore = Zustand.useStore;
                `,
                loader: 'js'
              };
            }
            // lucide-react → window.__lucide（宿主 main.tsx 已暴露）
            if (args.path === 'lucide-react') {
              return {
                contents: `
                  const _L = (typeof window !== 'undefined' ? window : globalThis).__lucide || {};
                  export default _L;
                  // Proxy getter：任意 named import 均从 window.__lucide 取，实现按需访问
                  export const Loader2         = _L.Loader2;
                  export const CheckCircle2    = _L.CheckCircle2;
                  export const AlertCircle     = _L.AlertCircle;
                  export const Circle          = _L.Circle;
