                  export const Swords          = _L.Swords;
                  export const Ghost           = _L.Ghost;
                  export const Moon            = _L.Moon;
                `,
                loader: 'js'
              };
            }
            if (args.path === 'xterm') {
              return {
                contents: `
                  const XTerm = (typeof window !== 'undefined' ? window : globalThis).XTerm || {};
                  export const Terminal = XTerm.Terminal;
                `,
                loader: 'js'
              };
            }
            if (args.path === 'xterm-addon-fit') {
              return {
                contents: `
                  const XTerm = (typeof window !== 'undefined' ? window : globalThis).XTerm || {};
                  export const FitAddon = XTerm.FitAddon;
                `,
                loader: 'js'
              };
            }
            if (args.path === 'react-tooltip') {
              return {
                contents: `
                  const ReactTooltip = (typeof window !== 'undefined' ? window : globalThis).ReactTooltip;
                  export default ReactTooltip;
                  export const Tooltip = ReactTooltip;
                `,
                loader: 'js'
              };
            }
            if (args.path === 'framer-motion') {
              return {
                contents: `
                  // framer-motion → window.FramerMotion（宿主 main.tsx 已暴露）
                  // 共享同一实例，避免双重实例导致 AnimatePresence/PresenceContext 冲突
                  const _FM = (typeof window !== 'undefined' ? window : globalThis).FramerMotion || {};
                  export default _FM;
                  export const motion           = _FM.motion;
                  export const AnimatePresence  = _FM.AnimatePresence;
                  export const animate          = _FM.animate;
                  export const useAnimate       = _FM.useAnimate;
                  export const useAnimation     = _FM.useAnimation;
                  export const useMotionValue   = _FM.useMotionValue;
                  export const useTransform     = _FM.useTransform;
                  export const useSpring        = _FM.useSpring;
                  export const useScroll        = _FM.useScroll;
                  export const useInView        = _FM.useInView;
                  export const useDragControls  = _FM.useDragControls;
                  export const LayoutGroup      = _FM.LayoutGroup;
                  export const LazyMotion       = _FM.LazyMotion;
                  export const m                = _FM.m;
                  export const domAnimation     = _FM.domAnimation;
                  export const domMax           = _FM.domMax;
                  export const stagger          = _FM.stagger;
                  export const spring           = _FM.spring;
                  export const easing           = _FM.easing;
                `,
                loader: 'js'
              };
            }
            // 'motion' 是 framer-motion v11 拆分出的子包，映射到同一全局实例
            if (args.path === 'motion') {
              return {
                contents: `
                  const _FM = (typeof window !== 'undefined' ? window : globalThis).FramerMotion || {};
                  export default _FM;
                  export const motion           = _FM.motion;
                  export const AnimatePresence  = _FM.AnimatePresence;
                  export const animate          = _FM.animate;
                  export const useAnimate       = _FM.useAnimate;
                  export const useMotionValue   = _FM.useMotionValue;
                  export const useTransform     = _FM.useTransform;
                  export const useSpring        = _FM.useSpring;
                  export const useScroll        = _FM.useScroll;
                  export const useInView        = _FM.useInView;
                  export const m                = _FM.m;
                  export const stagger          = _FM.stagger;
                `,
                loader: 'js'
              };
            }

            return null;
          });
        }
      };


      // 共享宿主核心单例状态，防止在插件内部多次打包生成副本导致状态脱节
      const globalHostImportsPlugin = {
        name: 'berrytrace-global-host-imports-plugin',
        setup(buildContext) {
          const getProjectRoot = () => {
            let curr = __dirname;
            for (let i = 0; i < 8; i++) {
              if (fs.existsSync(path.resolve(curr, 'src')) && fs.existsSync(path.resolve(curr, 'electron'))) {
                return curr;
              }
              const parent = path.dirname(curr);
              if (parent === curr) break;
              curr = parent;
            }
            if (fs.existsSync(path.resolve(__dirname, '../src'))) return path.resolve(__dirname, '..');
            if (fs.existsSync(path.resolve(__dirname, '../../src'))) return path.resolve(__dirname, '../..');
            return path.resolve(__dirname, '..');
          };
          const ROOT = getProjectRoot();
          const hostImports = {
            '@/stores/user': `
              const useUserStore = (typeof window !== 'undefined' ? window : globalThis).useUserStore;
              export { useUserStore };
            `,
            '@/stores/app': `
              const useAppStore = (typeof window !== 'undefined' ? window : globalThis).useAppStore;
              export { useAppStore };
            `,
            '@/services/http': `
              const httpService = (typeof window !== 'undefined' ? window : globalThis).httpService;
              export { httpService };
            `,
            '@/services/event_bus': `
              const event_bus = (typeof window !== 'undefined' ? window : globalThis).event_bus;
              export default event_bus;
            `,
            '@/services/publish_bridge': `
              const publish_bridge = (typeof window !== 'undefined' ? window : globalThis).publish_bridge;
              export const bindConsumers = publish_bridge ? publish_bridge.bindConsumers : undefined;
              export const unbindConsumers = publish_bridge ? publish_bridge.unbindConsumers : undefined;
            `,
            '@/plugins/PluginRegistry': `
              const PluginRegistry = (typeof window !== 'undefined' ? window : globalThis).PluginRegistry;
              export { PluginRegistry };
            `
          };
          buildContext.onResolve({ filter: /.*/ }, args => {
            if (!args.resolveDir) return null;
            
            let absolutePath = '';
            if (args.path.startsWith('@/')) {
              absolutePath = path.resolve(ROOT, 'src', args.path.slice(2));
            } else if (args.path.startsWith('.')) {
              absolutePath = path.resolve(args.resolveDir, args.path);
            } else {
              return null;
            }
            
            const normalized = absolutePath.replace(/\.(?:ts|tsx|js|jsx)$/, '');
            
            const userStorePath = path.resolve(ROOT, 'src/stores/user');
            const appStorePath = path.resolve(ROOT, 'src/stores/app');
            const httpServicePath = path.resolve(ROOT, 'src/services/http');
            const eventBusPath = path.resolve(ROOT, 'src/services/event_bus');
            const publishBridgePath = path.resolve(ROOT, 'src/services/publish_bridge');
            const pluginRegistryPath = path.resolve(ROOT, 'src/plugins/PluginRegistry');
            
            if (normalized === userStorePath) {
              return { path: '@/stores/user', namespace: 'global-host-imports-ns' };
            }
            if (normalized === appStorePath) {
              return { path: '@/stores/app', namespace: 'global-host-imports-ns' };
            }
            if (normalized === httpServicePath) {
              return { path: '@/services/http', namespace: 'global-host-imports-ns' };
            }
            if (normalized === eventBusPath) {
              return { path: '@/services/event_bus', namespace: 'global-host-imports-ns' };
            }
            if (normalized === publishBridgePath) {
              return { path: '@/services/publish_bridge', namespace: 'global-host-imports-ns' };
            }
            if (normalized === pluginRegistryPath) {
              return { path: '@/plugins/PluginRegistry', namespace: 'global-host-imports-ns' };
            }
            
            return null;
          });
          buildContext.onLoad({ filter: /.*/, namespace: 'global-host-imports-ns' }, args => {
            return { contents: hostImports[args.path], loader: 'js' };
          });
        }
      };

      await build({
        entryPoints: [entryPoint],
        outfile: path.join(pluginPath, view),
        bundle: true,
        platform: 'browser',
        target: ['es2022'],
        format: 'esm',
        minify: true,
        jsxFactory: 'React.createElement',
        jsxFragment: 'React.Fragment',
        plugins: [globalHostImportsPlugin, aliasPlugin, cssPlugin, globalSdkPlugin, globalReactPlugin],
        tsconfigRaw: {
          compilerOptions: {
            experimentalDecorators: true
          }
        },
        logLevel: 'info',
        external: ['electron'],
        define: {
          'import.meta.env': JSON.stringify({
            DEV: true,
            MODE: 'development',
            VITE_APP_SOCKET_URL: '',
            VITE_BASE_URL: '',
            VITE_APP_API_URL: '',
            VITE_UPLOAD_URL: '',
            VITE_APP_USE_MOCK: 'true',
            VITE_BERRYTRACE_MODEL: 'qwen3-vl-plus',
            VITE_BERRYTRACE_ENDPOINT: '',
            VITE_WEB_APP: 'false',
            VITE_ENABLE_PHONE_LOGIN: 'false',
          })
        },
      });
    }

    console.log(`✓ 插件 "${id}" 构建成功！\n`);
    return { success: true, pluginId: id };
  } catch (err) {
    console.error('❌ 构建插件失败:', err);
    return { success: false, pluginId: null };
  }
}

// 辅助函数: 通知宿主 LocalServer 进行热重载或解包加载
function notifyLocalServer(pluginId, pluginPath) {
  return new Promise((resolve) => {
    const configPath = path.join(os.homedir(), '.berrytrace', 'local_server.json');
    if (!fs.existsSync(configPath)) {
      console.log('💡 未检测到宿主运行的 LocalServer 配置 (~/.berrytrace/local_server.json)，跳过热重载通知。');
      resolve(false);
      return;
    }

    try {
      const config = JSON.parse(fs.readFileSync(configPath, 'utf8'));
      const { port, token } = config;

      // 1. 先探测 /ping
      const req = http.request({
        hostname: '127.0.0.1',
        port: port || 31828,
        path: '/ping',
        method: 'GET',
        timeout: 2000
      }, (res) => {
        if (res.statusCode !== 200) {
          console.log('💡 宿主 LocalServer 未响应 (/ping)，跳过热重载通知。');
          resolve(false);
          return;
        }

        // 2. 尝试调用 /reload-plugin?id=<pluginId>
        const reloadReq = http.request({
          hostname: '127.0.0.1',
          port: port || 31828,
          path: `/reload-plugin?id=${encodeURIComponent(pluginId)}`,
          method: 'GET',
          headers: {
            'Authorization': `Bearer ${token}`
          },
          timeout: 5000
        }, (reloadRes) => {
          let body = '';
          reloadRes.on('data', chunk => body += chunk);
          reloadRes.on('end', () => {
            if (reloadRes.statusCode === 200) {
              console.log(`✅ 成功通知 BerryTrace 宿主热重载插件 "${pluginId}"！`);
              resolve(true);
            } else {
              // 3. 若 reload 失败（如插件首次加载），退回调用 /load-unpacked-plugin?path=<absolutePath>
              const absPath = path.resolve(pluginPath);
              const loadReq = http.request({
                hostname: '127.0.0.1',
                port: port || 31828,
                path: `/load-unpacked-plugin?path=${encodeURIComponent(absPath)}`,
                method: 'GET',
                headers: {
                  'Authorization': `Bearer ${token}`
                },
                timeout: 5000
              }, (loadRes) => {
                let loadBody = '';
                loadRes.on('data', chunk => loadBody += chunk);
                loadRes.on('end', () => {
                  if (loadRes.statusCode === 200) {
                    console.log(`✅ 成功通知 BerryTrace 宿主加载未打包插件 "${pluginId}"！`);
                    resolve(true);
                  } else {
                    console.warn(`⚠️ 通知宿主加载插件失败 (HTTP ${loadRes.statusCode}): ${loadBody}`);
                    resolve(false);
                  }
                });
              });
              loadReq.on('error', (err) => {
                console.warn(`⚠️ 请求 /load-unpacked-plugin 异常: ${err.message}`);
                resolve(false);
              });
              loadReq.end();
            }
          });
        });
        reloadReq.on('error', (err) => {
          console.warn(`⚠️ 请求 /reload-plugin 异常: ${err.message}`);
          resolve(false);
        });
        reloadReq.end();
      });

      req.on('error', () => {
        console.log('💡 BerryTrace 宿主未启动，跳过热重载通知。');
        resolve(false);
      });
      req.end();
    } catch (err) {
      console.warn('⚠️ 读取 LocalServer Token 或通知失败:', err.message);
      resolve(false);
    }
  });
}

// 辅助函数: 获取日志 (优先连 LocalServer REST API，失败则降级读取本地文件)
function fetchLogsFromLocalServerOrFile(pluginId, limit = 50) {
  return new Promise((resolve) => {
    const configPath = path.join(os.homedir(), '.berrytrace', 'local_server.json');
    if (fs.existsSync(configPath)) {
      try {
        const config = JSON.parse(fs.readFileSync(configPath, 'utf8'));
        const { port, token } = config;
        const query = pluginId ? `?pluginId=${encodeURIComponent(pluginId)}&limit=${limit}` : `?limit=${limit}`;
        const req = http.request({
          hostname: '127.0.0.1',
          port: port || 31828,
          path: `/get-logs${query}`,
          method: 'GET',
          headers: { 'Authorization': `Bearer ${token}` },
          timeout: 2000
        }, (res) => {
          let body = '';
          res.on('data', chunk => body += chunk);
          res.on('end', () => {
            if (res.statusCode === 200) {
              try {
                const data = JSON.parse(body);
                if (data.logs && Array.isArray(data.logs)) {
                  console.log(`📋 ===== 宿主运行日志 (最近 ${data.logs.length} 条) =====`);
                  data.logs.forEach(log => {
                    const time = new Date(log.timestamp).toLocaleTimeString();
                    console.log(`[${time}] [${log.level.toUpperCase()}] [${log.source}] ${log.message}`);
                  });
                  resolve(true);
                  return;
                }
              } catch { /* fallback */ }
            }
            readFallbackFileLogs(pluginId, limit).then(resolve);
          });
        });
        req.on('error', () => {
          readFallbackFileLogs(pluginId, limit).then(resolve);
        });
        req.end();
        return;
      } catch { /* fallback */ }
    }
    readFallbackFileLogs(pluginId, limit).then(resolve);
  });
}

function readFallbackFileLogs(pluginId, limit = 50) {
  return new Promise((resolve) => {
    const possiblePaths = [
      path.join(process.cwd(), 'logs', 'app.log'),
      path.join(os.homedir(), 'Library', 'Application Support', 'berrytrace-dev', 'logs', 'app.log'),
      path.join(os.homedir(), 'Library', 'Application Support', 'berrytrace', 'logs', 'app.log'),
      path.join(os.homedir(), 'AppData', 'Roaming', 'berrytrace', 'logs', 'app.log'),
      path.join(os.homedir(), '.config', 'berrytrace', 'logs', 'app.log')
    ];

    let foundPath = null;
    for (const p of possiblePaths) {
      if (fs.existsSync(p)) {
        foundPath = p;
        break;
      }
    }

    if (!foundPath) {
      console.log('💡 未找到宿主运行记录或本地 app.log 文件');
      resolve(false);
      return;
    }

    try {
      console.log(`📄 读取本地日志文件: ${foundPath}`);
      const content = fs.readFileSync(foundPath, 'utf8');
      const lines = content.split('\n').filter(Boolean);
      let matched = lines;
      if (pluginId) {
        matched = lines.filter(line => line.includes(pluginId));
      }
      const recent = matched.slice(-limit);
      console.log(`📋 ===== 磁盘日志 (最近 ${recent.length} 条) =====`);
      recent.forEach(line => console.log(line));
      resolve(true);
    } catch (err) {
      console.error('❌ 读取日志文件失败:', err.message);
      resolve(false);
    }
  });
}

// 辅助函数: 如果存在 package.json 且包含 build 脚本，自动运行 npm run build
function runLocalBuild(pluginPath) {
  return new Promise((resolve) => {
    const pkgPath = path.join(pluginPath, 'package.json');
    if (!fs.existsSync(pkgPath)) {
      resolve(true); // 无 package.json，跳过构建
      return;
    }

    try {
      const pkg = JSON.parse(fs.readFileSync(pkgPath, 'utf8'));
      if (pkg.scripts && pkg.scripts.build) {
        console.log(`🔨 检测到本地构建脚本，正在执行: npm run build...`);
        exec('npm run build', { cwd: pluginPath }, (err, stdout, stderr) => {
          if (stdout && stdout.trim()) {
            console.log(stdout.trim());
          }
          if (err) {
            if (stderr && stderr.trim()) {
              console.error(stderr.trim());
            }
            console.error(`❌ 自动构建失败: npm run build 执行出错`);
            resolve(false);
          } else {
            console.log(`✓ 自动构建成功！\n`);
            resolve(true);
          }
        });
      } else {
        resolve(true); // 无 build 脚本，跳过构建
      }
    } catch (e) {
      console.warn(`⚠️ 解析 package.json 失败，跳过自动构建: ${e.message}`);
      resolve(true);
    }
  });
}

// 递归扫描目录
function scanDirRecursive(dir, baseDir, filesList = []) {
  const files = fs.readdirSync(dir);
  for (const file of files) {
    const fullPath = path.join(dir, file);
    const relPath = path.relative(baseDir, fullPath);
    const stat = fs.statSync(fullPath);

    // 跳过忽略的文件/文件夹
    if (
      file === '.git' ||
      file === 'private_key.pem' ||
      file === '.DS_Store' ||
      relPath.endsWith('.btp')
    ) {
      continue;
    }

    if (stat.isDirectory()) {
      scanDirRecursive(fullPath, baseDir, filesList);
    } else if (stat.isFile()) {
      filesList.push(relPath);
    }
  }
  return filesList;
}

// 计算文件哈希
function getFileHash(filePath) {
  const content = fs.readFileSync(filePath);
  return crypto.createHash('sha256').update(content).digest('hex');
}

// 打包并签名插件
function packPlugin(pluginPath = process.cwd()) {
  const manifestPath = path.join(pluginPath, 'plugin.json');
  if (!fs.existsSync(manifestPath)) {
    console.error(`❌ 错误: 未在 ${manifestPath} 找到 plugin.json。请确保您当前处于插件目录中。`);
    process.exit(1);
  }

  // 解析 plugin.json 清单文件
  let manifest;
  try {
    manifest = JSON.parse(fs.readFileSync(manifestPath, 'utf8'));
  } catch (err) {
    console.error(`❌ 解析 plugin.json 失败: ${err.message}`);
    process.exit(1);
  }

  const { id, version, category } = manifest;
  if (!id || !version) {
    console.error(`❌ 错误: plugin.json 必须包含 'id' 和 'version' 字段。`);
    process.exit(1);
  }
  if (!category || !category.trim()) {
    console.error(`❌ 错误: plugin.json 必须包含 'category' 字段（分类），且不能为空。`);
    console.error(`   您可以访问 www.getdear.cn 查询有哪些分类。`);
    process.exit(1);
  }

  // 检查开发者密钥对
  let privateKeyPath = path.join(pluginPath, 'private_key.pem');
  let publicKeyPath = path.join(pluginPath, 'public_key.pem');

  if (!fs.existsSync(privateKeyPath) || !fs.existsSync(publicKeyPath)) {
    console.log('⚠️ 未检测到开发者密钥对。正在自动生成新密钥...');
    generateKeys(pluginPath);
  }

  const privateKeyPem = fs.readFileSync(privateKeyPath, 'utf8');
  const publicKeyPem = fs.readFileSync(publicKeyPath, 'utf8');

  console.log(`📦 正在打包并签名插件 "${id}" (v${version})...`);

  // 扫描文件并进行过滤
  let filesToPack = scanDirRecursive(pluginPath, pluginPath);

  // 1. 如果 plugin.json 定义了 files 数组，则严格按其指定的路径打包
  if (Array.isArray(manifest.files)) {
    const allowedPatterns = manifest.files.map(p => p.replace(/\\/g, '/'));
    filesToPack = filesToPack.filter(relPath => {
      const normalizedPath = relPath.replace(/\\/g, '/');
      return allowedPatterns.some(pattern => {
        // 如果 pattern 是目录，匹配其自身及子目录/子文件
        return normalizedPath === pattern || normalizedPath.startsWith(pattern + '/');
      });
    });
  } else {
    // 2. 默认过滤规则：如果存在 dist 目录，默认只打包 dist、skills、.skills/Skills 目录，以及根目录下的特定元数据文件，防止把 jarvis 等开发源码/配置包进去。
    const hasDist = fs.existsSync(path.join(pluginPath, 'dist'));
    filesToPack = filesToPack.filter(relPath => {
      const normalizedPath = relPath.replace(/\\/g, '/');
      const parts = normalizedPath.split('/');
      const firstPart = parts[0];
      const part0Lower = firstPart.toLowerCase();
      const fileNameLower = parts[parts.length - 1].toLowerCase();

      // 1. 无论在哪个路径（包括 node_modules），都排除开发/临时/机密/无用源码及文档文件
      if (
        part0Lower === '.git' ||
        part0Lower === 'private_key.pem' ||
        part0Lower === 'public_key.pem' ||
        part0Lower === '.ds_store' ||
        fileNameLower === '.ds_store' ||
        normalizedPath.endsWith('.btp') ||
        part0Lower === '.gitignore' ||
        part0Lower === 'package-lock.json' ||
        part0Lower === 'pnpm-lock.yaml' ||
        part0Lower === 'yarn.lock' ||
        part0Lower === 'src' ||
        part0Lower === 'scripts' ||
        part0Lower === '.github' ||
        part0Lower === '.idea' ||
        part0Lower === '.vscode' ||
        part0Lower === '.cursor' ||
        fileNameLower.endsWith('.map') ||
        parts.includes('test') ||
        parts.includes('tests') ||
        parts.includes('__tests__') ||
        parts.includes('docs') ||
        fileNameLower.endsWith('.cpp') ||
        fileNameLower.endsWith('.hpp') ||
        fileNameLower.endsWith('.c') ||
        fileNameLower.endsWith('.h') ||
        fileNameLower.endsWith('.o') ||
        fileNameLower.endsWith('.obj')
      ) {
        return false;
      }

      // 排除非声明文件的 TypeScript 源码
      if (fileNameLower.endsWith('.ts') || fileNameLower.endsWith('.tsx')) {
        if (!fileNameLower.endsWith('.d.ts')) {
          return false;
        }
      }

      // 2. 生产依赖 node_modules 打包过滤
      if (part0Lower === 'node_modules') {
        // 如果是处于 .berrytrace/tmp/pack- 的临时构建沙箱中，放行通过上述通用过滤规则的 node_modules
        if (pluginPath.includes('.berrytrace') && pluginPath.includes('pack-')) {
          return true;
        }

        try {
          const pkgJsonPath = path.join(pluginPath, 'package.json');
          if (fs.existsSync(pkgJsonPath)) {
            const pkg = JSON.parse(fs.readFileSync(pkgJsonPath, 'utf8'));
            const deps = pkg.dependencies ? Object.keys(pkg.dependencies) : [];
            const subPart = parts[1];
            if (subPart) {
              if (subPart.startsWith('@')) {
                const scopeName = `${subPart}/${parts[2]}`;
                if (deps.some(d => d === scopeName || d.startsWith(scopeName + '/'))) {
                  return true;
                }
              } else {
                if (deps.some(d => d === subPart || d.startsWith(subPart + '/'))) {
                  return true;
                }
              }
            }
          }
        } catch (err) {
          console.warn('[Packager] Failed to filter node_modules dependencies:', err);
        }
        return false; // 默认排除未声明在 dependencies 中的开发依赖
      }

      if (hasDist) {
        // 如果有 dist 目录，允许打包 dist、skills(Skills)、.skills 目录，以及根目录下的特定元数据文件
        const isMetaFile = parts.length === 1 && (
          firstPart === 'plugin.json' ||
          firstPart === 'package.json' ||
          firstPart.endsWith('.json') ||
          firstPart.endsWith('.md') ||
          firstPart.toLowerCase() === 'license' ||
          firstPart.toLowerCase() === 'licence'
        );
        const isInAllowedDir = (
          part0Lower === 'dist' ||
          part0Lower === 'skills' ||
          part0Lower === '.skills'
        );
        return isInAllowedDir || isMetaFile;
      } else {
        // 如果没有 dist 目录，排除常见的开发配置文件
        if (
          fileNameLower === 'tsconfig.json' ||
          fileNameLower.startsWith('tsconfig.') ||
          fileNameLower.startsWith('vite.config.') ||
          fileNameLower.startsWith('webpack.config.') ||
          fileNameLower.startsWith('tailwind.config.') ||
          fileNameLower.startsWith('postcss.config.') ||
          fileNameLower.startsWith('eslint.config.') ||
          fileNameLower.startsWith('.eslintrc') ||
          fileNameLower.startsWith('.prettierrc')
        ) {
          return false;
        }
        return true;
      }
    });
  }

  const filesHashes = {};
  for (const relPath of filesToPack) {
    filesHashes[relPath] = getFileHash(path.join(pluginPath, relPath));
  }

  // 生成规范签名
  const canonicalStr = getCanonicalPackageString(id, version, filesHashes);
  const signer = crypto.createSign('SHA256');
  signer.update(canonicalStr);
  signer.end();
  const signature = signer.sign(privateKeyPem, 'hex');

  // 构建 signature.json
  const signatureData = {
    pluginId: id,
    version: version,
    publicKey: publicKeyPem,
    signature: signature,
    files: filesHashes
  };

  // 创建 ZIP 归档包
  const zip = new AdmZip();

  // 添加所有文件
  for (const relPath of filesToPack) {
    const fullPath = path.join(pluginPath, relPath);
    const dirName = path.dirname(relPath);
    if (dirName === '.') {
      zip.addLocalFile(fullPath);
    } else {
      zip.addLocalFile(fullPath, dirName);
    }
  }

  // 内存中直接向 ZIP 添加 signature.json
  zip.addFile('signature.json', Buffer.from(JSON.stringify(signatureData, null, 2), 'utf8'));

  const outputFilename = `${id}-${version}.btp`;
  const outputPath = path.join(pluginPath, outputFilename);
  if (fs.existsSync(outputPath)) {
    try {
      fs.unlinkSync(outputPath);
    } catch (e) {
      // 忽略前置清理发生的未找到错误
    }
  }
  try {
    zip.writeZip(outputPath);
  } catch (err) {
    console.error(`🚨 [Packager:ERROR] 写入插件包 ${outputPath} 失败: ${err.message}`);
    throw err;
  }

  console.log(`\n✓ 插件打包和签名成功！`);
  console.log(`安装包已保存至: ${outputPath}`);
  console.log(`已验证的文件总数: ${filesToPack.length}`);
  // 检测并报告 skills 和 .skills 文件
  const skillFiles = filesToPack.filter(f => 
    f.startsWith('skills' + path.sep) || f.startsWith('skills/') ||
    f.startsWith('.skills' + path.sep) || f.startsWith('.skills/')
  );
  if (skillFiles.length > 0) {
    const skillDirs = [...new Set(skillFiles.map(f => f.split(/[/\\]/)[1]))].filter(Boolean);
    console.log(`✓ 已打包 Skills 文档 (${skillFiles.length} 个文件, 共 ${skillDirs.length} 个 Skill): ${skillDirs.join(', ')}`);
  }
  console.log(`开发者公钥指纹: ${crypto.createHash('sha256').update(publicKeyPem).digest('hex').substring(0, 16)}...`);
  return outputPath;
}

// 凭证配置文件保存路径
function getAuthConfigPath() {
  return path.join(os.homedir(), '.berrytrace', 'auth.json');
}

// 网页回调登录关联
function loginDeveloper() {
  const server = http.createServer((req, res) => {
    // 处理跨域预检请求 (CORS Preflight)
    if (req.method === 'OPTIONS') {
      res.writeHead(200, {
        'Access-Control-Allow-Origin': '*',
        'Access-Control-Allow-Methods': 'POST, OPTIONS',
        'Access-Control-Allow-Headers': 'Content-Type'
      });
      res.end();
      return;
    }

    if (req.url === '/callback' && req.method === 'POST') {
      let body = '';
      req.on('data', chunk => {
        body += chunk.toString();
      });
      req.on('end', () => {
        try {
          const authData = JSON.parse(body);
          if (!authData.token) {
            throw new Error('鉴权数据中缺少 token 字段');
          }

          // 保存登录凭证
          const configPath = getAuthConfigPath();
          fs.mkdirSync(path.dirname(configPath), { recursive: true });
          fs.writeFileSync(configPath, JSON.stringify(authData, null, 2), 'utf8');

          console.log(`\n✓ 登录成功！欢迎回来，${authData.username || '开发者'}。`);
          console.log(`凭证已保存至: ${configPath}`);

          // 发送 HTML 确认响应页面
          res.writeHead(200, {
            'Content-Type': 'text/html; charset=utf-8',
            'Access-Control-Allow-Origin': '*'
          });
          res.end(`
            <!DOCTYPE html>
            <html>
            <head>
              <meta charset="utf-8">
              <title>BerryTrace CLI 登录成功</title>
              <style>
                body { font-family: system-ui, sans-serif; display: flex; justify-content: center; align-items: center; height: 100vh; margin: 0; background: #0f0f11; color: #e4e4e7; }
                .card { padding: 2rem; border-radius: 12px; background: #18181b; border: 1px solid #27272a; text-align: center; max-width: 400px; }
                h1 { color: #10b981; font-size: 1.5rem; margin-bottom: 0.5rem; }
                p { color: #a1a1aa; line-height: 1.5; }
              </style>
            </head>
            <body>
              <div class="card">
                <h1>✓ 登录成功</h1>
                <p>BerryTrace CLI 已成功关联您的账号，您可以关闭此浏览器标签页并返回终端。</p>
              </div>
            </body>
            </html>
          `);

          // 销毁连接、关闭服务并退出程序
          req.connection.destroy();
          server.close(() => {
            process.exit(0);
          });

        } catch (err) {
          console.error('❌ 处理登录回调失败:', err.message);
          res.writeHead(400, { 'Content-Type': 'application/json', 'Access-Control-Allow-Origin': '*' });
          res.end(JSON.stringify({ error: err.message }));
        }
      });
    } else {
      res.writeHead(404, { 'Content-Type': 'text/plain' });
      res.end('Not Found');
    }
  });

  server.listen(0, '127.0.0.1', () => {
    const port = server.address().port;
    const loginUrl = `https://getdear.cn/login?source=cli&port=${port}`;
    console.log(`🔑 正在启动网页登录流程...`);
    console.log(`如果浏览器未自动打开，请手动访问以下链接：${loginUrl}`);
    openBrowser(loginUrl);
  });
}

// 上传并发布插件包
async function publishPlugin(packagePath) {
  const configPath = getAuthConfigPath();
  if (!fs.existsSync(configPath)) {
    console.error(`❌ 错误：请先登录。运行以下命令登录：berrytrace-cli login`);
    process.exit(1);
  }

  let authData;
  try {
    authData = JSON.parse(fs.readFileSync(configPath, 'utf8'));
  } catch (err) {
    console.error(`❌ 读取鉴权文件失败：${err.message}`);
    process.exit(1);
  }

  if (!packagePath) {
    // 自动寻找当前目录下的 .btp 文件
    const files = fs.readdirSync(process.cwd());
    const btpFiles = files.filter(f => f.endsWith('.btp'));
    if (btpFiles.length === 0) {
      console.error(`❌ 错误：当前目录下未找到 .btp 插件包。请指定包路径，或先运行：berrytrace-cli pack`);
      process.exit(1);
    } else if (btpFiles.length === 1) {
      packagePath = path.resolve(btpFiles[0]);
    } else {
      // 多个 .btp 文件时，自动选择版本号最大的
      const parseVersion = (filename) => {
        const match = filename.match(/-(\d+\.\d+\.\d+(?:[.-][\w.]+)?)\.[^.]+$/);
        return match ? match[1] : '0.0.0';
      };
      const latestFile = btpFiles.sort((a, b) => {
        const va = parseVersion(a).split(/[.-]/).map(Number);
        const vb = parseVersion(b).split(/[.-]/).map(Number);
        for (let i = 0; i < Math.max(va.length, vb.length); i++) {
          const diff = (va[i] || 0) - (vb[i] || 0);
          if (diff !== 0) return diff;
        }
        return 0;
      }).pop();
      packagePath = path.resolve(latestFile);
      console.log(`ℹ️ 发现多个 .btp 文件，自动选择最新版本: ${latestFile}`);
    }
  } else {
    packagePath = path.resolve(packagePath);
  }

  if (!fs.existsSync(packagePath)) {
    console.error(`❌ 错误：找不到安装包文件：${packagePath}`);
    process.exit(1);
  }

  console.log(`📤 正在上传安装包 ${path.basename(packagePath)}...`);

  try {
    const fileBuffer = fs.readFileSync(packagePath);
    const blob = new Blob([fileBuffer], { type: 'application/octet-stream' });
    const formData = new FormData();
    formData.append('file', blob, path.basename(packagePath));

    const response = await fetch('https://getdear.cn/api/plugins/upload', {
      method: 'POST',
      headers: {
        'Authorization': `Bearer ${authData.token}`
      },
      body: formData
    });

    if (!response.ok) {
      const errText = await response.text();
      throw new Error(`服务器响应错误 ${response.status}: ${errText}`);
    }

    const result = await response.json();
    console.log(`\n✓ 插件发布成功！`);
    console.log(`服务器返回数据:`, result);

  } catch (err) {
    console.error(`❌ 发布插件失败: ${err.message}`);
    process.exit(1);
  }
}

// 命令行主路由入口
async function main() {
  const args = process.argv.slice(2);
  const command = args[0];

  // 运行命令时自动检测更新并自动升级（一天检查一次，本地开发环境跳过）
  await checkAndUpgrade(false);

  switch (command) {
    case '-v':
    case '--version':
    case 'version': {
      console.log(`v${cliVersion}`);
      break;
    }
    case 'upgrade': {
      await checkAndUpgrade(true);
      break;
    }
    case 'create': {
      const name = args[1];
      if (!name || name.startsWith('--')) {
        console.error('❌ 请指定插件名称。例如：berrytrace-cli create my-plugin [--id <id>]');
        process.exit(1);
      }
      const idIndex = args.indexOf('--id');
      const id = idIndex !== -1 ? args[idIndex + 1] : undefined;
      await createPlugin(name, { id });
      break;
    }
    case 'build': {
      const reloadFlag = args.includes('--reload') || args.includes('-r');
      const filteredArgs = args.slice(1).filter(a => a !== '--reload' && a !== '-r');
      const pluginPath = filteredArgs[0] ? path.resolve(filteredArgs[0]) : process.cwd();
      const res = await performSdkBuild(pluginPath);
      if (!res.success) {
        process.exit(1);
      }
      if (reloadFlag || args.length === 1 || (args.length === 2 && !args[1].startsWith('-'))) {
        await notifyLocalServer(res.pluginId, pluginPath);
      }
      break;
    }
    case 'reload': {
      const pluginPath = args[1] ? path.resolve(args[1]) : process.cwd();
      let pluginId = args[1];
      const pluginJsonPath = path.join(pluginPath, 'plugin.json');
      if (fs.existsSync(pluginJsonPath)) {
        try {
          const pluginJson = JSON.parse(fs.readFileSync(pluginJsonPath, 'utf8'));
          if (pluginJson.id) pluginId = pluginJson.id;
        } catch { /* fallback */ }
      }
      if (!pluginId) {
        console.error('❌ 无法获取插件 ID，请在插件目录运行或指定插件 ID/路径');
        process.exit(1);
      }
      await notifyLocalServer(pluginId, pluginPath);
      break;
    }
    case 'logs': {
      const targetArg = args[1];
      let pluginId = undefined;
      if (targetArg && !targetArg.startsWith('--')) {
        const pluginPath = path.resolve(targetArg);
        const pluginJsonPath = path.join(pluginPath, 'plugin.json');
        if (fs.existsSync(pluginJsonPath)) {
          try {
            const pluginJson = JSON.parse(fs.readFileSync(pluginJsonPath, 'utf8'));
            if (pluginJson.id) pluginId = pluginJson.id;
          } catch {
            pluginId = targetArg;
          }
        } else {
          pluginId = targetArg;
        }
      }
      const limitArgIndex = args.indexOf('--limit');
      const limit = limitArgIndex !== -1 ? parseInt(args[limitArgIndex + 1], 10) : 50;
      await fetchLogsFromLocalServerOrFile(pluginId, limit);
      break;
    }
    case 'generate-keys': {
      generateKeys();
      break;
    }
    case 'pack': {
      const pluginPath = args[1] ? path.resolve(args[1]) : process.cwd();
      const buildSuccess = await runLocalBuild(pluginPath);
      if (buildSuccess) {
        packPlugin(pluginPath);
      } else {
        process.exit(1);
      }
      break;
    }
    case 'login': {
      loginDeveloper();
      break;
    }
    case 'pack-publish':
    case 'publish': {
      const targetPath = args[1] ? path.resolve(args[1]) : process.cwd();
      let btpPath = targetPath;

      // 如果目标是目录，自动进行构建 and 打包，然后再发布生成的 .btp 文件
      if (fs.existsSync(targetPath) && fs.statSync(targetPath).isDirectory()) {
        const buildSuccess = await runLocalBuild(targetPath);
        if (!buildSuccess) {
          process.exit(1);
        }
        btpPath = packPlugin(targetPath);
        console.log('');
      }

      await publishPlugin(btpPath);
      break;
    }
    default: {
      console.log(`莓莓印记插件 SDK 命令行工具 (BerryTrace Plugin SDK CLI) v${cliVersion}`);
      console.log('========================================================');
      console.log('使用方法:');
      console.log('  berrytrace-cli -v, --version         - 显示版本号');
      console.log('  berrytrace-cli upgrade               - 检查并自我升级到最新版本');
      console.log('  berrytrace-cli create <name>         - 初始化一个新的插件项目目录');
      console.log('  berrytrace-cli build [path] [--reload] - 使用 SDK 自动构建插件源码并通知宿主热重载');
      console.log('  berrytrace-cli reload [path|id]      - 通知宿主本地 LocalServer 热重载或加载解包插件');
      console.log('  berrytrace-cli logs [path|id] [--limit 50] - 获取宿主运行的日志（自动降级读取本地 app.log）');
      console.log('  berrytrace-cli generate-keys         - 生成用于插件签名的开发密钥对 (私钥/公钥)');
      console.log('  berrytrace-cli pack [path]           - 编译并打包为 .btp 格式安装包（自动过滤源码目录）');
      console.log('  berrytrace-cli login                 - 在浏览器中登录并获取 CLI 授权凭证');
      console.log('  berrytrace-cli publish [path]        - 编译、打包并发布插件（支持目录路径，或直接指定 .btp 文件文件）');
      process.exit(0);
    }
  }
}

main().catch(err => {
  console.error('运行时发生致命错误:', err);
  process.exit(1);
});
