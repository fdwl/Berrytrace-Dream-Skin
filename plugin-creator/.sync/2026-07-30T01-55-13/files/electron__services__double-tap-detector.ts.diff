+/**
+ * 检索当前真正【已被用户开启/有效】的物理按键手势与所需修饰键集合
+ */
+export function getActivePhysicalGestures(): { activeGestures: Set<string>; requiredModifiers: Set<string> } {
+  const activeGestures = new Set<string>()
+  const requiredModifiers = new Set<string>()
+
+  // 1. 检索 Switch 开关状态
+  const doubleTapEnabled = (cache.get(CacheAttribute.prefDoubleTapEnabled) as boolean) ?? false
+  const fnVoiceEnabled = (cache.get(CacheAttribute.prefFnVoiceEnabled) as boolean) ?? false
+  const fnShiftTranslateEnabled = (cache.get(CacheAttribute.prefFnShiftTranslateEnabled) as boolean) ?? false
+  const fnSpaceMeimeiEnabled = (cache.get(CacheAttribute.prefFnSpaceMeimeiEnabled) as boolean) ?? false
+
+  if (fnVoiceEnabled) {
+    activeGestures.add('short_press:fn')
+    activeGestures.add('long_press_start:fn')
+    activeGestures.add('long_press_end:fn')
+    requiredModifiers.add('fn')
+  }
+  if (fnSpaceMeimeiEnabled) {
+    activeGestures.add('combo:fn+space')
+    requiredModifiers.add('fn')
+  }
+  if (fnShiftTranslateEnabled) {
+    activeGestures.add('combo:shift+fn')
+    requiredModifiers.add('fn')
+  }
+  if (doubleTapEnabled) {
+    const mod = (cache.get(CacheAttribute.prefDoubleTapModifier) as string) || DEFAULT_DOUBLE_TAP_MODIFIER_FALLBACK
+    activeGestures.add(`double_tap:${mod}`)
+    requiredModifiers.add(mod)
+  }
+
+  // 2. 检索 KeybindingsManager 中的有效规则（排除已被禁用的规则）
+  try {
+    const effectiveRules = KeybindingsManager.getInstance().getEffectiveKeybindings()
+    for (const rule of effectiveRules) {
+      if (rule.gesture && rule.gesture.trim().length > 0) {
+        const gesture = rule.gesture.trim()
+        activeGestures.add(gesture)
+        if (gesture.includes('fn')) requiredModifiers.add('fn')
+        if (gesture.includes('cmd')) requiredModifiers.add('cmd')
+        if (gesture.includes('alt')) requiredModifiers.add('alt')
+        if (gesture.includes('ctrl')) requiredModifiers.add('ctrl')
+        if (gesture.includes('shift')) requiredModifiers.add('shift')
+      }
+    }
+  } catch (_e) {
+    /* ignore error retrieving effective keybindings */
+  }
+
+  return { activeGestures, requiredModifiers }
+}
