+  /**
+   * 获取所有已注册的 AI 服务商及其模型列表。
+   */
+  async ai_getAiServers(): Promise<unknown> {
+    const mainWindow = ElectronMainWindow.getInstance().getWindow();
+    if (mainWindow && !mainWindow.isDestroyed()) {
+      try {
+        const serversJson = await mainWindow.webContents.executeJavaScript(`localStorage.getItem('agent-ai-servers')`);
+        if (serversJson) {
+          const parsed = JSON.parse(serversJson);
+          cache.set(CacheAttribute.agentAiServers, parsed); // 回写 cache
+          return parsed;
+        }
+      } catch (err) {
+        console.warn('[AiController] Failed to retrieve AI servers from main window:', err);
+      }
+    }
+    // voice-only fallback
+    const cached = cache.get(CacheAttribute.agentAiServers);
+    if (cached) return cached;
+    return [];
+  }
+
+  /**
+   * 获取按能力分配的服务商与模型映射（供 cline-agent 等插件读取当前 capability→{serverId, model} 配置）
+   */
+  async ai_getCapabilityModels(): Promise<unknown> {
+    const mainWindow = ElectronMainWindow.getInstance().getWindow();
+    if (mainWindow && !mainWindow.isDestroyed()) {
+      try {
+        // capability 映射存储在 agentStore 的 capabilityModels 字段，通过 localStorage 的 agent-store 读取
+        const storeJson = await mainWindow.webContents.executeJavaScript(`localStorage.getItem('agent-store')`);
+        if (storeJson) {
+          const state = JSON.parse(storeJson);
+          const models = state?.state?.capabilityModels || {};
+          cache.set(CacheAttribute.agentCapabilityModels, models); // 回写 cache
+          return models;
+        }
+      } catch (err) {
+        console.warn('[AiController] Failed to retrieve capability models:', err);
+      }
+    }
+    // voice-only fallback
+    const cached = cache.get(CacheAttribute.agentCapabilityModels);
+    if (cached) return cached;
+    return {};
+  }
+
+  async ai_getServerLlmConfig(options: string | { serverId: string }): Promise<unknown> {
+    const serverId = typeof options === 'string' ? options : options?.serverId;
+    if (!serverId) throw new Error('serverId parameter is required');
+
+    // 优先从主窗口读，fallback 到 cache（voice-only 模式）
+    let aiServersRaw: any[] | null = null;
+    const mainWindow = ElectronMainWindow.getInstance().getWindow();
+    if (mainWindow && !mainWindow.isDestroyed()) {
+      try {
+        const serversJson = await mainWindow.webContents.executeJavaScript(`localStorage.getItem('agent-ai-servers')`);
+        if (serversJson) {
+          const parsed = JSON.parse(serversJson);
+          if (Array.isArray(parsed)) {
+            aiServersRaw = parsed;
+            cache.set(CacheAttribute.agentAiServers, parsed);
+          }
+        }
+      } catch (err) {
+        console.warn('[AiController] Failed to retrieve server config from main window:', err);
+      }
+    } else {
+      const cached = cache.get(CacheAttribute.agentAiServers) as any[] | undefined;
+      if (Array.isArray(cached)) aiServersRaw = cached;
+    }
+
+    if (aiServersRaw) {
+      const server = aiServersRaw.find((s: any) => s.id === serverId || s.provider === serverId);
+      if (server) {
+        const { ElectronAuthManager } = await import('../../services/auth-manager');
+        const userToken = ElectronAuthManager.getInstance().getToken() || undefined;
+        return {
+          provider: server.provider,
+          model: server.model,
+          apiKey: server.provider === 'berrytrace' ? userToken : (server.apiKey || undefined),
+          baseUrl: server.baseUrl || (server.provider === 'berrytrace' ? 'https://ai.getdear.cn/v1' : undefined),
+        };
+      }
+    }
+    // Fallback to active default config
+    return this.retrieveLlmConfig();
+  }
+
+  /**
+   * 获取渲染进程中的 Voice Settings
+   */
+  async ai_getVoiceSettings(): Promise<unknown> {
+    const mainWindow = ElectronMainWindow.getInstance().getWindow();
+    if (mainWindow && !mainWindow.isDestroyed()) {
+      try {
+        const settingsJson = await mainWindow.webContents.executeJavaScript(`localStorage.getItem('berrytrace-voice-settings')`);
+        if (settingsJson) {
+          const parsed = JSON.parse(settingsJson);
+          const settings = parsed?.state?.settings || {};
+          // voice-only 模式下，voice-agents 插件自身持有 settings，无需 cache 兜底
+          return settings;
+        }
+      } catch (err) {
+        console.warn('[AiController] Failed to retrieve voice settings from main window:', err);
+      }
+    }
+    // voice-only 模式：voice settings 由 voice-agents 插件直接管理，返回空让插件侧处理
+    return {};
+  }
