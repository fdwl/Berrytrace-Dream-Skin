+// ── IPC: 渲染进程主动推送 AI 配置到主进程 cache（voice-only 模式保障）──
+// 在模块首次加载时注册（幂等：检查避免重复注册）
+let _aiConfigSyncRegistered = false;
+export function registerAiConfigSyncIpc(): void {
+  if (_aiConfigSyncRegistered) return;
+  _aiConfigSyncRegistered = true;
+  ipcMain.on('ai:sync-config-to-main', (_event, payload: {
+    llmConfig?: { provider: string; model: string; apiKey?: string; baseUrl?: string };
+    aiServers?: unknown[];
+    capabilityModels?: Record<string, unknown>;
+    voiceSettings?: Record<string, unknown>;
+  }) => {
+    try {
+      if (payload.llmConfig) cache.set(CacheAttribute.agentLlmConfig, payload.llmConfig);
+      if (payload.aiServers) cache.set(CacheAttribute.agentAiServers, payload.aiServers);
+      if (payload.capabilityModels) cache.set(CacheAttribute.agentCapabilityModels, payload.capabilityModels);
+      console.log('[AiController:sync] AI config synced to main process cache from renderer');
+    } catch (err) {
+      console.error('[AiController:sync] Failed to sync AI config to main cache:', err);
+    }
+  });
+}
 
