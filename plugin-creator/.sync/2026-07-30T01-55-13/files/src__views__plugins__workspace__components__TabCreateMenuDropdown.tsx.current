import React, { useEffect, useMemo, useRef, useState } from 'react';
import { Search, FileText, Terminal, Globe, Server, Bot, Plus, FileCode } from 'lucide-react';
import { useTabCreateMenuStore, type TabCreateMenuItem } from '../../../../stores/tabCreateMenuStore';
import { useWorkspaceStore } from '../../../../stores/workspace';

interface TabCreateMenuDropdownProps {
  x: number;
  y: number;
  onClose: () => void;
  tabsetId?: string;
}

export const TabCreateMenuDropdown: React.FC<TabCreateMenuDropdownProps> = ({
  x,
  y,
  onClose,
  tabsetId,
}) => {
  const [query, setQuery] = useState('');
  const [selectedIndex, setSelectedIndex] = useState(0);
  const inputRef = useRef<HTMLInputElement>(null);
  const containerRef = useRef<HTMLDivElement>(null);

  const itemsMap = useTabCreateMenuStore((state) => state.items);

  const registeredItems = useMemo(() => {
    return Object.values(itemsMap).filter((item) => item.enabled !== false);
  }, [itemsMap]);

  // 1. 系统默认的加号菜单基础选项
  const defaultSystemItems: TabCreateMenuItem[] = useMemo(() => [
    {
      id: 'system.new-md',
      pluginId: 'system',
      label: '新建 MD 文档',
      description: '创建并打开空白 Markdown 文件',
      category: 'system',
      iconName: 'FileCode',
      order: 1,
      onSelect: () => {
        useWorkspaceStore.getState().createMarkdownTab();
      },
    },
    {
      id: 'system.blank',
      pluginId: 'system',
      label: '空白标签页',
      description: '新建一个空白文件视图',
      category: 'system',
      iconName: 'FileText',
      order: 2,
      onSelect: () => {
        const sessionId = `blank_${Date.now()}`;
        useWorkspaceStore.getState().openWorkspaceTab(
          undefined,
          'system.workspace-blank',
          undefined,
          undefined,
          sessionId
        );
      },
    },
    {
      id: 'system.terminal',
      pluginId: 'system',
      label: '系统终端',
      description: '打开控制台 Bash/Zsh 终端',
      category: 'system',
      iconName: 'Terminal',
      order: 3,
      onSelect: () => {
        const sessionId = `terminal_${Date.now()}`;
        useWorkspaceStore.getState().openWorkspaceTab(
          undefined,
          'system.terminal',
          undefined,
          undefined,
          sessionId,
          false,
          '终端'
        );
      },
    },
    {
      id: 'system.browser',
      pluginId: 'system',
      label: '内置浏览器',
      description: '打开内置网页浏览器',
      category: 'system',
      iconName: 'Globe',
      order: 4,
      onSelect: () => {
        const sessionId = `browser_${Date.now()}`;
        useWorkspaceStore.getState().openWorkspaceTab(
          undefined,
          'system.browser',
          undefined,
          undefined,
          sessionId,
          false,
          '浏览器'
        );
      },
    },
  ], []);

  // 合并系统基础项与动态注册项（去重）
  const allItems = useMemo(() => {
    const map = new Map<string, TabCreateMenuItem>();
    defaultSystemItems.forEach((item) => map.set(item.id, item));
    registeredItems.forEach((item) => {
      if (item.enabled !== false) {
        map.set(item.id, item);
      }
    });
    return Array.from(map.values()).sort((a, b) => (a.order ?? 100) - (b.order ?? 100));
  }, [defaultSystemItems, registeredItems]);

  // 匹配与过滤选项
  const filteredItems = useMemo(() => {
    const q = query.trim().toLowerCase();
    if (!q) return allItems;
    return allItems.filter((item) => {
      const matchLabel = item.label.toLowerCase().includes(q);
      const matchDesc = item.description?.toLowerCase().includes(q);
      const matchKw = item.keywords?.some((k) => k.toLowerCase().includes(q));
      return matchLabel || matchDesc || matchKw;
    });
  }, [allItems, query]);

  // 自动获取焦点
  useEffect(() => {
    const timer = requestAnimationFrame(() => {
      inputRef.current?.focus();
    });
    return () => cancelAnimationFrame(timer);
  }, []);

  // 选中的索引边界修正
  useEffect(() => {
    setSelectedIndex(0);
  }, [query]);

  // 按键事件处理
  const handleKeyDown = (e: React.KeyboardEvent) => {
    if (e.key === 'ArrowDown') {
      e.preventDefault();
      setSelectedIndex((prev) => (filteredItems.length > 0 ? (prev + 1) % filteredItems.length : 0));
    } else if (e.key === 'ArrowUp') {
      e.preventDefault();
      setSelectedIndex((prev) => (filteredItems.length > 0 ? (prev - 1 + filteredItems.length) % filteredItems.length : 0));
    } else if (e.key === 'Enter') {
      e.preventDefault();
      const selected = filteredItems[selectedIndex];
      if (selected) {
        void selected.onSelect({ tabsetId });
        onClose();
      }
    } else if (e.key === 'Escape') {
      e.preventDefault();
      onClose();
    }
  };

  // 渲染项图标
  const renderItemIcon = (item: TabCreateMenuItem) => {
    if (item.iconName === 'Server' || item.category === 'ssh') {
      return <Server className="w-4 h-4 text-blue-400 shrink-0" />;
    }
    if (item.iconName === 'Bot' || item.category === 'agent') {
      return <Bot className="w-4 h-4 text-emerald-400 shrink-0" />;
    }
    if (item.iconName === 'FileCode') {
      return <FileCode className="w-4 h-4 text-purple-400 shrink-0" />;
    }
    if (item.iconName === 'Terminal') {
      return <Terminal className="w-4 h-4 text-yellow-400 shrink-0" />;
    }
    if (item.iconName === 'Globe') {
      return <Globe className="w-4 h-4 text-sky-400 shrink-0" />;
    }
    return <FileText className="w-4 h-4 text-gray-400 shrink-0" />;
  };

  // 分组呈现
  const groupedItems = useMemo(() => {
    const groups: { title: string; category: string; items: TabCreateMenuItem[] }[] = [
      { title: '系统快捷', category: 'system', items: [] },
      { title: 'SSH 远程主机', category: 'ssh', items: [] },
      { title: 'AI 智能体 / CLI', category: 'agent', items: [] },
      { title: '其他扩展', category: 'other', items: [] },
    ];

    filteredItems.forEach((item) => {
      if (item.category === 'system') {
        groups[0].items.push(item);
      } else if (item.category === 'ssh') {
        groups[1].items.push(item);
      } else if (item.category === 'agent') {
        groups[2].items.push(item);
      } else {
        groups[3].items.push(item);
      }
    });

    return groups.filter((g) => g.items.length > 0);
  }, [filteredItems]);

  // 计算展平数组中各项的实际下标
  let currentIndexTracker = 0;

  return (
    <div
      ref={containerRef}
      className="fixed flex flex-col rounded-xl border border-border shadow-2xl backdrop-blur-md no-drag select-none z-[10000] overflow-hidden bg-popover text-popover-foreground"
      style={{
        top: y,
        left: Math.min(x, window.innerWidth - 320),
        width: '300px',
        maxHeight: '440px',
      }}
      onClick={(e) => e.stopPropagation()}
    >
      {/* 顶部搜索框 */}
      <div className="p-2 border-b border-border/60 flex items-center gap-2 bg-muted/20">
        <Search className="w-4 h-4 text-muted-foreground ml-1 shrink-0" />
        <input
          ref={inputRef}
          type="text"
          value={query}
          onChange={(e) => setQuery(e.target.value)}
          onKeyDown={handleKeyDown}
          placeholder="搜索命令、主机、智能体..."
          className="w-full bg-transparent border-none text-xs text-foreground placeholder:text-muted-foreground outline-none py-1"
        />
      </div>

      {/* 滚动菜单列表 */}
      <div className="flex-1 overflow-y-auto p-1.5 space-y-2 max-h-[380px]">
        {filteredItems.length === 0 ? (
          <div className="py-6 text-center text-xs text-muted-foreground">
            未找到相关项
          </div>
        ) : (
          groupedItems.map((group) => (
            <div key={group.category} className="space-y-0.5">
              <div className="px-2.5 py-1 text-overline font-semibold text-muted-foreground uppercase tracking-wider">
                {group.title}
              </div>
              {group.items.map((item) => {
                const itemIndex = currentIndexTracker++;
                const isSelected = itemIndex === selectedIndex;
                return (
                  <div
                    key={item.id}
                    className={`flex items-center gap-2.5 px-2.5 py-1.5 rounded-lg cursor-pointer transition-colors duration-150 text-xs ${
                      isSelected
                        ? 'bg-accent text-accent-foreground font-medium'
                        : 'text-foreground/80 hover:bg-accent/60 hover:text-foreground'
                    }`}
                    onMouseEnter={() => setSelectedIndex(itemIndex)}
                    onClick={() => {
                      void item.onSelect({ tabsetId });
                      onClose();
                    }}
                  >
                    {renderItemIcon(item)}
                    <div className="flex flex-col min-w-0 flex-1">
                      <span className="truncate font-medium">{item.label}</span>
                      {item.description && (
                        <span
                          className={`truncate text-[10px] ${
                            isSelected ? 'text-accent-foreground/70' : 'text-muted-foreground'
                          }`}
                        >
                          {item.description}
                        </span>
                      )}
                    </div>
                  </div>
                );
              })}
            </div>
          ))
        )}
      </div>
    </div>
  );
};
