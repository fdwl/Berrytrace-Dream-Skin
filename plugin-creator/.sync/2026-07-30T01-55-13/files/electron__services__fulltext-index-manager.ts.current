import { BrowserWindow, powerMonitor, ipcMain, app } from 'electron'
import { join, extname, relative, basename } from 'path'
import * as fs from 'fs'
import os from 'os'
import { DatabaseManager } from './db-manager.js'
import eventBus from '../../src/services/event_bus';
import { WORKSPACE_DIR_NAME } from '../../src/config/constants.js'
import { LocalAIService } from './local-ai-service.js'
import { VectorSearchEngine } from './vector-search-engine.js'
import { FtsHybridSearcher } from './fts-hybrid-searcher.js'
import { DocumentLinkService } from './document-link-service.js'

// 模块化导入（符合 800 行限制规范）
import { QueryParser } from './fulltext-query-parser.js'
import { QueryCache } from './fulltext-cache.js'
import {
  extractFileContent,
  getSupportedExts,
} from './fulltext-file-parsers.js'
import { SKILLS_DIR, PLUGINS_DIR, FULLTEXT_CONFIG } from '../config/paths'

export interface IndexProgress {
  status: 'idle' | 'pending' | 'building' | 'paused' | 'error' | 'done'
  percent: number
  indexedCount: number
  totalCount: number
  estimatedRemainingMs: number
  noteIndexCount?: number
  fileIndexCount?: number
  dbSize?: number
}

interface NoteSearchResult {
  note_id: number
  title: string
  snip: string
  rank: number
}

interface FileSearchResult {
  file_path: string
  file_name: string
  snip: string
  rank: number
  line_number?: number
  score?: number
}

/** 全文索引中存储的工具条目 */
interface IndexedTool {
  name: string
  description?: string
  displayName?: string
  category?: string
  package?: string
  pluginId?: string
  cliName?: string
  type?: string
  downloadUrls?: Record<string, string>
  inputSchema?: { properties?: Record<string, { description?: string }> }
  isDynamic?: boolean
  userQueries?: string[]
  filePath?: string
}

/** 全文索引中存储的 Skill 元信息 */
interface IndexedSkillMeta {
  dir: string
  name: string
  mdPath: string
  mtimeMs: number
  modifiedAt?: number
}

// 缓存实例（模块级，单例共享）
const noteSearchCache = new QueryCache()
const fileSearchCache = new QueryCache()

/**
 * 全文索引管理器（主类）
 * 已模块化拆分：QueryParser / QueryCache / Notification / FileParsers 均在独立文件
 *
 * 性能优化：使用 Worker 线程处理 CPU 密集任务
 */
export class FullTextIndexManager {
  private static instance: FullTextIndexManager

  // 索引任务状态
  private status: IndexProgress['status'] = 'idle'
  private totalNotes = 0
  private indexedNotes = 0
  private startTime = 0
  private isRebuilding = false
  private startupIndexCheckDone = false

  // Counts & DB size cache for buildProgress (5-second TTL)
  private cachedNoteIndexCount = 0
  private cachedFileIndexCount = 0
  private cachedDbSize = 0
  private lastCountsQueryTime = 0

  // Known workspace paths for buildProgress() queries (populated during indexing)
  private knownWorkspacePaths: Set<string> = new Set()

  // 暂停/恢复控制
  private pauseRequested = false
  private resumeResolve: (() => void) | null = null

  // 资源监控
  private monitorInterval: NodeJS.Timeout | null = null
  private schedulingInterval: NodeJS.Timeout | null = null
  private watcher: { close: () => Promise<void> } | null = null
  private lastCpuPercent = 0
  private isUserActive = false

  // Worker 线程（懒加载）
  private worker: import('worker_threads').Worker | null = null

  public clearCountsCache(): void {
    this.lastCountsQueryTime = 0
  }

  private constructor() {
    this.startResourceMonitor()
    this.startScheduler()

    // 延迟扫描 / 闲时扫描：避免启动时抢占资源，等待系统空闲再触发索引检查
    this.scheduleIdleStartupIndexCheck()

    // 监听文件变化事件（用于增量索引）
    this.setupFileChangeWatcher()

    // 监听插件安装/卸载事件 → 防抖重建全文索引
    eventBus.on('plugin:changed', () => {
      if (this.pluginReindexTimer) clearTimeout(this.pluginReindexTimer);
      this.pluginReindexTimer = setTimeout(() => {
        this.pluginReindexTimer = null;
        console.log('[FullTextIndex] Plugin changed, rebuilding tools and skills index...');
        this.indexToolsLibrary([]).catch(err => console.warn('[FullTextIndex] plugin:changed reindex tools failed:', err));
        this.indexAllSkills().catch(err => console.warn('[FullTextIndex] plugin:changed reindex skills failed:', err));
      }, 2000);
    });

    // 监听本地 AI 服务就绪事件，就绪后对没有向量的项（如 skills / tools / 笔记 / 文件）重新进行向量化
    const localAI = LocalAIService.getInstance()
    const onLocalAiReady = () => {
      if (!this.startupIndexCheckDone) {
        console.log('[FullTextIndex] Local AI service is ready, but startup index check has not run yet. Postponing reindex to idle startup task.')
        return
      }
      console.log('[FullTextIndex] Local AI service became ready after startup. Triggering background vector reindex...')
      this.triggerVectorReindex()
      this.indexAllSkills().catch(err => {
        console.error('[FullTextIndex] Failed to rebuild skills index on Local AI ready:', err)
      })
      this.indexToolsLibrary([]).catch(err => {
        console.error('[FullTextIndex] Failed to rebuild tools index on Local AI ready:', err)
      })
    }

    if (localAI.isWorkerRunning()) {
      console.log('[FullTextIndex] Local AI service is already running. Rebuilding index...')
      onLocalAiReady()
    } else {
      localAI.on('ready', onLocalAiReady)
    }
  }

  /**
   * 安排闲时启动索引检查
   * 避免启动时抢占资源，等待系统闲置 5 秒后在后台执行。
   */
  private scheduleIdleStartupIndexCheck(): void {
    let checkCount = 0
    const checkInterval = setInterval(() => {
      checkCount++
      try {
        const idleTime = powerMonitor.getSystemIdleTime()
        // Wait at least 10 seconds (5 checks) and system idle >= 5s, OR force run after 20 seconds (10 checks)
        if ((checkCount >= 5 && idleTime >= 5) || checkCount >= 10) {
          clearInterval(checkInterval)
          console.log(`[FullTextIndex] Startup check triggered (checkCount=${checkCount}, idleTime=${idleTime}s), starting background index check...`)
          this.checkAndBuildIndexOnStartup().catch(err => {
            console.error('[FullTextIndex] Idle startup index check failed:', err)
          })
        }
      } catch (_e) {
        // Fallback: 如果系统不支持 powerMonitor，30 秒后自动执行
        clearInterval(checkInterval)
        setTimeout(() => {
          this.checkAndBuildIndexOnStartup()
        }, 30000)
      }
    }, 2000)
  }

  // ==================== 增量索引防抖机制 ====================
  private incrementalUpdateTimer: NodeJS.Timeout | null = null
  private pendingUpdates: Map<string, string[]> = new Map() // workspacePath -> changedFiles
  private pluginReindexTimer: NodeJS.Timeout | null = null
  private readonly DEBOUNCE_DELAY_MS = 60000 // 1 分钟防抖

  /**
   * 设置文件变化监听器
   * 监听 workspace:content-changed 事件，实现增量索引更新
   */
  private setupFileChangeWatcher(): void {
    // 监听来自 workspace-manager 的文件变化通知
    ipcMain.on('workspace:content-changed', (_event, payload) => {
      const { workspacePath, changedFiles } = payload as { workspacePath: string; changedFiles: string[] }

      if (!changedFiles || changedFiles.length === 0) return

      console.log(`[FullTextIndex] Received file changes: ${changedFiles.length} files in ${workspacePath}`)

      // If any of the changed files is a workflow file, trigger reindexing of tools library
      const hasWorkflowChange = changedFiles.some(f => f.endsWith('.workflow'));
      if (hasWorkflowChange) {
        console.log(`[FullTextIndex] Workflow file change detected in ${workspacePath}, triggering tools reindexing...`);
        this.indexToolsLibrary([], workspacePath).catch(err => {
          console.warn('[FullTextIndex] Failed to reindex tools after workflow file change:', err);
        });
      }

      // 收集待更新的文件
      if (!this.pendingUpdates.has(workspacePath)) {
        this.pendingUpdates.set(workspacePath, [])
      }
      const pending = this.pendingUpdates.get(workspacePath)!
      pending.push(...changedFiles)

      // 重置防抖计时器
      this.resetIncrementalUpdateTimer()
    })

    console.log('[FullTextIndex] File change watcher set up')
  }

  /**
   * 重置增量更新计时器（防抖）
   */
  private resetIncrementalUpdateTimer(): void {
    if (this.incrementalUpdateTimer) {
      clearTimeout(this.incrementalUpdateTimer)
    }

    this.incrementalUpdateTimer = setTimeout(() => {
      // 检查系统资源
      if (this.isUserActive || this.lastCpuPercent > 80) {
        console.log(`[FullTextIndex] Skipping incremental update due to resource constraints (CPU: ${this.lastCpuPercent}%, UserActive: ${this.isUserActive})`)
        // 资源不足，延长防抖时间（再等 1 分钟）
        this.resetIncrementalUpdateTimer()
        return
      }

      // 执行增量更新
      this.processPendingUpdates().catch((err) => {
        console.error('[FullTextIndex] Incremental index update failed:', err)
      })
    }, this.DEBOUNCE_DELAY_MS)
  }

  /**
   * 处理待更新的文件（防抖到期后执行）
   */
  private async processPendingUpdates(): Promise<void> {
    if (this.pendingUpdates.size === 0) return

    console.log(`[FullTextIndex] Processing incremental updates for ${this.pendingUpdates.size} workspace(s)`)

    for (const [workspacePath, changedFiles] of this.pendingUpdates) {
      // 去重
      const uniqueFiles = [...new Set(changedFiles)]

      // 分离删除和更新的文件
      const deletedFiles: string[] = []
      const updatedFiles: string[] = []

      for (const filePath of uniqueFiles) {
        if (!fs.existsSync(filePath)) {
          deletedFiles.push(filePath)
        } else {
          updatedFiles.push(filePath)
        }
      }

      // 立即处理删除（不需要防抖）
      if (deletedFiles.length > 0) {
        await this.updateFileIndexIncremental(workspacePath, deletedFiles, true)
      }

      // 延迟处理更新（防抖已在此方法外处理）
      if (updatedFiles.length > 0) {
        await this.updateFileIndexIncremental(workspacePath, updatedFiles, false)
      }
    }

    // 清空待更新列表
    this.pendingUpdates.clear()
  }

  /**
   * 增量更新文件索引
   * @param workspacePath 工作区路径
   * @param changedFiles 变化的文件列表
   * @param isDeletion 是否为删除操作（删除立即执行，不受防抖影响）
   * @param force 是否强制执行（忽略资源检查，用于启动时）
   */
  // 文件数量阈值（超过此值禁止索引）
  private static readonly MAX_FILES_FOR_INDEXING = 50000;

  /**
   * 检查文件是否应该被索引（过滤 . 开头的文件/目录）
   */
  private shouldIndexFile(filePath: string, workspacePath: string): boolean {
    const relativePath = relative(workspacePath, filePath);
    const parts = relativePath.split('/');

    // 检查路径的任何部分是否以 . 开头
    for (const part of parts) {
      if (part.startsWith('.') && part !== '.qoder') {
        return false;
      }
    }

    return true;
  }

  private async updateFileIndexIncremental(workspacePath: string, changedFiles: string[], isDeletion: boolean = false, force: boolean = false): Promise<void> {
    // 检查系统资源（删除操作除外，force 模式除外）
    if (!isDeletion && !force && (this.isUserActive || this.lastCpuPercent > 80)) {
      console.log(`[FullTextIndex] Skipping incremental update due to resource constraints (CPU: ${this.lastCpuPercent}%, UserActive: ${this.isUserActive}), will retry later`)
      return
    }

    // 检查工作区文件总数（防止意外索引大目录）：复用 ripgrep 枚举，尊重 .gitignore，避免全量 readdir
    try {
      const { RipgrepService } = await import('./ripgrep-service.js')
      const allFiles = await RipgrepService.getInstance().getFilesList(workspacePath)
      const fileCount = allFiles.length

      if (fileCount > FullTextIndexManager.MAX_FILES_FOR_INDEXING) {
        console.warn(`[FullTextIndex] Workspace has ${fileCount} files, exceeding threshold (${FullTextIndexManager.MAX_FILES_FOR_INDEXING}). Skipping incremental update.`);
        return;
      }
    } catch (err) {
      console.error('[FullTextIndex] Failed to check workspace size:', err);
    }

    console.log(`[FullTextIndex] Starting incremental update: ${changedFiles.length} files, force=${force}`)

    const wsDb = DatabaseManager.getInstance().getWorkspaceDB(workspacePath)
    let updatedCount = 0
    let deletedCount = 0
    let errorCount = 0

    // FTS5 虚拟表不能可靠地通过 file_path = ? 删除（因为被分词了），必须通过 rowid 删除
    const existingIndex = wsDb.prepare('SELECT rowid, file_path FROM FtsFileIndex WHERE workspace_path = ?').all(workspacePath) as {rowid: number, file_path: string}[]
    const fileToRowids = new Map<string, number[]>()
    for (const r of existingIndex) {
      if (!fileToRowids.has(r.file_path)) {
        fileToRowids.set(r.file_path, [])
      }
      fileToRowids.get(r.file_path)!.push(r.rowid)
    }

    for (const filePath of changedFiles) {
      try {
        // 过滤 . 开头的文件/目录
        if (!this.shouldIndexFile(filePath, workspacePath)) {
          console.log(`[FullTextIndex] Skipping dotfile: ${filePath}`)
          continue
        }

        const ext = extname(filePath).toLowerCase()

        // 只处理支持的文件类型
        if (!getSupportedExts().includes(ext)) {
          console.log(`[FullTextIndex] Skipping unsupported file type: ${filePath} (${ext})`)
          continue
        }

        const relativePath = relative(workspacePath, filePath)
        const oldRowids = fileToRowids.get(relativePath) || fileToRowids.get(filePath) || []

        // 检查文件是否存在
        if (!fs.existsSync(filePath)) {
          // 文件被删除，从索引中移除
          if (oldRowids.length > 0) {
            const stmt = wsDb.prepare('DELETE FROM FtsFileIndex WHERE rowid = ?')
            for (const oldRowid of oldRowids) {
              stmt.run(oldRowid)
            }
            console.log(`[FullTextIndex] Removed from index (file deleted): ${relativePath}`)
            deletedCount++
          }
          continue
        }

        // 先删除旧索引，防止由于提取内容失败或后续步骤导致的重复/老数据残留
        if (oldRowids.length > 0) {
          const stmt = wsDb.prepare('DELETE FROM FtsFileIndex WHERE rowid = ?')
          for (const oldRowid of oldRowids) {
            stmt.run(oldRowid)
          }
        }

        // 文件被修改或新增，更新索引
        console.log(`[FullTextIndex] Extracting content from: ${filePath}`)

        let mtime = new Date().toISOString()
        try {
          const stats = fs.statSync(filePath)
          mtime = stats.mtime.toISOString()
        } catch (e) {
          console.warn(`[FullTextIndex] Failed to get stats for ${filePath}:`, e)
        }

        let content = ''
        try {
          content = await extractFileContent(filePath, ext)
        } catch (err) {
          console.error(`[FullTextIndex] Failed to extract content for ${filePath}:`, err)
        }

        if (!content) {
          console.warn(`[FullTextIndex] Empty content extracted or failed to extract content: ${filePath}`)
        }

        // 截断存入 FTS5 数据库的文本上限，防止巨型文档膨胀内存与数据库
        const maxChars = FULLTEXT_CONFIG.FTS_MAX_CHARS
        const indexContent = (content && content.length > maxChars) ? content.slice(0, maxChars) : (content || '')
        const fileName = basename(filePath)

        // 插入新索引 (存储 relativePath 并且 file_type 去除点前缀)
        wsDb.prepare(`
          INSERT INTO FtsFileIndex (file_path, file_name, content, file_type, workspace_path, modified_at)
          VALUES (?, ?, ?, ?, ?, ?)
        `).run(relativePath, fileName, indexContent, ext.slice(1), workspacePath, mtime)

        console.log(`[FullTextIndex] Updated index (incremental): ${relativePath} (${content?.length || 0} chars)`)
        updatedCount++

        // 礼让 Electron 主线程事件循环，防止连续大文件处理导致 UI 卡顿
        await new Promise(resolve => setTimeout(resolve, FULLTEXT_CONFIG.YIELD_INTERVAL_MS))
      } catch (err) {
        console.error(`[FullTextIndex] Failed to update index for ${filePath}:`, err)
        errorCount++
      }
    }

    console.log(`[FullTextIndex] Incremental update complete: ${updatedCount} updated, ${deletedCount} deleted, ${errorCount} errors`)

    if (updatedCount > 0 || deletedCount > 0) {
      console.log(`[FullTextIndex] Incremental update complete: ${updatedCount} files updated, ${deletedCount} deleted`)
      // 清除缓存
      this.clearCountsCache()
      fileSearchCache.clear()
    }
  }

  public static getInstance(): FullTextIndexManager {
    if (!FullTextIndexManager.instance) {
      FullTextIndexManager.instance = new FullTextIndexManager()
    }
    return FullTextIndexManager.instance
  }

  // ==================== 文件解析（异步） ====================
  // 注意：Worker 线程已移除，改用异步处理
  // 原因：Worker 文件路径在编译后难以解析（code splitting 导致文件名哈希化）
  // 文件解析本身是 I/O 密集型任务，异步处理已足够

  /**
   * 异步解析文件内容（大文件分级索引策略）
   * - 普通文件 (<= FULLTEXT_CONFIG.LARGE_FILE_THRESHOLD): 提取全量文本内容
   * - 大型文档 (> 10MB 且 <= 300MB): 不提取数百兆全量原始文本，而是提炼【目录大纲+结构摘要】存入 FTS5 索引
   * - 超大二进制 (> 300MB): 跳过文本索引
   */
  private async extractFileContentAsync(filePath: string, ext: string): Promise<string> {
    try {
      let fileSize = 0
      try {
        const stats = await fs.promises.stat(filePath)
        fileSize = stats.size
      } catch (err) {
        console.warn(`[FullTextIndex] Stat failed for ${filePath}, skipping:`, err)
        return ''
      }

      // 超大文件 (> MAX_FILE_SIZE)，跳过索引
      if (fileSize > FULLTEXT_CONFIG.MAX_FILE_SIZE) {
        console.warn(`[FullTextIndex] Skipping huge file (>${(FULLTEXT_CONFIG.MAX_FILE_SIZE / 1024 / 1024).toFixed(0)}MB): ${filePath}`)
        return ''
      }

      // 大型文档 (> LARGE_FILE_THRESHOLD 且 <= MAX_FILE_SIZE)：提炼大纲作为索引文本
      if (fileSize > FULLTEXT_CONFIG.LARGE_FILE_THRESHOLD) {
        console.log(`[FullTextIndex] Large document detected (${(fileSize / 1024 / 1024).toFixed(2)}MB), extracting outline index for: ${filePath}`)
        const { extractDocumentOutline } = await import('./fulltext-file-parsers.js')
        const outlineRes = await extractDocumentOutline(filePath)
        const outlineTitles = outlineRes.outline.map(o => `${o.title} (Page ${o.page || 1})`).join('\n')
        return `[Large Document Outline / 大文档结构大纲 - Total Pages: ${outlineRes.totalPages || 0}]\n${outlineTitles}`
      }

      return await extractFileContent(filePath, ext)
    } catch (err) {
      console.error(`[FullTextIndex] extractFileContentAsync error for ${filePath}:`, err)
      return ''
    }
  }

  // ==================== 启动与自动构建 ====================

  private async checkAndBuildIndexOnStartup(): Promise<void> {
    const startTime = performance.now()
    console.log(`[FullTextIndex] [STARTUP] Starting checkAndBuildIndexOnStartup...`)
    try {
      await DatabaseManager.getInstance().whenReady()

      // Check and migrate vector dimensions/models if needed
      await this.checkAndMigrateVectorDimensions()

      // 1. 检查文件索引（仅限当前活动/打开的工作区）
      await this.checkAndBuildFileIndexOnStartup()

      // 2. 扫描并索引所有 Agent Skills
      await this.indexAllSkills()

      // 3. 索引所有可用 MCP 工具
      await this.indexToolsLibrary([])

      // 4. 闲置时拉取已安装应用（仅在缓存为空或超过 24 小时时刷新）
      await this.refreshInstalledAppsIfNeeded()
    } catch (err) {
      console.error('[FullTextIndex] Startup check failed:', err)
    } finally {
      this.startupIndexCheckDone = true
      console.log(`[FullTextIndex] [STARTUP] checkAndBuildIndexOnStartup finished in ${(performance.now() - startTime).toFixed(1)}ms`)
    }
  }

  private async checkAndMigrateVectorDimensions(): Promise<void> {
    try {
      const localAI = LocalAIService.getInstance()
      const activeModel = localAI.getActiveEmbeddingModel()

      // Fetch active workspaces from WorkspaceManager
      const { WorkspaceManager } = await import('./workspace-manager.js')
      const workspaceManager = WorkspaceManager.getInstance()

      const activeWorkspaces = new Set<string>()
      for (const win of BrowserWindow.getAllWindows()) {
        const wsPath = workspaceManager.getPathForWindow(win)
        if (wsPath && fs.existsSync(wsPath)) {
          activeWorkspaces.add(wsPath)
        }
      }
      const initialPath = workspaceManager.getInitialWorkspacePath()
      if (initialPath && fs.existsSync(initialPath)) {
        activeWorkspaces.add(initialPath)
      }
      const history = workspaceManager.getHistory()
      for (const entry of history) {
        if (entry.path && entry.exists && fs.existsSync(entry.path)) {
          activeWorkspaces.add(entry.path)
        }
      }

      for (const wsPath of activeWorkspaces) {
        try {
          const wsDb = DatabaseManager.getInstance().getWorkspaceDB(wsPath)
          const sample = wsDb.prepare('SELECT model_id, dimension FROM FtsVectorIndex LIMIT 1').all() as Array<{
            model_id: string
            dimension: number
          }>

          if (sample.length > 0) {
            const dbModelId = sample[0].model_id
            const dbDim = sample[0].dimension

            if (dbModelId !== activeModel.modelId || dbDim !== activeModel.dimension) {
              console.warn(`[FullTextIndex] Vector dimension/model mismatch in ${wsPath}! DB has ${dbModelId} (${dbDim}d) but active is ${activeModel.modelId} (${activeModel.dimension}d). Migrating...`)

              // Clear vectors in this workspace DB and memory cache
              wsDb.prepare('DELETE FROM FtsVectorIndex').run()
              VectorSearchEngine.getEngine(wsDb, wsPath).clear()

              // Rebuild files index
              this.rebuildFilesIndex(wsPath).catch(err => {
                console.error(`[FullTextIndex] Failed to rebuild files index for ${wsPath} during migration:`, err)
              })
            }
          }
        } catch (err) {
          console.error(`[FullTextIndex] Failed to check vector dimensions for workspace ${wsPath}:`, err)
        }
      }
    } catch (err) {
      console.error('[FullTextIndex] Failed to check and migrate vector dimensions:', err)
    }
  }

  public triggerVectorReindex(): void {
    console.log('[FullTextIndex] Triggering full vector indexing after model download...')

    // Trigger tools vector indexing
    this.indexToolsLibrary([]).catch(err => {
      console.error('[FullTextIndex] Failed to rebuild tools index in triggerVectorReindex:', err)
    })

    // Trigger files vector indexing for active workspaces
    import('./workspace-manager.js').then(({ WorkspaceManager }) => {
      const workspaceManager = WorkspaceManager.getInstance()
      const activeWorkspaces = new Set<string>()
      for (const win of BrowserWindow.getAllWindows()) {
        const wsPath = workspaceManager.getPathForWindow(win)
        if (wsPath && fs.existsSync(wsPath)) {
          activeWorkspaces.add(wsPath)
        }
      }
      const initialPath = workspaceManager.getInitialWorkspacePath()
      if (initialPath && fs.existsSync(initialPath)) {
        activeWorkspaces.add(initialPath)
      }
      for (const wsPath of activeWorkspaces) {
        this.rebuildFilesIndex(wsPath).catch(err => {
          console.error(`[FullTextIndex] Failed to rebuild files index for ${wsPath} after model download:`, err)
        })
      }
    }).catch(e => {
      console.warn('[FullTextIndex] Failed to resolve WorkspaceManager for vector reindex:', e)
    })
  }

  /**
   * 全量重建所有索引（Tools + Skills +   }

  /**
   * 检查是否需要刷新已安装应用缓存
   * 仅在 InstalledAppsCache 为空或上次更新超过 24 小时时才重新拉取
   */
  private async refreshInstalledAppsIfNeeded(): Promise<void> {
    try {
      const db = DatabaseManager.getInstance()
      await db.whenReady()
      if (!db.isReady()) return

      const rows = db.query(
        "SELECT updated_at FROM InstalledAppsCache ORDER BY updated_at DESC LIMIT 1"
      ) as { updated_at: string }[]

      const lastUpdated = rows[0]?.updated_at ? new Date(rows[0].updated_at).getTime() : 0
      const hoursSinceUpdate = (Date.now() - lastUpdated) / (1000 * 60 * 60)

      if (lastUpdated > 0 && hoursSinceUpdate < 24) {
        console.log(`[FullTextIndex] InstalledAppsCache is fresh (${hoursSinceUpdate.toFixed(1)}h ago), skipping refresh`)
        return
      }

      console.log('[FullTextIndex] InstalledAppsCache is stale or empty, refreshing in idle time...')
      await this.rebuildInstalledAppsCache()
    } catch (err) {
      console.error('[FullTextIndex] Failed to check InstalledAppsCache freshness:', err)
    }
  }

  /**
   * 在主进程中拉取系统已安装应用，写入 InstalledAppsCache 表
   * 仅在系统闲置时调用，不影响启动速度
   */
  public async rebuildInstalledAppsCache(): Promise<void> {
    try {
      console.log('[FullTextIndex] Fetching installed apps via get-installed-apps...')
      const { getInstalledApps } = await import('get-installed-apps')
      const rawApps = await getInstalledApps()

      const apps = (rawApps as Record<string, unknown>[])
        .filter((a) => !!a.appName)
        .map((a) => ({
          appName: (a.appName as string) || '',
          appPath: (a.appPath as string) || (a.kMDItemPath as string) || '',
          appIdentifier: (a.appIdentifier as string) || (a.kMDItemCFBundleIdentifier as string) || '',
          appVersion: (a.appVersion as string) || (a.kMDItemVersion as string) || '',
          updatedAt: new Date().toISOString(),
        }))

      const dbPath = DatabaseManager.getInstance().getGlobalDBPath()
      const { DatabaseWriter } = await import('./db-writer.js')

      const statements: Array<{ sql: string; params: any[] }> = [
        { sql: 'DELETE FROM InstalledAppsCache', params: [] }
      ]
      for (const app of apps) {
        statements.push({
          sql: 'INSERT INTO InstalledAppsCache (app_name, app_path, app_identifier, app_version, updated_at) VALUES (?, ?, ?, ?, ?)',
          params: [app.appName, app.appPath, app.appIdentifier, app.appVersion, app.updatedAt]
        })
      }

      await DatabaseWriter.getInstance().executeBatch(dbPath, statements)
      console.log(`[FullTextIndex] InstalledAppsCache rebuilt: ${apps.length} apps written to DB`)
    } catch (err) {
      console.error('[FullTextIndex] Failed to rebuild InstalledAppsCache:', err)
    }
  }

  /**
   * 启动时检查并构建当前活动工作区的文件索引（限制为当前活动工作区）
   */
  private async checkAndBuildFileIndexOnStartup(): Promise<void> {
    try {
      const { WorkspaceManager } = await import('./workspace-manager.js')
      const workspaceManager = WorkspaceManager.getInstance()

      // 获取所有当前活跃的工作区
      const activeWorkspaces = new Set<string>()
      for (const win of BrowserWindow.getAllWindows()) {
        const wsPath = workspaceManager.getPathForWindow(win)
        if (wsPath && fs.existsSync(wsPath)) {
          activeWorkspaces.add(wsPath)
        }
      }

      // 获取默认/初始工作区
      const initialPath = workspaceManager.getInitialWorkspacePath()
      if (initialPath && fs.existsSync(initialPath)) {
        activeWorkspaces.add(initialPath)
      }

      console.log(`[FullTextIndex] [STARTUP] Found ${activeWorkspaces.size} active workspaces for startup scanning:`, Array.from(activeWorkspaces))

      // 1. 扫描并更新活动工作区的索引
      for (const workspacePath of activeWorkspaces) {
        await this.checkAndBuildFileIndexForWorkspace(workspacePath)
      }
    } catch (err) {
      console.error('[FullTextIndex] Startup active file index check failed:', err)
    }
  }

  /**
   * 检查并增量更新指定工作区的文件索引
   */
  public async checkAndBuildFileIndexForWorkspace(workspacePath: string): Promise<void> {
    const startTime = performance.now()
    console.log(`[FullTextIndex] [SCAN] Checking file index for workspace: ${workspacePath}`)
    // Register workspace so buildProgress() can query index counts
    this.knownWorkspacePaths.add(workspacePath)
    try {
      const wsDb = DatabaseManager.getInstance().getWorkspaceDB(workspacePath)

      // 获取当前工作区中所有已索引文件的修改时间，并收集重复行
      const indexedFilesMap = new Map<string, { modified_at: string; rowid: number; allRowids: number[] }>()
      const duplicateRowidsToDelete: number[] = []
      try {
        const indexedRows = wsDb.prepare(
          'SELECT rowid, file_path, modified_at FROM FtsFileIndex WHERE workspace_path = ?'
        ).all(workspacePath) as { rowid: number; file_path: string; modified_at: string }[]
        for (const row of indexedRows) {
          const existing = indexedFilesMap.get(row.file_path)
          if (!existing) {
            indexedFilesMap.set(row.file_path, {
              modified_at: row.modified_at,
              rowid: row.rowid,
              allRowids: [row.rowid]
            })
          } else {
            existing.allRowids.push(row.rowid)
            // 保留最新修改时间以及最新行ID，重复行标记删除
            if (row.modified_at > existing.modified_at) {
              duplicateRowidsToDelete.push(existing.rowid)
              existing.rowid = row.rowid
              existing.modified_at = row.modified_at
            } else {
              duplicateRowidsToDelete.push(row.rowid)
            }
          }
        }
      } catch (e) {
        console.error(`[FullTextIndex] [SCAN] Failed to query indexed files map:`, e)
      }

      // 1. 批量清理已在磁盘上删除的文件的索引以及重复行（使用事务）
      const rowidsToDelete = [...duplicateRowidsToDelete]
      for (const [filePath, fileData] of indexedFilesMap.entries()) {
        const absolutePath = filePath.startsWith('/') || filePath.includes(':')
          ? filePath
          : join(workspacePath, filePath)

        if (!fs.existsSync(absolutePath)) {
          console.log(`[FullTextIndex] [SCAN] File deleted on disk, marking for deletion: ${filePath}`)
          rowidsToDelete.push(...fileData.allRowids)
          indexedFilesMap.delete(filePath)
        }
      }

      if (rowidsToDelete.length > 0) {
        const chunkSize = 100
        let deletedCount = 0
        for (let i = 0; i < rowidsToDelete.length; i += chunkSize) {
          const batch = rowidsToDelete.slice(i, i + chunkSize)
          wsDb.prepare('BEGIN TRANSACTION').run()
          try {
            const stmt = wsDb.prepare('DELETE FROM FtsFileIndex WHERE rowid = ?')
            for (const rowid of batch) {
              stmt.run(rowid)
            }
            wsDb.prepare('COMMIT').run()
            deletedCount += batch.length
          } catch (err) {
            wsDb.prepare('ROLLBACK').run()
            console.error('[FullTextIndex] [SCAN] Failed to delete batch of stale/duplicate indices in transaction:', err)
          }
          // Yield control back to the event loop
          await new Promise<void>(resolve => setImmediate(resolve))
        }
        console.log(`[FullTextIndex] [SCAN] Batch deleted ${deletedCount} stale/duplicate files from FTS index`)
        fileSearchCache.clear()
        this.clearCountsCache()
      }

      // 2. 遍历工作区目录中的实际文件，检查是否需要更新
      const filesToUpdate: string[] = []
      let scannedCount = 0
      let skippedCount = 0
      let alreadyIndexedCount = 0

      const walkDir = async (dir: string): Promise<void> => {
        const entries = await fs.promises.readdir(dir, { withFileTypes: true })
        for (const entry of entries) {
          const fullPath = join(dir, entry.name)

          // 核心过滤：跳过隐藏文件/特定构建目录（关键优化：避免扫描 node_modules 等造成卡死）
          if (
            (entry.name.startsWith('.') && entry.name !== '.qoder') ||
            entry.name === 'node_modules' ||
            entry.name === 'dist' ||
            entry.name === 'build' ||
            entry.name === WORKSPACE_DIR_NAME
          ) {
            skippedCount++
            continue
          }

          if (entry.isDirectory()) {
            await walkDir(fullPath)
          } else if (entry.isFile()) {
            const ext = extname(fullPath).toLowerCase()

            // 只处理支持的文档/笔记类型
            if (!getSupportedExts().includes(ext)) {
              skippedCount++
              continue
            }

            scannedCount++

            const stats = await fs.promises.stat(fullPath)
            const fileModifiedAt = stats.mtime.toISOString()

            // 比较修改时间，支持相对路径和绝对路径的精确匹配
            const relativePath = relative(workspacePath, fullPath)
            const indexedData = indexedFilesMap.get(relativePath) || indexedFilesMap.get(fullPath)
            const indexedAt = indexedData?.modified_at

            if (!indexedAt) {
              console.log(`[FullTextIndex] [SCAN] File not indexed yet: ${relativePath}`)
              filesToUpdate.push(fullPath)
            } else if (fileModifiedAt > indexedAt) {
              console.log(`[FullTextIndex] [SCAN] File modified, needs re-indexing: ${relativePath}`)
              filesToUpdate.push(fullPath)
            } else {
              alreadyIndexedCount++
            }
          }
        }
      }

      await walkDir(workspacePath)
      console.log(`[FullTextIndex] [SCAN] Scan result: ${scannedCount} files matched, ${filesToUpdate.length} to update, ${alreadyIndexedCount} up-to-date, ${skippedCount} skipped`)

      // 3. 增量更新变化的文件的索引
      if (filesToUpdate.length > 0) {
        console.log(`[FullTextIndex] [SCAN] Incrementally indexing ${filesToUpdate.length} files...`)
        await this.updateFileIndexIncremental(workspacePath, filesToUpdate, false, true) // force = true
      }
    } catch (err) {
      console.error('[FullTextIndex] [SCAN] Incremental workspace check failed:', err)
    } finally {
      console.log(`[FullTextIndex] [SCAN] Workspace indexing verification finished in ${(performance.now() - startTime).toFixed(1)}ms`)
    }
  }


  // ==================== 资源监控 ====================

  private startResourceMonitor(): void {
    this.monitorInterval = setInterval(async () => {
      this.lastCpuPercent = await this.measureCpuUsage()

      try {
        const idleTime = powerMonitor.getSystemIdleTime()
        this.isUserActive = idleTime < 5
      } catch {
        this.isUserActive = false
      }
    }, 2000)
  }

  private startScheduler(): void {
    this.schedulingInterval = setInterval(() => {
      if (this.status !== 'building' && this.status !== 'paused') return

      const shouldPause = this.isUserActive || this.lastCpuPercent > 80
      const shouldResume = !this.isUserActive && this.lastCpuPercent < 64

      if (this.status === 'building' && shouldPause) {
        console.log(`[FullTextIndex] Pausing indexer. Reason: CPU=${this.lastCpuPercent}%, UserActive=${this.isUserActive}`)
        this.pauseIndexing()
      } else if (this.status === 'paused' && shouldResume) {
        console.log(`[FullTextIndex] Resuming indexer. CPU=${this.lastCpuPercent}%`)
        this.resumeIndexing()
      }
    }, 2000)
  }

  private measureCpuUsage(): Promise<number> {
    return new Promise((resolve) => {
      const startMeasure = os.cpus().map((cpu) => {
        const times = cpu.times as Record<string, number>
        const total = Object.values(times).reduce((sum, val) => sum + val, 0)
        return { idle: times.idle, total }
      })

      setTimeout(() => {
        const endMeasure = os.cpus().map((cpu) => {
          const times = cpu.times as Record<string, number>
          const total = Object.values(times).reduce((sum, val) => sum + val, 0)
          return { idle: times.idle, total }
        })

        let totalDiff = 0
        let idleDiff = 0
        for (let i = 0; i < startMeasure.length; i++) {
          totalDiff += endMeasure[i]!.total - startMeasure[i]!.total
          idleDiff += endMeasure[i]!.idle - startMeasure[i]!.idle
        }

        resolve(totalDiff === 0 ? 0 : 100 - Math.round((100 * idleDiff) / totalDiff))
      }, 200)
    })
  }

  // ==================== 暂停/恢复 ====================

  public pauseIndexing(): void {
    if (this.status !== 'building') return
    this.pauseRequested = true
    console.log('[FullTextIndex] Pause requested')
  }

  public resumeIndexing(): void {
    if (this.status !== 'paused') return
    this.pauseRequested = false
    if (this.resumeResolve) {
      console.log('[FullTextIndex] Resuming indexing...')
      this.resumeResolve()
      this.resumeResolve = null
    }
  }

  private async checkPausePoint(): Promise<void> {
    if (!this.pauseRequested) return Promise.resolve()

    this.status = 'paused'
    this.broadcastProgress()
    console.log('[FullTextIndex] Paused. Waiting for resume signal...')

    return new Promise<void>((resolve) => {
      this.resumeResolve = () => {
        this.status = 'building'
        this.broadcastProgress()
        console.log('[FullTextIndex] Resumed from checkpoint.')
        resolve()
      }

      if (!this.pauseRequested && this.resumeResolve) {
        this.resumeResolve()
        this.resumeResolve = null
      }
    })
  }

  // ==================== 进度广播 ====================

  private broadcastProgress(): void {
    const progress = this.buildProgress()
    BrowserWindow.getAllWindows().forEach((win) => {
      if (!win.isDestroyed()) {
        win.webContents.send('fulltext-index:progress', progress)
      }
    })
  }

  private buildProgress(): IndexProgress {
    const now = Date.now()
    // Refresh counts every 5s; clearCountsCache() forces immediate refresh by resetting lastCountsQueryTime to 0
    if (now - this.lastCountsQueryTime > 5000) {
      this.lastCountsQueryTime = now
      try {
        let totalNotesCount = 0
        let totalFilesCount = 0
        let totalDbSize = 0

        // Get global DB file size
        try {
          const dbFolder = app.getPath('userData')
          const dbName = !app.isPackaged ? 'berrytrace-dev.db' : 'berrytrace.db'
          const globalDbPath = join(dbFolder, dbName)
          if (fs.existsSync(globalDbPath)) {
            totalDbSize += fs.statSync(globalDbPath).size
          }
        } catch { /* empty */ }

        // Use knownWorkspacePaths populated during indexing (synchronous, always correct)
        for (const wsPath of this.knownWorkspacePaths) {
          try {
            const wsDb = DatabaseManager.getInstance().getWorkspaceDB(wsPath)
            const noteCountRow = wsDb.prepare('SELECT COUNT(*) as count FROM FtsNoteIndex').all() as { count: number }[]
            totalNotesCount += noteCountRow[0]?.count || 0

            const fileCountRow = wsDb.prepare('SELECT COUNT(*) as count FROM FtsFileIndex').all() as { count: number }[]
            totalFilesCount += fileCountRow[0]?.count || 0

            const dbPath = join(wsPath, WORKSPACE_DIR_NAME, 'workspace.db')
            if (fs.existsSync(dbPath)) {
              totalDbSize += fs.statSync(dbPath).size
            }
          } catch (_err) {
            // Ignore workspace DB errors
          }
        }

        this.cachedNoteIndexCount = totalNotesCount
        this.cachedFileIndexCount = totalFilesCount
        this.cachedDbSize = totalDbSize
      } catch (_err) {
        // Avoid printing errors constantly during active indexing loop
      }
    }

    return {
      status: this.status,
      percent: this.totalNotes > 0 ? Math.round((this.indexedNotes / this.totalNotes) * 100) : 0,
      indexedCount: this.indexedNotes,
      totalCount: this.totalNotes,
      estimatedRemainingMs: this.estimateRemainingMs(),
      noteIndexCount: this.cachedNoteIndexCount,
      fileIndexCount: this.cachedFileIndexCount,
      dbSize: this.cachedDbSize,
    };
  }

  private estimateRemainingMs(): number {
    if (this.indexedNotes === 0 || this.status !== 'building') return 0
    const elapsed = Date.now() - this.startTime
    const rate = this.indexedNotes / elapsed
    const remaining = this.totalNotes - this.indexedNotes
    return Math.round(remaining / rate)
  }

  // ==================== 索引构建核心逻辑 ====================

  /**
   * 全量重建所有索引（Tools + Skills + Files 的 FTS5 + 向量）
   * 由用户从设置页面手动触发，或在模型切换后自动调用。
   * 此方法在后台异步执行，不阻塞调用方。
   */
  public async rebuildAllIndices(): Promise<void> {
    if (this.isRebuilding) {
      console.log('[FullTextIndex] Full rebuild already in progress, skipping duplicate call');
      return;
    }
    this.isRebuilding = true;
    this.rebuildAllIndicesAsync().catch((err) => {
      console.error('[FullTextIndex] Failed to rebuild all indices:', err)
      this.status = 'error'
      this.broadcastProgress()
    }).finally(() => {
      this.isRebuilding = false;
    })
  }

  private async rebuildAllIndicesAsync(): Promise<void> {
    try {
      this.status = 'building'
      this.broadcastProgress()

      // Step 1: 索引所有工作区文件
      console.log(`[FullTextIndex] Starting workspace files indexing...`)
      const { WorkspaceManager } = await import('./workspace-manager.js')
      const workspaceManager = WorkspaceManager.getInstance()

      const workspacePaths = new Set<string>()
      for (const win of BrowserWindow.getAllWindows()) {
        const wsPath = workspaceManager.getPathForWindow(win)
        if (wsPath && fs.existsSync(wsPath)) {
          workspacePaths.add(wsPath)
        }
      }

      const history = workspaceManager.getHistory()
      for (const entry of history) {
        if (entry.path && entry.exists && fs.existsSync(entry.path)) {
          workspacePaths.add(entry.path)
        }
      }

      console.log(`[FullTextIndex] Found ${workspacePaths.size} workspaces to index`)

      for (const wsPath of workspacePaths) {
        console.log(`[FullTextIndex] Indexing workspace: ${wsPath}`)
        await this.rebuildFilesIndex(wsPath)
      }

      // Step 2: 刷新已安装应用缓存
      console.log('[FullTextIndex] Refreshing installed apps cache...')
      await this.rebuildInstalledAppsCache()

      this.status = 'done'
      this.broadcastProgress()

      setTimeout(() => {
        if (this.status === 'done') {
          this.status = 'idle'
          this.broadcastProgress()
        }
      }, 3000)
    } catch (err) {
      console.error('[FullTextIndex] Failed to rebuild all indices:', err)
      this.status = 'error'
      this.broadcastProgress()
    }
  }

