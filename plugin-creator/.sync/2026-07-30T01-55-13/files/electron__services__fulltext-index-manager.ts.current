  // ==================== 工作区文件索引 ====================

  public async onFilesChanged(filePaths: string[], workspacePath: string): Promise<void> {
    const wsDb = DatabaseManager.getInstance().getWorkspaceDB(workspacePath)
    const vectorEngine = VectorSearchEngine.getEngine(wsDb, workspacePath)
    const supportedExts = getSupportedExts()

    // 预先查询工作区中所有的索引，以便通过 rowid 准确且高效地去重
    const existingIndex = wsDb.prepare(
      'SELECT rowid, file_path FROM FtsFileIndex WHERE workspace_path = ?'
    ).all(workspacePath) as { rowid: number; file_path: string }[]

    const fileToRowids = new Map<string, number[]>()
    for (const r of existingIndex) {
      if (!fileToRowids.has(r.file_path)) {
        fileToRowids.set(r.file_path, [])
      }
      fileToRowids.get(r.file_path)!.push(r.rowid)
    }

    for (const filePath of filePaths) {
      try {
        // 全文索引：过滤 . 开头的隐藏文件/文件夹
        if (!this.shouldIndexFile(filePath, workspacePath)) continue

        const ext = extname(filePath).toLowerCase()
        const relativePath = relative(workspacePath, filePath)
        const oldRowids = fileToRowids.get(relativePath) || fileToRowids.get(filePath) || []

        if (!fs.existsSync(filePath)) {
          if (oldRowids.length > 0) {
            const stmt = wsDb.prepare('DELETE FROM FtsFileIndex WHERE rowid = ?')
            for (const oldRowid of oldRowids) {
              stmt.run(oldRowid)
            }
          }
          // Delete Vector and links
          try {
            vectorEngine.delete(relativePath, 'file')
            vectorEngine.delete(relativePath, 'note_outline')
            wsDb.prepare("DELETE FROM FtsVectorIndex WHERE entity_type = 'note_chunk' AND entity_id LIKE ?").run(relativePath + '#chunk_%')
            wsDb.prepare('DELETE FROM doc_links WHERE source_path = ?').run(relativePath)
            wsDb.prepare('DELETE FROM semantic_pairs WHERE source_path = ? OR target_path = ?').run(relativePath, relativePath)
          } catch (e) {
            console.error('[FullTextIndex] Failed to delete indexes on file removal:', e)
          }
          console.log(`[FullTextIndex] Deleted file index for: ${relativePath}`)
          continue
        }

        if (!supportedExts.includes(ext)) continue

        const stats = fs.statSync(filePath)
        if (stats.isDirectory()) continue

        // 删除已有索引行（含重复项）
        if (oldRowids.length > 0) {
          const stmt = wsDb.prepare('DELETE FROM FtsFileIndex WHERE rowid = ?')
          for (const oldRowid of oldRowids) {
            stmt.run(oldRowid)
          }
        }

        const content = await this.extractFileContentAsync(filePath, ext)
        const fileName = basename(filePath)

        wsDb.prepare(
          `INSERT OR REPLACE INTO FtsFileIndex (file_path, file_name, content, file_type, workspace_path, modified_at) VALUES (?, ?, ?, ?, ?, ?)`
        ).run(relativePath, fileName, content, ext.slice(1), workspacePath, stats.mtime.toISOString())

        // Index links for markdown files
        if (ext === '.md') {
          try {
            const parsedLinks = await DocumentLinkService.getInstance().parseLinks(filePath, workspacePath)
            wsDb.prepare('DELETE FROM doc_links WHERE source_path = ?').run(relativePath)
            const insertLink = wsDb.prepare(
              'INSERT OR IGNORE INTO doc_links (source_path, target_text, display_text, anchor, target_type, line_number) VALUES (?, ?, ?, ?, ?, ?)'
            )
            for (const link of parsedLinks) {
              insertLink.run(relativePath, link.targetText, link.displayText || null, link.anchor || null, link.targetType, link.lineNumber)
            }
          } catch (err) {
            console.warn(`[FullTextIndex] Failed to index links for ${relativePath}:`, err)
          }
        }

        // Index Vector
        try {
          const textToEmbed = (fileName + '\n' + content).trim()
          const localAI = LocalAIService.getInstance()
          if (textToEmbed && localAI.isWorkerRunning()) {
            const activeModel = localAI.getActiveEmbeddingModel()
            const vector = await localAI.getEmbedding(textToEmbed)
            vectorEngine.addOrUpdate(relativePath, 'file', vector, activeModel.dimension, activeModel.modelId)
          }

          // Prioritize Outline Vector for Markdown files
          if (ext === '.md' && localAI.isWorkerRunning()) {
            const activeModel = localAI.getActiveEmbeddingModel()
            const outlineText = await DocumentLinkService.getInstance().extractOutlineText(filePath)
            if (outlineText) {
              const outlineVector = await localAI.getEmbedding(outlineText)
              vectorEngine.addOrUpdate(relativePath, 'note_outline', outlineVector, activeModel.dimension, activeModel.modelId)
            }
          }
        } catch (err) {
          console.warn(`[FullTextIndex] Failed to generate vector for file ${relativePath}:`, err)
        }

        console.log(`[FullTextIndex] Updated file index for: ${relativePath}`)
      } catch (err) {
        console.error('[FullTextIndex] Failed to index file:', filePath, err)
      }
    }
    this.clearCountsCache()
  }

  public async rebuildFilesIndex(workspacePath: string): Promise<void> {
    console.log(`[FullTextIndex] Rebuilding files index for workspace: ${workspacePath}`)
    this.status = 'building'
    // Register this workspace so buildProgress() can query its counts
    this.knownWorkspacePaths.add(workspacePath)
    this.broadcastProgress()

    const wsDb = DatabaseManager.getInstance().getWorkspaceDB(workspacePath)

    // 不再预先清空索引！使用 INSERT OR REPLACE 进行 upsert，保留现有数据可用性
    // 索引完成后，再删除磁盘上已不存在的文件条目（增量清理）

    // 收集所有需要索引的文件
    const filesToIndex: Array<{ fullPath: string; ext: string }> = []

    const walkDir = async (dir: string): Promise<void> => {
      const entries = await fs.promises.readdir(dir, { withFileTypes: true })
      for (const entry of entries) {
        const fullPath = join(dir, entry.name)

        // 跳过隐藏文件和特定目录
        if ((entry.name.startsWith('.') && entry.name !== '.qoder') || entry.name === 'node_modules' || entry.name === WORKSPACE_DIR_NAME) continue

        if (entry.isDirectory()) {
          await walkDir(fullPath)
        } else {
          const ext = extname(fullPath).toLowerCase()
          const supportedExts = getSupportedExts()
          if (supportedExts.includes(ext)) {
            filesToIndex.push({ fullPath, ext })
          }
        }
      }
    }

    try {
      // 先遍历收集文件列表
      await walkDir(workspacePath)

      console.log(`[FullTextIndex] Found ${filesToIndex.length} files to index in ${workspacePath}`)

      // Update total count for progress reporting
      this.totalNotes = filesToIndex.length
      this.indexedNotes = 0
      this.startTime = Date.now()
      this.broadcastProgress()

      // 分批索引文件
      const batchSize = 50  // 每批处理 50 个文件
      let indexedCount = 0

      for (let i = 0; i < filesToIndex.length; i += batchSize) {
        // 检查是否需要暂停
        await this.checkPausePoint()

        const batch = filesToIndex.slice(i, i + batchSize)

        // 1. Generate embeddings for the batch outside transaction
        const batchEmbeddings: Array<{
          relativePath: string;
          fileVector: number[] | null;
          outlineVector: number[] | null;
          dimension: number;
          modelId: string;
        } | null> = []
        for (const { fullPath, ext } of batch) {
          try {
            const stats = await fs.promises.stat(fullPath)
            if (stats.isDirectory() || stats.size > 10 * 1024 * 1024) {
              batchEmbeddings.push(null)
              continue
            }

            const content = await this.extractFileContentAsync(fullPath, ext)
            const fileName = basename(fullPath)
            const relativePath = relative(workspacePath, fullPath)
            const textToEmbed = (fileName + '\n' + content).trim()
            const localAI = LocalAIService.getInstance()

            if (localAI.isWorkerRunning()) {
              const activeModel = localAI.getActiveEmbeddingModel()
              let fileVector: number[] | null = null
              let outlineVector: number[] | null = null

              if (textToEmbed) {
                fileVector = await localAI.getEmbedding(textToEmbed)
              }

              if (ext === '.md') {
                const outlineText = await DocumentLinkService.getInstance().extractOutlineText(fullPath)
                if (outlineText) {
                  outlineVector = await localAI.getEmbedding(outlineText)
                }
              }

              batchEmbeddings.push({
                relativePath,
                fileVector,
                outlineVector,
                dimension: activeModel.dimension,
                modelId: activeModel.modelId
              })
            } else {
              batchEmbeddings.push(null)
            }
          } catch (_e) {
            batchEmbeddings.push(null)
          }
        }

        // 2. Perform DB operations inside transaction
        wsDb.prepare('BEGIN TRANSACTION').run()
        try {
          const stmt = wsDb.prepare(
            `INSERT OR REPLACE INTO FtsFileIndex (file_path, file_name, content, file_type, workspace_path, modified_at) VALUES (?, ?, ?, ?, ?, ?)`
          )
          for (let idx = 0; idx < batch.length; idx++) {
            const { fullPath, ext } = batch[idx]
            try {
              const stats = await fs.promises.stat(fullPath)
              if (stats.isDirectory()) continue
              if (stats.size > 10 * 1024 * 1024) continue

              const content = await this.extractFileContentAsync(fullPath, ext)
              const fileName = basename(fullPath)
              const relativePath = relative(workspacePath, fullPath)

              stmt.run(relativePath, fileName, content, ext.slice(1), workspacePath, stats.mtime.toISOString())

              // Index links for markdown files
              if (ext === '.md') {
                try {
                  const parsedLinks = await DocumentLinkService.getInstance().parseLinks(fullPath, workspacePath)
                  wsDb.prepare('DELETE FROM doc_links WHERE source_path = ?').run(relativePath)
                  const insertLink = wsDb.prepare(
                    'INSERT OR IGNORE INTO doc_links (source_path, target_text, display_text, anchor, target_type, line_number) VALUES (?, ?, ?, ?, ?, ?)'
                  )
                  for (const link of parsedLinks) {
                    insertLink.run(relativePath, link.targetText, link.displayText || null, link.anchor || null, link.targetType, link.lineNumber)
                  }
                } catch (linkErr) {
                  console.error('[FullTextIndex] Failed to parse links in rebuild:', linkErr)
                }
              }

              // Insert vectors
              const embeddingInfo = batchEmbeddings[idx]
              if (embeddingInfo) {
                const vectorEngine = VectorSearchEngine.getEngine(wsDb, workspacePath)
                if (embeddingInfo.fileVector) {
                  vectorEngine.addOrUpdate(
                    embeddingInfo.relativePath,
                    'file',
                    embeddingInfo.fileVector,
                    embeddingInfo.dimension,
                    embeddingInfo.modelId
                  )
                }
                if (embeddingInfo.outlineVector) {
                  vectorEngine.addOrUpdate(
                    embeddingInfo.relativePath,
                    'note_outline',
                    embeddingInfo.outlineVector,
                    embeddingInfo.dimension,
                    embeddingInfo.modelId
                  )
                }
              }

              indexedCount++
            } catch (err) {
              console.error('[FullTextIndex] Failed to index file:', fullPath, err)
            }
          }
          wsDb.prepare('COMMIT').run()
        } catch (err) {
          wsDb.prepare('ROLLBACK').run()
          console.error(`[FullTextIndex] Failed to index batch at ${i}:`, err)
          throw err
        }

        // 每处理完一批，报告进度
        this.indexedNotes = indexedCount
        this.broadcastProgress()
        console.log(`[FullTextIndex] Indexed ${indexedCount}/${filesToIndex.length} files`)
      }

      // Mark all as complete for progress reporting
      this.indexedNotes = this.totalNotes
      console.log(`[FullTextIndex] File index rebuild complete for: ${workspacePath} (${indexedCount} files)`)
      this.broadcastProgress()
      this.clearCountsCache()

      // 清理磁盘上已不存在的文件的索引条目（增量清理，不影响现有数据可用性）
      try {
        const indexedPaths = new Set(filesToIndex.map(f => relative(workspacePath, f.fullPath)))
        const dbFiles = wsDb.prepare('SELECT file_path FROM FtsFileIndex WHERE workspace_path = ?').all(workspacePath) as { file_path: string }[]
        const staleFiles = dbFiles.filter(f => !indexedPaths.has(f.file_path))
        if (staleFiles.length > 0) {
          console.log(`[FullTextIndex] Cleaning up ${staleFiles.length} stale file entries`)
          const vectorEngine = VectorSearchEngine.getEngine(wsDb, workspacePath)
          const deleteStmt = wsDb.prepare('DELETE FROM FtsFileIndex WHERE file_path = ? AND workspace_path = ?')
          for (const f of staleFiles) {
            deleteStmt.run(f.file_path, workspacePath)
            vectorEngine.delete(f.file_path, 'file')
            vectorEngine.delete(f.file_path, 'note_outline')
          }
        }
      } catch (e) {
        console.warn('[FullTextIndex] Failed to clean up stale file entries:', e)
      }

      await this.indexAllSkills(workspacePath)

      this.status = 'done'
      this.broadcastProgress()

      setTimeout(() => {
        if (this.status === 'done') {
          this.status = 'idle'
          this.broadcastProgress()
        }
      }, 3000)

    } catch (err) {
      console.error('[FullTextIndex] Failed to rebuild file index:', err)
      this.status = 'error'
      this.broadcastProgress()
    }
  }

  // ==================== 查询引擎（IPC 入口） ====================

  public async searchNotes(_query: string, _calendarUuid: number, _workspacePath?: string | null): Promise<NoteSearchResult[]> {
    return [];
  }

  public async searchFiles(query: string, workspacePath?: string): Promise<FileSearchResult[]> {
    const { WorkspaceManager } = await import('./workspace-manager.js')
    const activePath = workspacePath || WorkspaceManager.getInstance().getInitialWorkspacePath()
    if (!activePath) {
      console.warn('[FullTextIndex] No active workspace path found for searchFiles')
      return []
    }

    const scopeKey = activePath
    const cacheKey = `files:${scopeKey}:${query}`;

    // 1. 检查缓存
    const cached = fileSearchCache.get(cacheKey) as FileSearchResult[] | null
    if (cached) {
      console.log(`[FullTextIndex] Cache hit for files: ${cacheKey}`)
      return cached
    }

    // 2. 第一阶段：SQLite FTS5 + 向量检索 (仅涉及文档) — 极其迅速
    try {
      const wsFilter = 'AND workspace_path = ?'
      const parser = new QueryParser()
      const parsed = parser.parse(query)
      const ftsQuery = parser.toFtsQuery(parsed) || query

      const sql = `
        SELECT file_path, file_name, content, snippet(FtsFileIndex, 2, '[', ']', '...', 30) as snip, rank
        FROM FtsFileIndex
        WHERE FtsFileIndex MATCH ?
          ${wsFilter}
        ORDER BY rank
        LIMIT 100
      `
      const params = [ftsQuery, activePath]

      const wsDb = DatabaseManager.getInstance().getWorkspaceDB(activePath)
      const rawResults = wsDb.prepare(sql).all(...params) as unknown as (FileSearchResult & { content: string })[]

      const searchTerms = query.replace(/["'+-]/g, ' ').split(/\s+/).filter(Boolean)
      const firstTerm = searchTerms.length > 0 ? searchTerms[0].toLowerCase() : ''

      const ftsResults: FileSearchResult[] = rawResults.map(r => {
        let lineNumber = 1
        if (firstTerm && r.content) {
          const idx = r.content.toLowerCase().indexOf(firstTerm)
          if (idx !== -1) {
            const upToIdx = r.content.substring(0, idx)
            lineNumber = (upToIdx.match(/\n/g) || []).length + 1
          }
        }

        const { content: _content, ...rest } = r
        return {
          ...rest,
          line_number: lineNumber
        }
      })

      // RRF 混合搜索 (只针对 SQLite 中的文档)
      const hybridDbResults = await FtsHybridSearcher.searchFiles(query, activePath, ftsResults)

      const initialResults = hybridDbResults.map((item, idx) => ({
        ...item,
        rank: idx
      }))

      // 3. 异步启动第二阶段：后台通过 Ripgrep 检索代码，完成后 IPC 广播更新
      this.runRipgrepAndNotify(query, activePath, hybridDbResults).catch(err => {
        console.error('[FullTextIndex] Async Ripgrep search failed:', err)
      })

      // 立即返回第一阶段结果，保证 UI 界面立即响应，不留 Loading 空白
      return initialResults

    } catch (err) {
      console.error('[FullTextIndex] SQLite search failed:', err)
      return []
    }
  }

  /**
   * 后台异步执行 Ripgrep 搜索并向渲染进程发送更新事件
   */
  private async runRipgrepAndNotify(query: string, activePath: string, hybridDbResults: FileSearchResult[]) {
    const { RipgrepService } = await import('./ripgrep-service.js')
    const rgService = RipgrepService.getInstance()

    console.log(`[FullTextIndex:runRipgrepAndNotify] Launching background Ripgrep search for query "${query}"`)
    const rgMatches = await rgService.searchContent(query, activePath)

    const rgResults: FileSearchResult[] = rgMatches.map((m, idx) => ({
      file_path: m.filePath,
      file_name: m.fileName,
      snip: m.snippet,
      rank: 1.0,
      line_number: m.lineNumber,
      score: 1 / (60 + idx + 1)
    }))

    // 对 Ripgrep 结果赋予标题加权得分
    const rgResultsBoosted = rgResults.map(item => ({
      ...item,
      score: FtsHybridSearcher.applyTitleBoost(query, item.file_name, item.score ?? 0)
    }))

    // 合并第一阶段与第二阶段结果
    const combined = [...hybridDbResults, ...rgResultsBoosted]
    combined.sort((a, b) => (b.score ?? 0) - (a.score ?? 0))

    const truncated = combined.slice(0, 150)
    const finalResults = truncated.map((item, idx) => ({
      ...item,
      rank: idx
    }))

    // 存入缓存
    const cacheKey = `files:${activePath}:${query}`;
    fileSearchCache.set(cacheKey, finalResults)

    // 获取全部主窗口并发送更新广播
    const { BrowserWindow } = await import('electron')
    const wins = BrowserWindow.getAllWindows()
    console.log(`[FullTextIndex:runRipgrepAndNotify] Ripgrep search complete. Broadcasting update to ${wins.length} windows. Found ${finalResults.length} matches in total.`)
    for (const win of wins) {
      if (!win.isDestroyed() && win.webContents) {
        win.webContents.send('fts:search-update', {
          query,
          workspacePath: activePath,
          results: finalResults
        })
      }
    }
  }

  public async getStatus(): Promise<IndexProgress> {
    return this.buildProgress()
  }

  public async clearAllIndices(): Promise<void> {
    try {
      const { WorkspaceManager } = await import('./workspace-manager.js')
      const workspaceManager = WorkspaceManager.getInstance()
      const workspacePaths = new Set<string>()

      for (const win of BrowserWindow.getAllWindows()) {
        const wsPath = workspaceManager.getPathForWindow(win)
        if (wsPath && fs.existsSync(wsPath)) {
          workspacePaths.add(wsPath)
        }
      }

      const initialPath = workspaceManager.getInitialWorkspacePath()
      if (initialPath && fs.existsSync(initialPath)) {
        workspacePaths.add(initialPath)
      }

      const history = workspaceManager.getHistory()
      for (const entry of history) {
        if (entry.path && entry.exists && fs.existsSync(entry.path)) {
          workspacePaths.add(entry.path)
        }
      }

      for (const wsPath of workspacePaths) {
        try {
          const wsDb = DatabaseManager.getInstance().getWorkspaceDB(wsPath)
          wsDb.prepare('DELETE FROM FtsFileIndex').run()
          wsDb.prepare('DELETE FROM FtsAgentIndex').run()
          wsDb.prepare('DELETE FROM FtsVectorIndex').run()

          VectorSearchEngine.getEngine(wsDb, wsPath).clear()
        } catch { /* empty */ }
      }

      this.status = 'idle'
      this.totalNotes = 0
      this.indexedNotes = 0
      noteSearchCache.clear()
      fileSearchCache.clear()
      console.log('[FullTextIndex] All indices cleared.')
    } catch (err) {
      console.error('[FullTextIndex] Failed to clear indices:', err)
    }
  }

  public async clearNoteIndices(): Promise<void> {
    noteSearchCache.clear()
    console.log('[FullTextIndex] Note indices cleared.')
  }

  public async clearFileIndices(): Promise<void> {
    try {
      const { WorkspaceManager } = await import('./workspace-manager.js')
      const workspaceManager = WorkspaceManager.getInstance()
      const workspacePaths = new Set<string>()

      for (const win of BrowserWindow.getAllWindows()) {
        const wsPath = workspaceManager.getPathForWindow(win)
        if (wsPath && fs.existsSync(wsPath)) {
          workspacePaths.add(wsPath)
        }
      }

      const initialPath = workspaceManager.getInitialWorkspacePath()
      if (initialPath && fs.existsSync(initialPath)) {
        workspacePaths.add(initialPath)
      }

      const history = workspaceManager.getHistory()
      for (const entry of history) {
        if (entry.path && entry.exists && fs.existsSync(entry.path)) {
          workspacePaths.add(entry.path)
        }
      }

      for (const wsPath of workspacePaths) {
        try {
          const wsDb = DatabaseManager.getInstance().getWorkspaceDB(wsPath)
          wsDb.prepare('DELETE FROM FtsFileIndex').run()
          wsDb.prepare("DELETE FROM FtsVectorIndex WHERE entity_type = 'file'").run()
          VectorSearchEngine.getEngine(wsDb, wsPath).clear()
        } catch { /* empty */ }
      }

      fileSearchCache.clear()
      console.log('[FullTextIndex] File indices cleared.')
    } catch (err) {
      console.error('[FullTextIndex] Failed to clear file indices:', err)
    }
  }

  public shutdown(): void {
    if (this.monitorInterval) {
      clearInterval(this.monitorInterval)
      this.monitorInterval = null
    }
    if (this.schedulingInterval) {
      clearInterval(this.schedulingInterval)
      this.schedulingInterval = null
    }
    if (this.worker) {
      this.worker.terminate()
      this.worker = null
    }
  }

  // ==================== Agent Skills and Tools Indexing ====================

  /**
   * Index NPX Tools Whitelist
   */
  private isIndexingTools = false;

  public async indexToolsLibrary(tools: IndexedTool[], workspacePath?: string | null): Promise<void> {
    if (this.isIndexingTools) {
      console.log('[FullTextIndex] Tools indexing already in progress, skipping duplicate call');
      return;
    }
    this.isIndexingTools = true;
    try {
    console.log(`[FullTextIndex] Indexing tools library (passed: ${tools.length})...`)

    const activeWorkspaces = new Set<string>()
    if (workspacePath) {
      activeWorkspaces.add(workspacePath)
    } else {
      const { WorkspaceManager } = await import('./workspace-manager.js')
      const workspaceManager = WorkspaceManager.getInstance()
      for (const win of BrowserWindow.getAllWindows()) {
        const wsPath = workspaceManager.getPathForWindow(win)
        if (wsPath && fs.existsSync(wsPath)) {
          activeWorkspaces.add(wsPath)
        }
      }
      const initialPath = workspaceManager.getInitialWorkspacePath()
      if (initialPath && fs.existsSync(initialPath)) {
        activeWorkspaces.add(initialPath)
      }
    }

    // Get active MCP tools from McpHost
    let mcpTools: IndexedTool[] = [];
    try {
      const { McpHost } = await import('../plugins/mcp-host.js');
      mcpTools = McpHost.getInstance().listTools();
    } catch (err) {
      console.warn('[FullTextIndex] Failed to get MCP tools for indexing:', err);
    }

    for (const wsPath of activeWorkspaces) {
      try {
        const db = DatabaseManager.getInstance().getWorkspaceDB(wsPath)
        const dbKey = wsPath

        // 1. Read existing non-MCP tools to preserve them
        const preservedTools: IndexedTool[] = [];
        try {
          const rows = db.prepare("SELECT meta FROM FtsAgentIndex WHERE entity_type = 'tool'").all() as { meta: string }[];
          for (const row of rows) {
            try {
              const t = JSON.parse(row.meta);
              if (t.category !== 'mcp') {
                preservedTools.push(t);
              }
            } catch (_e) { /* empty */ }
          }
        } catch (_e) { /* empty */ }

        // 2. Merge all tools (passed tools + preserved tools + active MCP tools)
        const allToolsMap = new Map<string, IndexedTool>();

        // Add preserved non-MCP tools first
        for (const t of preservedTools) {
          allToolsMap.set(t.name, t);
        }
        // Add newly passed tools (overwrite if duplicate)
        for (const t of tools) {
          allToolsMap.set(t.name, t);
        }
        // Add active MCP tools (overwrite if duplicate)
        for (const t of mcpTools) {
          allToolsMap.set(t.name, {
            name: t.name,
            description: t.description,
            category: 'mcp',
            package: t.pluginId,
            inputSchema: t.inputSchema,
            displayName: t.displayName,
            isDynamic: t.isDynamic,
            userQueries: t.userQueries
          });
        }

        // Add `.workflow` files as tools from workspace path
        try {
          // @ts-ignore
          const yaml = (await import('js-yaml')) as any;
          const workflowFiles = await this.findWorkflowFiles(wsPath);
          for (const file of workflowFiles) {
            try {
              const rawContent = fs.readFileSync(file, 'utf-8');
              const doc = yaml.default.load(rawContent) as any;
              if (doc && doc.id) {
                const userQueries: string[] = [];
                if (doc.triggers) {
                  if (Array.isArray(doc.triggers.userQueries)) {
                    userQueries.push(...doc.triggers.userQueries);
                  }
                  if (doc.triggers.cron) {
                    userQueries.push(doc.triggers.cron);
                  }
                }
                allToolsMap.set(doc.id, {
                  name: doc.id,
                  displayName: doc.name || doc.id,
                  description: doc.description || `SOP 自动化工作流: ${doc.name || doc.id}`,
                  category: 'workflow',
                  package: 'workflow-engine',
                  inputSchema: {
                    properties: {}
                  },
                  isDynamic: false,
                  userQueries,
                  filePath: relative(wsPath, file)
                });
              }
            } catch (err) {
              console.warn(`[FullTextIndex] Failed to parse workflow file ${file}:`, err);
            }
          }
        } catch (err) {
          console.warn('[FullTextIndex] Failed to load js-yaml or search workflows:', err);
        }

        const mergedTools = Array.from(allToolsMap.values());

        // 3. Clear existing tools in FTS and Vector index
        try {
          db.prepare("DELETE FROM FtsAgentIndex WHERE entity_type = 'tool'").run()
        } catch (_err) {
          try {
            db.exec(`DROP TABLE IF EXISTS FtsAgentIndex`);
            db.exec(`
              CREATE VIRTUAL TABLE IF NOT EXISTS FtsAgentIndex USING fts5(
                entity_id,
                entity_type,
                title,
                content,
                meta,
                tokenize = 'unicode61'
              )
            `);
          } catch (_e) { /* ignore */ }
        }
        try {
          const existing = db.prepare("SELECT entity_id FROM FtsVectorIndex WHERE entity_type = 'tool'").all() as { entity_id: string }[]
          const vectorEngine = VectorSearchEngine.getEngine(db, dbKey)
          for (const item of existing) {
            vectorEngine.delete(item.entity_id, 'tool')
          }
        } catch (_e) { /* empty */ }

        // 4. Insert and generate vectors
        const localAI = LocalAIService.getInstance()
        const activeModel = localAI.getActiveEmbeddingModel()

        const stmt = db.prepare(
          `INSERT OR REPLACE INTO FtsAgentIndex (entity_id, entity_type, title, content, meta) VALUES (?, ?, ?, ?, ?)`
        )

        for (const tool of mergedTools) {
          try {
            const title = tool.displayName || tool.name
            const displayName = tool.name
            const description = tool.description || ''

            // Extract parameter descriptions from inputSchema
            const paramInfo: string[] = []
            if (tool.inputSchema && tool.inputSchema.properties) {
              for (const [propName, prop] of Object.entries(tool.inputSchema.properties)) {
                const p = prop as { description?: string }
                if (p.description) {
                  paramInfo.push(`${propName}: ${p.description}`)
                } else {
                  paramInfo.push(propName)
                }
              }
            }
            const paramsText = paramInfo.join('\n')

            // Custom synonyms/keywords to boost retrieval
            const customKeywords: string[] = []
            const nameLower = title.toLowerCase()

            if (nameLower.includes('editor_lines') || nameLower.includes('editor_selection') || nameLower.includes('editor_chunk') || nameLower.includes('editor_content')) {
              customKeywords.push('修改', '编辑', '替换', '优化', '重构', '这段', '那段', '这一行', '那一行', '这行', '那行', '当前行', '选区', '选中', '行数', '内容')
            }
            if (nameLower.includes('read_note') || nameLower.includes('list_notes') || nameLower.includes('read_file')) {
              customKeywords.push('读取', '查看', '获取', '打开', '笔记', '内容')
            }
            if (nameLower.includes('search')) {
              customKeywords.push('查找', '搜索', '定位', '匹配')
            }
            const customKeywordsText = customKeywords.join(' ')

            // 1. Build FTS5 content
            const userQueriesText = Array.isArray(tool.userQueries) ? tool.userQueries.join('\n') : ''
            const content = [
              title,
              displayName,
              description,
              paramsText,
              customKeywordsText,
              userQueriesText,
              tool.category || '',
              tool.package || ''
            ].filter(Boolean).join('\n')

            const meta = JSON.stringify(tool)

            stmt.run(tool.name, 'tool', title, content, meta)
          } catch (err) {
            console.warn(`[FullTextIndex] Failed to index tool ${tool.name} in ${wsPath}:`, err)
          }
        }
      } catch (err) {
        console.error(`[FullTextIndex] Failed to index tools library for workspace ${wsPath}:`, err)
      }
    }
    console.log('[FullTextIndex] Tools indexing complete.')
    } finally {
      this.isIndexingTools = false;
    }
  }

  /**
   * Scan global and workspace paths for SKILL.md/SKILLS.md and index them
   */
  public async indexAllSkills(workspacePath?: string | null): Promise<void> {
    console.log('[FullTextIndex] Scanning and indexing all Agent Skills...')

    const activeWorkspaces = new Set<string>()
    if (workspacePath) {
      activeWorkspaces.add(workspacePath)
    } else {
      const { WorkspaceManager } = await import('./workspace-manager.js')
      const workspaceManager = WorkspaceManager.getInstance()
      for (const win of BrowserWindow.getAllWindows()) {
        const wsPath = workspaceManager.getPathForWindow(win)
        if (wsPath && fs.existsSync(wsPath)) {
          activeWorkspaces.add(wsPath)
        }
      }
      const initialPath = workspaceManager.getInitialWorkspacePath()
      if (initialPath && fs.existsSync(initialPath)) {
        activeWorkspaces.add(initialPath)
      }
    }

    const skillDirs = new Set<string>()

    // 1. Scan global skills
    await this.collectSkillDirs(SKILLS_DIR, skillDirs)

    // 2. Scan workspace skills
    for (const wsPath of activeWorkspaces) {
      await this.collectSkillDirs(join(wsPath, '.skills'), skillDirs)
      await this.collectSkillDirs(join(wsPath, 'skills'), skillDirs)
    }

    // 3. Scan plugin skills
    try {
      if (fs.existsSync(PLUGINS_DIR)) {
        const pluginEntries = await fs.promises.readdir(PLUGINS_DIR, { withFileTypes: true })
        for (const entry of pluginEntries) {
          if (entry.isDirectory()) {
            const pluginSkillsDir = join(PLUGINS_DIR, entry.name, 'skills')
            await this.collectSkillDirs(pluginSkillsDir, skillDirs)
          }
        }
      }
    } catch (err) {
      console.warn('[FullTextIndex] Failed to scan plugin skills:', err)
    }

    console.log(`[FullTextIndex] Found ${skillDirs.size} skill directories to index.`)

    const localAI = LocalAIService.getInstance()
    const activeModel = localAI.getActiveEmbeddingModel()

    for (const wsPath of activeWorkspaces) {
      try {
        const db = DatabaseManager.getInstance().getWorkspaceDB(wsPath)
        const dbKey = wsPath

        // 1. Gather info for all scanned skills
        const scannedSkillsInfo: Array<{
          dir: string;
          name: string;
          mdPath: string;
          mtimeMs: number;
        }> = [];

        for (const skillDir of skillDirs) {
          const folderName = basename(skillDir)
          let skillMdPath = join(skillDir, 'SKILL.md')
          if (!fs.existsSync(skillMdPath)) {
            skillMdPath = join(skillDir, 'SKILLS.md')
          }
          if (!fs.existsSync(skillMdPath)) continue

          try {
            const stats = fs.statSync(skillMdPath);
            scannedSkillsInfo.push({
              dir: skillDir,
              name: folderName,
              mdPath: skillMdPath,
              mtimeMs: stats.mtimeMs,
            });
          } catch { /* empty */ }
        }

        // 2. Compare with existing skills to avoid unnecessary re-indexing
        let isIdentical = false;
        try {
          const rows = db.prepare("SELECT entity_id, meta FROM FtsAgentIndex WHERE entity_type = 'skill'").all() as { entity_id: string; meta: string }[];
          if (rows.length === scannedSkillsInfo.length) {
            const dbSkillsMap = new Map<string, IndexedSkillMeta>();
            for (const r of rows) {
              try {
                dbSkillsMap.set(r.entity_id, JSON.parse(r.meta));
              } catch { /* empty */ }
            }

            isIdentical = true;
            for (const skill of scannedSkillsInfo) {
              const dbSkill = dbSkillsMap.get(skill.name);
              if (!dbSkill || dbSkill.modifiedAt !== skill.mtimeMs) {
                isIdentical = false;
                break;
              }
            }

            if (isIdentical && localAI.isWorkerRunning()) {
              const vectorRows = db.prepare("SELECT entity_id FROM FtsVectorIndex WHERE entity_type = 'skill'").all() as { entity_id: string }[];
              const vectorIds = new Set(vectorRows.map(r => r.entity_id));
              for (const skill of scannedSkillsInfo) {
                if (!vectorIds.has(skill.name)) {
                  isIdentical = false;
                  console.log(`[FullTextIndex] Skill "${skill.name}" is missing vector representation. Re-indexing to generate vector.`);
                  break;
                }
              }
            }
          }
        } catch (e) {
          console.warn('[FullTextIndex] Failed to compare skills with database:', e);
        }

        if (isIdentical) {
          console.log(`[FullTextIndex] Skills in workspace ${wsPath} have not changed. Skipping indexing.`);
          continue;
        }

        // Clear existing skills in FTS and Vector index since there are changes
        db.prepare("DELETE FROM FtsAgentIndex WHERE entity_type = 'skill'").run()
        try {
          const existing = db.prepare("SELECT entity_id FROM FtsVectorIndex WHERE entity_type = 'skill'").all() as { entity_id: string }[]
          const vectorEngine = VectorSearchEngine.getEngine(db, dbKey)
          for (const item of existing) {
            vectorEngine.delete(item.entity_id, 'skill')
          }
        } catch (_e) { /* empty */ }

        const stmt = db.prepare(
          `INSERT OR REPLACE INTO FtsAgentIndex (entity_id, entity_type, title, content, meta) VALUES (?, ?, ?, ?, ?)`
        )

        for (const skill of scannedSkillsInfo) {
          try {
            const folderName = skill.name
            const skillMdPath = skill.mdPath
            const rawContent = fs.readFileSync(skillMdPath, 'utf-8')

            // Parse frontmatter
            const fm = this.parseYamlFrontmatter(rawContent)
            const title = fm.name || folderName
            const description = fm.description || ''

            // FTS 索引只存搜索元数据（和工具保持一致），完整指令通过 use_skill 加载
            const ftsContent = [
              title,
              description,
              fm.capabilities ? Object.keys(fm.capabilities).join(' ') : '',
              folderName,
            ].filter(Boolean).join('\n').slice(0, 2000)
            const meta = JSON.stringify({
              path: skill.dir,
              name: folderName,
              displayName: title,
              description,
              modifiedAt: skill.mtimeMs,
              ...fm
            })

            stmt.run(folderName, 'skill', title, ftsContent, meta)
          } catch (err) {
            console.warn(`[FullTextIndex] Failed to index skill from ${skill.dir} in ${wsPath}:`, err)
          }
        }
      } catch (err) {
        console.error(`[FullTextIndex] Failed to index skills for workspace ${wsPath}:`, err)
      }
    }
    console.log('[FullTextIndex] Skills indexing complete.')
  }

