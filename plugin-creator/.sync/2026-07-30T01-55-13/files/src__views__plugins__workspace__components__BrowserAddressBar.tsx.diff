diff --git a/src/views/plugins/workspace/components/BrowserAddressBar.tsx b/src/views/plugins/workspace/components/BrowserAddressBar.tsx
new file mode 100644
index 0000000..a81f2fd
--- /dev/null
+++ b/src/views/plugins/workspace/components/BrowserAddressBar.tsx
@@ -0,0 +1,136 @@
+import React, { useState, useEffect, useRef, useMemo, useCallback } from 'react';
+import { Globe, Search } from 'lucide-react';
+import { useBrowserHistoryStore } from '../../../../stores/browserHistory';
+import {
+  buildBrowserAddressBarSuggestions,
+  type BrowserAddressBarSuggestion,
+} from '../utils/browser-address-bar-suggestions';
+
+interface BrowserAddressBarProps {
+  value: string;
+  onChange: (val: string) => void;
+  onSubmit: (url: string) => void;
+}
+
+export function BrowserAddressBar({ value, onChange, onSubmit }: BrowserAddressBarProps) {
+  const [open, setOpen] = useState(false);
+  const [selectedIndex, setSelectedIndex] = useState(0);
+  const history = useBrowserHistoryStore((s) => s.history);
+  const inputRef = useRef<HTMLInputElement | null>(null);
+
+  const suggestions = useMemo(() => {
+    return buildBrowserAddressBarSuggestions({
+      browserUrlHistory: history,
+      value,
+    });
+  }, [history, value]);
+
+  useEffect(() => {
+    setSelectedIndex(0);
+  }, [suggestions]);
+
+  const handleSelectSuggestion = useCallback(
+    (s: BrowserAddressBarSuggestion) => {
+      setOpen(false);
+      onChange(s.url);
+      onSubmit(s.url);
+    },
+    [onChange, onSubmit]
+  );
+
+  const handleKeyDown = (e: React.KeyboardEvent<HTMLInputElement>) => {
+    if (e.key === 'Escape') {
+      setOpen(false);
+      return;
+    }
+
+    if (e.key === 'Enter') {
+      e.preventDefault();
+      setOpen(false);
+      if (open && suggestions.length > 0 && selectedIndex < suggestions.length) {
+        handleSelectSuggestion(suggestions[selectedIndex]);
+      } else {
+        onSubmit(value);
+      }
+      return;
+    }
+
+    if (!open || suggestions.length === 0) {
+      if (e.key === 'ArrowDown') setOpen(true);
+      return;
+    }
+
+    if (e.key === 'ArrowDown') {
+      e.preventDefault();
+      setSelectedIndex((prev) => (prev < suggestions.length - 1 ? prev + 1 : 0));
+    } else if (e.key === 'ArrowUp') {
+      e.preventDefault();
+      setSelectedIndex((prev) => (prev > 0 ? prev - 1 : suggestions.length - 1));
+    }
+  };
+
+  return (
+    <div className="relative flex-1 flex items-center min-w-0">
+      <form
+        onSubmit={(e) => {
+          e.preventDefault();
+          setOpen(false);
+          onSubmit(value);
+        }}
+        className="w-full flex items-center gap-2 px-3 py-1 rounded-xl bg-black/20 border border-[var(--border-light,#334155)] focus-within:border-[var(--color-brand,#3b82f6)] focus-within:ring-1 focus-within:ring-[var(--color-brand,#3b82f6)] transition-all h-7"
+      >
+        <Globe className="w-3.5 h-3.5 text-[var(--text-tertiary,#64748b)] shrink-0" />
+        <input
+          ref={inputRef}
+          type="text"
+          value={value}
+          onChange={(e) => {
+            onChange(e.target.value);
+            setOpen(true);
+          }}
+          onFocus={() => setOpen(true)}
+          onBlur={() => setTimeout(() => setOpen(false), 200)}
+          onKeyDown={handleKeyDown}
+          placeholder="输入网址或进行 Google 搜索"
+          className="flex-1 bg-transparent border-none text-xs text-[var(--text-primary,#f8fafc)] focus:outline-none placeholder-[var(--text-tertiary,#64748b)]"
+        />
+      </form>
+
+      {/* Dropdown Suggestions Popover */}
+      {open && suggestions.length > 0 && (
+        <div className="absolute top-full left-0 right-0 mt-1.5 rounded-xl bg-[var(--bg-card,#1e293b)] border border-[var(--border-light,#334155)] shadow-2xl z-50 overflow-hidden divide-y divide-black/5 dark:divide-white/5 animate-in fade-in slide-in-from-top-1 duration-150">
+          <div className="py-1 max-h-64 overflow-y-auto">
+            {suggestions.map((item, index) => {
+              const isSelected = index === selectedIndex;
+              return (
+                <div
+                  key={item.url + index}
+                  onMouseDown={(e) => {
+                    e.preventDefault();
+                    handleSelectSuggestion(item);
+                  }}
+                  onMouseEnter={() => setSelectedIndex(index)}
+                  className={`px-3 py-2 flex items-center gap-2.5 cursor-pointer text-xs transition-colors ${
+                    isSelected ? 'bg-[var(--color-brand,#3b82f6)]/20 text-blue-400' : 'text-[var(--text-primary,#f8fafc)] hover:bg-white/5'
+                  }`}
+                >
+                  {item.isSearch ? (
+                    <Search className="w-3.5 h-3.5 text-blue-400 shrink-0" />
+                  ) : (
+                    <Globe className="w-3.5 h-3.5 text-[var(--text-tertiary,#64748b)] shrink-0" />
+                  )}
+                  <div className="flex-1 min-w-0 flex flex-col">
+                    <span className="truncate font-medium">{item.title}</span>
+                    {item.subtitle && (
+                      <span className="truncate text-[11px] text-[var(--text-secondary,#94a3b8)] opacity-80">{item.subtitle}</span>
+                    )}
+                  </div>
+                </div>
+              );
+            })}
+          </div>
+        </div>
+      )}
+    </div>
+  );
+}