const __dirname = dirname(fileURLToPath(import.meta.url));


let _resolvedShellPath: string | null = null;

export function getShellPath(): string {
  if (_resolvedShellPath !== null) return _resolvedShellPath;

  const home = process.env.USERPROFILE || process.env.HOME || app.getPath('home');
  const isWin = process.platform === 'win32';
  const sep = isWin ? ';' : ':';

  let baseSystemPath = '';

  if (isWin) {
    const extras = [
      `${home}\\AppData\\Roaming\\npm`,
      `${home}\\AppData\\Local\\Programs\\node`,
      `${home}\\AppData\\Local\\nvm`,
      'C:\\Program Files\\nodejs',
      'C:\\Program Files (x86)\\nodejs',
    ].join(';');
    const existing = process.env.PATH || '';
    baseSystemPath = existing ? `${existing};${extras}` : extras;
  } else {
    const loginShell = process.env.SHELL || '/bin/zsh';
    try {
      const result = execFileSync(loginShell, ['-l', '-i', '-c', 'echo $PATH'], {
        timeout: 5000,
        encoding: 'utf-8',
        env: { ...process.env, TERM: 'dumb' },
      }).trim();
      if (result) {
        baseSystemPath = result;
      }
    } catch {
      // login shell failed — fall through to static fallback
    }

    if (!baseSystemPath) {
      baseSystemPath = [
        process.env.PATH || '',
        '/usr/local/bin',
        '/usr/bin',
        '/bin',
        '/usr/sbin',
        '/sbin',
        '/opt/homebrew/bin',
        '/opt/homebrew/sbin',
        '/opt/local/bin',
        `${home}/.npm-global/bin`,
        `${home}/.volta/bin`,
        `${home}/.cargo/bin`,
      ].filter(Boolean).join(':');
    }
  }

  // 确保应用内置降级 Node/NPM Shim 已经初始化
  const bundled = getBundledNpmPaths();
  const sandboxDir = join(app.getPath('userData'), 'npm-sandbox');
  if (bundled) {
    try {
      ensureSandboxShims(sandboxDir, bundled);
    } catch (err) {
      console.warn('[SystemController] Failed to auto-create sandbox shims:', err);
    }
  }

  // 附加 BerryTrace 应用专用全局 BIN 与降级 NPM 沙箱 BIN
  const appExtraDirs = [
    join(home, '.berrytrace', 'npm-global', 'bin'),
    join(home, '.npm-global', 'bin'),
    join(app.getPath('userData'), 'npx-tools-sandbox', 'bin'),
    join(sandboxDir, 'bin'),
  ];

  const rawList = [...baseSystemPath.split(sep), ...appExtraDirs];
  const uniqueList: string[] = [];

  for (const item of rawList) {
    const trimmed = item.trim();
    if (trimmed && !uniqueList.includes(trimmed)) {
      uniqueList.push(trimmed);
    }
  }

  _resolvedShellPath = uniqueList.join(sep);
  return _resolvedShellPath;
}

export interface ActiveProcess {
  child: ChildProcess;
  sessionId?: string;
  command: string;
  stdout: string;
  stderr: string;
  exitPromise: Promise<ExecCommandResult>;
  resolveExit?: (res: ExecCommandResult) => void;
  resolvedEarly: boolean;
  resolveEarly?: () => void;
}

const activeChildProcesses = new Map<string, ActiveProcess>();
const completedProcessHistory = new Map<string, ExecCommandResult>();

export function killProcessesForSession(sessionId: string) {
  console.log(`[PluginBridge] Killing active child processes for session: ${sessionId}`);
  for (const [key, item] of activeChildProcesses.entries()) {
    if (item.sessionId === sessionId) {
      try {
        item.child.kill('SIGTERM');
        console.log(`[PluginBridge] Killed process ${key}`);
      } catch (err) {
        console.warn(`[PluginBridge] Failed to kill process ${key}:`, err);
      }
      activeChildProcesses.delete(key);
    }
  }
}

ipcMain.on('agent:cancel-session', async (_event, payload: { sessionId?: string }) => {
  if (payload && typeof payload.sessionId === 'string') {
    killProcessesForSession(payload.sessionId);
    try {
      const { PluginManager } = await import('../plugin-manager');
      const pm = PluginManager.getInstance();
      const kernelPluginId = pm.getAgentKernelPluginId();
      if (kernelPluginId) {
        pm.emitToBackgroundPlugin(kernelPluginId, 'agent:cancel_session', { sessionId: payload.sessionId });
        console.log(`[PluginBridge] Forwarded agent:cancel_session to background plugin: ${kernelPluginId}`);
      }
    } catch (err) {
      console.error('[PluginBridge] Failed to forward agent:cancel_session to background plugin:', err);
    }
  }
});

export function writeStdinForSession(sessionId: string, text: string): boolean {
  console.log(`[PluginBridge] Writing to stdin for session: ${sessionId}, text length: ${text.length}`);
  let written = false;
  for (const item of activeChildProcesses.values()) {
    if (item.sessionId === sessionId) {
      if (item.child.stdin && !item.child.stdin.destroyed) {
        try {
          item.child.stdin.write(text + '\n');
          console.log(`[PluginBridge] Wrote text to stdin of process`);
          written = true;
        } catch (err) {
          console.warn(`[PluginBridge] Failed to write to stdin:`, err);
        }
      }
    }
  }
  return written;
}

ipcMain.on('agent:send-stdin', (_event, payload: { sessionId?: string; text?: string }) => {
  if (payload && typeof payload.sessionId === 'string' && typeof payload.text === 'string') {
    writeStdinForSession(payload.sessionId, payload.text);
  }
});

interface ExecCommandOptions {
  command: string;
  args?: string[];
  cwd?: string;
  env?: Record<string, string>;
  timeoutMs?: number;
  shell?: boolean;
  streamEventName?: string;
  sessionId?: string;
  resolveOnSilenceMs?: number;
  sudo?: boolean;
}

interface ExecCommandResult {
  code: number;
  stdout: string;
  stderr: string;
  signal: string | null;
  resolvedEarly?: boolean;
}

interface SudoerInstance {
  exec(command: string, options?: { env?: Record<string, string>; cwd?: string }): Promise<string | Buffer>;
}

async function executeSudoCommand(
  options: ExecCommandOptions,
  sender?: Electron.WebContents,
): Promise<ExecCommandResult> {
  const mod = await import('electron-sudo-universal') as Record<string, unknown>;
  const SudoerClass = (mod.default as Record<string, unknown>)?.["electron-sudo"] as new (opts: { name: string }) => SudoerInstance
    || (mod as Record<string, unknown>)["electron-sudo"] as new (opts: { name: string }) => SudoerInstance;
  if (!SudoerClass) {
    throw new Error('Failed to load electron-sudo-universal: SudoerClass not found in module exports');
  }
  const { oemManager } = await import('../../services/oem-manager');
  const appName = oemManager.getConfig().appName || '莓莓印记';
  const sudoer = new SudoerClass({ name: appName });

  const commandStr = [options.command, ...(options.args || [])].map(arg => {
    if (arg.includes(' ') && !arg.startsWith('"') && !arg.startsWith("'")) {
      return `"${arg.replace(/"/g, '\\"')}"`;
    }
    return arg;
  }).join(' ');

  const cwd = typeof options.cwd === 'string' && options.cwd.trim() ? options.cwd : app.getPath('home');
  const env = options.env || {};

  return new Promise<ExecCommandResult>((resolve) => {
    if (options.sessionId) {
      SystemSleepAssertionManager.acquire();
      const mainWin = ElectronMainWindow.getInstance().getWindow();
      if (mainWin && !mainWin.isDestroyed()) {
        mainWin.webContents.send('agent:process-started', { sessionId: options.sessionId });
      }
    }

    const streamEventName = options.streamEventName;

    sudoer.exec(commandStr, { env, cwd })
      .then((output: string | Buffer) => {
        const stdout = typeof output === 'string' ? output : (output as Buffer).toString('utf-8');
        
        if (streamEventName) {
          emitExecStream(sender, streamEventName, { stream: 'stdout', chunk: stdout });
          emitExecStream(sender, streamEventName, { stream: 'exit', code: 0, signal: null });
        }

        if (options.sessionId) {
          SystemSleepAssertionManager.release();
          const mainWin = ElectronMainWindow.getInstance().getWindow();
          if (mainWin && !mainWin.isDestroyed()) {
            mainWin.webContents.send('agent:process-exited', { sessionId: options.sessionId });
          }
        }

        resolve({
          code: 0,
          stdout,
          stderr: '',
          signal: null,
        });
      })
      .catch((err: Error) => {
        const errorText = err instanceof Error ? err.message : String(err);
        if (streamEventName) {
          emitExecStream(sender, streamEventName, { stream: 'stderr', chunk: errorText });
          emitExecStream(sender, streamEventName, { stream: 'exit', code: 1, signal: null });
        }

        if (options.sessionId) {
          const mainWin = ElectronMainWindow.getInstance().getWindow();
          if (mainWin && !mainWin.isDestroyed()) {
            mainWin.webContents.send('agent:process-exited', { sessionId: options.sessionId });
          }
        }

        resolve({
          code: 1,
          stdout: '',
          stderr: errorText,
          signal: null,
        });
      });
  });
}

interface ExecStreamPayload {
  stream: 'stdout' | 'stderr' | 'exit';
  chunk?: string;
  code?: number;
  signal?: string | null;
}

function emitExecStream(
  sender: Electron.WebContents | undefined,
  streamEventName: string | undefined,
  payload: ExecStreamPayload,
): void {
  if (!streamEventName) return;

  if (sender && !sender.isDestroyed()) {
    sender.send(streamEventName, payload);
    return;
  }

  BrowserWindow.getAllWindows().forEach((win) => {
    if (!win.isDestroyed()) {
      win.webContents.send(streamEventName, payload);
    }
  });
}

export function getBundledNpmPaths(): { npmCli: string; npxCli: string } | null {
  const npmCandidates: string[] = [];
  if (process.resourcesPath) {
    npmCandidates.push(join(process.resourcesPath, 'npm', 'bin', 'npm-cli.js'));
  }
  npmCandidates.push(join(app.getAppPath(), '..', 'build-resources', 'npm', 'bin', 'npm-cli.js'));
  npmCandidates.push(join(app.getAppPath(), 'build-resources', 'npm', 'bin', 'npm-cli.js'));

  for (const npmCli of npmCandidates) {
    if (fsSync.existsSync(npmCli)) {
      const npxCli = npmCli.replace('npm-cli.js', 'npx-cli.js');
      if (fsSync.existsSync(npxCli)) {
        return { npmCli, npxCli };
      }
    }
  }
  return null;
}

export function ensureSandboxShims(sandboxDir: string, bundled: { npmCli: string; npxCli: string }) {
  const binDir = join(sandboxDir, 'bin');
  if (!fsSync.existsSync(sandboxDir)) {
    fsSync.mkdirSync(sandboxDir, { recursive: true });
  }
  if (!fsSync.existsSync(binDir)) {
    fsSync.mkdirSync(binDir, { recursive: true });
  }

  const execPath = process.execPath;
  const homeDir = app ? app.getPath('home') : (process.env.HOME || process.env.USERPROFILE || '');
  const globalPrefix = join(homeDir, '.berrytrace', 'npm-global');

  if (process.platform === 'win32') {
    const shims = [
      {
        path: join(sandboxDir, 'node.cmd'),
        content: `@echo off\r\nset ELECTRON_RUN_AS_NODE=1\r\n"${execPath}" %*\r\n`
      },
      {
        path: join(sandboxDir, 'npm.cmd'),
        content: `@echo off\r\nset ELECTRON_RUN_AS_NODE=1\r\nif "%npm_config_prefix%"=="" set npm_config_prefix=${globalPrefix}\r\n"${execPath}" "${bundled.npmCli}" %*\r\n`
      },
      {
        path: join(sandboxDir, 'npx.cmd'),
        content: `@echo off\r\nset ELECTRON_RUN_AS_NODE=1\r\nif "%npm_config_prefix%"=="" set npm_config_prefix=${globalPrefix}\r\n"${execPath}" "${bundled.npxCli}" %*\r\n`
      },
      {
        path: join(binDir, 'node.cmd'),
        content: `@echo off\r\nset ELECTRON_RUN_AS_NODE=1\r\n"${execPath}" %*\r\n`
      },
      {
        path: join(binDir, 'npm.cmd'),
        content: `@echo off\r\nset ELECTRON_RUN_AS_NODE=1\r\nif "%npm_config_prefix%"=="" set npm_config_prefix=${globalPrefix}\r\n"${execPath}" "${bundled.npmCli}" %*\r\n`
      },
      {
        path: join(binDir, 'npx.cmd'),
        content: `@echo off\r\nset ELECTRON_RUN_AS_NODE=1\r\nif "%npm_config_prefix%"=="" set npm_config_prefix=${globalPrefix}\r\n"${execPath}" "${bundled.npxCli}" %*\r\n`
      }
    ];

    for (const shim of shims) {
      if (!fsSync.existsSync(shim.path) || fsSync.readFileSync(shim.path, 'utf8') !== shim.content) {
        try {
          fsSync.writeFileSync(shim.path, shim.content, 'utf8');
        } catch (err) {
          console.error(`[PluginBridge] Failed to write Windows shim ${shim.path}:`, err);
        }
      }
    }
  } else {
    const shims = [
      {
        path: join(binDir, 'node'),
        content: `#!/bin/sh\nexport ELECTRON_RUN_AS_NODE=1\nif [ -z "$npm_config_prefix" ]; then\n  export npm_config_prefix="${globalPrefix}"\nfi\nexec "${execPath}" "$@"\n`
      },
      {
        path: join(binDir, 'npm'),
        content: `#!/bin/sh\nexport ELECTRON_RUN_AS_NODE=1\nif [ -z "$npm_config_prefix" ]; then\n  export npm_config_prefix="${globalPrefix}"\nfi\nexec "${execPath}" "${bundled.npmCli}" "$@"\n`
      },
      {
        path: join(binDir, 'npx'),
        content: `#!/bin/sh\nexport ELECTRON_RUN_AS_NODE=1\nif [ -z "$npm_config_prefix" ]; then\n  export npm_config_prefix="${globalPrefix}"\nfi\nexec "${execPath}" "${bundled.npxCli}" "$@"\n`
      }
    ];

    for (const shim of shims) {
      if (!fsSync.existsSync(shim.path) || fsSync.readFileSync(shim.path, 'utf8') !== shim.content) {
        try {
          fsSync.writeFileSync(shim.path, shim.content, { encoding: 'utf8', mode: 0o755 });
        } catch (err) {
          console.error(`[PluginBridge] Failed to write POSIX shim ${shim.path}:`, err);
        }
      }
    }
  }
}

export async function executeSystemCommand(
  _pluginId: string,
  options: ExecCommandOptions,
  sender?: Electron.WebContents,
): Promise<ExecCommandResult> {
  if (!options || typeof options.command !== 'string' || !options.command.trim()) {
    throw new Error('system.execCommand requires a non-empty command string');
  }

  if (options.sudo) {
    return executeSudoCommand(options, sender);
  }

  const args = Array.isArray(options.args) ? options.args.map((arg) => {
    let s = String(arg);
    if ((s.startsWith("'") && s.endsWith("'")) || (s.startsWith('"') && s.endsWith('"'))) {
      s = s.slice(1, -1);
    }
    return s;
  }) : [];
  const timeoutMs =
    typeof options.timeoutMs === 'number'
      ? Math.max(0, Math.min(30 * 60 * 1000, Math.floor(options.timeoutMs)))
      : 0;
  const cwd = typeof options.cwd === 'string' && options.cwd.trim() ? options.cwd : app.getPath('home');

  const sandboxDir = join(app.getPath('userData'), 'npx-tools-sandbox');
  const binDir = join(sandboxDir, 'bin');

  const env: Record<string, string> = {
    ...Object.entries(process.env).reduce<Record<string, string>>((acc, [key, value]) => {
      if (typeof value === 'string') acc[key] = value;
      return acc;
    }, {}),
    PATH: getShellPath(),
    ...(options.env || {}),
  };

  const bundled = getBundledNpmPaths();
  if (bundled) {
    ensureSandboxShims(sandboxDir, bundled);
    env.npm_config_prefix = sandboxDir;
    env.npm_config_cache = join(sandboxDir, '.npm-cache');
    env.npm_config_tmp = join(sandboxDir, '.npm-tmp');
    env.npm_config_registry = 'https://registry.npmmirror.com';
  }

  const sandboxBinLocal = join(sandboxDir, 'node_modules', '.bin');
  const separator = process.platform === 'win32' ? ';' : ':';
  const currentPath = options.env?.PATH || env.PATH || getShellPath();
  const prependedPaths = [sandboxBinLocal, binDir];
  if (process.platform === 'win32') {
    prependedPaths.push(sandboxDir);
  }
  env.PATH = [...prependedPaths, currentPath].filter(Boolean).join(separator);

  if (_pluginId && _pluginId.includes('npx-tools')) {
    const home = app.getPath('home');
    let unifiedHome: string;
    if (process.platform === 'win32') {
      unifiedHome = join(process.env.APPDATA || app.getPath('appData'), 'BerryTrace');
      env.USERPROFILE = unifiedHome;
      env.APPDATA = unifiedHome;
    } else if (process.platform === 'darwin') {
      unifiedHome = join(app.getPath('appData'), 'BerryTrace');
      env.HOME = unifiedHome;
    } else {
      unifiedHome = join(home, '.local', 'share', 'berrytrace');
      env.HOME = unifiedHome;
    }

    if (!fsSync.existsSync(unifiedHome)) {
      fsSync.mkdirSync(unifiedHome, { recursive: true });
    }
  }

  let runCommand = options.command;
  let runArgs = args;
  if (runCommand === 'node' || runCommand === 'builtin-node') {
    runCommand = process.execPath;
    env.ELECTRON_RUN_AS_NODE = '1';

    if (args.length > 0 && typeof args[0] === 'string' && !fsSync.existsSync(args[0])) {
      const scriptPath = args[0];
      const match = scriptPath.match(/(plugins-dev\/[^/]+)\/node_modules\/(.+)$/);
      if (match) {
        let fallbackPath = join(app.getAppPath(), 'node_modules', match[2]);
        if (!fsSync.existsSync(fallbackPath)) {
          fallbackPath = join(app.getAppPath(), '..', 'node_modules', match[2]);
        }
        if (fsSync.existsSync(fallbackPath)) {
          runArgs = [fallbackPath, ...args.slice(1)];
        }
      }
    }
  }

  let useShell = Boolean(options.shell);
  if (process.platform === 'win32' && !options.shell) {
    if (!extname(runCommand)) {
      const pathDirs = (env.PATH || '').split(';');
      for (const dir of pathDirs) {
        const cmdPath = join(dir, `${runCommand}.cmd`);
        if (dir && fsSync.existsSync(cmdPath)) {
          runCommand = cmdPath;
          useShell = true;
          break;
        }
      }
    } else if (runCommand.endsWith('.cmd') || runCommand.endsWith('.bat')) {
      useShell = true;
    }
  }

  let retryCount = 0;

  const doSpawn = (): Promise<ExecCommandResult> => {
    return new Promise<ExecCommandResult>((resolve) => {
      const child = spawn(runCommand, runArgs, {
        cwd,
        env,
        shell: useShell,
        windowsHide: true,
      });

      if (options.sessionId) {
        const mainWin = ElectronMainWindow.getInstance().getWindow();
        if (mainWin && !mainWin.isDestroyed()) {
          mainWin.webContents.send('agent:process-started', { sessionId: options.sessionId });
        }
      }

      const processKey = options.streamEventName || `proc_${Date.now()}_${Math.random().toString(36).slice(2, 7)}`;

      let resolveExit: ((res: ExecCommandResult) => void) | undefined;
      const exitPromise = new Promise<ExecCommandResult>((r) => {
        resolveExit = r;
      });

      const processItem: ActiveProcess = {
        child,
        sessionId: options.sessionId,
        command: options.command,
        stdout: '',
        stderr: '',
        exitPromise,
        resolveExit,
        resolvedEarly: false,
        resolveEarly: () => {
          if (!settled) {
            settled = true;
            processItem.resolvedEarly = true;
            if (options.sessionId) {
              const mainWin = ElectronMainWindow.getInstance().getWindow();
              if (mainWin && !mainWin.isDestroyed()) {
                mainWin.webContents.send('agent:process-resolved-early', { sessionId: options.sessionId });
              }
            }
            resolve({
              code: 0,
              stdout,
              stderr,
              signal: null,
              resolvedEarly: true,
            });
          }
        }
      };
      activeChildProcesses.set(processKey, processItem);

      const cleanup = (finalResult?: ExecCommandResult) => {
        activeChildProcesses.delete(processKey);
        if (options.sessionId) {
          if (finalResult) {
            completedProcessHistory.set(options.sessionId, finalResult);
          }
          const mainWin = ElectronMainWindow.getInstance().getWindow();
          if (mainWin && !mainWin.isDestroyed()) {
            mainWin.webContents.send('agent:process-exited', { sessionId: options.sessionId });
          }
        }
      };

      let stdout = '';
      let stderr = '';
      let timedOut = false;
      let settled = false;
      let timeoutHandle: NodeJS.Timeout | undefined;
      let silenceTimer: NodeJS.Timeout | undefined;
      const silenceMs = typeof options.resolveOnSilenceMs === 'number' ? options.resolveOnSilenceMs : 0;

      const appendBounded = (base: string, chunk: string) => {
        const merged = base + chunk;
        const maxLen = 1024 * 1024;
        if (merged.length <= maxLen) return merged;
        return merged.slice(merged.length - maxLen);
      };

      const resetSilenceTimer = () => {
        if (silenceMs > 0) {
          if (silenceTimer) clearTimeout(silenceTimer);
          silenceTimer = setTimeout(() => {
            if (processItem.resolveEarly) {
              processItem.resolveEarly();
            }
          }, silenceMs);
        }
      };

      if (timeoutMs > 0) {
        timeoutHandle = setTimeout(() => {
          timedOut = true;
          child.kill('SIGTERM');
        }, timeoutMs);
      }

      resetSilenceTimer();

      child.stdout.on('data', (chunk: Buffer | string) => {
        const text = typeof chunk === 'string' ? chunk : chunk.toString('utf-8');
        stdout = appendBounded(stdout, text);
        processItem.stdout = stdout;
        emitExecStream(sender, options.streamEventName, { stream: 'stdout', chunk: text });
        resetSilenceTimer();
      });

      child.stderr.on('data', (chunk: Buffer | string) => {
        const text = typeof chunk === 'string' ? chunk : chunk.toString('utf-8');
        stderr = appendBounded(stderr, text);
        processItem.stderr = stderr;
        emitExecStream(sender, options.streamEventName, { stream: 'stderr', chunk: text });
        resetSilenceTimer();
      });

      child.on('error', (error) => {
        if (timeoutHandle) clearTimeout(timeoutHandle);
        if (silenceTimer) clearTimeout(silenceTimer);

        const errorCode = (error as NodeJS.ErrnoException).code;
        if ((errorCode === 'ENOENT' || errorCode === 'EACCES') && retryCount < 1 && bundled) {
          retryCount++;
          console.warn(`[PluginBridge] Command failed with ${errorCode}. Attempting shim self-healing and retry...`);
          cleanup();
          try {
            ensureSandboxShims(sandboxDir, bundled);
            doSpawn().then(resolve);
            return;
          } catch (repairErr) {
            console.error('[PluginBridge] Shim self-healing failed:', repairErr);
          }
        }

        const errorText = error instanceof Error ? error.message : String(error);
        const hint = `Command spawn failed: ${options.command} (${errorText})`;
        stderr = appendBounded(stderr, hint);
        processItem.stderr = stderr;
        emitExecStream(sender, options.streamEventName, { stream: 'stderr', chunk: `${hint}\n` });
        emitExecStream(sender, options.streamEventName, { stream: 'exit', code: 127, signal: null });

        const finalResult: ExecCommandResult = {
          code: 127,
          stdout,
          stderr,
          signal: null,
        };

        cleanup(finalResult);
        if (processItem.resolveExit) {
          processItem.resolveExit(finalResult);
        }

        if (!settled) {
          settled = true;
          resolve(finalResult);
        }
      });

      child.on('close', (code, signal) => {
        if (timeoutHandle) clearTimeout(timeoutHandle);
        if (silenceTimer) clearTimeout(silenceTimer);
        const exitCode = timedOut ? 124 : (code ?? 0);
        emitExecStream(sender, options.streamEventName, { stream: 'exit', code: exitCode, signal });

        const finalResult: ExecCommandResult = {
          code: exitCode,
          stdout,
          stderr,
          signal,
        };

        cleanup(finalResult);
        if (processItem.resolveExit) {
          processItem.resolveExit(finalResult);
        }

        if (!settled) {
          settled = true;
          resolve(finalResult);
        }
      });
    });
  };

  return await doSpawn();
}

async function waitSystemCommand(
  sessionId: string,
): Promise<ExecCommandResult> {
  for (const item of activeChildProcesses.values()) {
    if (item.sessionId === sessionId) {
      console.log(`[PluginBridge] Waiting for active process in session ${sessionId} to finish...`);
      return item.exitPromise;
    }
  }
  const history = completedProcessHistory.get(sessionId);
  if (history) {
    completedProcessHistory.delete(sessionId);
    return history;
  }
  return {
    code: 0,
    stdout: 'No active background command running in this session.',
    stderr: '',
    signal: null,
  };
}

export function resolveCommandEarly(sessionId: string): boolean {
  console.log(`[PluginBridge] Request to resolve command early for session: ${sessionId}`);
  let resolved = false;
  for (const item of activeChildProcesses.values()) {
    if (item.sessionId === sessionId) {
      if (item.resolveEarly) {
        item.resolveEarly();
        resolved = true;
      }
    }
  }
  return resolved;
}

const captureWindows = new Map<string, BrowserWindow>();

export interface FloatWindowOptions extends Partial<Omit<BrowserWindowConstructorOptions, 'webPreferences'>> {
  url: string;
  ignoreMouseEvents?: boolean;
}

export class SystemController extends BaseApiController {
  private trays = new Map<string, Tray>();
  private floatWindows = new Map<string, BrowserWindow>();
  // 插件 ID → 该插件创建的所有 winId 集合（反向索引）
  // 保证当 background 插件被 kill 时，可以按 pluginId 主动关闭其创建的孤窗
  private pluginFloatWindows = new Map<string, Set<string>>();

  // ── system namespace ──

  /**
   * 终止指定 Session 会话下的所有运行中子进程（终端、脚本）
   */
  async system_killSessionProcesses(sessionId: string): Promise<boolean> {
    if (sessionId) {
      killProcessesForSession(sessionId);
    }
    return true;
  }

  /**
   * 获取当前系统主题。
   * @returns 返回 'dark' 或 'light'
   */
  async system_getTheme(): Promise<string> {
    return nativeTheme.shouldUseDarkColors ? 'dark' : 'light';
  }

  /**
   * 获取宿主应用的 OEM 基础信息（如软件名称）
   */
  async system_getAppInfo(): Promise<{ appName: string; oemId: string; apiGateway: string; logoPath?: string; browserPolicy?: Record<string, unknown> }> {
    const { oemManager } = await import('../../services/oem-manager');
    const config = oemManager.getConfig();
    return {
      appName: config.appName,
      oemId: config.oemId,
      apiGateway: config.apiGateway,
      logoPath: config.logoPath,
      browserPolicy: config.browserPolicy as Record<string, unknown> | undefined,
    };
  }

  /**
   * 获取所有当前已启用插件声明的子代理（SubAgent）规格列表。
   */
  async system_getSubagentsList(): Promise<unknown[]> {
    const { PluginManager } = await import('../plugin-manager');
    return PluginManager.getInstance().getDeclaredSubAgents();
  }

  /**
   * 获取可用于屏幕捕获的源列表（屏幕/窗口）。
   * @param options types — 捕获类型：'screen' 或 'window'
   * @returns 源列表，每项包含 id 和 name
   */
  async system_getDesktopCapturerSources(options: { types: Array<'screen' | 'window'> }): Promise<Array<{ id: string; name: string }>> {
    const sources = await desktopCapturer.getSources({
      types: options.types,
      thumbnailSize: { width: 0, height: 0 }
    });
    return sources.map(s => ({
      id: s.id,
      name: s.name
    }));
  }

  /**
   * 发送系统原生通知。点击通知会恢复并聚焦主窗口。
   * @param options title — 通知标题，body — 通知正文，silent — 是否静默（默认 false）
   * @example
   * await callApi('system', 'showNotification', [{ title: '任务完成', body: '构建成功' }]);
   */
  async system_showNotification(options: { title: string; body: string; silent?: boolean }, _context: ApiContext): Promise<null> {
    if (Notification.isSupported()) {
      const { oemManager } = await import('../../services/oem-manager');
      const oemLogo = oemManager.getOEMLogoPath();
      const iconPath = oemLogo && fsSync.existsSync(oemLogo)
        ? oemLogo
        : app.isPackaged
        ? join(app.getAppPath(), 'dist', process.platform === 'win32' ? 'icon.ico' : 'icon.png')
        : join(app.getAppPath(), 'public', process.platform === 'win32' ? 'icon.ico' : 'icon.png');

      const notification = new Notification({
        title: options.title,
        body: options.body,
        icon: iconPath,
        silent: options.silent ?? false,
      });
      const win = BrowserWindow.getFocusedWindow() || BrowserWindow.getAllWindows()[0] || null;
      notification.on('click', () => {
        if (win) {
          if (win.isMinimized()) win.restore();
          win.focus();
        }
      });
      notification.show();
    }
    return null;
  }

  /**
   * 切换快速面板（语音助手面板）的显示/隐藏。
   */
  async system_toggleQuickPanel(): Promise<null> {
    const { ElectronQuickPanelWindow } = await import('../../windows/quick-panel');
    process.nextTick(() => {
      ElectronQuickPanelWindow.getInstance().toggleQuickPanelWindow();
    });
    return null;
  }

  /**
   * 在系统默认浏览器中打开 URL。
   * @param targetUrl 目标 URL
   * @example
   * await callApi('system', 'openExternal', ['https://example.com']);
   */
  async system_openExternal(targetUrl: string): Promise<null> {
    await shell.openExternal(targetUrl);
    return null;
  }

  /**
   * 打开 URL。internal=true 时在应用内嵌浏览器打开，否则在系统浏览器打开。
   * @param targetUrl 目标 URL
   * @param options internal — 是否内嵌打开，width/height — 内嵌窗口尺寸，alwaysOnTop — 是否置顶
   * @example
   * await callApi('system', 'openUrl', [{ targetUrl: 'https://example.com', internal: true, width: 1024, height: 768 }]);
   */
  async system_openUrl(targetUrl: string, options?: { internal?: boolean; width?: number; height?: number; alwaysOnTop?: boolean }): Promise<null> {
    const opts = options || {};
    if (opts.internal) {
      const mainWindow = ElectronMainWindow.getInstance().getWindow();
      if (mainWindow && !mainWindow.isDestroyed()) {
        const width = opts.width || 800;
        const height = opts.height || 600;
        const alwaysOnTop = opts.alwaysOnTop !== false;
        mainWindow.webContents.send('window:open-child', {
          name: `internal-browser:width=${width}&height=${height}&alwaysOnTop=${alwaysOnTop}`,
          url: targetUrl,
          features: `width=${width},height=${height},alwaysOnTop=${alwaysOnTop}`
        });
        return null;
      }
    }
    await shell.openExternal(targetUrl);
    return null;
  }

  /**
   * 向系统剪贴板写入文本。
   * @param text 文本内容
   */
  async system_clipboardWriteText(text: string): Promise<null> {
    clipboard.writeText(text);
    return null;
  }

  /**
   * 执行系统命令。支持 shell 命令、超时控制、流式输出、sudo 提权。
   * @param options command — 命令字符串，args — 参数数组，cwd — 工作目录，timeoutMs — 超时毫秒，streamEventName — 流事件名，sessionId — 会话 ID，sudo — 是否提权
   * @returns code — 退出码，stdout — 标准输出，stderr — 标准错误，signal — 终止信号
   * @example
   * await callApi('system', 'execCommand', [{ command: 'ls', args: ['-la'], cwd: '/tmp', timeoutMs: 10000 }]);
   */
  async system_execCommand(options: ExecCommandOptions, context: ApiContext): Promise<ExecCommandResult> {
    return executeSystemCommand(context.pluginId, options, context.sender);
  }

  /**
   * 解析内置 npm CLI 路径，用于插件中的 npm 操作。
   * @returns { npmCli, npxCli } 或 null
   */
  async system_resolveNpmCli(): Promise<unknown> {
    const paths = getBundledNpmPaths();
    if (paths) {
      console.log(`[PluginBridge] npm-cli.js resolved: ${paths.npmCli}`);
      return paths;
    }
    console.warn('[PluginBridge] Bundled npm-cli.js not found in extraResources or build-resources.');
    return null;
  }

  /**
   * 等待指定会话的 execCommand 完成，阻塞直到进程退出。
   * @param options sessionId — execCommand 时传入的会话 ID
   * @example
   * await callApi('system', 'waitCommand', [{ sessionId: 'my-session' }]);
   */
  async system_waitCommand(options: { sessionId: string }): Promise<ExecCommandResult> {
    return waitSystemCommand(options.sessionId);
  }

  /**
   * 提前终止指定会话的 execCommand，不等进程退出即返回已有输出。
   * @param options sessionId — execCommand 时传入的会话 ID
   * @example
   * await callApi('system', 'resolveCommandEarly', [{ sessionId: 'my-session' }]);
   */
  async system_resolveCommandEarly(options: { sessionId: string }): Promise<boolean> {
    return resolveCommandEarly(options.sessionId);
  }

  /**
   * 向正在运行的 execCommand 进程的 stdin 写入文本。
   * @param options sessionId — 会话 ID，text — 写入文本
   * @example
   * await callApi('system', 'writeStdin', [{ sessionId: 'my-session', text: 'y\\n' }]);
   */
  async system_writeStdin(options: { sessionId: string; text: string }): Promise<boolean> {
    return writeStdinForSession(options.sessionId, options.text);
  }

  /**
   * 获取当前系统焦点元素的输入信息（选中文本、输入值、角色）。
   * @returns selection — 选中文本，value — 输入值，role — AX 角色
   * @example
   * await callApi('system', 'getFocusedInputInfo', []);
   */
  async system_getFocusedInputInfo(): Promise<{ selection: string; value: string; role: string }> {
    console.log('[SystemController] getFocusedInputInfo called');
    const hook = getMouseHook();
    if (hook && hook.getFocusedInputInfo) {
      try {
        const info = hook.getFocusedInputInfo();
        console.log('[SystemController] getFocusedInputInfo result:', info);
        return info;
      } catch (err) {
        console.error('[SystemController] Failed to call native getFocusedInputInfo:', err);
      }
    } else {
      console.warn('[SystemController] getFocusedInputInfo is not supported on this platform/addon');
    }
    return { selection: '', value: '', role: '' };
  }

  /**
   * 检测当前系统焦点元素是否处于可编辑的输入区域。
   * 业务层可在触发 AI 填充前调用此接口，如果返回 isInput=false
   * 则提示用户将光标移入输入框后再执行。
   *
   * 返回值：
   *   isInput    — 是否为任何可输入区域（含 contenteditable）
   *   isEditable — 是否明确可编辑（AXEditable=true 或 native role）
   *   role       — AX Role 字符串，如 "AXTextField" / "AXWebArea"
   */
  async system_isFocusedInInputArea(): Promise<{ isInput: boolean; isEditable: boolean; role: string }> {
    console.log('[SystemController] isFocusedInInputArea called');
    const focusedWin = BrowserWindow.getFocusedWindow();
    if (focusedWin) {
      try {
        const isInput = await focusedWin.webContents.executeJavaScript(`
          (() => {
            let el = document.activeElement;
            while (el && el.shadowRoot && el.shadowRoot.activeElement) {
              el = el.shadowRoot.activeElement;
            }
            if (!el) return false;
            const tagName = el.tagName.toLowerCase();
            if (tagName === 'input' || tagName === 'textarea') return true;
            if (el.contentEditable === 'true' || el.contentEditable === 'plaintext-only') return true;
            if (el.getAttribute('role') === 'textbox') return true;
            
            let parent = el;
            while (parent && parent !== document.body) {
              if (parent.contentEditable === 'true' || parent.contentEditable === 'plaintext-only') return true;
              parent = parent.parentElement;
            }
            return false;
          })()
        `);
        console.log('[SystemController] Focused inside Electron window, JS input detection:', isInput);
        return { isInput: !!isInput, isEditable: !!isInput, role: isInput ? 'AXTextArea' : '' };
      } catch (err) {
        console.error('[SystemController] Failed to check focus in Electron window:', err);
      }
    }

    const hook = getMouseHook();
    if (hook && hook.isFocusedInInputArea) {
      try {
        const result = hook.isFocusedInInputArea();
        console.log('[SystemController] isFocusedInInputArea result:', result);
        return result;
      } catch (err) {
        console.error('[SystemController] Failed to call native isFocusedInInputArea:', err);
      }
    } else {
      console.warn('[SystemController] isFocusedInInputArea is not supported on this platform/addon');
    }
    return { isInput: false, isEditable: false, role: '' };
  }


  /**
   * 向当前焦点输入框插入文本。自动检测输入区域类型，按优先级尝试：
   * 1. IPC 直发（同应用窗口）2. 模拟键盘输入 3. Accessibility API 注入 4. 剪贴板粘贴。
   * 插入前会自动恢复之前缓存的活动应用焦点。失败时将文本写入剪贴板作为安全备份。
   * @param options text — 要插入的文本
   * @returns 是否插入成功
   * @example
   * await callApi('system', 'insertText', [{ text: 'Hello World' }]);
   */
  async system_insertText(options: { text: string }): Promise<boolean> {
    console.log(`[SystemController] insertText called with text length: ${options.text?.length}`);
    if (!options || typeof options.text !== 'string') {
      throw new Error('system.insertText requires a text parameter');
    }

    const hook = getMouseHook();

    // 1. Focus restoration: if we have a stashed target PID, reactivate it first
    const stashedPid = cache.get('lastActiveAppPid') as string | null;
    if (stashedPid) {
      console.log(`[SystemController] Restoring focus to stashed active app PID: ${stashedPid}`);
      try {
        if (hook && hook.activeWindow) {
          hook.activeWindow(stashedPid);
          // Give the OS window manager a brief moment to complete the focus transition
          await new Promise((resolve) => setTimeout(resolve, 80));
        }
      } catch (err) {
        console.error('[SystemController] Failed to restore focus to stashed PID:', err);
      }
      // Clear stashed PID
      cache.set('lastActiveAppPid', null);
    }

    let success = false;
    let viaAX = false;
    let viaTyping = false;
    let viaIPC = false;

    // A. If the focused window belongs to our own Electron application, insert via direct IPC
    const focusedWin = BrowserWindow.getFocusedWindow();
    if (focusedWin && !focusedWin.isDestroyed()) {
      try {
        const url = focusedWin.webContents.getURL();
        if (url && url.includes('fn-voice-panel')) {
          console.log('[SystemController:insertText] Focused window is the voice panel itself, bypassing direct IPC');
        } else {
          console.log('[SystemController:insertText] Direct IPC target: Our own app window found. Sending system:insert-text-direct event...');
          focusedWin.webContents.send('system:insert-text-direct', { text: options.text });
          success = true;
          viaIPC = true;
          return true;
        }
      } catch (err) {
        console.error('[SystemController:insertText] Failed to route insert text via direct IPC:', err);
      }
    }

    if (!hook) {
      console.error('[SystemController:insertText] MouseHook native module not loaded, cannot insert text!');
      return false;
    }

    // B. Check if the active window actually has a focused input field right now (for external apps)
    let isInputArea = false;
    if (hook.isFocusedInInputArea) {
      try {
        const focusInfo = hook.isFocusedInInputArea();
        isInputArea = focusInfo.isInput;
        console.log(`[SystemController:insertText:focus-debug] Target focus verification: isInput=${focusInfo.isInput}, isEditable=${focusInfo.isEditable}, role="${focusInfo.role}"`);
      } catch (err) {
        console.error('[SystemController:insertText:focus-debug] Failed to query isFocusedInInputArea:', err);
      }
    }

    if (!isInputArea) {
      // Enhanced diagnostics: log everything we know about the current focus state
      const frontmostAppId = hook?.getFrontmostAppId?.() || 'N/A';
      const frontmostPid = hook?.getFrontmostAppPid?.() || 'N/A';
      const focusInfoRetry = hook?.isFocusedInInputArea?.();
      console.warn(
        `[SystemController:insertText:focus-debug] Insertion validation FAILED — entering copy-fallback. Diagnostics:\n` +
        `  restoredPid: ${stashedPid || 'N/A'}\n` +
        `  frontmostAppId: ${frontmostAppId}\n` +
        `  frontmostPid: ${frontmostPid}\n` +
        `  focusInfo: ${JSON.stringify(focusInfoRetry)}\n` +
        `  textLength: ${options.text.length}`
      );
      // Copy to clipboard as safety backup
      try {
        clipboard.writeText(options.text);
        console.log('[SystemController:insertText:focus-debug] Text copied to clipboard as a safety backup');
      } catch (clipErr) {
        console.error('[SystemController:insertText:focus-debug] Failed to write backup to clipboard:', clipErr);
      }
      return false;
    }

    // 1. Try Simulated Typing (Keyboard simulation) - safest and most reliable for React/Monaco/Electron/Web editors
    if (!success && hook.simulateTyping) {
      console.log(`[SystemController:insertText] Mode [1/3] - Attempting native simulated typing for text of length: ${options.text.length}`);
      try {
        hook.simulateTyping(options.text);
        success = true;
        viaTyping = true;
        console.log('[SystemController:insertText] Native simulated typing successfully posted to OS event queue');
      } catch (err) {
        console.error('[SystemController:insertText] Native simulated typing failed:', err);
      }
    }

    // 2. Fallback to Accessibility API (AXUIElement)
    if (!success && hook.insertTextViaAX) {
      console.log('[SystemController:insertText] Mode [2/3] - Fallback to Accessibility AXUIElement injection...');
      try {
        success = hook.insertTextViaAX(options.text);
        if (success) {
          console.log('[SystemController:insertText] Text successfully injected via AXUIElement (Accessibility API)');
          viaAX = true;
        } else {
          console.warn('[SystemController:insertText] AXUIElement injection returned false (not editable or element lost)');
        }
      } catch (err) {
        console.error('[SystemController:insertText] AXUIElement injection failed with exception:', err);
      }
    }

    // 3. Absolute Fallback to Clipboard Paste
    if (!success) {
      console.log('[SystemController:insertText] Mode [3/3] - Fallback to Clipboard Copy & Paste Keystroke...');
      try {
        const oldText = clipboard.readText();
        clipboard.writeText(options.text);
        if (hook.simulatePasteKeystroke) {
          console.log('[SystemController:insertText] Simulating Cmd+V/Ctrl+V keystroke...');
          hook.simulatePasteKeystroke();
          success = true;
        } else {
          console.warn('[SystemController:insertText] simulatePasteKeystroke is not supported, skipping keyboard paste simulation');
        }
        setTimeout(() => {
          console.log('[SystemController:insertText] Restoring original clipboard text...');
          clipboard.writeText(oldText);
        }, 150);
      } catch (err) {
        console.error('[SystemController:insertText] Clipboard copy-paste fallback failed:', err);
      }
    }

    console.log(`[SystemController:insertText] Insertion session completed. Success: ${success}, Method: ${viaIPC ? 'IPC' : viaTyping ? 'Typing' : viaAX ? 'AX' : success ? 'Clipboard' : 'None'}`);

    // 3. Optional Auto-Send Enter simulation
    if (success && cache.get(CacheAttribute.prefFnAutoSendEnabled) === true) {
      const delay = viaAX ? 50 : 150;
      setTimeout(() => {
        if (hook.simulateEnterKeystroke) {
          console.log(`[SystemController] Simulating Enter key after ${delay}ms`);
          hook.simulateEnterKeystroke();
        } else {
          console.warn('[SystemController] simulateEnterKeystroke is not supported');
        }
      }, delay);
    }

    return success;
  }

  /**
   * 打开捕获窗口用于网页截屏/数据抓取。headless=true 时不可见，等待页面加载后返回。
   * @param url 要加载的 URL
   * @param token 捕获令牌（用于后续 triggerCapture / closeCaptureWindow）
   * @param headless 是否无头模式，默认 false
   */
  async system_openCaptureWindow(url: string, token: string, headless?: boolean): Promise<boolean> {
    const existing = captureWindows.get(token);
    if (existing && !existing.isDestroyed()) {
      try {
        existing.close();
      } catch (e) {
        console.error('[PluginBridge] Failed to close existing capture window:', e);
      }
    }

    const captureWin = new BrowserWindow({
      width: 1024,
      height: 768,
      show: !headless,
      webPreferences: {
        contextIsolation: true,
        nodeIntegration: false,
      }
    });

    if (headless) {
      captureWin.webContents.setWindowOpenHandler(() => ({ action: 'deny' }));
    }

    captureWindows.set(token, captureWin);

    captureWin.on('closed', () => {
      captureWindows.delete(token);
      const mainWin = ElectronMainWindow.getInstance().getWindow();
      if (mainWin && !mainWin.isDestroyed()) {
        mainWin.webContents.send('npx-tools:capture-window-closed', { token });
      }
    });

    if (headless) {
      await new Promise<void>((resolve, reject) => {
        const timeout = setTimeout(() => {
          reject(new Error(`[openCaptureWindow] Page load timeout (30s) for: ${url}`));
        }, 30000);

        captureWin.webContents.once('did-finish-load', () => {
          clearTimeout(timeout);
          resolve();
        });

        captureWin.webContents.on('did-fail-load', (_event, errCode, errDesc) => {
          clearTimeout(timeout);
          reject(new Error(`[openCaptureWindow] Page load failed: ${errCode} ${errDesc}`));
        });

        captureWin.loadURL(url).catch(reject);
      });
      return true;
    }

    captureWin.loadURL(url);
    return true;
  }

  /**
   * 触发捕获窗口截取页面 HTML 并关闭窗口。
   * @param token 捕获令牌
   * @returns 页面完整 HTML
   */
  async system_triggerCapture(token: string): Promise<string> {
    const captureWin = captureWindows.get(token);
    if (!captureWin || captureWin.isDestroyed()) {
      throw new Error('Capture window not found or already closed');
    }

    const html = await captureWin.webContents.executeJavaScript('document.documentElement.outerHTML');
    try {
      captureWin.close();
    } catch (e) {
      console.error('[PluginBridge] Failed to close capture window on triggerCapture:', e);
    }
    return html;
  }

  /**
   * 强制关闭指定令牌的捕获窗口。
   * @param token 捕获令牌
   */
  async system_closeCaptureWindow(token: string): Promise<boolean> {
    const captureWin = captureWindows.get(token);
    if (captureWin && !captureWin.isDestroyed()) {
      try {
        captureWin.close();
      } catch (e) {
        console.error('[PluginBridge] Failed to close capture window on closeCaptureWindow:', e);
      }
    }
    return true;
  }

  /**
   * 在桌面创建插件快捷方式（Windows .lnk / macOS .webloc / Linux .desktop）。
   * @param options name — 名称，icon — 图标路径（可选），description — 描述（可选）
   * @returns 创建成功返回 true
   * @example
   * await callApi("system", "createDesktopShortcut", [{ name: "我的插件" }]);
   */
  async system_createDesktopShortcut(options: { name: string; icon?: string; description?: string }, context: ApiContext): Promise<boolean> {
    const desktopPath = app.getPath('desktop');
    try {
      if (process.platform === 'win32') {
        const lnkPath = join(desktopPath, `${options.name}.lnk`);
        const execPath = process.execPath;
        const iconPath = options.icon || join(app.getAppPath(), 'dist', 'icon.ico');
        const tempVbsPath = join(app.getPath('temp'), `shortcut-${Date.now()}.vbs`);

        const vbsContent = [
          'Set WshShell = CreateObject("WScript.Shell")',
          `Set Shortcut = WshShell.CreateShortcut("${lnkPath.replace(/\\/g, '\\\\')}")`,
          `Shortcut.TargetPath = "${execPath.replace(/\\/g, '\\\\')}"`,
          `Shortcut.Arguments = "--run-plugin=${context.pluginId} --silent"`,
          `Shortcut.IconLocation = "${iconPath.replace(/\\/g, '\\\\')}"`,
          'Shortcut.Save'
        ].join('\r\n');

        await fs.writeFile(tempVbsPath, vbsContent, 'utf-8');
        const { exec } = await import('child_process');
        await new Promise((resolve, reject) => {
          exec(`cscript.exe //NoLogo "${tempVbsPath}"`, (error) => {
            fs.unlink(tempVbsPath).catch(() => {});
            if (error) reject(error);
            else resolve(true);
          });
        });
        return true;
      } else if (process.platform === 'darwin') {
        const weblocPath = join(desktopPath, `${options.name}.webloc`);
        const scheme = !app.isPackaged ? 'berrytrace-dev' : 'berrytrace';
        const weblocContent = `<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE plist PUBLIC "-//Apple//DTD PLIST 1.0//EN" "http://www.apple.com/DTDs/PropertyList-1.0.dtd">
<plist version="1.0">
<dict>
	<key>URL</key>
	<string>${scheme}://open-plugin?id=${context.pluginId}&amp;silent=true</string>
</dict>
</plist>`;
        await fs.writeFile(weblocPath, weblocContent, 'utf-8');
        return true;
      } else {
        const desktopFilePath = join(desktopPath, `${options.name}.desktop`);
        const iconPath = options.icon || '';
        const execPath = process.execPath;
        const desktopContent = `[Desktop Entry]
Name=${options.name}
Exec="${execPath}" --run-plugin=${context.pluginId} --silent
Icon=${iconPath}
Type=Application
Terminal=false
Categories=Utility;`;
        await fs.writeFile(desktopFilePath, desktopContent, { encoding: 'utf-8', mode: 0o755 });

        const appsPath = join(app.getPath('home'), '.local', 'share', 'applications');
        await fs.mkdir(appsPath, { recursive: true }).catch(() => {});
        const localDesktopPath = join(appsPath, `berrytrace-plugin-${context.pluginId}.desktop`);
        await fs.writeFile(localDesktopPath, desktopContent, { encoding: 'utf-8', mode: 0o755 });
        return true;
      }
    } catch (err) {
      console.error('[SystemController:createDesktopShortcut] Failed to create shortcut:', err);
      return false;
    }
  }

  /**
   * 设置插件的系统托盘菜单。首次调用自动创建托盘图标。
   * @param menuTemplate 菜单项数组，每项包含 label、type（normal/separator/checkbox）、clickCommand
   * @example
   * await callApi("system", "setTrayMenu", [{ menuTemplate: [{ label: "打开", clickCommand: "open" }] }]);
   */
  async system_setTrayMenu(menuTemplate: Array<{ label: string; type?: 'normal' | 'separator' | 'checkbox'; checked?: boolean; clickCommand: string }>, context: ApiContext): Promise<boolean> {
    try {
      let tray = this.trays.get(context.pluginId);
      if (!tray) {
        const { oemManager } = await import('../../services/oem-manager');
        const oemLogo = oemManager.getConfig().logoPath;
        const iconPath = oemLogo && fsSync.existsSync(oemLogo)
          ? oemLogo
          : app.isPackaged
          ? join(app.getAppPath(), 'dist', process.platform === 'win32' ? 'icon.ico' : 'icon.png')
          : join(app.getAppPath(), 'public', process.platform === 'win32' ? 'icon.ico' : 'icon.png');
        tray = new Tray(iconPath);
        this.trays.set(context.pluginId, tray);
      }

      const template = menuTemplate.map(item => {
        if (item.type === 'separator') {
          return { type: 'separator' as const };
        }
        return {
          label: item.label,
          type: item.type as 'normal' | 'separator' | 'submenu' | 'checkbox' | 'radio',
          checked: item.checked,
          click: () => {
            const dispatcher = ApiDispatcher.getInstance();
            dispatcher.dispatch(context.pluginId, 'commands', 'execute', [item.clickCommand]).catch((err: unknown) => {
              console.error('[TrayMenu] Failed to execute clickCommand:', item.clickCommand, err);
            });
          }
        };
      });

      template.push({ type: 'separator' as const });
      template.push({
        label: `关闭 ${context.pluginId}`,
        type: 'normal' as const,
        checked: undefined,
        click: async () => {
          tray?.destroy();
          this.trays.delete(context.pluginId);
          const { ElectronFloatWeb } = await import('../../windows/float-web');
          ElectronFloatWeb.getInstance().closePluginWindows(context.pluginId);
        }
      });

      const contextMenu = Menu.buildFromTemplate(template);
      tray.setContextMenu(contextMenu);
      const { oemManager } = await import('../../services/oem-manager');
      const appName = oemManager.getConfig().appName || '莓莓印记';
      tray.setToolTip(`${appName}插件: ${context.pluginId}`);
      return true;
    } catch (err) {
      console.error('[SystemController:setTrayMenu] Failed to set tray menu:', err);
      return false;
    }
  }

  /**
   * 注册全局快捷键，按下时自动执行指定的 commandId。
   * @param accelerator 快捷键（如 "CmdOrCtrl+Shift+K"）
   * @param commandId 触发时执行的命令 ID
   * @returns 注册成功返回 true
   */
  async system_registerGlobalShortcut(accelerator: string, commandId: string, context: ApiContext): Promise<boolean> {
    try {
      console.log(`⌨️ [GlobalShortcut:Register] Plugin "${context.pluginId}" registering global shortcut "${accelerator}" -> command "${commandId}"`);
      const isRegistered = globalShortcut.register(accelerator, () => {
        console.log(`⌨️ [GlobalShortcut:Triggered] [${new Date().toISOString()}] Accelerator "${accelerator}" fired -> executing command "${commandId}" (plugin: ${context.pluginId})`);
        const dispatcher = ApiDispatcher.getInstance();
        dispatcher.dispatch(context.pluginId, 'commands', 'execute', [commandId]).catch((err: unknown) => {
          console.error('❌ [GlobalShortcut:Error] Failed to execute hotkey command:', commandId, err);
        });
      });
      console.log(`⌨️ [GlobalShortcut:Register] Status for "${accelerator}": ${isRegistered ? 'SUCCESS ✅' : 'FAILED/OCCUPIED ❌'}`);
      return isRegistered;
    } catch (err) {
      console.error('❌ [GlobalShortcut:Register:Error] Registration failed for accelerator:', accelerator, err);
      return false;
    }
  }

  /**
   * 注销全局快捷键。
   * @param accelerator 快捷键
   */
  async system_unregisterGlobalShortcut(accelerator: string): Promise<null> {
    console.log(`⌨️ [GlobalShortcut:Unregister] Unregistering accelerator "${accelerator}"`);
    globalShortcut.unregister(accelerator);
    return null;
  }

  /**
   * 注册快捷动作（显示在快捷键列表 UI 中）。必须在后台进程注册。
   * @param options id — 唯一 ID，label — 显示名称，icon — 图标（可选）
   */
  async system_registerShortcutAction(options: { id: string; label: string; icon?: string }, context: ApiContext): Promise<void> {
    const { getShortcutActionRegistry } = await import('../../services/shortcut-action-registry.js');
    const registry = getShortcutActionRegistry();
    const dispatcher = ApiDispatcher.getInstance();
    registry.register({
      id: options.id,
      label: options.label,
      icon: options.icon || '⚡',
      pluginId: context.pluginId,
      handler: () => {
        dispatcher.dispatch(context.pluginId, 'commands', 'execute', [options.id]).catch((err: unknown) => {
          console.error('[ShortcutAction] Failed to execute command:', options.id, err);
        });
      },
    });
  }

  /**
   * 注销快捷动作。
   * @param id 快捷动作 ID
   */
  async system_unregisterShortcutAction(id: string): Promise<void> {
    const { getShortcutActionRegistry } = await import('../../services/shortcut-action-registry.js');
    const registry = getShortcutActionRegistry();
    registry.unregister(id);
  }

  /**
   * 列出所有已注册的快捷动作。
   */
  async system_listShortcutActions(): Promise<Array<{ id: string; label: string; icon: string; pluginId: string }>> {
    const { getShortcutActionRegistry } = await import('../../services/shortcut-action-registry.js');
    const registry = getShortcutActionRegistry();
    return registry.listActions().map(a => ({ id: a.id, label: a.label, icon: a.icon, pluginId: a.pluginId }));
  }

  /**
   * 设置窗口鼠标事件穿透（用于桌面特效等场景）。
   * @param ignore 是否忽略鼠标事件
   * @param options forward — 是否将事件转发到下层窗口
   */
  async system_setIgnoreMouseEvents(ignore: boolean, options: { forward: boolean } | undefined, context: ApiContext): Promise<null> {
    const targetWin = context.sender ? BrowserWindow.fromWebContents(context.sender) : (BrowserWindow.getFocusedWindow() || ElectronMainWindow.getInstance().getWindow());
    if (targetWin && !targetWin.isDestroyed()) {
      targetWin.setIgnoreMouseEvents(ignore, options);
    }
    return null;
  }

  // ── dialog namespace ──

  /**
   * 打开原生文件保存对话框。
   * @param options Electron SaveDialogOptions
   * @returns { filePath, canceled }
   * @example
   * await callApi("dialog", "showSaveDialog", [{ defaultPath: "/path/to/file.md" }]);
   */
  async dialog_showSaveDialog(options: SaveDialogOptions): Promise<unknown> {
    const focusedWindow = BrowserWindow.getFocusedWindow();
    if (focusedWindow) {
      return dialog.showSaveDialog(focusedWindow, options);
    }
    return dialog.showSaveDialog(options);
  }

  /**
   * 打开原生文件/目录选择对话框。
   * @param options Electron OpenDialogOptions
   * @example
   * await callApi("dialog", "showOpenDialog", [{ properties: ["openFile", "multiSelections"] }]);
   */
  async dialog_showOpenDialog(options: OpenDialogOptions): Promise<unknown> {
    const focusedWindow = BrowserWindow.getFocusedWindow();
    if (focusedWindow) {
      return dialog.showOpenDialog(focusedWindow, options);
    }
    return dialog.showOpenDialog(options);
  }

