  // ── window namespace ──

  /**
   * 开始窗口拖拽（macOS 专用）。
   */
  async window_startDrag(context: ApiContext): Promise<null> {
    const targetWin = context.sender ? BrowserWindow.fromWebContents(context.sender) : (BrowserWindow.getFocusedWindow() || ElectronMainWindow.getInstance().getWindow());
    if (targetWin && !targetWin.isDestroyed()) {
      const targetWinWithDrag = targetWin as unknown as { performDrag?: () => void };
      if (typeof targetWinWithDrag.performDrag === 'function') {
        targetWinWithDrag.performDrag();
      } else {
        console.log('[PluginBridge] performDrag is not supported on this platform/version');
      }
    }
    return null;
  }

  /**
   * 相对移动当前窗口。
   * @param deltaX 水平偏移像素
   * @param deltaY 垂直偏移像素
   * @example
   * await callApi("window", "move", [{ deltaX: 100, deltaY: 50 }]);
   */
  async window_move(deltaX: number, deltaY: number, context: ApiContext): Promise<null> {
    const targetWin = context.sender ? BrowserWindow.fromWebContents(context.sender) : (BrowserWindow.getFocusedWindow() || ElectronMainWindow.getInstance().getWindow());
    if (targetWin && !targetWin.isDestroyed()) {
      const [x, y] = targetWin.getPosition();
      targetWin.setPosition(Math.round(x + deltaX), Math.round(y + deltaY), false);
    }
    return null;
  }

  /**
   * 最大化/还原当前窗口。
   */
  async window_maximize(context: ApiContext): Promise<null> {
    const targetWin = context.sender ? BrowserWindow.fromWebContents(context.sender) : (BrowserWindow.getFocusedWindow() || ElectronMainWindow.getInstance().getWindow());
    if (targetWin && !targetWin.isDestroyed()) {
      if (targetWin.isMaximized()) {
        targetWin.unmaximize();
      } else {
        targetWin.maximize();
      }
    }
    return null;
  }

  /**
   * 关闭窗口。不传 floatId 关闭当前窗口，传 floatId 关闭指定浮动窗口。
   * @param floatId 浮动窗口 ID（从 window_create 获取，可选）
   */
  async window_close(floatId?: string, context?: ApiContext): Promise<null> {
    if (floatId) {
      if (this.floatWindows.has(floatId)) {
        const win = this.floatWindows.get(floatId)!;
        if (!win.isDestroyed()) win.close();
        this.floatWindows.delete(floatId);
      } else {
        console.warn(`[SystemController] floatId="${floatId}" not found in floatWindows, ignoring close request to protect main window.`);
      }
      return null;
    }
    const targetWin = context?.sender ? BrowserWindow.fromWebContents(context.sender) : (BrowserWindow.getFocusedWindow() || ElectronMainWindow.getInstance().getWindow());
    if (targetWin && !targetWin.isDestroyed()) {
      targetWin.close();
    }
    return null;
  }

  /**
   * 最小化当前窗口。
   */
  async window_minimize(context: ApiContext): Promise<null> {
    const targetWin = context.sender ? BrowserWindow.fromWebContents(context.sender) : (BrowserWindow.getFocusedWindow() || ElectronMainWindow.getInstance().getWindow());
    if (targetWin && !targetWin.isDestroyed()) {
      targetWin.minimize();
    }
    return null;
  }



  /**
   * 创建浮动窗口。支持 url / blob: / file: 协议，自动注入 winId 参数。
   * @param opts url — 页面 URL，width/height — 尺寸（默认 800x600），alwaysOnTop — 置顶，transparent — 透明，frame — 标题栏，ignoreMouseEvents — 鼠标穿透
   * @returns 窗口 ID（用于后续 show/hide/close/getState）
   * @example
   * const winId = await callApi("window", "create", [{ url: "popup.html", width: 600, height: 400, alwaysOnTop: true }]);
   */
  async window_create(opts: FloatWindowOptions, context: ApiContext): Promise<string> {
    const url = String(opts.url || 'about:blank');

    let isNativeElectron = false;
    if (context.pluginId) {
      try {
        const { PluginManager } = await import('../plugin-manager');
        const plugin = PluginManager.getInstance().getPlugin(context.pluginId);
        if (plugin?.manifest?.nativeElectron === true) {
          isNativeElectron = true;
        }
      } catch (err) {
        console.error('[Window] Failed to check plugin nativeElectron manifest:', err);
      }
    }

    const { url: _u, ignoreMouseEvents: _i, ...restOpts } = opts;
    const preloadPath = join(__dirname, 'plugin-preload.cjs');

    const win = new BrowserWindow({
      width: 800,
      height: 600,
      ...restOpts,
      webPreferences: isNativeElectron ? {
        nodeIntegration: true,
        contextIsolation: false,
        sandbox: false,
        webSecurity: false,
        preload: preloadPath,
      } : {
        contextIsolation: true,
        nodeIntegration: false,
        sandbox: true,
        preload: preloadPath,
      },
    });

    if (opts.ignoreMouseEvents === true) {
      win.setIgnoreMouseEvents(true, { forward: true });
    }

    const winId = `float-${context.pluginId}-${Date.now()}-${Math.random().toString(36).slice(2, 8)}`;
    this.floatWindows.set(winId, win);

    // 建立 pluginId → winId 反向索引，保证插件被 kill 时能主动关闭孤窗
    if (context.pluginId) {
      if (!this.pluginFloatWindows.has(context.pluginId)) {
        this.pluginFloatWindows.set(context.pluginId, new Set());
      }
      this.pluginFloatWindows.get(context.pluginId)!.add(winId);
    }

    win.on('closed', () => {
      this.floatWindows.delete(winId);
      // 窗口自然关闭时清理反向索引
      if (context.pluginId) {
        this.pluginFloatWindows.get(context.pluginId)?.delete(winId);
      }
    });

    // Append winId to URL query string so the child window renderer can identify its winId
    let finalUrl = url;
    if (!url.startsWith('data:')) {
      try {
        const urlObj = new URL(url);
        urlObj.searchParams.set('winId', winId);
        finalUrl = urlObj.toString();
      } catch {
        const separator = url.includes('?') ? '&' : '?';
        finalUrl = `${url}${separator}winId=${winId}`;
      }
    }

    win.loadURL(finalUrl);
    return winId;
  }

  /**
   * 按 pluginId 强制关闭该插件创建的所有浮层窗口。
   * 主要用于 background 插件被 kill 时无法执行 deactivate()，
   * 导致窗口孤立的场景。由 _performPluginUnloadCleanup 调用。
   */
  public closePluginFloatWindows(pluginId: string): void {
    const winIds = this.pluginFloatWindows.get(pluginId);
    if (!winIds || winIds.size === 0) return;
    console.log(`[SystemController] 🔒 Force-closing ${winIds.size} float window(s) for plugin "${pluginId}" (deactivate bypass)`);
    for (const winId of Array.from(winIds)) {
      const win = this.floatWindows.get(winId);
      if (win && !win.isDestroyed()) {
        try {
          win.close();
        } catch (_err) {
          /* ignore close error */
        }
      }
      this.floatWindows.delete(winId);
    }
    this.pluginFloatWindows.delete(pluginId);
  }

  /**
   * 显示指定浮动窗口。
   * @param winId 窗口 ID
   */
  async window_show(winId: string): Promise<null> {
    const win = this.floatWindows.get(winId);
    if (win && !win.isDestroyed()) win.show();
    return null;
  }

  /**
   * 隐藏指定浮动窗口。
   * @param winId 窗口 ID
   */
  async window_hide(winId: string): Promise<null> {
    const win = this.floatWindows.get(winId);
    if (win && !win.isDestroyed()) win.hide();
    return null;
  }

  /**
   * 获取浮动窗口状态。
   * @param winId 窗口 ID
   * @returns { id, visible, bounds: { x, y, width, height }, alwaysOnTop }
   */
  async window_getState(winId: string): Promise<unknown> {
    const win = this.floatWindows.get(winId);
    if (!win || win.isDestroyed()) return null;
    const bounds = win.getBounds();
    return {
      id: winId,
      visible: win.isVisible(),
      bounds: { x: bounds.x, y: bounds.y, width: bounds.width, height: bounds.height },
      alwaysOnTop: win.isAlwaysOnTop(),
    };
  }

  /**
   * 获取浮动窗口的原生操作系统句柄（HWND on Windows, NSWindow* on macOS）。
   * 通用窗口管理基础设施 — 可用于 ffmpeg 窗口捕获、自动化测试、外设绑定等场景。
   */
  async window_getNativeHandle(opts: { winId: string }): Promise<{
    handle: number;
    platform: string;
    title: string;
  }> {
    const win = this.floatWindows.get(opts.winId);
    if (!win || win.isDestroyed()) {
      throw new Error(`[System:getNativeHandle] Float window not found or destroyed: ${opts.winId}`);
    }

    if (process.platform === 'win32') {
      const buf = win.getNativeWindowHandle();
      // On x64 Windows, handle is 8 bytes; on 32-bit, 4 bytes
      const hwnd = typeof (buf as unknown as Record<string, unknown>).readBigUInt64LE === 'function'
        ? (buf as Buffer).readBigUInt64LE(0)
        : buf.readUInt32LE(0);
      addLog('info', 'System', `[System:getNativeHandle] win32 HWND=${hwnd} title="${win.getTitle()}"`);
      return { handle: Number(hwnd), platform: 'win32', title: win.getTitle() };
    }

    if (process.platform === 'darwin') {
      const winId = win.getNativeWindowHandle().readUInt32LE(0);
      addLog('info', 'System', `[System:getNativeHandle] darwin windowId=${winId} title="${win.getTitle()}"`);
      return { handle: winId, platform: 'darwin', title: win.getTitle() };
    }

    throw new Error(`[System:getNativeHandle] Unsupported platform: ${process.platform}`);
  }

  /**
   * 动态更新浮动窗口属性（尺寸、位置、置顶、可缩放）。
   * @param targetWindowId 窗口 ID
   * @param options width/height/x/y/alwaysOnTop/resizable
   */
  async window_updateWindowOptions(targetWindowId: string, options: {
    width?: number;
    height?: number;
    x?: number;
    y?: number;
    alwaysOnTop?: boolean;
    resizable?: boolean;
  }): Promise<null> {
    let win = this.floatWindows.get(targetWindowId);
    if (!win || win.isDestroyed()) {
      const { ElectronFloatWeb } = await import('../../windows/float-web');
      const floatWeb = ElectronFloatWeb.getInstance();
      const instance = floatWeb.getFloatWebWindowInstance(targetWindowId);
      if (instance && !instance.win.isDestroyed()) {
        win = instance.win;
      }
    }

    if (win && !win.isDestroyed()) {
      if (options.width !== undefined || options.height !== undefined) {
        const size = win.getSize();
        const w = options.width !== undefined ? options.width : size[0];
        const h = options.height !== undefined ? options.height : size[1];
        win.setSize(w, h);
      }
      if (options.x !== undefined || options.y !== undefined) {
        const pos = win.getPosition();
        const x = options.x !== undefined ? options.x : pos[0];
        const y = options.y !== undefined ? options.y : pos[1];
        win.setPosition(x, y);
      }
      if (options.alwaysOnTop !== undefined) {
        win.setAlwaysOnTop(options.alwaysOnTop);
      }
      if (options.resizable !== undefined) {
        win.setResizable(options.resizable);
      }
    }
    return null;
  }

  /**
   * 禁用/启用窗口默认拖拽行为。
   * @param disabled true 为禁用
   */
  async window_disableDefaultDrag(disabled: boolean, context: ApiContext): Promise<null> {
    if (context.sender && !context.sender.isDestroyed()) {
      context.sender.send('window:set-default-drag', disabled);
    }
    return null;
  }

  // ── user namespace ──

  /**
   * 查询当前用户会员状态。
   * @returns { isVip, points }
   */
  async user_getMembershipStatus(): Promise<unknown> {
    const { HookRegistry } = await import('../hook-registry.js');
    try {
      const result = await HookRegistry.getInstance().call('user:getMembershipStatus', []);
      if (result) {
        return result;
      }
    } catch (err) {
      console.error('[SystemController] Failed to call user:getMembershipStatus hook:', err);
    }
    return {
      isVip: false
    };
  }

  async user_setUser(user: { id: string; name: string }): Promise<void> {
    const { ElectronAuthManager } = await import('../../services/auth-manager');
    ElectronAuthManager.getInstance().setUser(user);
  }

  async user_getUser(): Promise<{ id: string; name: string } | null> {
    const { ElectronAuthManager } = await import('../../services/auth-manager');
    return ElectronAuthManager.getInstance().getUser();
  }

  async user_setLoggedIn(loggedIn: boolean): Promise<void> {
    const { ElectronAuthManager } = await import('../../services/auth-manager');
    ElectronAuthManager.getInstance().setLoggedIn(loggedIn);
  }

  async user_isLoggedIn(): Promise<boolean> {
    const { ElectronAuthManager } = await import('../../services/auth-manager');
    return ElectronAuthManager.getInstance().isLoggedIn();
  }

  // ── commands namespace ──

  /**
   * 注册命令。
   * @param options id — 命令 ID（可选，不传自动生成），返回命令 ID
   */
  async commands_register(options: { id?: string } | undefined, _context: ApiContext): Promise<string> {
    const id = options?.id || `cmd:${Date.now()}:${Math.random().toString(36).slice(2, 6)}`;
    console.log(`[SystemController] commands_register: ${id}`);
    return id;
  }

  /**
   * 注销命令。
   * @param id 命令 ID
   */
  async commands_unregister(id: string, _context: ApiContext): Promise<void> {
    console.log(`[SystemController] commands_unregister: ${id}`);
  }

  /**
   * 执行命令，广播到所有渲染进程和后台进程。
   * @param id 命令 ID
   * @param args 命令参数（可选）
   */
  async commands_execute(id: string, args?: Record<string, unknown>, _context?: ApiContext): Promise<void> {
    console.log(`[SystemController] commands_execute: ${id} args=`, args);

    // Hook 截流：调用 commands:beforeExecute
    try {
      const { HookRegistry } = await import('../hook-registry');
      const hookResult = await HookRegistry.getInstance().call(
        'commands:beforeExecute',
        [{ commandId: id, commandArgs: args }],
        _context?.sender,
        false,  // merge=false: 返回第一个结果
        3000,
      );

      if (hookResult && typeof hookResult === 'object' && (hookResult as Record<string, unknown>).block) {
        console.log(`[SystemController] 命令 "${id}" 被 hook 截流:`, (hookResult as Record<string, unknown>).reason || 'no reason');
        return;
      }
    } catch (err) {
      console.warn('[SystemController] commands:beforeExecute hook 调用失败:', err);
    }

    // Broadcast "commands:execute" event to renderer windows
    const windows = BrowserWindow.getAllWindows().filter((win) => !win.isDestroyed());
    console.log(`[SystemController] Broadcasting commands:execute "${id}" to ${windows.length} windows`);
    windows.forEach((win) => {
      win.webContents.send('commands:execute', { commandId: id, args });
    });

    // Notify background utility processes
    try {
      const { PluginLauncher } = await import('../plugin-launcher');
      const backgroundProcesses = PluginLauncher.getInstance().getBackgroundProcesses();
      console.log(`[SystemController] Notifying ${backgroundProcesses.size} background processes of command: ${id}`);
      for (const [, proc] of backgroundProcesses.entries()) {
        proc.sendMessage({
          type: 'sdk:events:on',
          eventName: 'commands:execute',
          payload: { commandId: id, args }
        });
      }
    } catch (err) {
      console.error('[SystemController] Failed to notify background processes of command:', id, err);
    }
  }

  /**
   * 获取当前系统的屏幕布局信息。
   */
  async system_getDisplays(): Promise<Array<{ id: number; bounds: { x: number; y: number; width: number; height: number }; scaleFactor: number; isPrimary: boolean }>> {
    try {
      const { screen } = await import('electron');
      const displays = screen.getAllDisplays();
      const primaryId = screen.getPrimaryDisplay().id;
      return displays.map(d => ({
        id: d.id,
        bounds: { x: d.bounds.x, y: d.bounds.y, width: d.bounds.width, height: d.bounds.height },
        scaleFactor: d.scaleFactor,
        isPrimary: d.id === primaryId
      }));
    } catch (err) {
      console.error('[SystemController] system_getDisplays failed:', err);
      throw err;
    }
  }

  /**
   * 列出当前系统的所有打开窗口。
   */
  async system_listWindows(): Promise<Array<{ id: number; title: string; appName: string; x: number; y: number; width: number; height: number; isMinimized: boolean }>> {
    try {
      const { Window } = await import('node-screenshots');
      const windows = Window.all();
      return windows.map(win => ({
        id: win.id(),
        title: win.title(),
        appName: win.appName(),
        x: win.x(),
        y: win.y(),
        width: win.width(),
        height: win.height(),
        isMinimized: win.isMinimized()
      }));
    } catch (err) {
      console.error('[SystemController] system_listWindows failed:', err);
      throw err;
    }
  }

  /**
   * 截取指定 ID 窗口的屏幕缓冲。支持局部裁剪与图像压缩质量设置。
   */
  async system_captureWindow(options: {
    windowId: number;
    quality?: 'low' | 'medium' | 'high';
    crop?: { x: number; y: number; width: number; height: number };
  }): Promise<string> {
    try {
      const { Window } = await import('node-screenshots');
      const windows = Window.all();
      const target = windows.find(win => win.id() === options.windowId);
      if (!target) {
        throw new Error(`Window with ID ${options.windowId} not found`);
      }
      const image = await target.captureImage();
      const buffer = await image.toPng();

      const sharpModule = await import('sharp');
      const sharp = sharpModule.default || sharpModule;
      let sharpImg = sharp(buffer);

      if (options.crop) {
        const metadata = await sharpImg.metadata();
        const origW = metadata.width || target.width();
        const origH = metadata.height || target.height();

        const left = Math.max(0, Math.round(options.crop.x * origW));
        const top = Math.max(0, Math.round(options.crop.y * origH));
        const width = Math.min(origW - left, Math.round(options.crop.width * origW));
        const height = Math.min(origH - top, Math.round(options.crop.height * origH));

        if (width > 0 && height > 0) {
          sharpImg = sharpImg.extract({ left, top, width, height });
        }
      }

      const quality = options.quality || 'high';
      let targetQuality = 90;
      let resizeWidth: number | null = null;

      if (quality === 'low') {
        resizeWidth = 800;
        targetQuality = 60;
      } else if (quality === 'medium') {
        resizeWidth = 1280;
        targetQuality = 80;
      }

      if (resizeWidth !== null) {
        sharpImg = sharpImg.resize({ width: resizeWidth, withoutEnlargement: true });
      }

      const outputBuffer = await sharpImg
        .jpeg({ quality: targetQuality })
        .toBuffer();

      return outputBuffer.toString('base64');
    } catch (err) {
      console.error('[SystemController] system_captureWindow failed:', err);
      throw err;
    }
  }

  /**
   * 模拟鼠标移动并点击指定物理屏幕坐标。
   */
  async system_simulateClick(options: { x: number; y: number; button: 'left' | 'right' | 'middle'; doubleClick?: boolean }): Promise<boolean> {
    try {
      const { mouse, Button, Point } = await import('@nut-tree-fork/nut-js');
      const originalPos = await mouse.getPosition();
      
      // 取消操作之间的默认延迟，保证操作的毫秒级即时性
      mouse.config.autoDelayMs = 0;
      
      // 瞬移到目标点击点
      await mouse.setPosition(new Point(options.x, options.y));
      
      const btn = options.button === 'right' ? Button.RIGHT : options.button === 'middle' ? Button.MIDDLE : Button.LEFT;
      if (options.doubleClick) {
        await mouse.doubleClick(btn);
      } else {
        await mouse.click(btn);
      }
      
      // 瞬移回原鼠标位置
      await mouse.setPosition(originalPos);
      return true;
    } catch (err) {
      console.error('[SystemController] system_simulateClick failed:', err);
      throw err;
    }
  }

  /**
   * 模拟鼠标拖拽（从起点拖拽到终点，常用于滑块验证码）。
   */
  async system_simulateDrag(options: { startX: number; startY: number; endX: number; endY: number }): Promise<boolean> {
    try {
      const { mouse, Point, straightTo } = await import('@nut-tree-fork/nut-js');
      const originalPos = await mouse.getPosition();
      const startPoint = new Point(options.startX, options.startY);
      const endPoint = new Point(options.endX, options.endY);
      
      mouse.config.autoDelayMs = 0;
      // 瞬移到拖拽起点
      await mouse.setPosition(startPoint);
      // 执行拖拽路径
      await mouse.drag(straightTo(endPoint));
      // 瞬移回原鼠标位置
      await mouse.setPosition(originalPos);
      return true;
    } catch (err) {
      console.error('[SystemController] system_simulateDrag failed:', err);
      throw err;
    }
  }

  /**
   * 模拟键盘打字输入文本。
   */
  async system_simulateType(options: { text: string }): Promise<boolean> {
    try {
      const { keyboard } = await import('@nut-tree-fork/nut-js');
      await keyboard.type(options.text);
      return true;
    } catch (err) {
      console.error('[SystemController] system_simulateType failed:', err);
      throw err;
    }
  }

