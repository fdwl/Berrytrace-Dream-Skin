    addLog("info", `plugin:${context.pluginId}`, message);
    return null;
  }

  /**
   * 记录 warn 级别日志。
   * @param message 日志消息
   */
  async log_warn(message: string, context: ApiContext): Promise<null> {
    addLog("warn", `plugin:${context.pluginId}`, message);
    return null;
  }

  /**
   * 记录 error 级别日志。
   * @param message 日志消息
   */
  async log_error(message: string, context: ApiContext): Promise<null> {
    addLog("error", `plugin:${context.pluginId}`, message);
    return null;
  }

  /**
   * 记录 debug 级别日志（仅开发模式可见）。
   * @param message 日志消息
   */
  async log_debug(message: string, context: ApiContext): Promise<null> {
