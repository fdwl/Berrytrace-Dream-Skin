/**
 * OnboardingService — 新手引导服务
 *
 * 职责：
 * 1. 首次运行检测（prefOnboardingCompleted）
 * 2. 引导期间快捷键拦截模式（_onboardingInterceptMode）
 * 3. 权限检查与引导（复用 PermissionGuideWindow）
 *
 * 不修改 main.ts 结构，所有逻辑封装在此文件中。
 */

import { ipcMain, systemPreferences, app } from 'electron'
import { cache, CacheAttribute } from '../config/index'
import { PermissionGuideWindow } from '../windows/permission-guide-window'
import { startGlobalDoubleTapHook } from './double-tap-detector'
import { startGlobalMouseHook } from './mouse-hook'
import { onboardingDownloadManager } from './onboarding-download'

// ─── Types ────────────────────────────────────────────────────
// ... (some content truncated for match, let's keep it exact)
export interface OnboardingConfig {
  fnKeyEnabled: boolean
  middleMouseEnabled: boolean
  quickPanelShortcut: string
}

export function registerOnboardingIpcHandlers(): void {
  // 开发模式下每次启动自动清除引导完成标记，方便联调
  if (!app.isPackaged) {
    cache.set(CacheAttribute.prefOnboardingCompleted, false)
    console.log('[OnboardingService] Dev mode detected — cleared onboarding completed flag')
  } else if (cache.get(CacheAttribute.prefOnboardingCompleted) === undefined) {
    // 生产环境下首次启动若未设置，默认为 false 以触发引导
    cache.set(CacheAttribute.prefOnboardingCompleted, false)
  }

  console.log('[OnboardingService] Registering onboarding IPC handlers...')

  // 1. 首次运行检测
  ipcMain.handle('onboarding:isCompleted', () => {
    const completed = (cache.get(CacheAttribute.prefOnboardingCompleted) as boolean) ?? false
    console.log(`[OnboardingService] onboarding:isCompleted → ${completed}`)
    return completed
  })

  ipcMain.handle('onboarding:get-status', () => {
    const completed = (cache.get(CacheAttribute.prefOnboardingCompleted) as boolean) ?? false
    console.log(`[OnboardingService] onboarding:get-status → ${completed}`)
    return { completed }
  })

  ipcMain.handle('onboarding:set-status', (_event, payload: unknown) => {
    const isComp = typeof payload === 'boolean' ? payload : !!(payload as { completed?: boolean })?.completed
    cache.set(CacheAttribute.prefOnboardingCompleted, isComp)
    console.log(`[OnboardingService] onboarding:set-status → ${isComp}`)
    return { success: true }
  })

  ipcMain.handle('models:fetch-platform-models', async () => {
    try {
      const endpoint = process.env.BERRYTRACE_ONLINE_ENDPOINT || 'https://berrytrace.getdear.cn'
      const modelsUrl = `${endpoint.replace(/\/+$/, '')}/v1/models`
      console.log(`[OnboardingService] Fetching platform models from: ${modelsUrl}`)
      const resp = await fetch(modelsUrl).catch(() => null)
      if (resp && resp.ok) {
        const json = await resp.json()
        const list = Array.isArray(json) ? json : (json?.data || json?.models || [])
        return { success: true, models: list }
      }
    } catch (e) {
      console.warn('[OnboardingService] Exception during models:fetch-platform-models:', e)
    }
    return {
      success: false,
      models: [
        { id: 'deepseek-v4-flash', name: 'DeepSeek V4 Flash', type: 'text_gen' },
        { id: 'qwen3-vl-plus', name: 'Qwen3 VL Plus', type: 'vision_gen' },
        { id: 'qwen3.5-omni-flash', name: 'Qwen3.5 Omni Flash', type: 'omni_gen' },
        { id: 'wan2.7-image-pro', name: 'Wan2.7 Image Pro', type: 'image_gen' }
      ]
    }
  })

  ipcMain.handle('llm:set-active-config', async (_event, config: { mode?: 'byok' | 'platform'; provider?: string; apiKey?: string; baseUrl?: string; modelId?: string }) => {
    console.log('[OnboardingService] llm:set-active-config → setting active model config:', config)
    try {
      cache.set('activeLlmConfig', config)
      return { success: true }
    } catch (err) {
      console.error('🚨 [OnboardingService:ERROR] Failed to set active LLM config:', err)
      return { success: false, error: String(err) }
    }
  })

  // 2. 完成引导并保存配置
  ipcMain.handle('onboarding:complete', (_event, config: OnboardingConfig) => {
    console.log('[OnboardingService] onboarding:complete → saving config', config)
    cache.set(CacheAttribute.prefOnboardingCompleted, true)
    // 恢复正常快捷键模式
    cache.set('_onboardingInterceptMode', false)
  })

  // 3. 快捷键拦截模式开关
  ipcMain.handle('onboarding:setShortcutInterceptMode', (_event, enabled: boolean) => {
    console.log(`[OnboardingService] Shortcut intercept mode: ${enabled}`)
    cache.set('_onboardingInterceptMode', enabled)
  })

  // 4. 辅助功能权限检查
  ipcMain.handle('onboarding:checkAccessibilityPermission', () => {
    if (process.platform !== 'darwin') return true
    return systemPreferences.isTrustedAccessibilityClient(false)
  })

  // 5. 请求辅助功能权限（弹出系统对话框）
  ipcMain.handle('onboarding:requestAccessibilityPermission', async () => {
    if (process.platform !== 'darwin') return
    await systemPreferences.isTrustedAccessibilityClient(true)
  })

  // 6. 显示权限引导窗口（带自动检测系统设置窗口位置）
  ipcMain.handle('onboarding:showPermissionGuide', (_event, type: 'accessibility' | 'screen') => {
    console.log(`[OnboardingService] Showing permission guide for: ${type}`)
    PermissionGuideWindow.getInstance().startAutoDetect(type)
  })

  // 6b. 自动检测权限缺失并启动引导（等价于 startAutoDetect）
  ipcMain.handle('onboarding:startAutoDetect', (_event, type: 'accessibility' | 'screen') => {
    console.log(`[OnboardingService] Starting auto-detect permission guide for: ${type}`)
    PermissionGuideWindow.getInstance().startAutoDetect(type)
  })

  // 7. 临时跳过引导（本次不显示，但下次启动仍会提示）
  ipcMain.handle('onboarding:shouldSkip', () => {
    const skipped = (cache.get('_onboardingSkipped') as boolean) ?? false
    if (skipped) {
      cache.set('_onboardingSkipped', false)
      console.log('[OnboardingService] onboarding:shouldSkip → true (cleared, will prompt next launch)')
      return true
    }
    return false
  })

  // 8. 设置跳过标记（用户在引导页点击"跳过"，下次启动时生效）
  ipcMain.handle('onboarding:skip', () => {
    cache.set('_onboardingSkipped', true)
    console.log('[OnboardingService] onboarding:skip → flag set')
  })

  // 9. 启动全局 native hooks（按需调用，不在 main.ts 自动启动）
  ipcMain.handle('onboarding:startGlobalHooks', () => {
    console.log('[OnboardingService] Starting global hooks (native mouse + keyboard)...')
    try { startGlobalMouseHook() } catch (e) { console.warn('[OnboardingService] Mouse hook start failed:', e) }
    try { startGlobalDoubleTapHook() } catch (e) { console.warn('[OnboardingService] Double-tap hook start failed:', e) }
  })

  // 10. 静默下载相关
  ipcMain.handle('onboarding:start-silent-download', async () => {
    console.log('[OnboardingService] onboarding:start-silent-download triggered')
    await onboardingDownloadManager.startSilentDownloads()
    return true
  })

  ipcMain.handle('onboarding:get-download-status', () => {
    return onboardingDownloadManager.getItems()
  })

  ipcMain.handle('onboarding:is-download-finished', () => {
    return onboardingDownloadManager.isFinished()
  })

  ipcMain.handle('onboarding:retry-item', async (_event, itemId: string) => {
    console.log(`[OnboardingService] onboarding:retry-item triggered for ${itemId}`)
    return onboardingDownloadManager.retryItem(itemId)
  })

  console.log('[OnboardingService] All onboarding IPC handlers registered.')
}
