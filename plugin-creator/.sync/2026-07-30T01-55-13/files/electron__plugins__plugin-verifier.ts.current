
export interface PluginManifest {
  id: string;
  name: string;
  version: string;
  description?: string;
  scope?: 'workspace' | 'global';
  main: string;
  permissions?: string[];
  mcp?: Record<string, unknown>;
  signature?: string;
  fileAssociations?: string[];
  triggerPrefix?: string | string[];
  quickPanelMode?: 'window' | 'embedded';
  view?: string;
  settingsSchema?: Record<string, unknown>;
  auth?: {
    provider: string;
    required?: boolean;
    scopes?: string[];
    [key: string]: unknown;
  };
  type?: string;
  keywords?: string[];
  documentCreators?: Array<{
    id?: string;
    label: string;
    extension: string;
    defaultFileName?: string;
    description?: string;
  }>;
  disableDefaultDrag?: boolean;
  supportTabs?: boolean;
  startupPriority?: 'high' | 'normal';
  /** 常驻插件：不会被空闲回收，启动时预加载。在 plugin.json 中声明 "resident": true */
  resident?: boolean;
  uiMode?: 'iframe' | 'webContentsView';
  /**
   * 进程隔离等级（声明式）
   * - required:     必须独立进程（AI 引擎、任意代码执行类插件）
   * - recommended:  建议独立，主进程可在低内存时降级（原生模块、网络 I/O 密集型）
   * - optional:     可共享进程（纯计算/轻量插件），默认值
   */
  processIsolation?: 'required' | 'recommended' | 'optional';
  windowScope?: string | string[];
  nativeElectron?: boolean;
  /** 限制插件进程 V8 堆内存上限 (MB) */
  memoryLimit?: number;
  agentKernel?: {
    protocol: string;
    capabilities: string[];
  };
  berrytrace?: {
    id: string;
    label?: string;
    icon?: string;
    startupPriority?: 'high' | 'normal';
    requiredFiles?: Array<{ path: string; minSize: number }>;
  };
  activationEvents?: string[];
  /**
   * 插件空闲回收超时时间（毫秒），可选。
   * 默认使用全局 5 分钟 (300000ms)。
   */
  idleTimeout?: number;
  /**
   * 声明式启动入口（Startup Entry）。
   *
   * 插件通过此字段声明它能提供一种「替代启动模式」。
   * 宿主扫描所有已安装插件的 manifest，将所有 startupEntry 汇总展示给用户，
   * 用户在宿主设置中选择激活哪一个（或使用默认正常启动）。
   *
   * 规则：
   * - 同时只能有一个 startupEntry 生效（排他性入口）
   * - 具体激活哪个插件的 entry，由宿主 cache 中的 activeStartupEntry 决定
   * - 插件本身不控制是否激活，控制权在宿主和用户
   *
   * @example
   * // voice-agents/plugin.json
   * "startupEntry": {
   *   "type": "suppressMainWindow",
   *   "label": "语音助手快速启动",
   *   "description": "应用启动时只显示语音助手界面，不打开主窗口，降低内存占用约 70%",
   *   "voiceUiPlugins": [
   *     { "id": "com.berrytrace.plugin.voice-ui-desktop-pet", "label": "桌面宠物", "isDefault": true },
   *     { "id": "com.berrytrace.plugin.voice-ui-minimal-hud", "label": "极简 HUD" }
   *   ]
   * }
   */
  startupEntry?: {
    /**
     * 入口类型，决定宿主如何调整启动行为。
     * - 'suppressMainWindow': 不显示主窗口，只显示关联的 voice UI 浮窗
     */
    type: 'suppressMainWindow';
    /** 在宿主设置中展示的入口名称 */
    label: string;
    /** 详细描述，展示在宿主设置的选项下方 */
    description?: string;
    /**
     * 该入口关联的 Voice UI 子插件列表（仅 suppressMainWindow 类型使用）。
     * 宿主会让用户从中选择一个作为启动时显示的界面。
     * 若为空，宿主自动激活 voice-agents 的默认 UI。
     */
    voiceUiPlugins?: Array<{
      /** 子插件 ID（需已安装） */
      id: string;
      /** 在选择器中展示的名称 */
      label: string;
      /** 是否为默认选项（未配置时使用） */
      isDefault?: boolean;
    }>;
  };

  contributes?: {
    selectionMenuItems?: Array<{
      id: string;
      label: string;
      icon?: string;
      viewType?: string;
      [key: string]: unknown;
    }>;
    shortcutActions?: Array<{
      id: string;
      label: string;
      icon?: string;
      [key: string]: unknown;
    }>;
    ribbonIcons?: Array<{
      id: string;
      icon: string;
      label: string;
      command: string;
      contextAction?: string;
      windowScope?: string | string[];
      [key: string]: unknown;
    }>;
    commands?: Array<{
      command: string;
      title: string;
      category?: string;
      [key: string]: unknown;
    }>;
    workspaceViews?: Array<{
      id: string;
      title: string;
      view: string;
      [key: string]: unknown;
    }>;
    folderContextMenuItems?: Array<{
      id: string;
      label: string;
      command: string;
      [key: string]: unknown;
    }>;
    events?: {
      emits?: Array<{ name: string; description?: string }>;
      listens?: Array<{ name: string; description?: string }>;
    };
    views?: Array<{
      viewType: string;
      placement?: { type: string; label?: string; icon?: string; order?: number };
      [key: string]: unknown;
    }>;
    settingsSections?: Array<{
      id: string;
      targetTab: string;
      label?: string;
      viewClassName: string;
      order?: number;
      [key: string]: unknown;
    }>;
    voiceHandlers?: Array<{
      priority?: number;
      [key: string]: unknown;
    }>;
    [key: string]: unknown;
  };
}

export type PluginStatus = 'DEV' | 'APPROVED' | 'VERIFIED' | 'UNVERIFIED' | 'BLOCKED';

export class PluginVerifier {
  public static async getPluginStatus(
    _manifest: PluginManifest,
    _fullPath: string,
    isDevFolder: boolean,
    _checkFileIntegrity: boolean = false
  ): Promise<PluginStatus> {
    if (isDevFolder) {
      return 'DEV';
    }

    // 🔒 安全签名校验功能暂时注释/关闭，默认直接放行 APPROVED
    return 'APPROVED';

    /*
