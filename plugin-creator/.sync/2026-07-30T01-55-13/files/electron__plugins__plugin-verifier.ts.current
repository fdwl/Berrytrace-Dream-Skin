    const hasSignature = await fs.stat(signaturePath).then(s => s.isFile()).catch(() => false);
    if (hasSignature) {
      try {
        const sigContent = await fs.readFile(signaturePath, 'utf-8');
        const signatureJson = JSON.parse(sigContent);
        const verifResult = verifyPackageSignature(fullPath, signatureJson, checkFileIntegrity);
        if (verifResult.isValid) {
          return verifResult.isOfficial ? 'APPROVED' : 'VERIFIED';
        }
      } catch (err) {
        console.error(`[PluginVerifier] Failed to verify signature.json at ${signaturePath}:`, err);
      }
    }

    if (verifyPluginSignature(manifest)) {
      return 'APPROVED';
    }

    return 'UNVERIFIED';
    */
  }
}
