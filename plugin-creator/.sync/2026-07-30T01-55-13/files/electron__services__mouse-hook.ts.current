import { app, shell, dialog, BrowserWindow } from 'electron'
import { join, dirname } from 'path'
import { fileURLToPath } from 'url'
import { spawn } from 'child_process'
import type { ChildProcess } from 'child_process'
import { createRequire } from 'module'
import { cache, CacheAttribute } from '../config/index'
import { ElectronQuickPanelWindow } from '../windows/quick-panel'
import { ElectronFloatWeb } from '../windows/float-web'
import { getShortcutActionRegistry } from './shortcut-action-registry'
import { KeybindingsManager } from './keybindings-manager'

const require = createRequire(import.meta.url)
const __filename = fileURLToPath(import.meta.url)
const __dirname = dirname(__filename)

export interface WindowItem {
  id: string | number
  title: string
  ownerName: string
  path: string
  icon?: string
}

export interface MouseHook {
  isAccessibilityGranted: () => boolean
  startHook: (
    callback: (coords: { x: number; y: number; appId: string }) => void,
    delay: number,
    interval: number
  ) => boolean
  stopHook: () => void
  getOpenWindows?: () => WindowItem[]
  activeWindow?: (id: string | number) => boolean
  getFocusedInputInfo?: () => { selection: string; value: string; role: string }
  insertTextViaAX?: (text: string) => boolean
  simulatePasteKeystroke?: () => void
  simulateTyping?: (text: string) => void
  simulateEnterKeystroke?: () => void
  getFrontmostAppId?: () => string
  getFrontmostAppPid?: () => string
  /** 检测当前系统焦点元素是否为可编辑输入区域 */
  isFocusedInInputArea?: () => { isInput: boolean; isEditable: boolean; role: string }
}

let mouseHook: MouseHook | null = null
let isMouseHookRunning = false
let mouseHookProcess: ChildProcess | null = null
let mouseHookShutdownTimer: NodeJS.Timeout | null = null

export function getMouseHook(): MouseHook | null {
  if (!mouseHook) {
    try {
      const addonPath = join(__dirname, 'mouse_hook.node')
      const t0 = performance.now()
      mouseHook = require(addonPath)
      console.log(`✅ Native Mouse Hook loaded successfully from: ${addonPath} (took ${(performance.now() - t0).toFixed(1)}ms)`)
    } catch (e) {
      console.error('❌ Failed to load Native Mouse Hook:', e)
    }
  }
  return mouseHook
}

import { ShortcutActivationDispatcher } from './shortcut-activation-dispatcher'

export function startGlobalMouseHook() {
  const tStart = performance.now()
  const enabled = (cache.get(CacheAttribute.prefRightClickLongPress) as boolean) ?? false

  // 动态检索 KeybindingsManager 是否有绑定 right_click:long_press 手势的规则
  let hasRightClickKeybinding = false
  try {
    const keybindings = KeybindingsManager.getInstance().getEffectiveKeybindings()
    hasRightClickKeybinding = keybindings.some((rule: { gesture?: string }) => rule.gesture === 'right_click:long_press')
  } catch (_e) {
    /* ignore error retrieving effective keybindings */
  }

  if (!enabled && !hasRightClickKeybinding) {
    console.log('[NativeHook:Mouse:STATUS] Mouse hook is disabled by user settings. Helper process will NOT be spawned.')
    stopGlobalMouseHook()
    return
  }

  const hook = getMouseHook()
  if (!hook) {
    console.error('🚨 [NativeHook:Mouse:ERROR] Native module not loaded, cannot start.')
    return
  }

  if (isMouseHookRunning || mouseHookProcess) {
    console.log('[NativeHook:Mouse:STATUS] Global mouse hook is already running, skipping start.')
    return
  }

  // Ensure any existing hook is fully cleaned up before starting a new one
  stopGlobalMouseHook()

  if (process.platform === 'darwin') {
    const tPerm = performance.now()
    const hasPermission = hook.isAccessibilityGranted()
    console.log(`[NativeHook:Mouse:STATUS] Accessibility permission check took ${(performance.now() - tPerm).toFixed(1)}ms`)

    if (!hasPermission) {
      console.warn('⚠️ [NativeHook:Mouse:WARN] Accessibility permission missing on macOS.')
      shell.openExternal('x-apple.systempreferences:com.apple.preference.security?Privacy_Accessibility').catch((err) => {
        console.error('🚨 [NativeHook:Mouse:ERROR] Failed to open accessibility preferences:', err)
      })
    }
  }

  const delay = (cache.get(CacheAttribute.prefRightClickLongPressDelay) as number) || 350

  // Determine path of helper executable
  const helperName = process.platform === 'win32' ? 'mouse_hook_helper.exe' : 'mouse_hook_helper'
  const isDev = !app.isPackaged
  const helperPath = isDev
    ? join(__dirname, '..', process.platform === 'win32' ? 'build-win' : 'build-mac', 'Release', helperName)
    : join(process.resourcesPath, 'app.asar.unpacked', 'dist-electron', helperName)

  console.log(`[NativeHook:Mouse:START] Spawning global mouse hook helper: ${helperPath} (delay: ${delay}ms)...`)

  try {
    const tSpawn = performance.now()
    mouseHookProcess = spawn(helperPath, [delay.toString(), '10', process.pid.toString()], {
      stdio: ['pipe', 'pipe', 'pipe']
    })
    console.log(`[NativeHook:Mouse:START] Helper spawn took ${(performance.now() - tSpawn).toFixed(1)}ms (total start duration: ${(performance.now() - tStart).toFixed(1)}ms)`)

    isMouseHookRunning = true

    let buffer = ''
    mouseHookProcess.stdout?.on('data', (data) => {
      buffer += data.toString()
      const lines = buffer.split('\n')
      buffer = lines.pop() || ''
      for (const line of lines) {
        const trimmed = line.trim()
        if (!trimmed) continue
        try {
          const parsed = JSON.parse(trimmed)
          console.log('[NativeHook:Mouse:EVENT] Event received from helper process:', parsed)
          if (parsed.event === 'long_press') {
            console.log('[NativeHook:Mouse:EVENT] Right-click long press detected!')
            ShortcutActivationDispatcher.getInstance().handleGesture('right_click:long_press').then((handled) => {
              if (handled) {
                console.log('[NativeHook:Mouse:ACTION] Handled right_click:long_press via ShortcutActivationDispatcher')
                return
              }

              const appId = parsed.appId || ''
              let disabledApps: string[]
              try {
                disabledApps = JSON.parse((cache.get(CacheAttribute.prefRightClickLongPressDisabledApps) as string) || '[]')
              } catch {
                disabledApps = []
              }
              if (appId && disabledApps.includes(appId.toLowerCase())) {
                console.log(`[NativeHook:Mouse:SUPPRESSED] App disabled: ${appId}`)
                return
              }
              const customUrl = (cache.get(CacheAttribute.prefRightClickLongPressUrl) as string) || 'berrytrace://quick-panel'
              if (customUrl.trim()) {
                const urlToOpen = customUrl.replace(/%appId%/g, encodeURIComponent(appId))
                if (urlToOpen.startsWith('berrytrace://') || urlToOpen.startsWith('berrytrace-dev://')) {
                  try {
                    const urlObj = new URL(urlToOpen)
                    const action = urlObj.hostname || urlObj.host
                    if (action === 'show-main') {
                      import('../windows/main-window').then(({ ElectronMainWindow }) => {
                        ElectronMainWindow.getInstance().toggleWindow()
                      })
                    } else if (action === 'screenshot') {
                      import('./screenshot').then(({ ElectronScreenshot }) => {
                        ElectronScreenshot.getInstance().triggerScreenshot()
                      })
                    } else if (action === 'lock') {
                      import('./desktop-lock').then(({ ElectronDesktopLock }) => {
                        import('../windows/main-window').then(({ ElectronMainWindow }) => {
                          const win = ElectronMainWindow.getInstance().getWindow()
                          ElectronDesktopLock.getInstance().triggerLock(win)
                        })
                      })
                    } else if (action === 'quick-panel') {
                      ElectronQuickPanelWindow.getInstance().toggleQuickPanelWindow()
                    } else {
                      try {
                        ElectronFloatWeb.getInstance().openFloatWebWindow(urlToOpen, true)
                      } catch (err) {
                        console.error('Failed to open float ball window:', err)
                      }
                    }
                  } catch (_e) {
                    try {
                      ElectronFloatWeb.getInstance().openFloatWebWindow(urlToOpen, true)
                    } catch (err) {
                      console.error('Failed to open float ball window:', err)
                    }
                  }
                } else {
                  shell.openExternal(urlToOpen)
                }
              } else {
                ElectronQuickPanelWindow.getInstance().showQuickPanelAtCursor(appId)
              }
            }).catch((err) => {
              console.error('🚨 [NativeHook:Mouse:ERROR] Error handling right_click:long_press:', err)
            })
          } else if (parsed.event === 'button_press') {
            // ── Onboarding intercept mode: forward to onboarding guide ──
            const onboardingIntercept = (cache.get('_onboardingInterceptMode') as boolean) ?? false
            if (onboardingIntercept) {
              const buttonNum = parsed.button as number
              const buttonNames: Record<number, string> = { 2: 'middle', 3: 'button4', 4: 'button5' }
              const buttonName = buttonNames[buttonNum] || `button${buttonNum}`
              console.log(`[MouseHook] Onboarding intercept — forwarding: ${buttonName}`)
              BrowserWindow.getAllWindows().forEach((win) => {
                if (!win.isDestroyed()) {
                  win.webContents.send('onboarding:shortcutTest', {
                    source: 'mouse',
                    event: 'button_press',
                    button: buttonNum,
                    buttonName,
                    timestamp: Date.now(),
                  })
                }
              })
              continue
            }

            // Check if mouse button monitoring is enabled
            const mouseButtonEnabled = (cache.get(CacheAttribute.prefMouseButtonEnabled) as boolean) ?? true
            if (!mouseButtonEnabled) continue

            // Middle (2) / Side button 4 / Side button 5
            const buttonNum = parsed.button as number
            const buttonNames: Record<number, string> = { 2: 'middle', 3: 'button4', 4: 'button5' }
            const buttonName = buttonNames[buttonNum] || `button${buttonNum}`
            console.log(`[MouseHook] Mouse ${buttonName} pressed at (${parsed.x}, ${parsed.y}) in ${parsed.appId}`)

            // Execute registered action bindings (empty array = disabled for this button)
            const mouseButtonBindings = (cache.get(CacheAttribute.prefMouseButtonBindings) as Record<string, string[]>) || {}
            const registry = getShortcutActionRegistry()
            const executed = registry.executeBindings(buttonName, mouseButtonBindings)
            if (executed > 0) {
              console.log(`[MouseHook] Executed ${executed} bound actions for mouse ${buttonName}`)
            }

            // Broadcast to renderer processes so plugins can listen directly
            BrowserWindow.getAllWindows().forEach((win) => {
              if (!win.isDestroyed()) {
                win.webContents.send('shortcut:mouse-button', {
                  button: buttonNum,
                  buttonName,
                  x: parsed.x,
                  y: parsed.y,
                  appId: parsed.appId,
                })
              }
            })

          } else if (parsed.event === 'conflict_detected') {
            console.warn('[MouseHook] Critical hook conflict detected by helper! Disabling hook.')
            cache.set(CacheAttribute.prefRightClickLongPress, false)
            stopGlobalMouseHook()

            BrowserWindow.getAllWindows().forEach((win) => {
              if (!win.isDestroyed()) {
                win.webContents.send('pref:changed')
              }
            })

            dialog.showMessageBox({
              type: 'error',
              title: '鼠标挂钩已自动停用',
              message: '系统检测到本程序与其它右键长按/鼠标手势工具（例如 utools）存在严重冲突。为避免锁死您的鼠标，右键长按唤起快捷面板的功能已自动关闭。\n\n如果您想继续使用，请先关闭冲突的其他辅助软件。',
              buttons: ['确定']
            })
          }
        } catch (e) {
          console.error('[MouseHook] Failed to parse stdout JSON:', trimmed, e)
        }
      }
    })

    mouseHookProcess.stderr?.on('data', (data) => {
      console.log(`[MouseHook Helper Log] ${data.toString().trim()}`)
    })

    mouseHookProcess.on('close', (code) => {
      console.log(`[MouseHook Process] Helper process exited with code ${code}`)
      mouseHookProcess = null
      isMouseHookRunning = false
    })

    mouseHookProcess.on('error', (err) => {
      console.error('[MouseHook Process] Helper process error:', err)
    })

  } catch (err) {
    console.error('[MouseHook] Failed to spawn helper process:', err)
    isMouseHookRunning = false
    mouseHookProcess = null
  }
}

export function stopGlobalMouseHook() {
  if (mouseHookProcess) {
    console.log('[MouseHook] Stopping global mouse hook helper process...')
    const proc = mouseHookProcess
    mouseHookProcess.stdin?.end()

    if (mouseHookShutdownTimer) {
      clearTimeout(mouseHookShutdownTimer)
      mouseHookShutdownTimer = null
    }

    try {
      proc.kill()
    } catch (err) {
      console.warn('[MouseHook] Failed to send termination signal to helper process:', err)
    }

    mouseHookShutdownTimer = setTimeout(() => {
      if (proc.exitCode === null) {
        console.warn('[MouseHook] Helper process did not exit after termination signal, killing it.')
        try {
          proc.kill('SIGKILL')
        } catch (err) {
          console.warn('[MouseHook] Failed to force kill helper process:', err)
        }
      }
      mouseHookShutdownTimer = null
    }, 500)

    mouseHookProcess = null
  }
  isMouseHookRunning = false
}
