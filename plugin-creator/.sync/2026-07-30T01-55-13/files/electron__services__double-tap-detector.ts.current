import { app, systemPreferences, BrowserWindow } from 'electron'
import { join, dirname } from 'path'
import { fileURLToPath } from 'url'
import { spawn } from 'child_process'
import type { ChildProcess } from 'child_process'
import { cache, CacheAttribute } from '../config/index'
import { getShortcutActionRegistry } from './shortcut-action-registry'
import { ShortcutActivationDispatcher } from './shortcut-activation-dispatcher'

import { KeybindingsManager } from './keybindings-manager'

const __filename = fileURLToPath(import.meta.url)
const __dirname = dirname(__filename)

/** 默认阈值/手势参数（消除魔法字面量） */
const DEFAULT_DOUBLE_TAP_MODIFIER_FALLBACK = 'cmd'
export const DEFAULT_LONG_PRESS_KEY = 'alt'
const DEFAULT_DOUBLE_TAP_THRESHOLD_MS = 400
const DEFAULT_LONG_PRESS_DELAY_MS = 500
const DOUBLE_TAP_HELPER_NAME = process.platform === 'win32' ? 'keyboard_double_tap_helper.exe' : 'keyboard_double_tap_helper'

let doubleTapProcess: ChildProcess | null = null
let isDoubleTapHookRunning = false
let doubleTapShutdownTimer: NodeJS.Timeout | null = null

export function isDoubleTapPermissionGranted(): boolean {
  if (process.platform === 'darwin') {
    return systemPreferences.isTrustedAccessibilityClient(false)
  }
  return true
}

/**
 * 检索当前真正【已被用户开启/有效】的物理按键手势与所需修饰键集合
 */
export function getActivePhysicalGestures(): { activeGestures: Set<string>; requiredModifiers: Set<string> } {
  const activeGestures = new Set<string>()
  const requiredModifiers = new Set<string>()

  // 1. 检索 Switch 开关状态
  const doubleTapEnabled = (cache.get(CacheAttribute.prefDoubleTapEnabled) as boolean) ?? false
  const fnVoiceEnabled = (cache.get(CacheAttribute.prefFnVoiceEnabled) as boolean) ?? false
  const fnShiftTranslateEnabled = (cache.get(CacheAttribute.prefFnShiftTranslateEnabled) as boolean) ?? false
  const fnSpaceMeimeiEnabled = (cache.get(CacheAttribute.prefFnSpaceMeimeiEnabled) as boolean) ?? false

  if (fnVoiceEnabled) {
    activeGestures.add('short_press:fn')
    activeGestures.add('long_press_start:fn')
    activeGestures.add('long_press_end:fn')
    requiredModifiers.add('fn')
  }
  if (fnSpaceMeimeiEnabled) {
    activeGestures.add('combo:fn+space')
    requiredModifiers.add('fn')
  }
  if (fnShiftTranslateEnabled) {
    activeGestures.add('combo:shift+fn')
    requiredModifiers.add('fn')
  }
  if (doubleTapEnabled) {
    const mod = (cache.get(CacheAttribute.prefDoubleTapModifier) as string) || DEFAULT_DOUBLE_TAP_MODIFIER_FALLBACK
    activeGestures.add(`double_tap:${mod}`)
    requiredModifiers.add(mod)
  }

  // 2. 检索 KeybindingsManager 中的有效规则（排除已被禁用的规则）
  try {
    const effectiveRules = KeybindingsManager.getInstance().getEffectiveKeybindings()
    for (const rule of effectiveRules) {
      if (rule.gesture && rule.gesture.trim().length > 0) {
        const gesture = rule.gesture.trim()
        activeGestures.add(gesture)
        if (gesture.includes('fn')) requiredModifiers.add('fn')
        if (gesture.includes('cmd')) requiredModifiers.add('cmd')
        if (gesture.includes('alt')) requiredModifiers.add('alt')
        if (gesture.includes('ctrl')) requiredModifiers.add('ctrl')
        if (gesture.includes('shift')) requiredModifiers.add('shift')
      }
    }
  } catch (_e) {
    /* ignore error retrieving effective keybindings */
  }

  return { activeGestures, requiredModifiers }
}

export function startGlobalDoubleTapHook() {
  const { activeGestures, requiredModifiers } = getActivePhysicalGestures()
  const anyShortcutActive = requiredModifiers.size > 0
  
  // 同步保存状态供缓存查询
  cache.set('prefNativeHookMasterSwitch', anyShortcutActive)

  if (!anyShortcutActive) {
    console.log('[NativeHook:DoubleTap:STOP] 💤 零键盘手势开启，底层 C++ 钩子进程销毁休眠。')
    stopGlobalDoubleTapHook()
    return
  }

  if (isDoubleTapHookRunning || doubleTapProcess) {
    console.log('[NativeHook:DoubleTap:STATUS] Global double-tap hook is already running, skipping start.')
    return
  }

  stopGlobalDoubleTapHook()

  if (process.platform === 'darwin') {
    const hasPermission = isDoubleTapPermissionGranted()
    if (!hasPermission) {
      console.warn('⚠️ [NativeHook:DoubleTap:WARN] Accessibility permission missing on macOS for double tap / Fn gestures.')
      return
    }
  }

  // 仅保留当前已被开启快捷键所需的物理修饰键，避免无意义的键盘事件拦截
  const allModifiers = [...requiredModifiers].join(',')

  const threshold = (cache.get(CacheAttribute.prefDoubleTapThreshold) as number) || DEFAULT_DOUBLE_TAP_THRESHOLD_MS
  const longPressDelay = (cache.get(CacheAttribute.prefLongPressDelay) as number) || DEFAULT_LONG_PRESS_DELAY_MS

  const helperName = DOUBLE_TAP_HELPER_NAME
  const isDev = !app.isPackaged
  const helperPath = isDev
    ? join(__dirname, '..', process.platform === 'win32' ? 'build-win' : 'build-mac', 'Release', helperName)
    : join(process.resourcesPath, 'app.asar.unpacked', 'dist-electron', helperName)

  console.log(`[NativeHook:DoubleTap:START] Spawning helper: ${helperPath} (modifiers: [${allModifiers}], activeGestures: ${Array.from(activeGestures).join(', ')})`)

  try {
    // args: [modifiers, threshold, longPressDelay, pid]
    doubleTapProcess = spawn(helperPath, [allModifiers, threshold.toString(), longPressDelay.toString(), process.pid.toString()], {
      stdio: ['pipe', 'pipe', 'pipe']
    })

    isDoubleTapHookRunning = true

    let buffer = ''
    doubleTapProcess.stdout?.on('data', (data) => {
      buffer += data.toString()
      const lines = buffer.split('\n')
      buffer = lines.pop() || ''
      for (const line of lines) {
        const trimmed = line.trim()
        if (!trimmed) continue
        try {
          const parsed = JSON.parse(trimmed)
          console.log(`[NativeHook:DoubleTap:EVENT] Helper event received: ${parsed.event}:${parsed.modifier}`)
          handleHelperEvent(parsed)
        } catch (e) {
          console.error('🚨 [NativeHook:DoubleTap:ERROR] Failed to parse helper stdout JSON:', trimmed, e)
        }
      }
    })

    doubleTapProcess.stderr?.on('data', (data) => {
      console.log(`[NativeHook:DoubleTap Log] ${data.toString().trim()}`)
    })

    doubleTapProcess.on('close', (code) => {
      console.log(`[NativeHook:DoubleTap:EXIT] Helper process exited with code ${code}`)
      doubleTapProcess = null
      isDoubleTapHookRunning = false
    })

    doubleTapProcess.on('error', (err) => {
      console.error('🚨 [NativeHook:DoubleTap:ERROR] Helper process error:', err)
    })

  } catch (err) {
    console.error('🚨 [NativeHook:DoubleTap:ERROR] Failed to spawn helper process:', err)
    isDoubleTapHookRunning = false
    doubleTapProcess = null
  }
}

export function stopGlobalDoubleTapHook() {
  if (doubleTapProcess) {
    console.log('[DoubleTap] Stopping global double-tap helper process...')
    const proc = doubleTapProcess
    doubleTapProcess.stdin?.end()

    if (doubleTapShutdownTimer) {
      clearTimeout(doubleTapShutdownTimer)
      doubleTapShutdownTimer = null
    }

    try {
      proc.kill()
    } catch (err) {
      console.warn('[DoubleTap] Failed to send kill signal to helper process:', err)
    }

    doubleTapShutdownTimer = setTimeout(() => {
      if (proc.exitCode === null) {
        console.warn('[DoubleTap] Helper process did not exit after termination signal, force killing.')
        try {
          proc.kill('SIGKILL')
        } catch (err) {
          console.warn('[DoubleTap] Failed to SIGKILL helper process:', err)
        }
      }
      doubleTapShutdownTimer = null
    }, 500)

    doubleTapProcess = null
  }
  isDoubleTapHookRunning = false
}

export function restartGlobalDoubleTapHook() {
  console.log('[DoubleTap] Restarting global double-tap hook due to config change...')
  stopGlobalDoubleTapHook()
  // Clear any pending force-kill timer from stopGlobalDoubleTapHook
  if (doubleTapShutdownTimer) {
    clearTimeout(doubleTapShutdownTimer)
    doubleTapShutdownTimer = null
  }
  setTimeout(() => {
    startGlobalDoubleTapHook()
  }, 100)
}

function handleHelperEvent(parsed: { event: string; modifier: string; timestamp?: number }) {
  const gestureKey = `${parsed.event}:${parsed.modifier}`
  const { activeGestures } = getActivePhysicalGestures()

  // 严格粒度关口校验：如果该手势未被激活/开启，直接拦截丢弃
  if (!activeGestures.has(gestureKey)) {
    console.log(`[NativeHook:DoubleTap:GATED] Event "${gestureKey}" blocked because gesture is not active.`)
    return
  }

  // ── Onboarding intercept mode: forward to onboarding guide instead of executing actions ──
  const onboardingIntercept = (cache.get('_onboardingInterceptMode') as boolean) ?? false
  if (onboardingIntercept) {
    console.log(`[DoubleTap] Onboarding intercept mode — forwarding event: ${parsed.event}:${parsed.modifier}`)
    const allWindows = BrowserWindow.getAllWindows()
    for (const win of allWindows) {
      if (!win.isDestroyed()) {
        win.webContents.send('onboarding:shortcutTest', {
          source: 'keyboard',
          event: parsed.event,
          modifier: parsed.modifier,
          timestamp: parsed.timestamp,
        })
      }
    }
    return
  }

  // 1. 尝试通过 ShortcutActivationDispatcher 动态激活绑定插件或执行系统指令
  ShortcutActivationDispatcher.getInstance().handleGesture(gestureKey).catch((err) => {
    console.error('[DoubleTap] Failed to handle gesture via ShortcutActivationDispatcher:', err)
  })

  // 2. 尝试 ActionRegistry 绑定动作
  const bindings = (cache.get(CacheAttribute.prefShortcutBindings) as Record<string, string[]>) || {}
  const registry = getShortcutActionRegistry()
  const executed = registry.executeBindings(gestureKey, bindings)

  if (executed > 0) {
    console.log(`[DoubleTap] Executed ${executed} bound actions for gesture: ${gestureKey}`)
  }

  // 3. 将手势事件广播至渲染进程（供监听原生手势的插件使用）
  const allWindows = BrowserWindow.getAllWindows()
  for (const win of allWindows) {
    if (!win.isDestroyed()) {
      win.webContents.send('shortcut:gesture', {
        event: parsed.event,
        modifier: parsed.modifier,
        timestamp: parsed.timestamp,
      })
    }
  }
}
