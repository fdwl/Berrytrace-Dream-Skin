/**
 * BrowserTabPanel — WebContentsView 架构下的浏览器 Tab 面板
 *
 * 迁移自 <webview> 标签方案。
 * 本组件只负责：
 *   1. 渲染工具栏（地址栏、导航按钮）
 *   2. 渲染占位 div，通过 ResizeObserver 同步区域坐标给主进程
 *   3. 工具栏操作通过 IPC 通知主进程 BrowserViewManager 执行
 *   4. 监听主进程 browser-view:event 更新工具栏状态（URL/Title/Loading）
 *
 * 外部网页内容由主进程 BrowserViewManager 管理的 WebContentsView 渲染，
 * 与本渲染进程完全隔离，崩溃不传播到主窗口。
 */

import { useEffect, useRef, useState, useCallback } from 'react';
import { useWorkspaceStore } from '../../../stores/workspace';
import { useAppStore } from '../../../stores/app';
import { useDashboardStore } from '../../../stores/dashboard';

interface BrowserTabPanelProps {
  tabId: string;
  visible: boolean;
  customParams?: Record<string, any>;
}

// IPC channel 常量（与 browser-view-manager.ts BVC 保持一致）
const BVC_NAVIGATE = 'browser-view:navigate';
const BVC_EVENT    = 'browser-view:event';
const BVC_SYNC     = 'browser-view:request-sync-bounds';
const BVC_SET_BOUNDS = 'browser-view:set-bounds';

// 模块级监听器：workspace-browser:prepare（工作区预热）
// 当主进程发起 browser_action 时，AppLayout 处理 workspace-browser:prepare，
// 本模块只需在 Tab 创建后把实际 tabId 传回给主进程。
if (typeof window !== 'undefined' && window.electronAPI?.ipc?.on) {
  window.electronAPI.ipc.on('workspace-browser:action', async (data: any) => {
    // 在 WebContentsView 架构下，浏览器操作直接在主进程执行，
    // 渲染进程不再处理 workspace-browser:action 消息。
    // 保留监听器占位以避免 IPC 未读警告。
    console.log('[BrowserTabPanel] workspace-browser:action received (no-op in WebContentsView mode):', data?.action);
  });
}

export default function BrowserTabPanel({ tabId, visible, customParams }: BrowserTabPanelProps) {
  const placeholderRef = useRef<HTMLDivElement>(null);
  const theme = useAppStore(state => state.theme);
  const isOverlayActive = useWorkspaceStore(state => state.isOverlayActive);
  const workspaceVisible = useDashboardStore(state => state.workspaceVisible);

  const initialUrl = customParams?.initialUrl || 'https://www.google.com';
  const [address, setAddress] = useState(initialUrl);
  const [inputAddress, setInputAddress] = useState(initialUrl);
  const [isLoading, setIsLoading] = useState(false);
  const [canGoBack, setCanGoBack] = useState(false);
  const [canGoForward, setCanGoForward] = useState(false);

  // 内容区是否真正可见（工具栏所属逻辑）
  const contentVisible = visible && workspaceVisible && !isOverlayActive;

  // ── 1. 通知主进程创建 WebContentsView（组件 mount 时）────────────────────────
  useEffect(() => {
    if (window.electronAPI?.ipc) {
      window.electronAPI.ipc.send('browser-view:create', { tabId, url: initialUrl });
      console.log(`[BrowserTabPanel:${tabId}] Sent browser-view:create url=${initialUrl}`);
    }
    return () => {
      // Tab 关闭时通知主进程销毁 WebContentsView
      if (window.electronAPI?.ipc) {
        window.electronAPI.ipc.send('browser-view:destroy', { tabId });
        console.log(`[BrowserTabPanel:${tabId}] Sent browser-view:destroy`);
      }
    };
  }, [tabId]);

  // ── 2. ResizeObserver 同步占位区域坐标给主进程（Throttle 16ms）────────────────
  useEffect(() => {
    const placeholder = placeholderRef.current;
    if (!placeholder) return;

    let rafId: number | null = null;
    const syncBounds = () => {
      const rect = placeholder.getBoundingClientRect();
      window.electronAPI?.ipc?.send(BVC_SET_BOUNDS, {
        tabId,
        x:       Math.round(rect.x),
        y:       Math.round(rect.y),
        width:   Math.round(rect.width),
        height:  Math.round(rect.height),
        visible: contentVisible && rect.width > 10 && rect.height > 10,
      });
    };

    const throttledSync = () => {
      if (rafId !== null) return;
      rafId = requestAnimationFrame(() => {
        rafId = null;
        syncBounds();
      });
    };

    const observer = new ResizeObserver(throttledSync);
    observer.observe(placeholder);

    // 立即同步一次
    syncBounds();

    // 监听主进程主动请求同步（窗口 resize/move 兜底）
    const unsubSync = window.electronAPI?.ipc?.on(BVC_SYNC, (payload: { tabId: string }) => {
      if (payload.tabId === tabId) syncBounds();
    });

    return () => {
      observer.disconnect();
      if (rafId !== null) cancelAnimationFrame(rafId);
      unsubSync?.();
    };
  }, [tabId, contentVisible]);

  // ── 3. Tab 可见性变化时通知主进程显示/隐藏 ────────────────────────────────────
  useEffect(() => {
    if (!placeholderRef.current) return;
    const rect = placeholderRef.current.getBoundingClientRect();
    window.electronAPI?.ipc?.send(BVC_SET_BOUNDS, {
      tabId,
      x:       Math.round(rect.x),
      y:       Math.round(rect.y),
      width:   Math.round(rect.width),
      height:  Math.round(rect.height),
      visible: contentVisible && rect.width > 10 && rect.height > 10,
    });
  }, [tabId, contentVisible]);

  // ── 4. 监听主进程事件推送（URL/Title/Loading/快捷键）────────────────────────────
  useEffect(() => {
    const unsubEvent = window.electronAPI?.ipc?.on(BVC_EVENT, (event: { tabId: string; type: string; data: any }) => {
      if (event.tabId !== tabId) return;

      switch (event.type) {
        case 'url':
          setAddress(event.data);
          setInputAddress(event.data);
          // 同步 Tab 配置（供 session re-hydration 使用）
          useWorkspaceStore.getState().updateTabConfig(tabId, { customParams: { initialUrl: event.data } });
          break;
        case 'title':
          if (event.data?.trim()) {
            useWorkspaceStore.getState().updateTabName(tabId, event.data);
          }
          break;
        case 'loading':
          setIsLoading(event.data);
          break;
        case 'nav-state':
          setCanGoBack(event.data.canGoBack);
          setCanGoForward(event.data.canGoForward);
          break;
        case 'crashed':
          setIsLoading(false);
          console.warn(`[BrowserTabPanel:${tabId}] WebContentsView crashed:`, event.data);
          break;
        case 'shortcut':
          if (event.data === 'close-tab') {
            useWorkspaceStore.getState().closeTab(tabId);
          } else if (event.data === 'focus-address') {
            document.querySelector<HTMLInputElement>(`#browser-address-${tabId}`)?.focus();
          }
          break;
        case 'new-window':
          // 在新 Tab 中打开
          useWorkspaceStore.getState().openWorkspaceTab(
            undefined, 'system.browser', undefined, undefined, undefined, false, '浏览器',
            undefined, { initialUrl: event.data }
          );
          break;
      }
    });

    return () => { unsubEvent?.(); };
  }, [tabId]);

  // ── 工具栏操作 → IPC → 主进程 BrowserViewManager ───────────────────────────────

  const sendNav = useCallback((action: string, data?: string) => {
    window.electronAPI?.ipc?.send(BVC_NAVIGATE, { tabId, action, data });
  }, [tabId]);

  const handleGoBack    = () => sendNav('back');
  const handleGoForward = () => sendNav('forward');
  const handleReload    = () => isLoading ? sendNav('stop') : sendNav('reload');
  const handleGoHome    = () => sendNav('load', 'https://www.google.com');

  const handleNavigateSubmit = (e: React.FormEvent) => {
    e.preventDefault();
    let url = inputAddress.trim();
    if (!url) return;
    const isUrl = /^(https?:\/\/)?([a-zA-Z0-9-]+\.)+[a-zA-Z]{2,}(:\d+)?(\/\S*)?$/.test(url);
    if (!isUrl) {
      url = `https://www.google.com/search?q=${encodeURIComponent(url)}`;
    } else if (!/^https?:\/\//i.test(url)) {
      url = `https://${url}`;
    }
    sendNav('load', url);
  };

  const handleOpenExternal = () => {
    if (window.electronAPI?.callApi) {
      window.electronAPI.callApi('system', 'openExternal', [address]);
    }
  };

  return (
    <div
      className="w-full h-full flex flex-col bg-[var(--bg-page)] overflow-hidden"
      style={{ display: visible ? 'flex' : 'none' }}
    >
      {/* Browser Toolbar */}
      <div className="flex items-center gap-2 px-3 py-1.5 border-b border-[var(--border-light)] bg-[var(--bg-page)] shrink-0 h-9 select-none">
        {/* Navigation Buttons */}
        <button
          onClick={handleGoBack}
          disabled={!canGoBack}
          className="p-1 rounded text-[var(--text-secondary)] hover:text-[var(--text-primary)] hover:bg-[var(--bg-hover)] disabled:opacity-30 disabled:hover:bg-transparent disabled:hover:text-[var(--text-secondary)] border-none bg-transparent cursor-pointer flex items-center justify-center transition-colors"
          title="后退"
        >
          <svg width="14" height="14" viewBox="0 0 24 24" fill="none" stroke="currentColor" strokeWidth="2.5">
            <polyline points="15 18 9 12 15 6" />
          </svg>
        </button>

        <button
          onClick={handleGoForward}
          disabled={!canGoForward}
          className="p-1 rounded text-[var(--text-secondary)] hover:text-[var(--text-primary)] hover:bg-[var(--bg-hover)] disabled:opacity-30 disabled:hover:bg-transparent disabled:hover:text-[var(--text-secondary)] border-none bg-transparent cursor-pointer flex items-center justify-center transition-colors"
          title="前进"
        >
          <svg width="14" height="14" viewBox="0 0 24 24" fill="none" stroke="currentColor" strokeWidth="2.5">
            <polyline points="9 18 15 12 9 6" />
          </svg>
        </button>

        <button
          onClick={handleReload}
          className="p-1 rounded text-[var(--text-secondary)] hover:text-[var(--text-primary)] hover:bg-[var(--bg-hover)] border-none bg-transparent cursor-pointer flex items-center justify-center transition-colors"
          title={isLoading ? '停止' : '重新加载'}
        >
          {isLoading ? (
            <svg width="14" height="14" viewBox="0 0 24 24" fill="none" stroke="currentColor" strokeWidth="2.5">
              <line x1="18" y1="6" x2="6" y2="18" /><line x1="6" y1="6" x2="18" y2="18" />
            </svg>
          ) : (
            <svg width="14" height="14" viewBox="0 0 24 24" fill="none" stroke="currentColor" strokeWidth="2.5" className={isLoading ? 'animate-spin' : ''}>
              <path d="M23 4v6h-6" /><path d="M20.49 15a9 9 0 1 1-2.12-9.36L23 10" />
            </svg>
          )}
        </button>

        <button
          onClick={handleGoHome}
          className="p-1 rounded text-[var(--text-secondary)] hover:text-[var(--text-primary)] hover:bg-[var(--bg-hover)] border-none bg-transparent cursor-pointer flex items-center justify-center transition-colors"
          title="主页"
        >
          <svg width="14" height="14" viewBox="0 0 24 24" fill="none" stroke="currentColor" strokeWidth="2.5">
            <path d="M3 9l9-7 9 7v11a2 2 0 0 1-2 2H5a2 2 0 0 1-2-2z" />
            <polyline points="9 22 9 12 15 12 15 22" />
          </svg>
        </button>

        {/* Address Input Bar */}
        <form onSubmit={handleNavigateSubmit} className="flex-1 flex items-center gap-1.5 px-3.5 py-1 rounded-lg bg-[var(--bg-input,rgba(0,0,0,0.1))] border border-[var(--border-light)] focus-within:border-[var(--color-brand)] focus-within:ring-1 focus-within:ring-[var(--color-brand)] transition-all h-6">
          <input
            id={`browser-address-${tabId}`}
            type="text"
            value={inputAddress}
            onChange={(e) => setInputAddress(e.target.value)}
            className="flex-1 bg-transparent border-none text-[11px] text-[var(--text-primary)] focus:outline-none placeholder-[var(--text-tertiary)]"
            placeholder="输入网址或进行搜索"
          />
        </form>

        {/* External Link Button */}
        <button
          onClick={handleOpenExternal}
          className="p-1 rounded text-[var(--text-secondary)] hover:text-[var(--text-primary)] hover:bg-[var(--bg-hover)] border-none bg-transparent cursor-pointer flex items-center justify-center transition-colors"
          title="在外部浏览器打开"
        >
          <svg width="14" height="14" viewBox="0 0 24 24" fill="none" stroke="currentColor" strokeWidth="2.5">
            <path d="M18 13v6a2 2 0 0 1-2 2H5a2 2 0 0 1-2-2V8a2 2 0 0 1 2-2h6" />
            <polyline points="15 3 21 3 21 9" /><line x1="10" y1="14" x2="21" y2="3" />
          </svg>
        </button>
      </div>

      {/* WebContentsView 占位区域 — 主进程 WebContentsView 叠加在此处 */}
      <div
        ref={placeholderRef}
        className="flex-1 relative"
        style={{
          // 工作区面板隐藏或 overlay 激活时，通知主进程隐藏 WebContentsView
          visibility: contentVisible ? 'visible' : 'hidden',
          background: 'transparent',
        }}
      >
        {/* 仅在加载中时显示占位提示（WebContentsView 遮挡时不可见，作为备用） */}
        {isLoading && (
          <div className="absolute inset-0 flex items-center justify-center text-[var(--text-tertiary)] text-xs pointer-events-none">
            <span>加载中...</span>
          </div>
        )}
      </div>
    </div>
  );
}
