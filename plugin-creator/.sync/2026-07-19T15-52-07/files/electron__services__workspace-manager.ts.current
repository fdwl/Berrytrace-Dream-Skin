  public getCalendarFolder(calendarUuid: number): { path: string | null; exists: boolean } {
    try {
      const checkPath = (wsPath: string): string | null => {
        if (!wsPath || !fs.existsSync(wsPath)) return null
        try {
          const metaFile = join(wsPath, WORKSPACE_DIR_NAME, WORKSPACE_META_FILE_NAME)
          if (fs.existsSync(metaFile)) {
            const data = JSON.parse(fs.readFileSync(metaFile, 'utf8'))
            if (Number(data.calendarUuid) === calendarUuid) {
              return wsPath
            }
          }
        } catch {}
        return null
      }

      for (const win of BrowserWindow.getAllWindows()) {
        const wsPath = this.getPathForWindow(win)
        if (wsPath) {
          const matched = checkPath(wsPath)
          if (matched) return { path: matched, exists: true }
        }
      }

      const history = this.getHistory()
      for (const entry of history) {
        const matched = checkPath(entry.path)
        if (matched) return { path: matched, exists: true }
      }
    } catch (err) {
      console.error('[WorkspaceManager] Failed to get calendar folder:', err)
    }
    return { path: null, exists: false }
  }

  public async associateRemoteCalendar(calendarUuid: number, name: string, folderPath: string): Promise<{ success: boolean; error?: string }> {
    if (!calendarUuid || !name || !folderPath) {
      throw new Error('参数不完整')
    }

    const dotFolder = join(folderPath, WORKSPACE_DIR_NAME)
    const metaFile = join(dotFolder, WORKSPACE_META_FILE_NAME)

    // Check if the metafile already exists and has a different uuid
    if (fs.existsSync(metaFile)) {
      try {
        const content = fs.readFileSync(metaFile, 'utf8')
        const data = JSON.parse(content)
        const existingUuid = Number(data.calendarUuid)
        if (existingUuid && existingUuid !== calendarUuid) {
          const choice = dialog.showMessageBoxSync({
            type: 'warning',
            buttons: ['覆盖关联', '取消'],
            defaultId: 1,
            cancelId: 1,
            title: '目录已被占用',
            message: `所选文件夹已绑定了另一个本地仓库 (UUID: ${existingUuid})。`,
            detail: '如果您继续，该目录将被重新绑定到当前选择的远程空间，原有本地空间关联将失效。是否确认覆盖？'
          })
          if (choice === 1) {
            return { success: false, error: 'USER_CANCELLED' }
          }
        }
      } catch (err) {
        console.error('[WorkspaceManager] Failed to read existing workspace.json:', err)
      }
    }

    // Ensure folder structure exists
    if (!fs.existsSync(folderPath)) {
      fs.mkdirSync(folderPath, { recursive: true })
    }
    if (!fs.existsSync(dotFolder)) {
      fs.mkdirSync(dotFolder, { recursive: true })
    }

    // Write workspace.json
    const data = {
      calendarUuid,
      name,
      recentDocuments: []
    }
    fs.writeFileSync(metaFile, JSON.stringify(data, null, 2), 'utf8')

    // Associated remote calendar locally in workspace.json

    return { success: true }
  }

  public async searchContent(wsPath: string | null, query: string): Promise<any[]> {
    if (!wsPath || !fs.existsSync(wsPath) || !query) {
      return []
    }

    const results: any[] = []
    const cleanQuery = query.toLowerCase().trim()
    if (!cleanQuery) return []

    const traverse = async (dir: string) => {
      if (results.length >= 100) return
      const files = await fs.promises.readdir(dir, { withFileTypes: true })
      for (const file of files) {
        if (results.length >= 100) return
        const name = file.name
        if (
          name === '.git' ||
          name === 'node_modules' ||
          name === WORKSPACE_DIR_NAME ||
          name === '.DS_Store' ||
          name.startsWith('.')
        ) {
          continue
        }

        const fullPath = join(dir, name)
        if (file.isDirectory()) {
          await traverse(fullPath)
        } else {
          const ext = extname(name).toLowerCase()
          if (ext === '.md' || ext === '.txt') {
            try {
              const content = await fs.promises.readFile(fullPath, 'utf8')
              const lowerContent = content.toLowerCase()

              if (lowerContent.includes(cleanQuery)) {
                const lines = content.split('\n')
                for (let i = 0; i < lines.length; i++) {
                  const line = lines[i]
                  const lowerLine = line.toLowerCase()
                  const index = lowerLine.indexOf(cleanQuery)
                  if (index !== -1) {
                    let start = Math.max(0, index - 20)
                    let end = Math.min(line.length, index + cleanQuery.length + 30)
                    let snippet = line.substring(start, end)
                    if (start > 0) snippet = '...' + snippet
                    if (end < line.length) snippet = snippet + '...'

                    results.push({
                      path: fullPath,
                      fileName: name,
                      line: i + 1,
                      snippet: snippet.trim()
                    })
                    if (results.filter(r => r.path === fullPath).length >= 3) {
                      break
                    }
                  }
                }
              }
            } catch (err) {
              console.warn('[WorkspaceManager] Failed to read file for searchContent:', fullPath, err)
            }
          }
        }
      }
    }

    try {
      await traverse(wsPath)
    } catch (err) {
      console.error('[WorkspaceManager] Failed to search content in:', wsPath, err)
    }

    return results
  }

  public async saveRibbonOrder(wsPath: string | null, ribbonOrder: string[]): Promise<boolean> {
    if (!wsPath || !fs.existsSync(wsPath)) {
      return false
    }
    const dotFolder = join(wsPath, WORKSPACE_DIR_NAME)
    const metaFile = join(dotFolder, WORKSPACE_META_FILE_NAME)
    try {
      if (!fs.existsSync(dotFolder)) {
        fs.mkdirSync(dotFolder, { recursive: true })
      }
      let data: any = {}
      if (fs.existsSync(metaFile)) {
        try {
          const content = fs.readFileSync(metaFile, 'utf8')
          data = JSON.parse(content)
        } catch (_) {}
      }
      data.ribbonOrder = ribbonOrder
      fs.writeFileSync(metaFile, JSON.stringify(data, null, 2), 'utf8')
      return true
    } catch (err) {
      console.error('[WorkspaceManager] Failed to save ribbon order:', err)
      return false
    }
  }

  public async updateMetadata(wsPath: string | null, updates: Record<string, any>): Promise<boolean> {
    if (!wsPath || !fs.existsSync(wsPath)) {
      return false
    }
    const dotFolder = join(wsPath, WORKSPACE_DIR_NAME)
    const metaFile = join(dotFolder, WORKSPACE_META_FILE_NAME)
    try {
      if (!fs.existsSync(dotFolder)) {
        fs.mkdirSync(dotFolder, { recursive: true })
      }
      let data: any = {}
      if (fs.existsSync(metaFile)) {
        try {
          const content = fs.readFileSync(metaFile, 'utf8')
          data = JSON.parse(content)
        } catch (_) {}
      }
      data = { ...data, ...updates }
      fs.writeFileSync(metaFile, JSON.stringify(data, null, 2), 'utf8')
      return true
    } catch (err) {
      console.error('[WorkspaceManager] Failed to update metadata:', err)
      return false
    }
  }

  // ─── Phase 3: per-workspace plugin overrides ───────────────────────

  /** 获取工作区的插件 override 配置 */
  public async getPluginOverrides(wsPath: string | null): Promise<Record<string, { enabled?: boolean; config?: Record<string, unknown> }>> {
    if (!wsPath || !fs.existsSync(wsPath)) return {}
    const metaFile = join(wsPath, WORKSPACE_DIR_NAME, WORKSPACE_META_FILE_NAME)
    try {
      if (!fs.existsSync(metaFile)) return {}
      const content = fs.readFileSync(metaFile, 'utf8')
      const data = JSON.parse(content)
      return data.pluginOverrides || {}
    } catch (err) {
      console.error('[WorkspaceManager] Failed to get plugin overrides:', err)
      return {}
    }
  }

  /** 设置工作区中某个插件的 override */
  public async setPluginOverride(wsPath: string | null, pluginId: string, enabled: boolean): Promise<boolean> {
    console.log(`[WorkspaceManager] setPluginOverride called: wsPath=${wsPath}, pluginId=${pluginId}, enabled=${enabled}`)
    if (!wsPath || !fs.existsSync(wsPath)) {
      console.warn(`[WorkspaceManager] setPluginOverride: wsPath invalid or not exists: ${wsPath}`)
      return false
    }
    const dotFolder = join(wsPath, WORKSPACE_DIR_NAME)
    const metaFile = join(dotFolder, WORKSPACE_META_FILE_NAME)
    console.log(`[WorkspaceManager] setPluginOverride: dotFolder=${dotFolder}, metaFile=${metaFile}`)
    try {
      if (!fs.existsSync(dotFolder)) {
        console.log(`[WorkspaceManager] setPluginOverride: creating dotFolder`)
        fs.mkdirSync(dotFolder, { recursive: true })
      }
      let data: any = {}
      if (fs.existsSync(metaFile)) {
        try {
          const content = fs.readFileSync(metaFile, 'utf8')
          data = JSON.parse(content)
          console.log(`[WorkspaceManager] setPluginOverride: read existing meta, keys=${Object.keys(data).join(',')}`)
        } catch (parseErr) {
          console.warn(`[WorkspaceManager] setPluginOverride: failed to parse meta, using empty`, parseErr)
        }
      } else {
        console.log(`[WorkspaceManager] setPluginOverride: metaFile does not exist, creating new`)
      }
      if (!data.pluginOverrides) {
        data.pluginOverrides = {}
      }
      data.pluginOverrides[pluginId] = { ...data.pluginOverrides[pluginId], enabled }
      fs.writeFileSync(metaFile, JSON.stringify(data, null, 2), 'utf8')
      console.log(`[WorkspaceManager] setPluginOverride: SUCCESS wrote ${pluginId}=${enabled} to ${metaFile}`)
      return true
    } catch (err) {
      console.error('[WorkspaceManager] setPluginOverride: FAILED', err)
      return false
    }
  }

  /** 删除工作区中某个插件的 override（恢复为跟随全局） */
  public async removePluginOverride(wsPath: string | null, pluginId: string): Promise<boolean> {
    console.log(`[WorkspaceManager] removePluginOverride called: wsPath=${wsPath}, pluginId=${pluginId}`)
    if (!wsPath || !fs.existsSync(wsPath)) {
      console.warn(`[WorkspaceManager] removePluginOverride: wsPath invalid: ${wsPath}`)
      return false
    }
    const metaFile = join(wsPath, WORKSPACE_DIR_NAME, WORKSPACE_META_FILE_NAME)
    try {
      if (!fs.existsSync(metaFile)) {
        console.log(`[WorkspaceManager] removePluginOverride: metaFile does not exist`)
        return false
      }
      const content = fs.readFileSync(metaFile, 'utf8')
      const data = JSON.parse(content)
      if (!data.pluginOverrides || !data.pluginOverrides[pluginId]) {
        console.log(`[WorkspaceManager] removePluginOverride: no override for ${pluginId}`)
        return false
      }
      delete data.pluginOverrides[pluginId]
      if (Object.keys(data.pluginOverrides).length === 0) {
        delete data.pluginOverrides
      }
      fs.writeFileSync(metaFile, JSON.stringify(data, null, 2), 'utf8')
      console.log(`[WorkspaceManager] removePluginOverride: SUCCESS removed ${pluginId} from ${metaFile}`)
      return true
    } catch (err) {
      console.error('[WorkspaceManager] removePluginOverride: FAILED', err)
      return false
    }
  }

  public registerIpcHandlers(): void {
    ipcMain.handle('workspace:updateMetadata', async (event, updates: Record<string, any>) => {
      const wsPath = this.getPathForWebContents(event.sender)
      return this.updateMetadata(wsPath, updates)
    })

    // Phase 1: Pull pending agent tasks for the current workspace
    // 窗口在 workspace:switched 处理完成后主动拉取，避免推送丢失
    ipcMain.handle('workspace:pullPendingTasks', async (event) => {
      const wsPath = this.getPathForWebContents(event.sender)
      if (!wsPath) return []
      try {
        const { WorkspaceContextManager } = await import('./workspace-context-manager')
        const ctx = WorkspaceContextManager.getInstance().getContext(wsPath)
        if (!ctx) return []
        const tasks = ctx.drainPendingTasks()
        if (tasks.length > 0) {
          console.log(`[WorkspaceManager] Pulled ${tasks.length} pending tasks for ${wsPath}`)
        }
        return tasks
      } catch (err) {
        console.error('[WorkspaceManager] Failed to pull pending tasks:', err)
        return []
      }
    })

    ipcMain.handle('workspace:saveRibbonOrder', async (event, ribbonOrder: string[]) => {
      const wsPath = this.getPathForWebContents(event.sender)
      return this.saveRibbonOrder(wsPath, ribbonOrder)
    })

    ipcMain.handle('workspace:searchContent', async (event, query: string) => {
      const wsPath = this.getPathForWebContents(event.sender)
      return this.searchContent(wsPath, query)
    })

    ipcMain.handle('workspace:associateRemoteCalendar', async (_event, calendarUuid: number, name: string, folderPath: string) => {
      return this.associateRemoteCalendar(calendarUuid, name, folderPath)
    })

    ipcMain.handle('workspace:getCalendarFolder', (_event, calendarUuid: number) => {
      return this.getCalendarFolder(calendarUuid)
    })

    ipcMain.handle('workspace:getPath', (event) => {
      return this.getPathForWebContents(event.sender)
    })

    ipcMain.handle('workspace:getMetadata', (event) => {
      const win = BrowserWindow.fromWebContents(event.sender)
      if (!win) return { path: null, name: '', calendarUuid: 0 }
      return this.getMetadataForWindow(win)
    })

    ipcMain.handle('workspace:selectFolder', async () => {
      return this.selectFolder()
    })

    ipcMain.handle('workspace:setPath', async (event, path: string | null) => {
      const win = BrowserWindow.fromWebContents(event.sender)
      if (!win) return false
      return this.setPathForWindow(win, path)
    })

    ipcMain.handle('workspace:relaunch', () => {
      this.relaunch()
    })

    ipcMain.handle('workspace:readDir', async (event, dirPath?: string) => {
      const wsPath = this.getPathForWebContents(event.sender)
      return this.readDir(dirPath, wsPath)
    })

    ipcMain.handle('workspace:readDirRecursively', async (event, dirPath?: string) => {
      const wsPath = this.getPathForWebContents(event.sender)
      return this.readDirRecursively(dirPath, wsPath)
    })

    ipcMain.handle('workspace:createFile', async (event, parentPath: string, name: string, content?: string) => {
      const wsPath = this.getPathForWebContents(event.sender)
      return this.createFile(parentPath, name, wsPath, content)
    })

    ipcMain.handle('workspace:createDirectory', async (event, parentPath: string, name: string) => {
      const wsPath = this.getPathForWebContents(event.sender)
      return this.createDirectory(parentPath, name, wsPath)
    })

    ipcMain.handle('workspace:deleteItem', async (event, itemPath: string) => {
      const wsPath = this.getPathForWebContents(event.sender)
      return this.deleteItem(itemPath, wsPath)
    })

    ipcMain.handle('workspace:renameItem', async (event, oldPath: string, newPath: string) => {
      const wsPath = this.getPathForWebContents(event.sender)
      return this.renameItem(oldPath, newPath, wsPath)
    })

    ipcMain.handle('workspace:duplicateItem', async (event, itemPath: string) => {
      const wsPath = this.getPathForWebContents(event.sender)
      return this.duplicateItem(itemPath, wsPath)
    })

    ipcMain.handle('workspace:importItem', async (event, srcPath: string, targetPath: string) => {
      const wsPath = this.getPathForWebContents(event.sender)
      return this.importItem(srcPath, targetPath, wsPath)
    })

    ipcMain.handle('workspace:create', async (event, parentPath: string, name: string) => {
      const win = BrowserWindow.fromWebContents(event.sender)
      return this.createWorkspace(parentPath, name, win)
    })

    ipcMain.handle('workspace:getHistory', () => {
      return this.getHistory()
    })

    ipcMain.handle('workspace:removeFromHistory', (_event, path: string) => {
      this.removeFromHistory(path)
    })

    // 搜索面板相关 IPC handlers
    ipcMain.handle('workspace:getRecentDocuments', (event) => {
      const win = BrowserWindow.fromWebContents(event.sender)
      if (!win) return []
      return this.getRecentDocuments(win)
    })

    ipcMain.handle('workspace:addRecentDocument', async (event, filePath: string, title: string) => {
      const win = BrowserWindow.fromWebContents(event.sender)
      if (!win) return
      await this.addRecentDocument(win, filePath, title)
    })

    ipcMain.handle('workspace:searchDocuments', async (_event, { query, workspacePath }: { query: string; workspacePath: string }) => {
      if (!workspacePath || !query) return []

      try {
        const { FullTextIndexManager } = await import('./fulltext-index-manager.js')
        const rows = await FullTextIndexManager.getInstance().searchFiles(query, workspacePath)

        return (rows || []).map((row: any) => ({
          filePath: row.file_path,
          fileName: row.file_name,
          snippet: row.snip,
          lineNumber: row.line_number,
          rank: row.rank
        }))
      } catch (err) {
        console.error('[WorkspaceManager] FTS search failed:', err)
        return []
      }
    })

    ipcMain.handle('workspace:getActiveTabOutline', async () => {
      // 通过渲染进程获取当前激活 Tab 的大纲
      const mainWindow = ElectronMainWindow.getInstance().getWindow()
      if (!mainWindow || mainWindow.isDestroyed()) return null

      return new Promise((resolve) => {
        const token = Math.floor(Math.random() * 1000000)
        const timeout = setTimeout(() => {
          resolve(null)
        }, 3000)

        ipcMain.once(`workspace:get-active-tab-outline-response:${token}`, (_event, data) => {
          clearTimeout(timeout)
          resolve(data)
        })

        mainWindow.webContents.send('workspace:get-active-tab-outline-request', { token })
      })
    })

    ipcMain.handle('workspace:notifyPluginNavigate', (_event, data: { pluginId: string; filePath: string; lineNumber?: number; headingText?: string }) => {
      const mainWindow = ElectronMainWindow.getInstance().getWindow()
      if (mainWindow && !mainWindow.isDestroyed()) {
        mainWindow.webContents.send('plugin:navigate-to-position', data)
      }
      return null
    })

    // 获取支持某个文件扩展名的插件列表
    ipcMain.handle('workspace:getPluginsByExtension', async (_event, ext: string) => {
      try {
        const { PluginManager } = await import('../plugins/plugin-manager')
        const pm = PluginManager.getInstance()
        const plugins = pm.getPluginsByExtension(ext)

        return plugins.map(p => ({
          id: p.manifest.id,
          name: p.manifest.name,
          fileAssociations: p.manifest.fileAssociations || []
        }))
      } catch (err) {
        console.error('[WorkspaceManager] Failed to get plugins by extension:', err)
        return []
      }
    })
  }
}
