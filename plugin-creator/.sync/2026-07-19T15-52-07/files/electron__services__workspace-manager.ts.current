  /** @deprecated Use WorkspaceContext.activate() instead */
  public startWatcherForPath(p: string): void {
    console.warn('[WorkspaceManager] startWatcherForPath is deprecated. Use WorkspaceContext.activate() instead.')
  }

  /** @deprecated Use WorkspaceContext.deactivate() instead */
  public stopWatcherForPath(p: string): void {
    console.warn('[WorkspaceManager] stopWatcherForPath is deprecated. Use WorkspaceContext.deactivate() instead.')
    // 清理旧的 debounce 定时器（如果存在）
    const debounceTimeout = this.debounceTimeouts.get(p)
    if (debounceTimeout) {
      clearTimeout(debounceTimeout)
      this.debounceTimeouts.delete(p)
    }
    const structureTimeout = this.structureDebounceTimeouts.get(p)
    if (structureTimeout) {
      clearTimeout(structureTimeout)
      this.structureDebounceTimeouts.delete(p)
    }
    this.changedFilesMap.delete(p)
    for (const [key, timeout] of this.fileChangeDebounceTimeouts.entries()) {
      if (key.startsWith(`${p}:`)) {
        clearTimeout(timeout)
        this.fileChangeDebounceTimeouts.delete(key)
      }
    }
  }

