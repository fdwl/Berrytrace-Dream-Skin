+import { BERRYTRACE_HOME } from '../config/paths'
+
+const RECENT_SESSIONS_FILE = join(BERRYTRACE_HOME, 'recent_sessions.json');
+
+interface RecentSessionItem {
+  sessionId: string;
+  title?: string;
+  task?: string;
+  workDir: string;
+  status?: string;
+  startedAt?: number;
+  updatedAt?: number;
+  finalMessage?: string;
+  [key: string]: unknown;
+}
+
+async function getRecentSessionsList(): Promise<RecentSessionItem[]> {
+  try {
+    if (fs.existsSync(RECENT_SESSIONS_FILE)) {
+      const content = await fsPromises.readFile(RECENT_SESSIONS_FILE, 'utf-8');
+      const list = JSON.parse(content);
+      if (Array.isArray(list)) return list;
+    }
+  } catch (err) {
+    console.warn('[FileManager:getRecentSessionsList] Warning:', err);
+  }
+  return [];
+}
+
+async function updateRecentSessions(session: Record<string, unknown>): Promise<RecentSessionItem[]> {
+  try {
+    if (!session || !session.sessionId) return [];
+    if (!fs.existsSync(BERRYTRACE_HOME)) {
+      await fsPromises.mkdir(BERRYTRACE_HOME, { recursive: true });
+    }
+    const currentList = await getRecentSessionsList();
+    const sessionId = String(session.sessionId);
+    
+    const metaItem: RecentSessionItem = {
+      sessionId,
+      title: (session.title as string) || (session.task as string)?.slice(0, 28) || 'AI 会话',
+      task: (session.task as string) || '',
+      workDir: (session.workDir as string) || '',
+      status: (session.status as string) || 'completed',
+      startedAt: Number(session.startedAt) || Date.now(),
+      updatedAt: Number(session.updatedAt) || Date.now(),
+      finalMessage: session.finalMessage as string | undefined,
+    };
+
+    let filtered = currentList.filter((item) => item.sessionId !== sessionId);
+    filtered.unshift(metaItem);
+    filtered.sort((a, b) => (Number(b.startedAt || b.updatedAt) || 0) - (Number(a.startedAt || a.updatedAt) || 0));
+
+    if (filtered.length > 20) {
+      filtered = filtered.slice(0, 20);
+    }
+
+    await fsPromises.writeFile(RECENT_SESSIONS_FILE, JSON.stringify(filtered, null, 2), 'utf-8');
+    return filtered;
+  } catch (err) {
+    console.error('[FileManager:updateRecentSessions] Error updating recent sessions:', err);
+    return [];
+  }
+}
+
+async function removeRecentSession(sessionId: string): Promise<RecentSessionItem[]> {
+  try {
+    if (!sessionId) return [];
+    const currentList = await getRecentSessionsList();
+    const filtered = currentList.filter((item) => item.sessionId !== sessionId);
+    if (filtered.length !== currentList.length) {
+      await fsPromises.writeFile(RECENT_SESSIONS_FILE, JSON.stringify(filtered, null, 2), 'utf-8');
+    }
+    return filtered;
+  } catch (err) {
+    console.error('[FileManager:removeRecentSession] Error removing recent session:', err);
+    return [];
+  }
+}
 
