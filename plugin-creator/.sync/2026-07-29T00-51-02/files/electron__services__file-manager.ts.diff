+              const subMessagesJsonl = join(sessionsDir, sessionId, 'messages.jsonl');
+              const subMessagesJson = join(sessionsDir, sessionId, 'messages.json');
+
+              if (fs.existsSync(subSessionJson)) sessionJsonPath = subSessionJson;
+              if (fs.existsSync(subMessagesJsonl)) {
+                messagesJsonPath = subMessagesJsonl;
+              } else if (fs.existsSync(subMessagesJson)) {
+                messagesJsonPath = subMessagesJson;
+              }
+            } else if (entry.isFile() && entry.name.endsWith('.json')) {
+              sessionId = entry.name.replace('.json', '');
+              sessionJsonPath = join(sessionsDir, entry.name);
+            }
+
+            if (!sessionId) continue;
+
+            let metaData: Record<string, unknown> = {};
+            let statMs = Date.now();
+
+            if (sessionJsonPath) {
+              const stat = await fsPromises.stat(sessionJsonPath);
+              statMs = stat.mtimeMs;
+              const raw = await fsPromises.readFile(sessionJsonPath, 'utf-8');
+              metaData = (JSON.parse(raw) || {}) as Record<string, unknown>;
+            }
+
+            let turnsData = (metaData.turns as unknown[]) || [];
+            if (messagesJsonPath) {
