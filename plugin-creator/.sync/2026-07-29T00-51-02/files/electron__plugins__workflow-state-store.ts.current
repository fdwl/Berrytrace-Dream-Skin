import fs from 'fs';
import path from 'path';
import { BERRYTRACE_HOME } from '../config/paths';
import type { StepExecutionResult, WorkflowExecutionResult } from './workflow-types';

export interface PersistentRunState {
  runId: string;
  workflowId: string;
  status: 'running' | 'paused' | 'completed' | 'failed' | 'canceled';
  currentStepId?: string;
  idempotencyKey?: string;
  input: Record<string, unknown>;
  stepOutputs: Record<string, unknown>;
  stepResults: StepExecutionResult[];
  startedAt: number;
  updatedAt: number;
  error?: string;
}

export class WorkflowStateStore {
  private static instance: WorkflowStateStore | null = null;
  private storageDir: string;

  private constructor() {
    this.storageDir = path.join(BERRYTRACE_HOME, 'workflow_executions');
    if (!fs.existsSync(this.storageDir)) {
      fs.mkdirSync(this.storageDir, { recursive: true });
    }
  }

  public static getInstance(): WorkflowStateStore {
    if (!WorkflowStateStore.instance) {
      WorkflowStateStore.instance = new WorkflowStateStore();
    }
    return WorkflowStateStore.instance;
  }

  /**
   * 保存或更新执行状态（在每个 Step 执行前后触发落盘）
   */
  public saveRunState(state: PersistentRunState): void {
    try {
      state.updatedAt = Date.now();
      const filePath = path.join(this.storageDir, `${state.runId}.json`);
      fs.writeFileSync(filePath, JSON.stringify(state, null, 2), 'utf-8');
    } catch (err) {
      console.error(`[WorkflowStateStore] Failed to save state for run "${state.runId}":`, err);
    }
  }

  /**
   * 根据 idempotencyKey 查找历史/运行中的 Run（防止重复触发）
   */
  public getRunByIdempotencyKey(idempotencyKey: string): PersistentRunState | null {
    if (!idempotencyKey) return null;
    try {
      if (!fs.existsSync(this.storageDir)) return null;
      const files = fs.readdirSync(this.storageDir).filter((f) => f.endsWith('.json'));

      for (const file of files) {
        const state = this.getRunState(file.replace('.json', ''));
        if (state && state.idempotencyKey === idempotencyKey) {
          return state;
        }
      }
    } catch (err) {
      console.error(`[WorkflowStateStore] Failed to lookup idempotency key:`, err);
    }
    return null;
  }

  /**
   * 获取指定的运行状态
   */
  public getRunState(runId: string): PersistentRunState | null {
    try {
      const filePath = path.join(this.storageDir, `${runId}.json`);
      if (!fs.existsSync(filePath)) return null;
      const txt = fs.readFileSync(filePath, 'utf-8');
      return JSON.parse(txt) as PersistentRunState;
    } catch {
      return null;
    }
  }

  /**
   * 查找未正常完成的崩溃运行记录（用于程序重启时的断点自愈恢复）
   */
  public getUnfinishedRuns(): PersistentRunState[] {
    const unfinished: PersistentRunState[] = [];
    try {
      if (!fs.existsSync(this.storageDir)) return [];
      const files = fs.readdirSync(this.storageDir).filter((f) => f.endsWith('.json'));

      for (const file of files) {
        const state = this.getRunState(file.replace('.json', ''));
        if (state && (state.status === 'running' || state.status === 'paused')) {
          unfinished.push(state);
        }
      }
    } catch (err) {
      console.error(`[WorkflowStateStore] Failed to list unfinished runs:`, err);
    }
    return unfinished;
  }

  /**
   * 标记运行状态为已完成/失败
   */
  public markCompleted(runId: string, success: boolean, finalResult: WorkflowExecutionResult): void {
    const state = this.getRunState(runId);
    if (state) {
      state.status = success ? 'completed' : 'failed';
      state.stepResults = finalResult.steps;
      state.error = finalResult.error;
      this.saveRunState(state);
    }
  }

  /**
   * 当步骤输出体过大 (>1MB) 时，卸载至物理磁盘文件，在内存中只保留句柄
   */
  public offloadLargeOutput(runId: string, stepId: string, output: unknown): { __offloaded: boolean; path: string; preview: string; sizeBytes: number } | null {
    try {
      const str = typeof output === 'string' ? output : JSON.stringify(output);
      if (str.length < 1024 * 1024) return null; // 小于 1MB 无需卸载

      const tmpDir = path.resolve(process.cwd(), '.berrytrace', 'tmp');
      if (!fs.existsSync(tmpDir)) fs.mkdirSync(tmpDir, { recursive: true });

      const fileName = `offload_${runId}_${stepId.replace(/[^a-zA-Z0-9_-]/g, '_')}.json`;
      const filePath = path.join(tmpDir, fileName);
      fs.writeFileSync(filePath, typeof output === 'string' ? output : JSON.stringify(output, null, 2), 'utf-8');

      console.log(`[WorkflowStateStore] Offloaded large payload (${str.length} bytes) for step "${stepId}" to "${filePath}"`);
      return {
        __offloaded: true,
        path: filePath,
        preview: str.slice(0, 300) + '...',
        sizeBytes: str.length,
      };
    } catch (err) {
      console.error(`[WorkflowStateStore] Failed to offload large output for step "${stepId}":`, err);
      return null;
    }
  }

  /**
   * 清理过期/历史状态文件（默认保留最近 30 天）
   */
  public cleanup(maxAgeMs = 30 * 24 * 3600 * 1000): void {
    try {
      if (!fs.existsSync(this.storageDir)) return;
      const files = fs.readdirSync(this.storageDir).filter((f) => f.endsWith('.json'));
      const now = Date.now();

      for (const file of files) {
        const filePath = path.join(this.storageDir, file);
        const stat = fs.statSync(filePath);
        if (now - stat.mtimeMs > maxAgeMs) {
          fs.unlinkSync(filePath);
        }
      }
    } catch (err) {
      console.error(`[WorkflowStateStore] Cleanup failed:`, err);
    }
  }
}
