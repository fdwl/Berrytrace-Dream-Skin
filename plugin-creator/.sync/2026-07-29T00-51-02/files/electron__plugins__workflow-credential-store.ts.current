import fs from 'fs';
import path from 'path';
import { safeStorage } from 'electron';

export class WorkflowCredentialStore {
  private static instance: WorkflowCredentialStore | null = null;
  private vaultFilePath: string;
  private memoryCache: Map<string, string> = new Map();

  private constructor() {
    this.vaultFilePath = path.resolve(process.cwd(), '.berrytrace', 'vault.json');
    this.loadVault();
  }

  public static getInstance(): WorkflowCredentialStore {
    if (!WorkflowCredentialStore.instance) {
      WorkflowCredentialStore.instance = new WorkflowCredentialStore();
    }
    return WorkflowCredentialStore.instance;
  }

  private getSafeStorage(): typeof safeStorage | null {
    try {
      if (safeStorage && safeStorage.isEncryptionAvailable()) {
        return safeStorage;
      }
    } catch {
      // safeStorage is not available
    }
    return null;
  }

  private loadVault(): void {
    if (!fs.existsSync(this.vaultFilePath)) return;
    try {
      const content = fs.readFileSync(this.vaultFilePath, 'utf-8');
      const rawData: Record<string, string> = JSON.parse(content);
      const safeStorage = this.getSafeStorage();

      for (const [key, val] of Object.entries(rawData)) {
        if (safeStorage && val.startsWith('enc:')) {
          const buf = Buffer.from(val.replace('enc:', ''), 'base64');
          const decrypted = safeStorage.decryptString(buf);
          this.memoryCache.set(key, decrypted);
        } else if (val.startsWith('b64:')) {
          const decrypted = Buffer.from(val.replace('b64:', ''), 'base64').toString('utf-8');
          this.memoryCache.set(key, decrypted);
        } else {
          this.memoryCache.set(key, val);
        }
      }
    } catch (err) {
      console.error(`[WorkflowCredentialStore] Failed to load vault:`, err);
    }
  }

  private saveVault(): void {
    try {
      const dir = path.dirname(this.vaultFilePath);
      if (!fs.existsSync(dir)) fs.mkdirSync(dir, { recursive: true });

      const safeStorage = this.getSafeStorage();
      const exportData: Record<string, string> = {};

      for (const [key, val] of this.memoryCache.entries()) {
        if (safeStorage) {
          const encBuf = safeStorage.encryptString(val);
          exportData[key] = `enc:${encBuf.toString('base64')}`;
        } else {
          exportData[key] = `b64:${Buffer.from(val, 'utf-8').toString('base64')}`;
        }
      }

      fs.writeFileSync(this.vaultFilePath, JSON.stringify(exportData, null, 2), 'utf-8');
    } catch (err) {
      console.error(`[WorkflowCredentialStore] Failed to save vault:`, err);
    }
  }

  /**
   * 设置秘钥凭证
   */
  public setCredential(key: string, secretValue: string): void {
    if (!key) return;
    this.memoryCache.set(key, secretValue);
    this.saveVault();
  }

  /**
   * 获取秘钥解密凭证
   */
  public getCredential(key: string): string | null {
    return this.memoryCache.get(key) || null;
  }

  /**
   * 删除凭证
   */
  public deleteCredential(key: string): boolean {
    const existed = this.memoryCache.delete(key);
    if (existed) this.saveVault();
    return existed;
  }

  /**
   * 列出所有保存的凭证名称（隐藏敏感内容）
   */
  public listCredentialKeys(): string[] {
    return Array.from(this.memoryCache.keys());
  }

  /**
   * 在字符串参数中解算凭证表达式 (例如 "$credential.openai_key")
   */
  public resolveCredentialExpression(inputStr: string): string {
    if (!inputStr || typeof inputStr !== 'string') return inputStr;
    return inputStr.replace(/\$credential\.([a-zA-Z0-9_-]+)/g, (_, credKey) => {
      const val = this.getCredential(credKey);
      if (val === null) {
        console.warn(`[WorkflowCredentialStore] Credential key "$credential.${credKey}" not found in vault.`);
        return `$credential.${credKey}`;
      }
      return val;
    });
  }
}
