+export function getFinalToolName(toolName: string, pluginId: string, allowedPrefixes?: string[]): string {
+  const parts = pluginId.split('.');
+  const lastPart = parts[parts.length - 1] || '';
+  const defaultPrefix = lastPart.replace(/-/g, '_').toLowerCase().replace(/_tools$/, '').replace(/_agent$/, '');
+
+  let prefixes = allowedPrefixes;
+  if (!prefixes && pluginId) {
+    try {
+      const pm = PluginManager.getInstance();
+      const plugin = pm.getPlugin(pluginId);
+      prefixes = plugin?.manifest?.mcp?.toolPrefixes;
+    } catch {
+      // 忽略可能存在的依赖初始化顺序问题
+    }
+  }
+
+  const activePrefixes = prefixes && prefixes.length > 0
+    ? prefixes.map(p => p.toLowerCase())
+    : [defaultPrefix];
+
+  // 校验工具名是否以允许的前缀开头
+  let hasValidPrefix = false;
+  for (const p of activePrefixes) {
+    if (toolName.startsWith(p + '_')) {
+      hasValidPrefix = true;
+      break;
+    }
+  }
+
+  if (!hasValidPrefix && pluginId !== 'berrytrace.host' && pluginId !== '') {
+    console.warn(`[McpHost] Warning: Tool "${toolName}" from plugin "${pluginId}" does not follow the naming standard. It should be prefixed with "${activePrefixes[0]}_".`);
+  }
+
+  return toolName;
+}
 
