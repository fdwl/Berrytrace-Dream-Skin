import { ipcMain } from 'electron';
import type { ApiContext} from './api-context';
import { BaseApiController } from './api-context';
import { ElectronMainWindow } from '../../windows/main-window';
import { BrowserViewManager } from '../../windows/browser-view-manager';

export class BrowserController extends BaseApiController {
  // ── browser namespace ──

  /**
   * 执行工作区浏览器动作（打开网页、点击、输入、滚动、截图、执行JS等）。
   *
   * 迁移后流程（WebContentsView 架构）：
   *  1. 预热 — 通知 AppLayout 打开 workspace，等待 React UI 就绪并创建对应 Tab
   *  2. 执行 — 直接在主进程通过 BrowserViewManager 操作 WebContentsView，不再经过渲染进程中转
   */
  async browser_action(action: string, params: Record<string, any>, context: ApiContext): Promise<any> {
    const mainWindow = ElectronMainWindow.getInstance().getWindow();
    if (!mainWindow || mainWindow.isDestroyed()) {
      throw new Error('[BrowserController] Main window not found');
    }

    // 预热工作区面板，等待 React 侧创建 Tab 并上报 tabId
    const tabId = await this._prepareWorkspace(mainWindow);
    const bvm = BrowserViewManager.getInstance();

    if (!bvm.hasView(tabId)) {
      console.warn(`[BrowserController] WebContentsView for tabId=${tabId} not yet registered, waiting...`);
      const ready = await new Promise<boolean>((resolve) => {
        const timer = setTimeout(() => resolve(false), 5000);
        const check = setInterval(() => {
          if (bvm.hasView(tabId)) {
            clearInterval(check);
            clearTimeout(timer);
            resolve(true);
          }
        }, 100);
      });
      if (!ready) {
        throw new Error(`[BrowserController] WebContentsView for tabId=${tabId} 未在 5s 内就绪，浏览器标签可能创建失败`);
      }
    }

    let result: any = null;

    if (action === 'open') {
      const { url } = params;
      await bvm.loadURL(tabId, url);
      result = { url: bvm.getURL(tabId) };

    } else if (action === 'click') {
      const { x, y, selector } = params;
      await bvm.executeJavaScript(tabId, `
        (() => {
          let el = null;
          if (${JSON.stringify(selector)}) {
            el = document.querySelector(${JSON.stringify(selector)});
          } else if (typeof ${x} === 'number' && typeof ${y} === 'number') {
            el = document.elementFromPoint(${x}, ${y});
          }
          if (el) {
            const rect = el.getBoundingClientRect();
            const cx = rect.left + rect.width / 2;
            const cy = rect.top + rect.height / 2;
            const opts = { bubbles: true, cancelable: true, view: window, clientX: cx, clientY: cy };
            el.dispatchEvent(new MouseEvent('mousedown', opts));
            el.dispatchEvent(new MouseEvent('mouseup', opts));
            el.click();
            if (el instanceof HTMLElement) el.focus();
            return true;
          }
          return false;
        })()
      `);
      result = { success: true };

    } else if (action === 'type') {
      const { text, selector } = params;
      await bvm.executeJavaScript(tabId, `
        (() => {
          let el = ${JSON.stringify(selector)} ? document.querySelector(${JSON.stringify(selector)}) : document.activeElement;
          if (el && (el.tagName === 'INPUT' || el.tagName === 'TEXTAREA' || el.isContentEditable)) {
            if (el instanceof HTMLElement) el.focus();
            if (el.isContentEditable) { el.textContent = ${JSON.stringify(text)}; }
            else { el.value = ${JSON.stringify(text)}; }
            el.dispatchEvent(new Event('input', { bubbles: true }));
            el.dispatchEvent(new Event('change', { bubbles: true }));
            return true;
          }
          return false;
        })()
      `);
      result = { success: true };

    } else if (action === 'scroll') {
      const { direction, px } = params;
      const amount = direction === 'up' ? -(px || 500) : (px || 500);
      await bvm.executeJavaScript(tabId, `window.scrollBy({ top: ${amount}, behavior: 'auto' })`);
      result = { success: true };

    } else if (action === 'eval') {
      result = await bvm.executeJavaScript(tabId, params.code);

    } else if (action === 'state') {
      const text  = await bvm.executeJavaScript(tabId, `document.body?.innerText || ''`);
      const title = await bvm.executeJavaScript(tabId, `document.title || ''`);
      const url   = bvm.getURL(tabId);
      result = { text, title, url };

    } else if (action === 'screenshot') {
      const nativeImg = await bvm.capturePage(tabId);
      const base64 = nativeImg.toPNG().toString('base64');
      result = { base64 };

    } else if (action === 'back') {
      if (bvm.canGoBack(tabId)) {
        bvm.goBack(tabId);
        result = { success: true, url: bvm.getURL(tabId) };
      } else {
        result = { success: false, reason: 'Cannot go back' };
      }

    } else if (action === 'wait') {
      const { selector, ms } = params;
      if (selector) {
        const start = Date.now();
        let found = false;
        while (Date.now() - start < 10000) {
          const exists = await bvm.executeJavaScript(tabId, `!!document.querySelector(${JSON.stringify(selector)})`);
          if (exists) { found = true; break; }
          await new Promise(r => setTimeout(r, 200));
        }
        result = { success: found };
      } else if (typeof ms === 'number') {
        await new Promise(r => setTimeout(r, ms));
        result = { success: true };
      }

    } else if (action === 'close_workspace' || action === 'hide_workspace' || action === 'hide') {
      // 隐藏工作区面板
      mainWindow.webContents.send('workspace:hide');
      BrowserViewManager.getInstance().hideAllViews();
      result = { success: true };

    } else {
      throw new Error(`[BrowserController] Unknown browser action: ${action}`);
    }

    return result;
  }

  /**
   * 获取当前工作区浏览器状态
   */
  async browser_getActiveStatus(context: ApiContext): Promise<any> {
    try {
      const state = await this.browser_action('state', {}, context);
      return { active: true, url: state.url, title: state.title };
    } catch {
      return { active: false, url: null };
    }
  }

  /**
   * 检测系统已安装的本地浏览器
   */
  async browser_detectBrowsers(): Promise<any> {
    const { detectInstalledBrowsers } = await import('../../services/browser-cookie-import');
    return detectInstalledBrowsers();
  }

  /**
   * 将网页抓取/注释/截图临时保存为文件，用于 ChatInput 附件块
   */
  async browser_saveTempAttachment(params: { filename: string; content: string; isBase64?: boolean }): Promise<{ ok: boolean; filePath: string; relativePath: string }> {
    const fs = await import('node:fs/promises');
    const path = await import('node:path');
    const os = await import('node:os');
    const { app } = await import('electron');

    try {
      const tmpDir = path.join(app.getPath('userData'), 'tmp_attachments');
      await fs.mkdir(tmpDir, { recursive: true });
      const filePath = path.join(tmpDir, params.filename);

      if (params.isBase64) {
        const base64Data = params.content.replace(/^data:image\/\w+;base64,/, '');
        const buffer = Buffer.from(base64Data, 'base64');
        await fs.writeFile(filePath, buffer);
      } else {
        await fs.writeFile(filePath, params.content, 'utf-8');
      }

      return { ok: true, filePath, relativePath: filePath };
    } catch (err: any) {
      console.error('[BrowserController] saveTempAttachment error:', err);
      throw err;
    }
  }

  /**
   * 从指定的本地浏览器导入 Cookie 到 workspace session
   */
  async browser_importCookiesFromBrowser(params: { family: string; profile?: string }): Promise<any> {
    const { importCookiesFromBrowser } = await import('../../services/browser-cookie-import');
    return importCookiesFromBrowser(params.family as any, params.profile);
  }

  /**
   * 一键从所有识别到的本地浏览器导入 Cookie
   */
  async browser_importCookiesFromAllBrowsers(): Promise<any> {
    const { importCookiesFromAllBrowsers } = await import('../../services/browser-cookie-import');
    return importCookiesFromAllBrowsers();
  }


  /**
   * 从 JSON 文件导入 Cookie 到 workspace session
   */
  async browser_importCookiesFromFile(params: { filePath?: string }): Promise<any> {
    const { pickCookieFile, importCookiesFromFile } = await import('../../services/browser-cookie-import');
    const mainWindow = ElectronMainWindow.getInstance().getWindow();
    let file = params?.filePath;
    if (!file) {
      file = (await pickCookieFile(mainWindow)) || undefined;
    }
    if (!file) {
      return { ok: false, reason: 'canceled' };
    }
    return importCookiesFromFile(file);
  }


  /** 缓存 prepared 状态，避免同一 session 中重复预热 */
  private _preparedAt = 0;
  private _lastTabId = '';

  /**
   * 通知 AppLayout 打开 workspace 面板并创建 browser-panel Tab。
   * 返回活跃 Tab ID（React 侧创建 Tab 后通过 IPC 回传）。
   */
  private async _prepareWorkspace(mainWindow: Electron.BrowserWindow): Promise<string> {
    const bvm = BrowserViewManager.getInstance();
    if (this._preparedAt > 0 && Date.now() - this._preparedAt < 180_000 && this._lastTabId && bvm.hasView(this._lastTabId)) {
      return this._lastTabId;
    }

    return new Promise<string>((resolve) => {
      const prepareId = `prep_${Date.now()}_${Math.random().toString(36).substring(2, 7)}`;
      const responseChannel = `workspace-browser:prepared:${prepareId}`;

      const timer = setTimeout(() => {
        ipcMain.removeListener(responseChannel, handlePrepared);
        // タイムアウト時は空 tabId で続行（BrowserViewManager 側で対処）
        resolve(this._lastTabId || '');
      }, 15000);

      const handlePrepared = (_event: any, payload?: { tabId?: string }) => {
        clearTimeout(timer);
        ipcMain.removeListener(responseChannel, handlePrepared);
        const tabId = payload?.tabId || this._lastTabId || '';
        this._lastTabId = tabId;
        this._preparedAt = Date.now();
        resolve(tabId);
      };

      ipcMain.on(responseChannel, handlePrepared);
      mainWindow.webContents.send('workspace-browser:prepare', { prepareId });
    });
  }
}
