+import React from 'react';
+import { Square, ArrowUpRight, Pencil, Type, Undo, Redo, Trash2 } from 'lucide-react';
+
+export type MarkupTool = 'rect' | 'arrow' | 'pen' | 'text';
+
+interface MarkupToolbarProps {
+  tool: MarkupTool;
+  onToolChange: (tool: MarkupTool) => void;
+  color: string;
+  onColorChange: (color: string) => void;
+  width: number;
+  onWidthChange: (width: number) => void;
+  canUndo: boolean;
+  canRedo: boolean;
+  onUndo: () => void;
+  onRedo: () => void;
+  onClear: () => void;
+}
+
+const COLORS = ['#ef4444', '#3b82f6', '#10b981', '#f59e0b', '#ec4899', '#ffffff', '#000000'];
+const WIDTHS = [2, 4, 8];
+
+export function MarkupToolbar({
+  tool,
+  onToolChange,
+  color,
+  onColorChange,
+  width,
+  onWidthChange,
+  canUndo,
+  canRedo,
+  onUndo,
+  onRedo,
+  onClear,
+}: MarkupToolbarProps) {
+  return (
+    <div className="flex items-center gap-2 px-3 py-1.5 rounded-xl bg-[var(--bg-card,#1e293b)] border border-[var(--border-light,#334155)] shadow-2xl backdrop-blur text-xs select-none">
+      {/* Tool Buttons */}
+      <div className="flex items-center gap-1 pr-2 border-r border-black/10 dark:border-white/10">
+        <button
+          type="button"
+          onClick={() => onToolChange('rect')}
+          className={`p-1.5 rounded-lg transition-colors cursor-pointer ${
+            tool === 'rect' ? 'bg-blue-600 text-white shadow' : 'text-slate-400 hover:bg-white/10 hover:text-white'
+          }`}
+          title="矩形框 (Rectangle)"
+        >
+          <Square className="w-4 h-4" />
+        </button>
+
+        <button
+          type="button"
+          onClick={() => onToolChange('arrow')}
+          className={`p-1.5 rounded-lg transition-colors cursor-pointer ${
+            tool === 'arrow' ? 'bg-blue-600 text-white shadow' : 'text-slate-400 hover:bg-white/10 hover:text-white'
+          }`}
+          title="指示箭头 (Arrow)"
+        >
+          <ArrowUpRight className="w-4 h-4" />
+        </button>
+
+        <button
+          type="button"
+          onClick={() => onToolChange('pen')}
+          className={`p-1.5 rounded-lg transition-colors cursor-pointer ${
+            tool === 'pen' ? 'bg-blue-600 text-white shadow' : 'text-slate-400 hover:bg-white/10 hover:text-white'
+          }`}
+          title="涂鸦画笔 (Freehand Pen)"
+        >
+          <Pencil className="w-4 h-4" />
+        </button>
+
+        <button
+          type="button"
+          onClick={() => onToolChange('text')}
+          className={`p-1.5 rounded-lg transition-colors cursor-pointer ${
+            tool === 'text' ? 'bg-blue-600 text-white shadow' : 'text-slate-400 hover:bg-white/10 hover:text-white'
+          }`}
+          title="添加文字 (Text Annotation)"
+        >
+          <Type className="w-4 h-4" />
+        </button>
+      </div>
+
+      {/* Colors */}
+      <div className="flex items-center gap-1.5 pr-2 border-r border-black/10 dark:border-white/10">
+        {COLORS.map((c) => (
+          <button
+            key={c}
+            type="button"
+            onClick={() => onColorChange(c)}
+            className={`w-4 h-4 rounded-full border transition-transform cursor-pointer ${
+              color === c ? 'scale-125 border-white ring-2 ring-blue-500' : 'border-transparent hover:scale-110'
+            }`}
+            style={{ backgroundColor: c }}
+            title={`颜色: ${c}`}
+          />
+        ))}
+      </div>
+
+      {/* Line Widths */}
+      <div className="flex items-center gap-1 pr-2 border-r border-black/10 dark:border-white/10">
+        {WIDTHS.map((w) => (
+          <button
+            key={w}
+            type="button"
+            onClick={() => onWidthChange(w)}
+            className={`p-1.5 rounded-lg flex items-center justify-center transition-colors cursor-pointer ${
+              width === w ? 'bg-white/20 text-white' : 'text-slate-400 hover:bg-white/10'
+            }`}
+            title={`线条粗细: ${w}px`}
+          >
+            <div className="rounded-full bg-current" style={{ width: w + 2, height: w + 2 }} />
+          </button>
+        ))}
+      </div>
+
+      {/* Actions */}
+      <div className="flex items-center gap-1">
+        <button
+          type="button"
+          onClick={onUndo}
+          disabled={!canUndo}
+          className="p-1.5 rounded-lg text-slate-400 hover:bg-white/10 hover:text-white disabled:opacity-30 cursor-pointer"
+          title="撤销 (Undo)"
+        >
+          <Undo className="w-4 h-4" />
+        </button>
+
+        <button
+          type="button"
+          onClick={onRedo}
+          disabled={!canRedo}
+          className="p-1.5 rounded-lg text-slate-400 hover:bg-white/10 hover:text-white disabled:opacity-30 cursor-pointer"
+          title="重做 (Redo)"
+        >
+          <Redo className="w-4 h-4" />
+        </button>
+
+        <button
+          type="button"
+          onClick={onClear}
+          className="p-1.5 rounded-lg text-red-400 hover:bg-red-500/20 cursor-pointer"
+          title="清空画布 (Clear All)"
+        >
+          <Trash2 className="w-4 h-4" />
+        </button>
+      </div>
+    </div>
+  );
+}