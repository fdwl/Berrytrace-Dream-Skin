+          <button
+            type="button"
+            onClick={onAttachToAgent}
+            className="flex items-center gap-1.5 px-3.5 py-1.5 rounded-lg bg-blue-600 hover:bg-blue-500 text-white font-medium shadow-md transition-colors cursor-pointer"
+            title="填充至 Agent 输入框"
