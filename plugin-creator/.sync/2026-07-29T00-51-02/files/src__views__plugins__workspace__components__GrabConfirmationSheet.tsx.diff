+import React from 'react';
+import { Copy, Image, MessageSquarePlus, X } from 'lucide-react';
+
+export interface GrabConfirmationSheetProps {
+  payload: any;
+  onCopyText: () => void;
+  onCopyScreenshot: () => void;
+  onAttachToAgent: () => void;
+  onCancel: () => void;
+}
+
+export function GrabConfirmationSheet({
+  payload,
+  onCopyText,
+  onCopyScreenshot,
+  onAttachToAgent,
+  onCancel,
+}: GrabConfirmationSheetProps) {
+  const { target, page } = payload;
+
+  return (
+    <div className="absolute inset-0 z-40 bg-black/40 dark:bg-black/60 backdrop-blur-sm flex items-center justify-center p-4 select-none animate-in fade-in duration-150">
+      <div className="w-full max-w-md bg-card text-foreground border border-border rounded-2xl shadow-2xl overflow-hidden flex flex-col">
+        {/* Header */}
+        <div className="flex items-center justify-between px-5 py-3 border-b border-border bg-muted/30">
+          <div className="flex items-center gap-2">
+            <span className="px-2 py-0.5 rounded bg-blue-500/15 text-blue-600 dark:text-blue-400 font-mono text-xs font-semibold">
+              DOM GRAB
+            </span>
+            <h3 className="text-xs font-semibold text-foreground">已选中页面元素</h3>
+          </div>
+          <button
+            type="button"
+            onClick={onCancel}
+            className="p-1 rounded-lg text-muted-foreground hover:text-foreground hover:bg-muted transition-colors cursor-pointer"
+            title="关闭 (Esc)"
+          >
+            <X className="w-4 h-4" />
+          </button>
+        </div>
+
+        {/* Content Preview */}
+        <div className="p-4 space-y-3 text-xs">
+          {payload.screenshot?.dataUrl && (
+            <div className="space-y-1">
+              <span className="text-[11px] text-muted-foreground font-medium uppercase tracking-wider">元素裁剪截图预览</span>
+              <div className="overflow-hidden rounded-xl border border-border/60 bg-black/10 dark:bg-black/40 p-2 flex items-center justify-center">
+                <img
+                  src={payload.screenshot.dataUrl}
+                  alt="Selected element screenshot"
+                  className="max-h-40 max-w-full object-contain rounded shadow-sm"
+                />
+              </div>
+            </div>
+          )}
+
+          <div className="p-3 rounded-xl bg-muted/40 border border-border/60 space-y-1 font-mono">
+            <div className="text-blue-600 dark:text-blue-400 font-bold text-sm">{`<${target.tagName}>`}</div>
+            <div className="text-foreground truncate">{target.selector}</div>
+            <div className="text-[11px] text-muted-foreground">
+              尺寸: {Math.round(target.rectViewport.width)} x {Math.round(target.rectViewport.height)} px
+            </div>
+          </div>
+
+          {target.textSnippet && (
+            <div className="space-y-1">
+              <span className="text-[11px] text-muted-foreground font-medium uppercase tracking-wider">文本内容</span>
+              <p className="p-2.5 rounded-lg bg-muted/30 border border-border/40 text-foreground text-[11px] max-h-20 overflow-y-auto">
+                {target.textSnippet}
+              </p>
+            </div>
+          )}
+
+          <div className="text-[11px] text-muted-foreground">
+            来源页面: <span className="text-foreground underline truncate">{page.sanitizedUrl}</span>
+          </div>
+        </div>
+
+        {/* Actions */}
+        <div className="flex items-center justify-end gap-2 px-4 py-3 border-t border-border bg-muted/20 text-xs">
+          <button
+            type="button"
+            onClick={onCancel}
+            className="px-3 py-1.5 rounded-lg border border-border text-muted-foreground hover:bg-muted transition-colors cursor-pointer"
+            title="取消"
+          >
+            取消
+          </button>
+
+          <button
+            type="button"
+            onClick={onCopyText}
+            className="flex items-center gap-1.5 px-3 py-1.5 rounded-lg border border-border bg-background hover:bg-muted text-foreground font-medium transition-colors cursor-pointer shadow-sm"
+            title="快捷键 S: 复制 Markdown 结构文本"
+          >
+            <Copy className="w-3.5 h-3.5 text-blue-500" />
+            复制 Markdown [S]
+          </button>
+
+          <button
+            type="button"
+            onClick={onCopyScreenshot}
+            className="flex items-center gap-1.5 px-3 py-1.5 rounded-lg border border-border bg-background hover:bg-muted text-foreground font-medium transition-colors cursor-pointer shadow-sm"
+            title="快捷键 C: 复制元素截图"
+          >
+            <Image className="w-3.5 h-3.5 text-emerald-500" />
