import type { BerrytraceEventMap, BerrytraceEventName, BerrytraceCommandMap, BerrytraceCommandName } from './event-catalog.js';
/**
 * 莓莓印记 (BerryTrace) 插件 SDK 类型定义文件
 *
 * 本文件定义了插件开发所需的所有类型接口。
 * 插件开发者可以通过 `berrytrace` 全局对象访问这些 API。
 *
 * @example
 * // 在插件中访问 SDK
 * const sdk: BerryTraceSDK = window.berrytrace;
 *
 * // 获取插件信息
 * const info = await sdk.plugin.getInfo();
 *
 * // 记录日志
 * sdk.log.info('插件已加载');
 */
export interface PluginInfo {
    id: string;
    name: string;
    version: string;
    description?: string;
    path: string;
}
/**
 * 插件信息 API
 * 用于获取当前插件的元数据信息
 */
export interface PluginInfoAPI extends GeneratedPluginInfoAPI {
    /**
     * 获取当前插件的详细信息
     * @returns 返回插件信息对象，包含 id、name、version、path 等
     * @example
     * const info = await sdk.plugin.getInfo();
     * console.log(info.name, info.version);
     */
    getInfo(): Promise<PluginInfo>;
    /**
     * 获取当前插件的生命周期上下文
     * @returns 返回生命周期上下文对象
     */
    getLifecycleContext(): Promise<PluginLifecycleContext>;
}
/**
 * 日志 API
 * 提供插件日志记录功能，日志会统一输出到宿主应用的日志系统
 */
export interface LogAPI extends Omit<GeneratedLogAPI, 'info' | 'warn' | 'error' | 'debug'> {
    /**
     * 记录信息级别日志
     * @param message 日志消息
     * @example
     * sdk.log.info('插件初始化完成');
     */
    info(message: string): Promise<void>;
    /**
     * 记录警告级别日志
     * @param message 日志消息
     * @example
     * sdk.log.warn('配置文件不存在，使用默认配置');
     */
    warn(message: string): Promise<void>;
    /**
     * 记录错误级别日志
     * @param message 日志消息
     * @example
     * sdk.log.error('连接服务器失败');
     */
    error(message: string): Promise<void>;
    /**
     * 记录调试级别日志
     * @param message 日志消息
     * @example
     * sdk.log.debug('处理数据:', JSON.stringify(data));
     */
    debug(message: string): Promise<void>;
}
export interface ChatMessage {
    role: 'system' | 'user' | 'assistant';
    content: string;
}
export interface ChatOptions {
    modelId?: string;
    messages: ChatMessage[];
    temperature?: number;
    maxTokens?: number;
    sessionId?: string;
}
export interface ChatResponse {
    content: string;
    usage: {
        promptTokens: number;
        completionTokens: number;
        totalTokens: number;
    };
}
export type AgentLlmProvider = 'aliyun' | 'ollama' | 'berrytrace' | 'custom';
export interface AgentLlmConfig {
    provider: AgentLlmProvider;
    model: string;
    apiKey?: string;
    baseUrl?: string;
}
export interface AgentTaskOptions {
    sessionId?: string;
    task: string;
    history?: Array<{
        role: 'user' | 'assistant';
        content: string;
    }>;
    workDir?: string;
    activeDocument?: {
        tabId: string;
        title: string;
        path?: string;
        extension?: string;
        pluginId?: string;
        isUntitled?: boolean;
    };
    /**
     * @internal
     * 首选 LLM 配置由宿主根据用户全局 AI 设置自动填充，插件无需传入。
     * 若插件显式传入，宿主 SDK 层会优先使用全局配置覆盖此字段。
     */
    llmConfig?: AgentLlmConfig;
    /**
     * @internal
     * 所有可用的 AI 服务器配置列表，供 Agent 内核根据任务复杂度智能选择模型。
     * 由宿主 SDK 层从用户全局 AI 设置自动填充。
     */
    availableConfigs?: AgentLlmConfig[];
    maxSteps?: number;
    /**
     * 自定义系统提示词。
     */
    systemPrompt?: string;
    /**
     * 是否跳过系统默认提示词。
     */
    skipDefaultSystemPrompt?: boolean;
}
export interface AgentKernelStatus {
    isRunning: boolean;
    pluginId: string;
}
export interface RerankResult {
    index: number;
    score: number;
}
export interface OCRResult {
    text: string;
    blocks: Array<{
        text: string;
        box: [number, number, number, number];
    }>;
}
/**
 * AI 功能 API
 * 提供 AI 对话、Agent 任务执行等功能
 * 注意：embed/rerank/OCR 等能力位于独立的 local-ai 命名空间
 */
export interface AIApi extends Omit<GeneratedAIApi, 'chat' | 'chatStream' | 'runAgentTask' | 'cancelAgentTask' | 'getAgentKernelStatus'> {
    /**
     * 发起 AI 对话（非流式）
     * @param options 对话选项，包含消息历史、模型配置等
     * @returns 返回 AI 的回复内容和使用统计
     * @example
     * const response = await sdk.ai.chat({
     *   messages: [
     *     { role: 'user', content: '你好，请介绍一下自己' }
     *   ],
     *   temperature: 0.7
     * });
     * console.log(response.content);
     */
    chat(options: ChatOptions): Promise<ChatResponse>;
    /**
     * 发起 AI 对话（流式）
     * @param options 对话选项
     * @param onChunk 接收每个文本块的回调函数
     * @example
     * await sdk.ai.chatStream(
     *   { messages: [{ role: 'user', content: '写一首诗' }] },
     *   (chunk) => process.stdout.write(chunk)
     * );
     */
    chatStream(options: ChatOptions, onChunk: (chunk: string) => void): Promise<void>;
    /**
     * 运行 AI Agent 任务（需要 Agent 内核插件）
     * @param options 任务选项，包含任务描述、工作目录、LLM 配置等
     * @returns 返回会话 ID 和内核插件 ID
     * @example
     * const result = await sdk.ai.runAgentTask({
     *   task: '帮我分析这个目录下的代码结构',
     *   workDir: '/path/to/project'
     * });
     * console.log('会话 ID:', result.sessionId);
     */
    runAgentTask(options: AgentTaskOptions): Promise<{
        sessionId: string;
        kernelPluginId: string;
        accepted: boolean;
    }>;
    /**
     * 取消正在运行的 AI Agent 任务
     * @param sessionId 要取消的会话 ID
     */
    cancelAgentTask(sessionId: string): Promise<void>;
    /**
     * 获取 Agent 内核状态
     * @returns 返回内核是否运行中及其插件 ID
     */
    getAgentKernelStatus(): Promise<AgentKernelStatus>;
    /**
     * 插件注册检测到的 Agent 为 AI 服务商
     * @param config 服务商配置
     * @returns 返回生成的 serverId
     * @example
     * const serverId = await sdk.ai.registerAgentProvider({
     *   name: 'Codex CLI (本地)',
     *   provider: 'custom',
     *   model: 'gpt-5.3-codex',
     *   baseUrl: 'http://localhost:32100/v1',
     *   supportedModels: ['gpt-5.3-codex'],
     * });
     */
    registerAgentProvider(config: {
        name: string;
        provider: AgentLlmProvider;
        model: string;
        baseUrl?: string;
        apiKey?: string;
        supportedModels?: string[];
        icon?: string;
        uniqueKey?: string;
    }): Promise<string>;
    /**
     * 插件注销 AI 服务商
     * @param serverId 要注销的服务商 ID
     * @example
     * await sdk.ai.unregisterAgentProvider('plugin_xxx');
     */
    unregisterAgentProvider(serverId: string): Promise<void>;
}
export interface ActiveAppInfo {
    name: string;
    title: string;
    path: string;
    bundleId?: string;
    pid: number;
}
export interface SelectionInfo {
    text: string;
    html?: string;
    appSource: string;
}
/**
 * 上下文 API
 * 获取用户当前上下文信息，如活动应用、选中文本等
 */
export interface ContextAPI extends Omit<GeneratedContextAPI, 'getActiveApp' | 'getSelection'> {
    /**
     * 获取当前活动应用信息
     * @returns 返回活动应用的名称、标题、路径等信息
     * @example
     * const app = await sdk.context.getActiveApp();
     * console.log('当前应用:', app.name);
     */
    getActiveApp(): Promise<ActiveAppInfo>;
    /**
     * 监听活动应用变化
     * @param callback 当活动应用变化时调用
     * @returns 取消监听的函数
     * @example
     * const off = sdk.context.onActiveAppChanged((app) => {
     *   console.log('活动应用变为:', app.name);
     * });
     * // 取消监听
     * off();
     */
    onActiveAppChanged(callback: (appInfo: ActiveAppInfo) => void): () => void;
    /**
     * 获取用户当前选中的文本
     * @returns 返回选中文本信息，如果没有选中则返回 null
     * @example
     * const selection = await sdk.context.getSelection();
     * if (selection) {
     *   console.log('选中文本:', selection.text);
     * }
     */
    getSelection(): Promise<SelectionInfo | null>;
    /**
     * 写入共享上下文数据
     */
    set(key: string, value: unknown, options?: {
        ttlMs?: number;
        scope?: 'session' | 'workspace' | 'global';
    }): Promise<null>;
    /**
     * 读取共享上下文数据
     */
    get(key: string, options?: {
        scope?: 'session' | 'workspace' | 'global';
    }): Promise<unknown>;
    /**
     * 列出指定 scope 下的所有 key
     */
    list(options?: {
        scope?: 'session' | 'workspace' | 'global';
    }): Promise<string[]>;
    /**
     * 清除指定 scope 下的数据
     */
    clear(options?: {
        scope?: 'session' | 'workspace' | 'global';
    }): Promise<null>;
}
export interface WorkflowAPI {
    register(def: Record<string, unknown>): Promise<null>;
    execute(workflowId: string, input?: Record<string, unknown>, triggerType?: string): Promise<unknown>;
    list(): Promise<unknown[]>;
    get(workflowId: string): Promise<unknown>;
    unregister(workflowId: string): Promise<boolean>;
    cancel(runId: string): Promise<boolean>;
    pause(runId: string): Promise<boolean>;
    resume(runId: string): Promise<boolean>;
    executeFrom(workflowId: string, fromStepId: string, previousInput?: Record<string, unknown>): Promise<unknown>;
    getActiveRun(workflowId: string): Promise<unknown>;
    matchIntent(userQuery: string): Promise<{
        matched: boolean;
        workflowId?: string;
        workflowName?: string;
        confidence: number;
        matchedTrigger?: string;
    }>;
    getHistory(workflowId: string): Promise<unknown[]>;
}
export interface McpContent {
    type: 'text' | 'image';
    text?: string;
    data?: string;
    mimeType?: string;
}
export interface McpToolResult {
    content: McpContent[];
    isError?: boolean;
}
export interface McpResourceContents {
    uri: string;
    mimeType?: string;
    text?: string;
    blob?: string;
}
export interface McpResourceResult {
    contents: McpResourceContents[];
}
/**
 * MCP (Model Context Protocol) API
 * 允许插件注册工具和资源，供 AI Agent 调用
 *
 * @see https://modelcontextprotocol.io
 */
export interface McpAPI extends Omit<GeneratedMcpAPI, 'registerDynamicTool' | 'unregisterDynamicTool' | 'listTools' | 'callTool' | 'registerSystemPrompt' | 'unregisterSystemPrompt'> {
    /**
     * 注册 MCP 工具处理器（静态工具，需在 plugin.json 中声明）
     * @param toolName 工具名称，需与 plugin.json 中 mcp.tools 数组里的 name 字段匹配
     * @param handler 工具处理函数，接收参数并返回结果
     * @example
     * sdk.mcp.registerToolHandler('my_plugin_search', async (args) => {
     *   const results = await search(args.query as string);
     *   return { content: [{ type: 'text', text: JSON.stringify(results) }] };
     * });
     */
    registerToolHandler(toolName: string, handler: (args: Record<string, unknown>) => Promise<McpToolResult>): void;
    /**
     * 注册 MCP 资源处理器
     * @param uriPattern URI 模式，如 'file:///{path}'
     * @param handler 资源处理函数
     */
    registerResourceHandler(uriPattern: string, handler: (params: Record<string, string>) => Promise<McpResourceResult>): void;
    /**
     * 注册动态 MCP 工具（运行时动态注册，无需在 plugin.json 中预先声明）
     * @param toolSpec 工具规范，包含名称、描述、输入模式等
     * @param handler 工具处理函数
     * @example
     * await sdk.mcp.registerDynamicTool(
     *   {
     *     name: 'dynamic_search',
     *     description: '动态搜索工具',
     *     inputSchema: { type: 'object', properties: { query: { type: 'string' } } }
     *   },
     *   async (args) => {
     *     return { content: [{ type: 'text', text: '搜索结果' }] };
     *   }
     * );
     */
    registerDynamicTool(toolSpec: {
        name: string;
        description: string;
        inputSchema: Record<string, unknown>;
        displayName?: string;
        userQueries?: string[];
    }, handler: (args: Record<string, unknown>) => Promise<McpToolResult>): Promise<void>;
    /**
     * 动态注册系统提示词指令
     * @param promptId 提示词 ID，用于唯一标识该提示词
     * @param promptText 提示词文本内容
     */
    registerSystemPrompt(promptId: string, promptText: string): Promise<void>;
    /**
     * 取消注册动态系统提示词指令
     * @param promptId 提示词 ID
     */
    unregisterSystemPrompt(promptId: string): Promise<void>;
    /**
     * 取消注册动态 MCP 工具
     * @param toolName 要取消注册的工具名称
     */
    unregisterDynamicTool(toolName: string): Promise<void>;
    /**
     * 列出当前可用的所有 MCP 工具
     * @returns 工具列表
     */
    listTools(): Promise<unknown[]>;
    /**
     * 调用 MCP 工具
     * @param name 工具名称
     * @param args 工具参数
     * @returns 工具执行结果
     */
    callTool(name: string, args: Record<string, unknown>): Promise<unknown>;
}
/**
 * 存储 API
 * 提供键值对存储和简易数据库功能，数据按插件 ID 隔离存储
 */
export interface StorageAPI extends Omit<GeneratedStorageAPI, 'kv' | 'db'> {
    /** 键值对存储 - 适合简单的配置项、用户偏好等 */
    kv: {
        /**
         * 获取存储的值
         * @param key 键名
         * @param defaultValue 默认值（当键不存在时返回）
         * @example
         * const theme = await sdk.storage.kv.get('theme', 'light');
         */
        get<T>(key: string, defaultValue?: T): Promise<T>;
        /**
         * 设置存储的值
         * @param key 键名
         * @param value 值（会被 JSON 序列化）
         * @example
         * await sdk.storage.kv.set('theme', 'dark');
         */
        set<T>(key: string, value: T): Promise<void>;
        /**
         * 删除指定的键
         * @param key 要删除的键名
         */
        delete(key: string): Promise<void>;
        /** 清空所有键值对 */
        clear(): Promise<void>;
    };
    /** 简易数据库 - 使用类 SQL 语法操作（基于 JSON 文件实现） */
    db: {
        /**
         * 执行 SQL 查询（支持 CREATE TABLE、INSERT INTO、SELECT）
         * @param sql SQL 语句
         * @param params 参数数组
         * @returns 查询结果数组（SELECT）或操作结果（CREATE/INSERT）
         * @example
         * // 创建表
         * await sdk.storage.db.execute('CREATE TABLE IF NOT EXISTS notes (id, title, content)');
         * // 插入数据
         * await sdk.storage.db.execute('INSERT INTO notes VALUES (?, ?, ?)', [1, '标题', '内容']);
         * // 查询数据
         * const notes = await sdk.storage.db.execute('SELECT * FROM notes');
         */
        execute(sql: string, params?: unknown[]): Promise<Record<string, unknown>[]>;
    };
}
/**
 * 文件系统 API
 * 提供文件读写、目录操作等功能
 * 注意：出于安全考虑，文件访问受到限制，建议使用 getSafePath 获取允许的目录
 */
export interface FileSystemAPI extends Omit<GeneratedFileSystemAPI, 'readFile' | 'readDir' | 'writeFile' | 'renameFile' | 'deleteFile' | 'getSafePath' | 'showItemInFolder' | 'stat' | 'mkdir' | 'extractZip' | 'copyDir' | 'removeDir' | 'hashFile' | 'downloadFile'> {
    /**
     * 读取文件内容
     * @param filePath 文件绝对路径
     * @param encoding 编码方式，'utf-8' 返回字符串，'base64' 返回 base64 字符串，不传返回 Buffer
     * @example
     * const text = await sdk.filesystem.readFile('/path/to/file.txt', 'utf-8');
     * const base64 = await sdk.filesystem.readFile('/path/to/image.png', 'base64');
     */
    readFile(filePath: string, encoding?: 'utf-8' | 'base64'): Promise<string | Buffer>;
    /**
     * 读取目录内容
     * @param dirPath 目录绝对路径
     * @returns 目录项数组，每项包含名称和类型信息
     * @example
     * const items = await sdk.filesystem.readDir('/path/to/dir');
     * items.forEach(item => console.log(item.name, item.isDirectory ? '目录' : '文件'));
     */
    readDir(dirPath: string): Promise<Array<{
        name: string;
        isDirectory: boolean;
        isFile: boolean;
    }>>;
    /**
     * 写入文件内容（如果文件不存在会创建，如果存在会覆盖）
     * @param filePath 文件绝对路径
     * @param content 要写入的内容（字符串或 Buffer）
     */
    writeFile(filePath: string, content: string | Buffer): Promise<void>;
    /**
     * 重命名/移动文件
     * @param oldPath 原路径
     * @param newPath 新路径
     */
    renameFile(oldPath: string, newPath: string): Promise<void>;
    /**
     * 删除文件
     * @param filePath 要删除的文件路径
     */
    deleteFile(filePath: string): Promise<void>;
    /**
     * 获取安全的系统目录路径
     * @param name 目录名称：'userData'（应用数据目录）、'documents'（文档目录）、'desktop'（桌面目录）、'temp'（临时目录）
     * @returns 目录的绝对路径
     * @example
     * const dataDir = await sdk.filesystem.getSafePath('userData');
     * // 在应用数据目录下写入文件
     * await sdk.filesystem.writeFile(dataDir + '/my-data.json', JSON.stringify(data));
     */
    getSafePath(name: 'userData' | 'documents' | 'desktop' | 'temp' | 'skills'): Promise<string>;
    /**
     * 在文件管理器中显示文件（跨平台）
     * @param filePath 文件路径
     */
    showItemInFolder(filePath: string): Promise<void>;
    /**
     * 获取文件/目录状态
     * @param filePath 路径
     * @returns 包含 isFile、isDirectory、size、mtimeMs 的对象
     */
    stat(filePath: string): Promise<{
        isFile: boolean;
        isDirectory: boolean;
        size: number;
        mtimeMs: number;
    }>;
    /**
     * 递归创建目录
     * @param dirPath 目录路径
     */
    mkdir(dirPath: string): Promise<void>;
    /**
     * 解压 ZIP 文件到目标目录（含 Zip Slip 安全检查）
     * @param zipPath ZIP 文件路径
     * @param destDir 目标目录
     * @param overwrite 是否覆盖已有文件（默认 true）
     */
    extractZip(zipPath: string, destDir: string, overwrite?: boolean): Promise<void>;
    /**
     * 递归复制目录
     * @param srcPath 源目录
     * @param dstPath 目标目录
     */
    copyDir(srcPath: string, dstPath: string): Promise<void>;
    /**
     * 递归删除目录
     * @param dirPath 目录路径
     */
    removeDir(dirPath: string): Promise<void>;
    /**
     * 计算文件哈希值
     * @param filePath 文件路径
     * @param algorithm 哈希算法（默认 'sha256'）
     * @returns 十六进制哈希字符串
     */
    hashFile(filePath: string, algorithm?: string): Promise<string>;
    /**
     * 从 URL 下载文件到本地路径
     * @param url 下载地址
     * @param destPath 目标文件路径（含文件名）
     */
    downloadFile(url: string, destPath: string): Promise<void>;
}
/**
 * 命令选项
 * 用于注册可执行的命令
 */
export interface CommandOptions {
    /** 命令唯一标识符 */
    id: string;
    /** 命令显示名称 */
    name: string;
    /** 命令描述（可选） */
    description?: string;
    /** 命令图标（可选，支持 emoji 或图标类名） */
    icon?: string;
    /** 快捷键（可选），如 'CmdOrCtrl+Shift+P' */
    shortcut?: string;
    /** 命令处理函数 */
    handler: (args?: Record<string, unknown>) => Promise<unknown> | unknown;
}
/**
 * 命令 API
 * 允许插件注册命令，用户可通过命令面板调用
 */
export interface CommandAPI {
    /**
     * 注册命令
     * @param options 命令选项
     * @returns 注册的命令 ID
     * @example
     * const cmdId = sdk.commands.register({
     *   id: 'my-plugin.hello',
     *   name: 'Say Hello',
     *   icon: '👋',
     *   handler: () => sdk.log.info('Hello!')
     * });
     */
    register(options: CommandOptions): string;
    /**
     * 取消注册命令
     * @param id 要取消注册的命令 ID
     */
    unregister(id: string): void;
    /**
     * 执行命令
     * @param id 命令 ID
     * @param args 传递给处理函数的参数
     * @returns 处理函数返回的值
     * @example
     * const result = await sdk.commands.execute('my-plugin.hello');
     */
    execute(id: string, args?: Record<string, unknown>): Promise<unknown>;
}
export type EventHandler = (...args: unknown[]) => void;
/**
 * 事件 API
 * 插件间通信的核心机制，基于发布-订阅模式
 *
 * 平台级事件（BerrytraceEventName）拥有完整的 TypeScript 类型推断。
 * 插件内部私有事件（如 'my-plugin:data-updated'）使用 string 重载，payload 为 unknown。
 *
 * @see event-catalog.ts — 平台级事件类型注册表
 */
export interface EventAPI {
    /**
     * 监听平台级广播事件（持续监听，payload 有完整类型推断）
     * @example
     * const off = sdk.events.on('agent:step_update', (payload) => {
     *   console.log(payload.status); // 类型安全：AgentStepUpdatePayload
     * });
     */
    on<K extends BerrytraceEventName>(eventName: K, handler: (payload: BerrytraceEventMap[K]) => void): () => void;
    /**
     * 监听插件私有事件（持续监听）
     * @example
     * const off = sdk.events.on('my-plugin:data-updated', (data) => {
     *   console.log('数据已更新:', data);
     * });
     * // 取消监听
     * off();
     */
    on(eventName: string, handler: EventHandler): () => void;
    /**
     * 监听平台级广播事件（仅触发一次，payload 有完整类型推断）
     */
    once<K extends BerrytraceEventName>(eventName: K, handler: (payload: BerrytraceEventMap[K]) => void): void;
    /**
     * 监听插件私有事件（仅触发一次）
     */
    once(eventName: string, handler: EventHandler): void;
    /**
     * 发射平台级广播事件（payload 类型与事件名强绑定）
     * @example
     * sdk.events.emit('agent:kernel_ready', { kernelId: '...', framework: 'mastra', protocol: '...' });
     */
    emit<K extends BerrytraceEventName>(eventName: K, payload: BerrytraceEventMap[K]): void;
    /**
     * 发射插件私有事件
     * @example
     * sdk.events.emit('my-plugin:data-updated', { id: 123, name: 'test' });
     */
    emit(eventName: string, payload?: unknown): void;
    /**
     * 取消监听事件
     * @param eventName 事件名称
     * @param handler 要移除的处理函数（必须与注册时相同引用）
     */
    off(eventName: string, handler: EventHandler): void;
}
/**
 * 宿主命令 API（仅 background / main 插件有意义）
 *
 * 用于订阅宿主下发的命令。命令（Command）与事件（Event）的语义区别：
 *   - sdk.events.on → 广播通知：某事已发生，任意插件可发射，任意插件可订阅
 *   - sdk.host.onCommand → 宿主指令：宿主请你做某事，只有宿主可发射，只有目标插件订阅
 *
 * @example
 * // Agent 内核插件监听执行任务命令
 * const off = sdk.host.onCommand('agent:execute_task', (payload) => {
 *   // payload 是 AgentExecuteTaskPayload，有完整类型
 *   kernel.executeTask(payload);
 * });
 *
 * @see BerrytraceCommandMap in event-catalog.ts — 命令类型注册表
 */
export interface HostCommandAPI {
    /**
     * 监听宿主下发的命令（持续监听，payload 有完整类型推断）
     */
    onCommand<K extends BerrytraceCommandName>(commandName: K, handler: (payload: BerrytraceCommandMap[K]) => void): () => void;
    /**
     * 监听宿主下发的命令（仅触发一次）
     */
    onceCommand<K extends BerrytraceCommandName>(commandName: K, handler: (payload: BerrytraceCommandMap[K]) => void): void;
}
export interface FloatWindowOptions {
    url: string;
    width?: number;
    height?: number;
    x?: number;
    y?: number;
    alwaysOnTop?: boolean;
    resizable?: boolean;
    title?: string;
    frame?: boolean;
    transparent?: boolean;
    skipTaskbar?: boolean;
    focusable?: boolean;
    ignoreMouseEvents?: boolean;
    hasShadow?: boolean;
    show?: boolean;
    fullscreen?: boolean;
    type?: string;
    [key: string]: unknown;
}
export interface WindowState {
    id: string;
    visible: boolean;
    bounds: {
        x: number;
        y: number;
        width: number;
        height: number;
    };
    alwaysOnTop: boolean;
}
/**
 * 窗口 API
 * 统一管理当前窗口操作与浮窗创建/控制
 */
export interface WindowAPI extends Omit<GeneratedWindowAPI, 'close' | 'minimize' | 'maximize' | 'startDrag' | 'move' | 'disableDefaultDrag' | 'setIgnoreMouseEvents' | 'create' | 'show' | 'hide' | 'getState' | 'getNativeHandle' | 'updateWindowOptions'> {
    /** 关闭窗口（不传参关闭当前窗口，传 id 关闭指定浮窗） */
    close(id?: string): Promise<void>;
    /** 最小化当前窗口 */
    minimize(): Promise<void>;
    /** 最大化/还原当前窗口 */
    maximize(): Promise<void>;
    /** 开始拖拽窗口（macOS） */
    startDrag(): Promise<void>;
    /** 相对移动窗口 */
    move(deltaX: number, deltaY: number): Promise<void>;
    /** 禁用默认拖拽行为 */
    disableDefaultDrag(disabled: boolean): Promise<void>;
    /** 设置鼠标穿透（桌面特效场景） */
    setIgnoreMouseEvents(ignore: boolean, options?: {
        forward: boolean;
    }): Promise<void>;
    /** 创建独立浮窗，返回 windowId */
    create(options: FloatWindowOptions): Promise<string>;
    /** 显示指定浮窗 */
    show(id: string): Promise<void>;
    /** 隐藏指定浮窗 */
    hide(id: string): Promise<void>;
    /** 获取浮窗状态 */
    getState(id: string): Promise<WindowState>;
    /** 获取浮窗的 OS 原生窗口句柄（Windows: HWND, macOS: window ID），用于 ffmpeg/自动化等场景 */
    getNativeHandle(opts: {
        winId: string;
    }): Promise<{
        handle: number;
        platform: string;
        title: string;
    }>;
    /** 更新浮窗选项 */
    updateWindowOptions(id: string, options: Partial<FloatWindowOptions>): Promise<void>;
}
/**
 * 保存对话框选项
 * 简化版，仅包含插件开发常用的选项
 */
export interface SaveDialogOptions {
    /** 对话框标题 */
