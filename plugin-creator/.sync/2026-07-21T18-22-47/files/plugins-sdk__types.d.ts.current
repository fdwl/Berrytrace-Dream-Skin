     */
    setProperties(sessionId: string, properties: Record<string, unknown>): void;
    /**
     * 获取会话属性
     * @param sessionId 会话 ID
     * @returns 属性对象或 undefined
     */
    getProperties(sessionId: string): Record<string, unknown> | undefined;
    /**
     * 获取会话指定属性
     * @param sessionId 会话 ID
     * @param key 属性键名
     */
    getProperty(sessionId: string, key: string): Promise<unknown>;
    /**
     * 设置会话指定属性
     * @param sessionId 会话 ID
     * @param key 属性键名
     * @param value 属性值
     */
    setProperty(sessionId: string, key: string, value: unknown): Promise<void>;
    /**
     * 注册面板（用于 AI 对话界面）
     * @param sessionId 会话 ID
     * @param panels 面板配置数组
     */
    registerPanels(sessionId: string, panels: unknown[]): void;
    /**
     * 获取当前活动标签页 ID
     * @returns 活动标签页 ID 或 null
