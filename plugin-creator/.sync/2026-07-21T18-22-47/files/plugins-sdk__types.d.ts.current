    /** 默认保存路径 */
    defaultPath?: string;
    /** 文件过滤器，如 [{ name: 'Text', extensions: ['txt'] }] */
    filters?: Array<{
        name: string;
        extensions: string[];
    }>;
    /** 是否不显示文件扩展名选择框 */
    dontAddToRecent?: boolean;
}
/**
 * 打开对话框选项
 * 简化版，仅包含插件开发常用的选项
 */
export interface OpenDialogOptions {
    /** 对话框标题 */
    title?: string;
    /** 默认打开路径 */
    defaultPath?: string;
    /** 文件过滤器，如 [{ name: 'Images', extensions: ['jpg', 'png'] }] */
    filters?: Array<{
        name: string;
        extensions: string[];
    }>;
    /** 对话框属性，如 ['openFile', 'multiSelections'] */
    properties?: Array<'openFile' | 'openDirectory' | 'multiSelections' | 'showHiddenFiles'>;
    /** 是否不显示文件扩展名选择框 */
    dontAddToRecent?: boolean;
}
/**
 * 对话框返回结果（保存/打开通用）
 */
export interface DialogReturnValue {
    /** 用户是否取消了对话框 */
    canceled: boolean;
    /** 保存对话框返回：选择的文件路径 */
    filePath?: string;
    /** 打开对话框返回：选择的文件路径数组 */
    filePaths?: string[];
}
/**
 * 对话框 API
 * 提供原生的文件选择对话框功能
 */
export interface DialogAPI extends Omit<GeneratedDialogAPI, 'showSaveDialog' | 'showOpenDialog'> {
    /**
     * 显示保存文件对话框
     * @param options 对话框配置选项
     * @returns 返回 Promise，包含文件路径信息
     * @example
     * const result = await sdk.dialog.showSaveDialog({
     *   title: '保存文件',
     *   defaultPath: 'my-file.txt',
     *   filters: [{ name: 'Text', extensions: ['txt'] }]
     * });
     * if (!result.canceled) {
     *   console.log('保存路径:', result.filePath);
     * }
     */
    showSaveDialog(options: SaveDialogOptions): Promise<DialogReturnValue>;
    /**
     * 显示打开文件对话框
     * @param options 对话框配置选项
     * @returns 返回 Promise，包含选中的文件路径信息
     * @example
     * const result = await sdk.dialog.showOpenDialog({
     *   title: '选择文件',
     *   properties: ['openFile', 'multiSelections'],
     *   filters: [{ name: 'Images', extensions: ['jpg', 'png'] }]
     * });
     * if (!result.canceled) {
     *   console.log('选中文件:', result.filePaths);
     * }
     */
    showOpenDialog(options: OpenDialogOptions): Promise<DialogReturnValue>;
}
