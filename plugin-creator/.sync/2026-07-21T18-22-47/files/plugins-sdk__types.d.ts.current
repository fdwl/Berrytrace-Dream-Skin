    /**
     * 基于 token 的异步 API 调用，支持超时控制。
     * 通过 token 匹配请求-响应，避免阻塞 invoke 通道，适合耗时操作（如 HTTP 请求）。
     */
    callApiResult(apiName: string, methodName: string, args?: unknown[], timeoutMs?: number): Promise<unknown>;
    /** 搜索 API - 提供全文检索功能 */
    search: SearchAPI;
    /** 插件信息 API - 获取当前插件的元数据 */
    plugin: PluginInfoAPI;
    /** 日志 API - 记录插件运行日志 */
    log: LogAPI;
    /** AI 功能 API - 调用 AI 对话、Agent 任务等 */
    ai: AIApi;
    /** 上下文 API - 获取用户当前选中的内容或活动应用 */
    context: ContextAPI;
    /** Workflow 编排 API - 注册与硬执行工作流 */
    workflow: WorkflowAPI;
    /** MCP (Model Context Protocol) API - 注册和管理 MCP 工具 */
    mcp: McpAPI;
    /** 命令 API - 注册和执行命令 */
    commands: CommandAPI;
    /** 事件 API - 插件间广播通知通信 */
    events: EventAPI;
    /**
     * 宿主命令 API - 订阅宿主下发的命令（仅 background / main 插件有意义）
     * 语义：宿主请你做某事 vs events 的某事已发生通知各方
     */
    host: HostCommandAPI;
    /** 窗口 API - 操作当前的/新建的窗口（关闭、最小化、创建浮窗等） */
    window: WindowAPI;
    /** 浮动窗口创建 API（已合并到 window.create） */
    createWindow: WindowAPI;
    /** 存储 API - 键值对存储和简易数据库 */
    storage: StorageAPI;
    /** 文件系统 API - 读写文件、管理目录 */
    filesystem: FileSystemAPI;
    /** 系统 API - 主题、通知、执行命令等系统功能 */
    system: SystemAPI;
    /** 对话框 API - 显示原生文件选择对话框 */
    dialog: DialogAPI;
    /** 工作区 API - 操作工作区视图、标签页等 */
    workspace: WorkspaceAPI;
    /** 设置 API - 注册设置面板的一级 Tab */
    settings: SettingsAPI;
    /** 调度器 API - 注册定时或周期性执行的任务 */
    scheduler: SchedulerAPI;
    /** 临时发布 API - 将文档发布为临时网页分享 */
    publish: PublishAPI;
    /** 划词菜单 API - 注册按钮到系统划词菜单 */
    selectionMenu: SelectionMenuAPI;
    /** 跨插件 Hooks API - 插件间协作回调 */
    hooks: HookAPI;
    /**
     * 统一注册一个 View 到 BerryTrace 系统（全局唯一入口）
     *
     * 不属于任何子模块，通过 `placement` 声明这个 View 渲染到哪里。
     *
     * @example 注册设置面板 Tab
     * sdk.registerView({
     *   viewType: 'com.xxx:settings',
     *   viewClass: MySettingsView,
     *   placement: { type: 'settings', label: '插件设置', icon: '<svg...>', order: 90 },
     * });
     *
     * @example 注册工作区编辑视图
     * sdk.registerView({
     *   viewType: 'com.xxx:workspace',
     *   viewClass: MyEditorView,
     *   placement: { type: 'workspace' },
     * });
     */
    registerView(config: RegisterViewConfig): void;
    /**
     * 注销一个已注册的 View。
     * 若该 View 通过 `RegisterViewConfig` 注册，同时自动清理对应的次级注册。
     */
    unregisterView(viewType: string): void;
}
/**
 * 设置面板 Tab 注册配置
 */
export interface SettingsTabConfig {
