/**
 * 工作区 API
 * 用于操作 BerryTrace 的工作区，如注册视图、操作标签、注册功能区图标等
 */
/**
 * 声明一个 View 被渲染到系统的哪个位置，以及该位置所需的元信息。
 * 与 RegisterViewConfig.placement 配合使用。
 */
export type ViewPlacement = 
/** 工作区 Tab（主编辑视图，通过 fileAssociations 路由或直接打开） */
{
    type: 'workspace';
}
/** 设置面板的一级 Tab */
 | {
    type: 'settings';
    /** Tab 显示名称 */
    label: string;
    /** Tab 图标（SVG 字符串，可选） */
    icon?: string;
    /** 排序权重，数字越小越靠前，默认 100 */
    order?: number;
}
/** Quick Panel 嵌入视图 */
 | {
    type: 'quickPanel';
}
/** 划词菜单内嵌视图 */
 | {
    type: 'selectionMenu';
    label: string;
    icon?: string;
};
/**
 * 统一注册视图配置（推荐写法）
 * 将 ViewClass 注册与渲染位置声明合并为一次调用，消除 viewType 字符串的外部耦合。
 *
 * @example
 * // 注册到设置面板
 * sdk.workspace.registerView({
 *   viewType: 'com.xxx:settings',
 *   viewClass: MySettingsView,
 *   placement: { type: 'settings', label: '插件设置', order: 90 },
 * });
 *
 * @example
 * // 注册到工作区 Tab（无需 placement 元信息）
 * sdk.workspace.registerView({
 *   viewType: 'com.xxx:workspace',
 *   viewClass: MyEditorView,
 *   placement: { type: 'workspace' },
 * });
 */
export interface RegisterViewConfig {
    /** 视图唯一标识，如 'com.berrytrace.plugin.xxx:workspace' */
    viewType: string;
    /** View 类（需继承 View 基类），接受 (container, sdk) 构造参数 */
    viewClass: new (container: HTMLElement, app: unknown) => unknown;
    /** 声明此 View 渲染在哪里以及对应的元信息 */
    placement: ViewPlacement;
}
export interface WorkspaceAPI extends Omit<GeneratedWorkspaceAPI, 'getPath' | 'getMetadata' | 'openWorkspaceTab'> {
    /**
     * @deprecated 请使用顶层方法 `sdk.registerView()` 代替。
     * 向后兼容别名，内部委托到 `sdk.registerView`。
     */
