export interface ExecCommandOptions {
    command: string;
    args?: string[];
    cwd?: string;
    env?: Record<string, string>;
    timeoutMs?: number;
    shell?: boolean;
    streamEventName?: string;
    sessionId?: string;
    resolveOnSilenceMs?: number;
    sudo?: boolean;
}
export interface ExecCommandResult {
    code: number;
    stdout: string;
    stderr: string;
    signal: string | null;
    resolvedEarly?: boolean;
}
/**
 * 系统 API
 * 提供系统级功能，如主题获取、通知显示、执行系统命令等
 */
export interface SystemAPI extends Omit<GeneratedSystemAPI, 'getTheme' | 'showNotification' | 'openUrl' | 'openExternal' | 'execCommand' | 'waitCommand' | 'createDesktopShortcut' | 'setTrayMenu' | 'registerGlobalShortcut' | 'unregisterGlobalShortcut'> {
    /**
     * 获取当前系统主题
     * @returns 返回 'light' 或 'dark'
     * @example
     * const theme = await sdk.system.getTheme();
     * if (theme === 'dark') {
     *   // 应用暗色主题样式
     * }
     */
    getTheme(): Promise<'light' | 'dark'>;
    /**
     * 获取当前宿主应用的 OEM 信息（如应用名称、API网关等）
     */
    getAppInfo(): Promise<{
        appName: string;
        oemId: string;
        apiGateway: string;
        logoPath?: string;
    }>;
    /**
     * 显示系统通知
     * @param options 通知选项，包含标题、正文、是否静音
     * @example
     * await sdk.system.showNotification({
     *   title: '任务完成',
     *   body: '文件已成功处理',
     *   silent: false
     * });
     */
    showNotification(options: {
        title: string;
        body: string;
        silent?: boolean;
    }): Promise<void>;
    /**
     * 在 BerryTrace 内部浏览器中打开 URL
     * @param url 要打开的 URL
     * @param options 打开选项
     * @example
     * await sdk.system.openUrl('https://example.com', {
     *   internal: true,
     *   width: 800,
     *   height: 600
     * });
     */
    openUrl(url: string, options?: {
        internal?: boolean;
        width?: number;
        height?: number;
        alwaysOnTop?: boolean;
    }): Promise<void>;
    /**
     * 在系统默认浏览器中打开 URL
     * @param url 要打开的 URL
     * @example
     * await sdk.system.openExternal('https://example.com');
     */
    openExternal(url: string): Promise<void>;
    /**
     * 执行系统命令
     * @param options 命令选项，包含命令、参数、工作目录、超时等
     * @returns 返回执行结果，包含退出码、stdout、stderr 等
     * @example
     * // 执行简单命令
     * const result = await sdk.system.execCommand({
     *   command: 'ls',
     *   args: ['-la'],
     *   cwd: '/path/to/dir',
     *   timeoutMs: 5000
     * });
     * console.log(result.stdout);
     *
     * @example
     * // 流式获取输出
     * await sdk.system.execCommand({
     *   command: 'tail',
     *   args: ['-f', '/var/log/system.log'],
     *   streamEventName: 'my-plugin:log-stream'
     * });
     * // 在别处监听
     * sdk.events.on('my-plugin:log-stream', (data) => {
     *   console.log(data.stream, data.chunk);
     * });
     */
    execCommand(options: {
        command: string;
        args?: string[];
        cwd?: string;
        env?: Record<string, string>;
        timeoutMs?: number;
        shell?: boolean;
        streamEventName?: string;
        sessionId?: string;
        resolveOnSilenceMs?: number;
    }): Promise<{
        code: number;
        stdout: string;
        stderr: string;
        signal: string | null;
        resolvedEarly?: boolean;
    }>;
    /**
     * 等待后台命令完成
     * @param options 包含 sessionId 的选项
     * @returns 返回执行结果
     * @example
     * // 启动长时间运行的命令
     * await sdk.system.execCommand({
     *   command: 'npm',
     *   args: ['install'],
     *   sessionId: 'my-session'
     * });
     * // 在别处等待完成
     * const result = await sdk.system.waitCommand({ sessionId: 'my-session' });
     */
    waitCommand(options: {
        sessionId: string;
    }): Promise<{
        code: number;
        stdout: string;
        stderr: string;
        signal: string | null;
    }>;
    /** 动态为当前插件在桌面创建快捷方式 */
    createDesktopShortcut(options: {
        name: string;
        icon?: string;
        description?: string;
    }): Promise<boolean>;
    /** 注册系统托盘菜单 */
    setTrayMenu(menuTemplate: Array<{
        label: string;
        type?: 'normal' | 'separator' | 'checkbox';
        checked?: boolean;
        clickCommand: string;
    }>): Promise<void>;
    /** 动态注册全局系统热键 */
    registerGlobalShortcut(accelerator: string, commandId: string): Promise<boolean>;
    /** 取消注册全局系统热键 */
    unregisterGlobalShortcut(accelerator: string): Promise<void>;
    /** 注册快捷键动作（供用户在设置中绑定到手势） */
    registerShortcutAction(options: {
        id: string;
        label: string;
        icon?: string;
    }): Promise<void>;
    /** 注销快捷键动作 */
    unregisterShortcutAction(id: string): Promise<void>;
    /** 获取所有已注册的快捷键动作 */
    listShortcutActions(): Promise<Array<{
        id: string;
        label: string;
        icon: string;
        pluginId: string;
    }>>;
    /** 获取当前获得焦点的输入框信息 */
    getFocusedInputInfo(): Promise<{
        selection: string;
        value: string;
        role: string;
    }>;
    /** 在当前获得焦点的输入框光标处插入/替换文本 */
    insertText(options: {
        text: string;
    }): Promise<boolean>;
    /**
     * 检测当前系统光标是否处于可编辑输入区域。
     * 适用于 AI 填充前的前置检查：若 isInput=false 则提示用户先点击一个输入框。
     *
     * @returns isInput    — 是否为任何可输入区域（含 contenteditable 的网页输入框）
     * @returns isEditable — 是否明确可编辑（AX editable 属性 = true 或 native input role）
     * @returns role       — AX 角色字符串，如 "AXTextField" / "AXTextArea" / "AXWebArea"
     *
     * @example
     * const { isInput } = await sdk.system.isFocusedInInputArea()
     * if (!isInput) {
     *   sdk.ui.showToast('请先点击一个输入框，再触发 AI 填充')
     *   return
     * }
     * await sdk.system.insertText({ text: aiResult })
     */
    isFocusedInInputArea(): Promise<{
        isInput: boolean;
        isEditable: boolean;
        role: string;
    }>;
}
export interface FolderContextMenuItem {
    id: string;
    label: string;
    onClick: (folderPath: string) => void;
