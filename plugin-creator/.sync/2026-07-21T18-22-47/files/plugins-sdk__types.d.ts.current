        filePath?: string;
        extension?: string;
        pluginId?: string;
        title?: string;
        customParams?: Record<string, unknown>;
    } | null;
    /**
     * 注册功能区图标（侧边栏图标）
     * @param id 图标唯一标识符
     * @param icon 图标：静态字符串 | 动态函数 | React 元素 | 返回 React 元素的函数
     * @param title 悬停提示文字
     * @param onClick 点击回调函数
     * @param pluginId 插件 ID（可选，默认当前插件）
     * @param onContextMenu 右键点击回调函数（可选）
     * @example
     * // 静态 SVG
