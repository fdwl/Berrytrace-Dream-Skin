/**
 * BerryTrace SDK 主接口
 * 这是插件开发者最直接使用的接口，通过全局对象 `berrytrace` 访问
 *
 * @example
 * // 获取 SDK 实例
 * const sdk = window.berrytrace;
 *
 * // 使用各个 API 模块
 * await sdk.plugin.getInfo();
 * await sdk.log.info('Hello BerryTrace');
 * await sdk.system.showNotification({ title: '提示', body: '操作完成' });
 */
export interface NoteSearchResult {
    note_id: number;
    title: string;
