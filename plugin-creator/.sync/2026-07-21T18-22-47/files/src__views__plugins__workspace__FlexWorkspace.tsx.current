import React, { useEffect, useState, useRef } from 'react';
import { createPortal } from 'react-dom';
import { useNavigate } from 'react-router-dom';
import { Actions, Layout, Model, TabNode, type Action } from 'flexlayout-react';
import { useWorkspaceStore } from '../../../stores/workspace';
import { useAppStore } from '../../../stores/app';
import { useAgentStore } from '../../../stores/agent';
import WorkspaceTabPanel from './WorkspaceTabPanel';
import BrowserTabPanel from './BrowserTabPanel';
import { isElectron, isMac } from '../../../utils/platform';
import { useShortcut } from '../../../hooks/useShortcut';

import 'flexlayout-react/style/light.css';
import './globals.css';

import WorkspaceHome from './WorkspaceHome';
import SidebarPanel from './SidebarPanel';
import WorkspaceTabBar from '../../../layouts/components/WorkspaceTabBar';
import { type RecentDocItem } from './WorkspaceHome';
import type { IJsonModel } from 'flexlayout-react';

/** 布局节点接口 - 用于类型安全的布局树遍历 */
interface LayoutNode {
  type?: string;
  id?: string;
  name?: string;
  children?: LayoutNode[];
  config?: Record<string, unknown>;
  selected?: number;
}

/** 根据 workspace 路径生成独立的 localStorage key */
const getLayoutStorageKey = (workspacePath: string) => {
  // 对路径做简单规范化，去掉末尾斜杠，替换路径分隔符
  const normalized = workspacePath.replace(/\\/g, '/').replace(/\/$/, '');
  return `berrytrace-layout:${normalized}`;
};

/** 从 localStorage 加载指定 workspace 的布局 JSON，失败返回 null */
const loadLayoutFromStorage = (workspacePath: string) => {
  try {
    const key = getLayoutStorageKey(workspacePath);
    const raw = localStorage.getItem(key);
    if (!raw) return null;
    return JSON.parse(raw);
  } catch {
    return null;
  }
};

/** 将布局 JSON 存入指定 workspace 的 localStorage key */
const saveLayoutToStorage = (workspacePath: string, layoutJson: unknown) => {
  try {
    const key = getLayoutStorageKey(workspacePath);
    localStorage.setItem(key, JSON.stringify(layoutJson));
  } catch (e) {
    console.warn('[FlexWorkspace] Failed to save layout:', e);
  }
};

/** 递归收集布局 JSON 树中的所有 tab 节点 */
const getLayoutTabs = (layoutJson: IJsonModel): LayoutNode[] => {
  const tabs: LayoutNode[] = [];
  const traverse = (node: LayoutNode) => {
    if (!node) return;
    if (node.type === 'tab') {
      tabs.push(node);
    } else if (node.children && Array.isArray(node.children)) {
      node.children.forEach(traverse);
    }
  };
  if (layoutJson && layoutJson.layout) {
    traverse(layoutJson.layout as LayoutNode);
  }
  return tabs;
};

/** 合并当前内存中的布局与加载的缓存布局，保留内存中较新的 Tab，避免被覆盖 */
const mergeLayouts = (currentLayout: IJsonModel, savedLayout: IJsonModel): IJsonModel => {
  if (!currentLayout) return savedLayout;
  if (!savedLayout) return currentLayout;

  const currentTabs = getLayoutTabs(currentLayout);
  if (currentTabs.length === 0) return savedLayout;

  const savedTabs = getLayoutTabs(savedLayout);
  const savedTabIds = new Set(savedTabs.map(t => t.id).filter(Boolean));
  const missingTabs = currentTabs.filter(t => t.id && !savedTabIds.has(t.id));

  if (missingTabs.length === 0) {
    return savedLayout;
  }

  // 深拷贝 savedLayout 避免修改缓存对象
  const mergedLayout = JSON.parse(JSON.stringify(savedLayout)) as IJsonModel;

  // 寻找到 mergedLayout 中的第一个 tabset 节点
  let targetTabset: LayoutNode | null = null;
  const findFirstTabset = (node: LayoutNode): boolean => {
    if (!node) return false;
    if (node.type === 'tabset') {
      targetTabset = node;
      return true;
    }
    if (node.children && Array.isArray(node.children)) {
      for (const child of node.children) {
        if (findFirstTabset(child)) return true;
      }
    }
    return false;
  };

  if (mergedLayout.layout) {
    findFirstTabset(mergedLayout.layout as LayoutNode);
  }

  if (targetTabset) {
    if (!targetTabset.children) {
      targetTabset.children = [];
    }
    missingTabs.forEach(tab => {
      targetTabset!.children.push(JSON.parse(JSON.stringify(tab)));
    });
    // 选中新合并进来的最后一个 Tab
    targetTabset.selected = targetTabset.children.length - 1;
  } else {
    return currentLayout;
  }

  return mergedLayout;
};

function FlexWorkspace() {
  const navigate = useNavigate();

  const layoutJson = useWorkspaceStore(state => state.layoutJson);
  const updateLayoutJson = useWorkspaceStore(state => state.updateLayoutJson);
  const activeSessionId = useAgentStore(state => state.activeSessionId);
  const zenMode = useAppStore(state => state.zenMode);
  const storeShowRightSidebar = useWorkspaceStore(state => state.showRightSidebar);
  const showRightSidebar = storeShowRightSidebar && !zenMode;
  const toggleRightSidebar = useWorkspaceStore(state => state.toggleRightSidebar);
  const outlines = useWorkspaceStore(state => state.outlines);
  const activeTabId = useWorkspaceStore(state => state.activeTabId);
  const rightSidebarWidth = useWorkspaceStore(state => state.rightSidebarWidth || 240);
  const setRightSidebarWidth = useWorkspaceStore(state => state.setRightSidebarWidth);
  const [isResizingRight, setIsResizingRight] = useState(false);

  // 当前 workspace 路径，用于区分不同 workspace 的布局存储
  const workspacePathRef = useRef<string | null>(null);
  const layoutLoaded = useWorkspaceStore(state => state.layoutLoaded);
  const [contextMenu, setContextMenu] = useState<{
    x: number;
    y: number;
    node: TabNode;
  } | null>(null);

  const handleContextMenu = (node: unknown, event: React.MouseEvent) => {
    if (node && typeof node === 'object' && 'getType' in node && (node as TabNode).getType() === 'tab') {
      event.preventDefault();
      setContextMenu({
        x: event.clientX,
        y: event.clientY,
        node: node as TabNode
      });
    }
  };

  useEffect(() => {
    const handleCloseMenu = () => setContextMenu(null);
    window.addEventListener('click', handleCloseMenu);
    return () => window.removeEventListener('click', handleCloseMenu);
  }, []);


  // 监听主进程创建新文档的请求（Ctrl+Command+N）
  useEffect(() => {
    if (!isElectron || !window.electronAPI?.main?.onCreateNewDocument) return;

    const unsubscribe = window.electronAPI.main.onCreateNewDocument(() => {
      console.log('[FlexWorkspace] Received main:create-new-document message');

      // 1. 隐藏左右侧边栏，提供沉浸式体验
      const store = useWorkspaceStore.getState();
      useAppStore.getState().setSidebarCollapsed(true);
      store.setRightSidebar(false);

      // 2. 检查布局中是否已经打开了以 "未命名" 开头的 tab 窗口
      const tabs = getLayoutTabs(store.layoutJson);
      const existingDraftTab = tabs.find(t => t.name && t.name.startsWith('未命名'));

      if (existingDraftTab && existingDraftTab.id) {
        store.setActiveTabId(existingDraftTab.id);
      } else {
        const sessionId = `draft_${Date.now()}`;
        store.openWorkspaceTab(undefined, 'com.berrytrace.plugin.markdown-editor', 'md', undefined, sessionId);
      }
    });

    return () => {
      unsubscribe();
    };
  }, []);



  // 注意：webview:new-window 已废弃（WebContentsView 迁移后）
  // new-window 事件现在由 BrowserViewManager 通过 browser-view:event(type='new-window') 发出
  // 由各 BrowserTabPanel 实例自行处理，不需要在 FlexWorkspace 层级监听



  // 监听主进程重新打开侧边栏的请求（Ctrl+Command+O）
  useEffect(() => {
    if (!isElectron || !window.electronAPI?.main?.onShowSidebars) return;

    const unsubscribe = window.electronAPI.main.onShowSidebars(() => {
      console.log('[FlexWorkspace] Received main:show-sidebars message');
      // 重新打开左右侧边栏
      const store = useWorkspaceStore.getState();
      store.setLeftSidebar(true);
      store.setRightSidebar(true);
    });

    return () => {
      unsubscribe();
    };
  }, []);

  const handleRightMouseDown = (e: React.MouseEvent) => {
    e.preventDefault();
    setIsResizingRight(true);
  };

  useEffect(() => {
    if (!isResizingRight) return;

    const handleMouseMove = (e: MouseEvent) => {
      let newWidth = window.innerWidth - e.clientX;
      if (newWidth < 180) newWidth = 180;
      if (newWidth > 500) newWidth = 500;
      setRightSidebarWidth(newWidth);
    };

    const handleMouseUp = () => {
      setIsResizingRight(false);
    };

    window.addEventListener('mousemove', handleMouseMove);
    window.addEventListener('mouseup', handleMouseUp);
    return () => {
      window.removeEventListener('mousemove', handleMouseMove);
      window.removeEventListener('mouseup', handleMouseUp);
    };
  }, [isResizingRight, setRightSidebarWidth]);

  useEffect(() => {
    document.documentElement.style.setProperty('--workspace-right-sidebar-width', `${rightSidebarWidth}px`);
  }, [rightSidebarWidth]);

  const [pluginMap, setPluginMap] = useState<Record<string, string>>({});
  const [activeRightTabState, setActiveRightTab] = useState<string>('outline');
  const [selectedOutlineIndex, setSelectedOutlineIndex] = useState<number | null>(null);
  const registeredPanels = useWorkspaceStore(state => state.registeredPanels);
  const activePanels = activeTabId ? (registeredPanels[activeTabId] || []) : [];

  const [plusMenu, setPlusMenu] = useState<{ x: number; y: number; tabsetId: string } | null>(null);

  const handlePlusClick = (e: React.MouseEvent, tabsetId: string) => {
    e.stopPropagation();
    const rect = e.currentTarget.getBoundingClientRect();
    setPlusMenu({
      x: rect.left,
      y: rect.bottom + 4,
      tabsetId
    });
  };

  useEffect(() => {
    const handleClose = () => setPlusMenu(null);
    window.addEventListener('click', handleClose);
    return () => window.removeEventListener('click', handleClose);
  }, []);

  const [tabbarElements, setTabbarElements] = useState<Element[]>([]);

  useEffect(() => {
    if (!layoutLoaded) return;

    const updateTabbars = () => {
      const elements = Array.from(document.querySelectorAll('.flexlayout__tabset_tabbar_inner'));
      setTabbarElements(elements);
    };

    updateTabbars();

    const observer = new MutationObserver(updateTabbars);
    observer.observe(document.body, { childList: true, subtree: true });

    return () => {
      observer.disconnect();
    };
  }, [layoutLoaded]);

  // 当 activeSessionId 改变时，将 layoutLoaded 重置为 false，从而重新触发 loadLayout
  useEffect(() => {
    useWorkspaceStore.setState({ layoutLoaded: false });
  }, [activeSessionId]);

  // ── 按 workspace.json 记载/保存布局 ──────────────────────────────────────────
  useEffect(() => {
    if (layoutLoaded) return;

    const loadLayout = async () => {
      const t_layout_start = performance.now();
      console.log(`[FlexWorkspace] [Perf] loadLayout starts...`);
      let workspacePath: string | null = null;
      let savedMetadata: any = null;
      try {
        if (window.electronAPI?.workspace?.getPath) {
          const t_getPath = performance.now();
          workspacePath = await window.electronAPI.workspace.getPath();
          console.log(`[FlexWorkspace] [Perf] getPath took ${(performance.now() - t_getPath).toFixed(2)}ms, path: ${workspacePath}`);
        }
      } catch (e) {
        console.warn('[FlexWorkspace] Failed to get workspace path:', e);
      }

      workspacePathRef.current = workspacePath;

      // 1. 尝试从 activeSessionId 的 layout 恢复
      let restored = false;
      const currentActiveSessionId = useAgentStore.getState().activeSessionId;
      if (currentActiveSessionId) {
        const session = useAgentStore.getState().sessions[currentActiveSessionId];
        if (session?.workspaceLayout?.layoutJson && getLayoutTabs(session.workspaceLayout.layoutJson).length > 0) {
          console.log('[FlexWorkspace] Restoring saved layout from session:', currentActiveSessionId);
          useWorkspaceStore.setState({
            layoutJson: session.workspaceLayout.layoutJson,
            activeTabId: session.workspaceLayout.activeTabId || null,
            tabHistories: session.workspaceLayout.tabHistories || {}
          });
          restored = true;
        }
      }

      // 2. 如果没恢复（如 session 尚未保存过布局），退避从全局的 metadata.json 恢复
      if (!restored && workspacePath) {
        try {
          if (window.electronAPI?.workspace?.getMetadata) {
            savedMetadata = await window.electronAPI.workspace.getMetadata();
          }
        } catch (e) {
          console.warn('[FlexWorkspace] Failed to get workspace path/metadata:', e);
        }

        const currentTabs = getLayoutTabs(useWorkspaceStore.getState().layoutJson);
        if (savedMetadata?.layoutJson && getLayoutTabs(savedMetadata.layoutJson).length > 0) {
          if (currentTabs.length > 0) {
            console.log('[FlexWorkspace] Skipping saved layout restore — store already has tabs (likely from pending open)');
          } else {
            console.log('[FlexWorkspace] Restoring saved layout, activeTabId:', savedMetadata.activeTabId);
            useWorkspaceStore.setState({
              layoutJson: savedMetadata.layoutJson,
              activeTabId: savedMetadata.activeTabId || null,
              tabHistories: savedMetadata.tabHistories || {}
            });
          }
          restored = true;
        }
      }

      // 3. 如果没恢复，且当前没有任何 tab，则重置工作区
      if (!restored) {
        const currentTabs = getLayoutTabs(useWorkspaceStore.getState().layoutJson);
        if (currentTabs.length === 0) {
          console.log('[FlexWorkspace] No saved layout found or empty, resetting workspace');
          useWorkspaceStore.getState().resetWorkspace();
        }
      }

      useWorkspaceStore.setState({ layoutLoaded: true });
      console.log(`[FlexWorkspace] [Perf] loadLayout completed in ${(performance.now() - t_layout_start).toFixed(2)}ms, layoutLoaded set to true`);

      // 布局初始化完成后，消费 pending 的文件打开请求（解决首次从侧边栏点击文件不打开的竞态问题）
      const pending = useWorkspaceStore.getState().consumePendingOpenFile();
      if (pending) {
        // Browser tab: open in internal browser panel
        if (pending.pluginId === 'system.browser' || pending.extension === 'url') {
          useWorkspaceStore.getState().openBrowserTab(
            pending.filePath || 'about:blank',
            pending.title
          );
        } else if (pending.inNewGroup) {
          useWorkspaceStore.getState().openWorkspaceTabInNewGroup(
            pending.filePath,
            pending.pluginId,
            pending.extension,
            pending.articleId,
            pending.sessionId
          );
        } else {
          useWorkspaceStore.getState().openWorkspaceTab(
            pending.filePath,
            pending.pluginId,
            pending.extension,
            pending.articleId,
            pending.sessionId,
            pending.replaceActiveTab,
            pending.title,
            pending.line,
            pending.customParams
          );
        }
      }
    };

    void loadLayout();
  }, [layoutLoaded]);

  // 组件卸载时重置状态
  useEffect(() => {
    return () => {
      useWorkspaceStore.setState({ layoutLoaded: false });
    };
  }, []);

  // ── 监听 store 变化，自动保存布局和 Tab 历史 ─────────────────
  useEffect(() => {
    if (!layoutLoaded) return;

    let timeoutId: NodeJS.Timeout;
    const unsubscribe = useWorkspaceStore.subscribe((state, prevState) => {
      // 仅在关键状态发生改变时写入
      if (
        state.layoutJson === prevState.layoutJson &&
        state.activeTabId === prevState.activeTabId &&
        state.tabHistories === prevState.tabHistories
      ) {
        return;
      }

      clearTimeout(timeoutId);
      timeoutId = setTimeout(() => {
        const currentActiveSessionId = useAgentStore.getState().activeSessionId;
        if (currentActiveSessionId) {
          // 保存到 active session 的 SQLite DB & store
          useAgentStore.getState().updateSessionLayout(currentActiveSessionId, {
            layoutJson: state.layoutJson,
            activeTabId: state.activeTabId,
            tabHistories: state.tabHistories
          });
        } else {
          // 否则退避保存到项目的 metadata.json
          if (window.electronAPI?.workspace?.updateMetadata && workspacePathRef.current) {
            window.electronAPI.workspace.updateMetadata({
              layoutJson: state.layoutJson,
              activeTabId: state.activeTabId,
              tabHistories: state.tabHistories
            }).catch((err: unknown) => {
              console.warn('[FlexWorkspace] Failed to auto-save workspace metadata:', err);
            });
          }
        }
      }, 500);
    });

    return () => {
      unsubscribe();
      clearTimeout(timeoutId);
    };
  }, [layoutLoaded]);
  // ─────────────────────────────────────────────────────────────────────────────
  // ─────────────────────────────────────────────────────────────────────────────

  const activeRightTab = activePanels.some(p => p.id === activeRightTabState)
    ? activeRightTabState
    : (activePanels[0]?.id || 'outline');

  useEffect(() => {
    if (window.electronAPI?.plugins?.getList) {
      window.electronAPI.plugins.getList().then(list => {
        const map: Record<string, string> = {};
        list.forEach((p: { id: string; isActive: boolean; fileAssociations?: string[] }) => {
          if (p.isActive && p.fileAssociations) {
            p.fileAssociations.forEach((assocExt: string) => {
              const extClean = assocExt.toLowerCase().replace(/^\./, '');
              if (!map[extClean]) {
                map[extClean] = p.id;
              }
            });
          }
        });
        setPluginMap(map);
      }).catch(err => console.error('Failed to get plugin list for drag-drop map:', err));
    }
  }, []);

  const onExternalDrag = (_event: React.DragEvent<HTMLElement>) => {
    const path = useWorkspaceStore.getState().draggedPath;
    if (!path) return undefined;

    // Check if the node is already in the layout to prevent duplicate ID crash
    if (modelState.model.getNodeById(path)) {
      return undefined;
    }

    const ext = path.split('.').pop()?.toLowerCase() || '';
    const pluginId = pluginMap[ext] || 'com.berrytrace.plugin.markdown-editor';
    const fileName = path.split(/[/\\]/).pop() || '未命名';

    return {
      json: {
        type: 'tab',
        id: path,
        name: fileName,
        component: 'plugin-view',
        config: { filePath: path, pluginId, extension: ext }
      },
      onDrop: (node: { getId: () => string } | null) => {
        if (node) {
          queueMicrotask(() => {
            useWorkspaceStore.setState({ activeTabId: node.getId() });
          });
        }
      }
    };
  };

  // Sync layout model efficiently without recreating it when changes are internal
  const renderCountRef = useRef(0);
  renderCountRef.current++;

  const [modelState, setModelState] = useState(() => {
    try {
      return {
        model: Model.fromJson(layoutJson),
        jsonStr: JSON.stringify(layoutJson)
      };
    } catch (err) {
      console.error('Failed to parse layout model:', err);
      const fallback = {
        global: { tabEnableClose: true },
        layout: { type: 'row', children: [{ type: 'tabset', id: 'main-tabset', children: [] }] }
      };
      return {
        model: Model.fromJson(fallback),
        jsonStr: JSON.stringify(fallback)
      };
    }
  });

  const currentJsonString = JSON.stringify(layoutJson);
  if (modelState.jsonStr !== currentJsonString) {
    console.log(`[FlexWorkspace] Render #${renderCountRef.current} - Render-phase sync triggered. prev jsonStr len:`, modelState.jsonStr.length, 'curr len:', currentJsonString.length);
    try {
      const prevJson = JSON.parse(modelState.jsonStr);
      const currJson = JSON.parse(currentJsonString);

      // 检测是否有结构性变化（tab 新增或删除），若有则走完整重建，否则增量更新
      const collectTabIds = (node: any, ids: Set<string>) => {
        if (!node) return;
        if (node.type === 'tab' && node.id) ids.add(node.id);
        if (node.children && Array.isArray(node.children)) {
          for (const child of node.children) collectTabIds(child, ids);
        }
      };
      const prevIds = new Set<string>(); collectTabIds(prevJson.layout, prevIds);
      const currIds = new Set<string>(); collectTabIds(currJson.layout, currIds);
      const hasStructuralChange = prevIds.size !== currIds.size ||
        [...prevIds].some(id => !currIds.has(id)) ||
        [...currIds].some(id => !prevIds.has(id));

      if (hasStructuralChange) {
        const removed = [...prevIds].filter(id => !currIds.has(id));
        const added = [...currIds].filter(id => !prevIds.has(id));
        let model = modelState.model;

        // If it's pure deletion, delete nodes in-place to avoid unmounting/remounting other tabs
        if (removed.length > 0 && added.length === 0) {
          console.log('[FlexWorkspace] Structural deletion detected, removing tabs in-place:', removed);
          for (const id of removed) {
            if (model.getNodeById(id)) {
              model.doAction(Actions.deleteTab(id));
            }
          }
          setModelState({ model, jsonStr: currentJsonString });
        } else {
          console.log('[FlexWorkspace] Structural change detected (addition/split), rebuilding model. prev tabs:', prevIds.size, 'curr tabs:', currIds.size);
          const newModel = Model.fromJson(layoutJson);
          setModelState({ model: newModel, jsonStr: currentJsonString });
        }
      } else {
        // 仅属性变化（name/config 更新），增量更新避免闪屏
        let model = modelState.model;

        const syncNode = (prev: any, curr: any) => {
          if (!prev || !curr) return;
          if (prev.type === 'tab' && curr.type === 'tab' && prev.id === curr.id) {
            const nameChanged = prev.name !== curr.name;
            const configChanged = JSON.stringify(prev.config) !== JSON.stringify(curr.config);
            if (nameChanged || configChanged) {
              const attrs: Record<string, any> = {};
              if (nameChanged) attrs.name = curr.name;
              if (configChanged) attrs.config = curr.config;
              model.doAction(Actions.updateNodeAttributes(curr.id, attrs));
            }
          }
          // 同步 tabset 的选中索引变化（例如 openWorkspaceTab 发现已有 tab 时 selectTab 只改了 selected）
          if (prev.type === 'tabset' && curr.type === 'tabset') {
            if (prev.selected !== curr.selected &&
                typeof curr.selected === 'number' &&
                curr.children &&
                curr.selected >= 0 &&
                curr.selected < curr.children.length) {
              const selectedChild = curr.children[curr.selected];
              if (selectedChild && selectedChild.id) {
                model.doAction(Actions.selectTab(selectedChild.id));
              }
            }
          }
          if (prev.children && curr.children && Array.isArray(prev.children) && Array.isArray(curr.children)) {
            const len = Math.max(prev.children.length, curr.children.length);
            for (let i = 0; i < len; i++) {
              syncNode(prev.children[i], curr.children[i]);
            }
          }
        };

        syncNode(prevJson.layout, currJson.layout);

        setModelState({ model, jsonStr: currentJsonString });
      }
    } catch {
      // 增量更新失败，回退到完整重建
      try {
        const newModel = Model.fromJson(layoutJson);
        setModelState({
          model: newModel,
          jsonStr: currentJsonString
        });
      } catch (err) {
        console.error('Failed to parse layout model:', err);
      }
    }
  }

  useEffect(() => {
    let extension = '';
    let path = '';
    if (activeTabId) {
      const node = modelState.model.getNodeById(activeTabId) as TabNode | undefined;
      if (node) {
        const config = node.getConfig() as { filePath?: string; extension?: string } | undefined;
        if (config?.extension) {
          extension = config.extension;
        }
        if (config?.filePath) {
          path = config.filePath;
        }
      }
    }

    if (window.electronAPI?.ipc?.send) {
      window.electronAPI.ipc.send('workspace:active-tab-changed', {
        tabId: activeTabId,
        extension,
        path
      });
    }

    // 切换 Tab 时自动同步侧边栏文件列表选中状态，并展开对应文件夹
    if (activeTabId && path) {
      window.dispatchEvent(new CustomEvent('app:locate-in-sidebar', {
        detail: { filePath: path }
      }));
    }
  }, [activeTabId, modelState.model]);

  const getTabCount = (layoutModel: Model) => {
    let count = 0;
    layoutModel.visitNodes((node) => {
      if (node.getType() === 'tab') {
        count++;
      }
    });
    return count;
  };

  const tabCount = getTabCount(modelState.model);

  const onModelChange = (layoutModel: Model) => {
    console.log('[FlexWorkspace] onModelChange called (flexlayout internal change)');
    const nextJson = layoutModel.toJson();
    const nextJsonStr = JSON.stringify(nextJson);
    setModelState({
      model: layoutModel,
      jsonStr: nextJsonStr
    });
    updateLayoutJson(nextJson);
  };

  const onAction = (action: Action): Action | undefined => {
    if (action.type === Actions.DELETE_TAB) {
      const nodeId = action.data?.node as string;
      const node = modelState.model.getNodeById(nodeId) as TabNode | undefined;
      if (node) {
        const config = node.getConfig() as { filePath?: string } | undefined;
        const filePath = config?.filePath;
        if (filePath && typeof window !== 'undefined' && window.electronAPI?.ipc?.send) {
          window.electronAPI.ipc.send('workspace:file-closed', {
            filePath,
            timestamp: Date.now()
          });
        }
      }
    } else if (action.type === Actions.RENAME_TAB) {
      const nodeId = action.data?.node as string;
      const newName = (action.data?.text as string | undefined)?.trim();
      const node = modelState.model.getNodeById(nodeId) as TabNode | undefined;
      if (node && newName) {
        const config = node.getConfig() as { filePath?: string } | undefined;
        const filePath = config?.filePath;
        if (filePath) {
          if (/[/\\]/.test(newName)) {
            alert('文件名不能包含路径分隔符');
            return undefined;
          }
          const currentName = node.getName() || '';
          if (newName !== currentName) {
            const separator = filePath.includes('\\') ? '\\' : '/';
            const parentPath = filePath.substring(0, filePath.lastIndexOf(separator));
            const newPath = `${parentPath}${separator}${newName}`;
            void window.electronAPI.workspace.renameItem(filePath, newPath).then(() => {
              useWorkspaceStore.getState().renameFilePath(filePath, newPath);
              const win = window as any;
              if (win.__updateScannedFilePath) {
                win.__updateScannedFilePath(filePath, newPath);
              }
            }).catch((err: unknown) => {
              alert('重命名失败: ' + (err instanceof Error ? err.message : String(err)));
            });
          }
        }
      }
    }
    return action;
  };

  // Factory to instantiate tab panels dynamically
  const factory = (node: TabNode) => {
    const component = node.getComponent();
    if (component === 'plugin-view') {
      const config = node.getConfig() as {
        pluginId: string;
        filePath?: string;
        articleId?: string;
        extension?: string;
        sessionId?: string;
        customParams?: Record<string, any>;
      };
      return (
        <WorkspaceTabPanel
          key={node.getId()}
          tabId={node.getId()}
          pluginId={config.pluginId}
          filePath={config.filePath}
          articleId={config.articleId}
          extension={config.extension}
          sessionId={config.sessionId}
          customParams={config.customParams}
          visible={node.isVisible()}
        />
      );
    }
    if (component === 'browser-panel') {
      const config = node.getConfig() as {
        customParams?: Record<string, any>;
      };
      return (
        <BrowserTabPanel
          key={node.getId()}
          tabId={node.getId()}
          visible={node.isVisible()}
          customParams={config.customParams}
        />
      );
    }
    return null;
  };

  const handleOutlineClick = (text: string, line?: number, index?: number) => {
    if (!activeTabId) return;
    setSelectedOutlineIndex(index ?? null);
    window.dispatchEvent(new CustomEvent('berrytrace:outline-click', {
      detail: { sessionId: activeTabId, text, line }
    }));
  };

  const handleCreateNew = () => {
    const sessionId = `blank_${Date.now()}`;
    useWorkspaceStore.getState().openWorkspaceTab(undefined, 'system.workspace-blank', undefined, undefined, sessionId);
  };

  const handleOpenRecent = (item: RecentDocItem) => {
    const ext = (item.path.split('.').pop() || '').toLowerCase();
    const pluginId = pluginMap[ext] || 'system.unsupported-file';
    useWorkspaceStore.getState().openWorkspaceTab(
      item.path,
      pluginId,
      ext
    );
  };

  const handleCloseWorkspace = () => {
    navigate('/workspace');
  };

  // Register Command+t/n and Command+w shortcuts
  useShortcut(isMac ? 'Cmd+t' : 'Ctrl+t', (e) => {
    e.preventDefault();
    handleCreateNew();
  });

  useShortcut(isMac ? 'Cmd+n' : 'Ctrl+n', (e) => {
    e.preventDefault();
    handleCreateNew();
  });

  useShortcut(isMac ? 'Cmd+w' : 'Ctrl+w', (e) => {
    if (tabCount > 0) {
      e.preventDefault();
      if (activeTabId) {
        useWorkspaceStore.getState().closeTab(activeTabId);
      }
    } else {
      if (window.electronAPI?.close) {
        window.electronAPI.close();
      }
    }
  });

  // Cmd/Ctrl+1…6: switch to 1st…6th tab
  useShortcut(isMac ? 'Cmd+1' : 'Ctrl+1', (e) => {
    e.preventDefault();
    const tabs = getLayoutTabs(useWorkspaceStore.getState().layoutJson);
    if (tabs[0]?.id) useWorkspaceStore.getState().setActiveTabId(tabs[0].id);
  }, { allowInInputs: false });

  useShortcut(isMac ? 'Cmd+2' : 'Ctrl+2', (e) => {
    e.preventDefault();
    const tabs = getLayoutTabs(useWorkspaceStore.getState().layoutJson);
    if (tabs[1]?.id) useWorkspaceStore.getState().setActiveTabId(tabs[1].id);
  }, { allowInInputs: false });

  useShortcut(isMac ? 'Cmd+3' : 'Ctrl+3', (e) => {
    e.preventDefault();
    const tabs = getLayoutTabs(useWorkspaceStore.getState().layoutJson);
    if (tabs[2]?.id) useWorkspaceStore.getState().setActiveTabId(tabs[2].id);
  }, { allowInInputs: false });

  useShortcut(isMac ? 'Cmd+4' : 'Ctrl+4', (e) => {
    e.preventDefault();
    const tabs = getLayoutTabs(useWorkspaceStore.getState().layoutJson);
    if (tabs[3]?.id) useWorkspaceStore.getState().setActiveTabId(tabs[3].id);
  }, { allowInInputs: false });

  useShortcut(isMac ? 'Cmd+5' : 'Ctrl+5', (e) => {
    e.preventDefault();
    const tabs = getLayoutTabs(useWorkspaceStore.getState().layoutJson);
    if (tabs[4]?.id) useWorkspaceStore.getState().setActiveTabId(tabs[4].id);
  }, { allowInInputs: false });

  useShortcut(isMac ? 'Cmd+6' : 'Ctrl+6', (e) => {
    e.preventDefault();
    const tabs = getLayoutTabs(useWorkspaceStore.getState().layoutJson);
    if (tabs[5]?.id) useWorkspaceStore.getState().setActiveTabId(tabs[5].id);
  }, { allowInInputs: false });

  if (!layoutLoaded) {
    // 等待 workspace 路径异步加载完成，避免渲染旧布局后再替换导致闪烁
    return null;
  }

  if (!modelState.model || tabCount === 0) {
    return (
      <div className="flex flex-col w-full h-full overflow-hidden" style={{ backgroundColor: 'var(--bg-page, #1e1e1e)', color: 'var(--text-primary, #ffffff)' }}>
        <WorkspaceHome
          onOpenRecent={handleOpenRecent}
          onCreateNew={handleCreateNew}
          onClose={handleCloseWorkspace}
        />
      </div>
    );
  }

  return (
    <div className={`flex flex-col w-full h-full overflow-hidden ${zenMode ? 'zen-mode' : ''}`} style={{ backgroundColor: 'var(--bg-page, #1e1e1e)', color: 'var(--text-primary, #ffffff)' }}>
            {/* Main Area divided into content sidebar and tabs */}
      <div className="flex flex-1 w-full h-full overflow-hidden relative">
        {/* FlexLayout Workspace */}
        <main className="flex-1 h-full overflow-hidden relative flex flex-col">
          <WorkspaceTabBar />
          <div className="flex-1 overflow-hidden">
            <Layout
              model={modelState.model}
              factory={factory}
              onModelChange={onModelChange}
              onExternalDrag={onExternalDrag}
              onAction={onAction}
              onContextMenu={handleContextMenu}
            />
            {tabbarElements.map((el, index) => {
              return createPortal(
                <button
                  key={`add-tab-btn-${index}`}
                  onClick={(e) => handlePlusClick(e, 'default')}
                  className="flexlayout__tab_button_add no-drag hover:bg-[rgba(255,255,255,0.08)] text-[var(--text-secondary)] hover:text-white transition-colors duration-150 cursor-pointer flex items-center justify-center"
                  title="新建标签页"
                  style={{
                    border: 'none',
                    background: 'transparent',
                    alignSelf: 'center',
                    height: '22px',
                    width: '22px',
                    borderRadius: '4px',
                    marginLeft: '6px',
                    marginRight: '6px',
                    flexShrink: 0
                  }}
                >
                  <svg width="12" height="12" viewBox="0 0 24 24" fill="none" stroke="currentColor" strokeWidth="2.8" strokeLinecap="round" strokeLinejoin="round">
                    <line x1="12" y1="5" x2="12" y2="19" />
                    <line x1="5" y1="12" x2="19" y2="12" />
                  </svg>
                </button>,
                el
              );
            })}
          {/* {activePanels.length > 0 && !showRightSidebar && !zenMode && (
            <button
              className={`absolute z-[110] w-7 h-7 flex items-center justify-center rounded cursor-pointer transition-all duration-200 text-[var(--text-tertiary,#cccccc)] hover:text-[var(--text-primary,#ffffff)] hover:bg-[rgba(255,255,255,0.08)] ${
                isMac ? 'top-1.5 right-1.5' : 'top-0 right-[110px]'
              }`}
              style={{
                border: 'none',
                background: 'transparent',
              }}
              onClick={toggleRightSidebar}
              title="展开右边栏"
            >
              <svg xmlns="http://www.w3.org/2000/svg" width="14" height="14" viewBox="0 0 24 24" fill="none" stroke="currentColor" strokeWidth="2.5" strokeLinecap="round" strokeLinejoin="round">
                <line x1="21" y1="10" x2="7" y2="10"/><line x1="21" y1="6" x2="3" y2="6"/>
                <line x1="21" y1="14" x2="3" y2="14"/><line x1="21" y1="18" x2="7" y2="18"/>
              </svg>
            </button>
          )} */}
          </div>
        </main>
      </div>

      {/* ── plusMenu Dropdown Menu ── */}
      {plusMenu && (
        <div
          className="fixed flex flex-col gap-px p-1 rounded-lg backdrop-blur-md no-drag"
          style={{
            top: plusMenu.y,
            left: plusMenu.x,
            zIndex: 10000,
            width: '120px',
            backgroundColor: 'var(--bg-card, rgba(30,30,30,0.85))',
            border: '1px solid var(--border-light, rgba(255,255,255,0.08))',
            boxShadow: '0 10px 30px rgba(0,0,0,0.3)',
          }}
          onClick={(e) => e.stopPropagation()}
        >
          <div
            className="px-3 py-1.5 text-[12px] rounded-md cursor-pointer transition-all duration-120 text-[var(--text-secondary,#cccccc)] hover:bg-[var(--bg-hover,rgba(255,255,255,0.08))] hover:text-white"
            onClick={() => {
              setPlusMenu(null);
              const sessionId = `blank_${Date.now()}`;
              useWorkspaceStore.getState().openWorkspaceTab(
                undefined,
                'system.workspace-blank',
                undefined,
                undefined,
                sessionId
              );
            }}
          >
            文件
          </div>
          <div
            className="px-3 py-1.5 text-[12px] rounded-md cursor-pointer transition-all duration-120 text-[var(--text-secondary,#cccccc)] hover:bg-[var(--bg-hover,rgba(255,255,255,0.08))] hover:text-white"
            onClick={() => {
              setPlusMenu(null);
              const sessionId = `terminal_${Date.now()}`;
              useWorkspaceStore.getState().openWorkspaceTab(
                undefined,
                'system.terminal',
                undefined,
                undefined,
                sessionId,
                false,
                '终端'
              );
            }}
          >
            终端
          </div>
          <div
            className="px-3 py-1.5 text-[12px] rounded-md cursor-pointer transition-all duration-120 text-[var(--text-secondary,#cccccc)] hover:bg-[var(--bg-hover,rgba(255,255,255,0.08))] hover:text-white"
            onClick={() => {
              setPlusMenu(null);
              const sessionId = `browser_${Date.now()}`;
              useWorkspaceStore.getState().openWorkspaceTab(
                undefined,
                'system.browser',
                undefined,
                undefined,
                sessionId,
                false,
                '浏览器'
              );
            }}
          >
            浏览器
          </div>
        </div>
      )}

      {contextMenu && (
        <div
          className="flex flex-col gap-px p-1 rounded-lg backdrop-blur-md"
          style={{
            position: 'fixed',
            top: contextMenu.y,
            left: contextMenu.x,
            zIndex: 10000,
            backgroundColor: 'var(--bg-card, rgba(30,30,30,0.85))',
            border: '1px solid var(--border-light, rgba(255,255,255,0.08))',
            boxShadow: '0 10px 30px rgba(0,0,0,0.3)',
            animation: 'contextMenuFadeIn 0.12s cubic-bezier(0.16,1,0.3,1)',
          }}
          onClick={(e) => e.stopPropagation()}
        >
          {(() => {
            const config = contextMenu.node.getConfig() as { filePath?: string } | undefined;
            if (config?.filePath) {
              return (
                <>
                  <div className="px-3 py-1.5 text-[12px] rounded-md cursor-pointer transition-all duration-120" style={{ color: 'var(--text-secondary, #cccccc)' }} onClick={() => {
                    window.dispatchEvent(new CustomEvent('app:locate-in-sidebar', {
                      detail: { filePath: config.filePath }
                    }));
                    setContextMenu(null);
                  }} onMouseEnter={(e) => e.currentTarget.style.backgroundColor = 'var(--bg-hover, rgba(255,255,255,0.08))'}
                     onMouseLeave={(e) => e.currentTarget.style.backgroundColor = 'transparent'}>
                    在侧边栏中定位
                  </div>
                  <div className="h-px mx-1" style={{ backgroundColor: 'var(--border-light, rgba(255,255,255,0.08))' }} />
                </>
              );
            }
            return null;
          })()}
          <div className="px-3 py-1.5 text-[12px] rounded-md cursor-pointer transition-all duration-120" style={{ color: 'var(--text-secondary, #cccccc)' }} onClick={() => {
            useWorkspaceStore.getState().closeTab(contextMenu.node.getId());
            setContextMenu(null);
          }} onMouseEnter={(e) => e.currentTarget.style.backgroundColor = 'var(--bg-hover, rgba(255,255,255,0.08))'}
             onMouseLeave={(e) => e.currentTarget.style.backgroundColor = 'transparent'}>
            关闭标签
          </div>
          <div className="h-px mx-1" style={{ backgroundColor: 'var(--border-light, rgba(255,255,255,0.08))' }} />
          <div className="px-3 py-1.5 text-[12px] rounded-md cursor-pointer transition-all duration-120" style={{ color: 'var(--text-secondary, #cccccc)' }} onClick={() => {
            const siblings = contextMenu.node.getParent().getChildren();
            const index = siblings.indexOf(contextMenu.node);
            const toClose = siblings.slice(0, index).filter(n => n.isCloseable()).map(n => n.getId());
            useWorkspaceStore.getState().closeTabs(toClose);
            setContextMenu(null);
          }} onMouseEnter={(e) => e.currentTarget.style.backgroundColor = 'var(--bg-hover, rgba(255,255,255,0.08))'}
             onMouseLeave={(e) => e.currentTarget.style.backgroundColor = 'transparent'}>
            关闭左边标签
          </div>
          <div className="px-3 py-1.5 text-[12px] rounded-md cursor-pointer transition-all duration-120" style={{ color: 'var(--text-secondary, #cccccc)' }} onClick={() => {
            const siblings = contextMenu.node.getParent().getChildren();
            const index = siblings.indexOf(contextMenu.node);
            const toClose = siblings.slice(index + 1).filter(n => n.isCloseable()).map(n => n.getId());
            useWorkspaceStore.getState().closeTabs(toClose);
            setContextMenu(null);
          }} onMouseEnter={(e) => e.currentTarget.style.backgroundColor = 'var(--bg-hover, rgba(255,255,255,0.08))'}
             onMouseLeave={(e) => e.currentTarget.style.backgroundColor = 'transparent'}>
            关闭右边标签
          </div>
          <div className="h-px mx-1" style={{ backgroundColor: 'var(--border-light, rgba(255,255,255,0.08))' }} />
          <div className="px-3 py-1.5 text-[12px] rounded-md cursor-pointer transition-all duration-120" style={{ color: 'var(--text-secondary, #cccccc)' }} onClick={() => {
            const siblings = contextMenu.node.getParent().getChildren();
            const toClose = siblings.filter(n => n !== contextMenu.node && n.isCloseable()).map(n => n.getId());
            useWorkspaceStore.getState().closeTabs(toClose);
            setContextMenu(null);
          }} onMouseEnter={(e) => e.currentTarget.style.backgroundColor = 'var(--bg-hover, rgba(255,255,255,0.08))'}
             onMouseLeave={(e) => e.currentTarget.style.backgroundColor = 'transparent'}>
            关闭其它标签
          </div>
          <div className="px-3 py-1.5 text-[12px] rounded-md cursor-pointer transition-all duration-120" style={{ color: 'var(--text-secondary, #cccccc)' }} onClick={() => {
            const siblings = contextMenu.node.getParent().getChildren();
            const toClose = siblings.filter(n => n.isCloseable()).map(n => n.getId());
            useWorkspaceStore.getState().closeTabs(toClose);
            setContextMenu(null);
          }} onMouseEnter={(e) => e.currentTarget.style.backgroundColor = 'var(--bg-hover, rgba(255,255,255,0.08))'}
             onMouseLeave={(e) => e.currentTarget.style.backgroundColor = 'transparent'}>
            关闭所有标签
          </div>
        </div>
      )}
    </div>
  );
}

export default FlexWorkspace;
