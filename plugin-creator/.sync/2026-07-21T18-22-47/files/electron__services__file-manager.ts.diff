+/** 精准浅层扫描项目目录下的 .workflow 文件 (最多 2 层：根目录及 1 级常用子目录) */
+async function scanShallowWorkflowFiles(projectDir: string): Promise<string[]> {
+  if (!projectDir || !fs.existsSync(projectDir)) {
+    return [];
+  }
+  const results: string[] = [];
+  const startTime = Date.now();
+  console.log(`[WorkflowScanner:scanDir] ========= 开始浅层扫描 =========`);
+  console.log(`[WorkflowScanner:scanDir] 目标路径: "${projectDir}"`);
+
+  try {
+    const rootEntries = await fsPromises.readdir(projectDir, { withFileTypes: true });
+    console.log(`[WorkflowScanner:scanDir] 根目录项共计 ${rootEntries.length} 项`);
+
+    for (const entry of rootEntries) {
+      // 1. 过滤所有以 . 开头的隐藏文件夹/文件
+      if (entry.name.startsWith('.')) continue;
+
+      // 2. 过滤常见的构建/依赖目录
+      if (entry.name === 'node_modules' || entry.name === 'dist' || entry.name === 'build' || entry.name === 'out') continue;
+
+      const fullPath = join(projectDir, entry.name);
+
+      // 1 层：根目录下的 *.workflow 文件（放宽 isFile() 判断，提升软链/Dirent 兼容性）
+      if (entry.name.endsWith('.workflow')) {
+        console.log(`[WorkflowScanner:scanDir] 匹配根目录文件: "${fullPath}"`);
+        results.push(fullPath);
+      } 
+      // 2 层：1 级子目录 (如 docs, workflows 等)
+      else if (entry.isDirectory()) {
+        try {
+          const subEntries = await fsPromises.readdir(fullPath, { withFileTypes: true });
+          for (const sub of subEntries) {
+            if (sub.name.startsWith('.')) continue;
+            if (sub.name.endsWith('.workflow')) {
+              const subFullPath = join(fullPath, sub.name);
+              console.log(`[WorkflowScanner:scanDir] 匹配子目录文件: "${subFullPath}"`);
+              results.push(subFullPath);
+            }
+          }
+        } catch (subErr) {
+          console.warn(`[WorkflowScanner:scanDir] 无法读取子目录 "${fullPath}":`, subErr);
+        }
+      }
+    }
+  } catch (err) {
+    console.error(`[WorkflowScanner:scanDir] 无法读取根目录 "${projectDir}":`, err);
+  }
+
+  console.log(`[WorkflowScanner:scanDir] 扫描结束: 找到 ${results.length} 个 .workflow 文件 (耗时 ${Date.now() - startTime}ms)`);
+  console.log(`[WorkflowScanner:scanDir] =================================`);
+  return results;
+}
 
